cultureInfo en-US
	translations
		model Model
			table 'Measures Folder'
				measure 'Census All Teachers FTE'
					caption: Census All Teachers FTE
				measure 'Census All Staff FTE'
					caption: Census All Staff FTE
				measure 'Forecast Spend on Other Costs Percentile'
					caption: Forecast Spend on Other Costs Percentile
				measure 'Forecast Spend on All Staff Percentile'
					caption: Forecast Spend on All Staff Percentile
				measure 'Percentage Excluded -2 Years'
					caption: Percentage Excluded -2 Years
				measure 'Spend on All Staff as % Total Expenditure'
					caption: Spend on All Staff as % Total Expenditure
				measure 'Spend on Other Staff as % Total Expenditure'
					caption: Spend on Other Staff as % Total Expenditure
				measure 'Formatted - Forecast Defecit (Expenditure as % Total Income)'
					caption: Formatted - Forecast Defecit (Expenditure as % Total Income)
				measure 'Formatted - Forecast Defecit (Expenditure minus Total Income)'
					caption: Formatted - Forecast Defecit (Expenditure minus Total Income)
				measure 'Percentage Suspension -2 Years'
					caption: Percentage Excluded -2 Years
				measure 'Percentage Suspension -2 Years 1+'
					caption: Percentage Excluded -2 Years
				measure 'Percentage Suspension -2 Years 2+'
					caption: Percentage Excluded -2 Years
			table 'Calculation Group: Exclusion 1+/2+'
				caption: Calculation Group: Exclusion 1+/2+
			table 'Calc Suspension 1+/2+'
				caption: Calculation Group: Exclusion 1+/2+

