table 'Management Accounts'
	lineageTag: 10df33b4-c6bb-40a7-8920-3936ff9c828c

	/// 
	/// DIVIDE (
	/// SUM ( 'Management Accounts'[Budget (Full Year)] ),
	/// SUM ( 'Management Accounts'[Variance (YTD)] )
	/// ) - 1
	measure 'Forecast (Full Year) Variance as % of Budget (Full Year)' =
			
			DIVIDE (
			    SUM ( 'Management Accounts'[Budget (Full Year)] ),
			    SUM ( 'Management Accounts'[Variance (YTD)] )
			) - 1
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 7977726d-9857-4417-bf8c-98641000912a

