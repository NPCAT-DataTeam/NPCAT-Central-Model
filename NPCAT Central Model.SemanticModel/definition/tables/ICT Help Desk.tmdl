	column 'Day Opened' =
			
			VAR Weekdaynum = WEEKDAY('ICT Help Desk'[Create Date],2)
			Return
			SWITCH(Weekdaynum,
			1,"Monday",
			2,"Tuesday",
			3,"Wednesday",
			4,"Thursday",
			5,"Friday",
			6,"Saturday",
			7,"Sunday"
			)
		lineageTag: 421ec75a-ffe5-4a50-876c-ff0de2ae0798
		summarizeBy: none

