	column 'SEN Compliance Tier' =
			
			SWITCH(
			    TRUE(),
			        [SEN Compliance % (Most Recent QA)] = 1,1,
			        [SEN Compliance % (Most Recent QA)] > 0.95,2,
			        [SEN Compliance % (Most Recent QA)] >= 0.9,3,
			        [SEN Compliance % (Most Recent QA)] < 0.9,4
			    )
		formatString: 0
		lineageTag: 0f8f3087-0894-4823-8695-b2bfb5defead
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'SEN Compliance Tier Sort' =
			
			SWITCH(
			    TRUE(),
			        [SEN Compliance % (Most Recent QA)] = 1,1,
			        [SEN Compliance % (Most Recent QA)] > 0.95,2,
			        [SEN Compliance % (Most Recent QA)] >= 0.9,3,
