	column 'Main Role' = ```
			
			VAR _Employee = 'Employees'[Employee Key]
			VAR _PostSort =  CALCULATE(
			MIN('Employee Job Roles'[Post Type (Inc Leadership) Sort]),
			'Employee Job Roles'[Employee Key] = _Employee)
			RETURN
			SWITCH(
			    TRUE(),
			    _PostSort = 1,"Leadership",
			    _PostSort = 2,"Teacher",
			    _PostSort = 3,"Teaching Assistant",
			    _PostSort = 4,"Support Staff",
			    ISBLANK(_PostSort),"Missing Post Type"
			    )
			
			```
		lineageTag: aed6702c-6149-495d-a14d-7868ce02a94a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

