	partition 'zP Attendance School Year-cf742ae4-b4cf-42f6-9826-b88bf68972a2' = calculated
		mode: import
		source =
				
				VAR CurrentYear =CALCULATE(Max('Calendar'[School Year]),'Calendar'[Current School Year Offset] = 0)
				VAR LastYear =CALCULATE(Max('Calendar'[School Year]),'Calendar'[Current School Year Offset] = -1)
				VAR TwoYearAgo =CALCULATE(Max('Calendar'[School Year]),'Calendar'[Current School Year Offset] = -2)
				
				RETURN
				{
				    (TwoYearAgo, NAMEOF('Measures Folder'[Attendance Year End (-2 Years)]), 0),
				    (LastYear, NAMEOF('Measures Folder'[Attendance Year End (-1 Years)]), 1),
				    (CurrentYear, NAMEOF('Measures Folder'[Attendance Percentage YTD]), 2),
				    ("SPLY", NAMEOF('Measures Folder'[Attendance Percentage YTD SPLY]), 3)
				}

	annotation PBI_Id = 3a97d86bdc7246a3a4c899e7d8a9a481

