	column Grade
		lineageTag: ea315423-db79-4f8f-9e17-9e8e42519d76
		summarizeBy: none
		isNameInferred
		sourceColumn: KS4 Assessments[Grade]
		sortByColumn: 'Grade Sort'

		annotation SummarizationSetBy = Automatic

	column 'Grade Set' =
			
			SWITCH(TRUE(),
			'KS4 Distinct Grades'[Grade Sort] <= 3, "Admin",
			'KS4 Distinct Grades'[Grade Sort] = 4, "U",
			'KS4 Distinct Grades'[Grade Sort] IN {5,7,10,13,16,19,22,25,28} , "GCSE",
			'KS4 Distinct Grades'[Grade Sort] IN {6,8,9,11,12,14,15,17,18,20,21,23,24,26,27,29,30} , "GCSE Double",
			'KS4 Distinct Grades'[Grade Sort] >= 31, "BTEC/Cam NAT"
			)
		lineageTag: 79304cc9-c767-451d-8611-5292df72e69f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Admin Grade Selector' =
			
			SWITCH(TRUE(),
			'KS4 Distinct Grades'[Grade Sort] <= 3, "Show Admin Grades",
			'KS4 Distinct Grades'[Grade Sort] > 3,"Hide Admin Grades"
			)
		lineageTag: 9403cb89-835a-41cb-bc44-4fd2146acf0b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

