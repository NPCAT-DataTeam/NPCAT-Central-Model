	column 'Catholic QA Compliance Tier' =
			
			SWITCH(
			    TRUE(),
			        [Catholic QA Compliance % (Most Recent QA)] = 1,1,
			        [Catholic QA Compliance % (Most Recent QA)] > 0.95,2,
			        [Catholic QA Compliance % (Most Recent QA)] >= 0.9,3,
			        [Catholic QA Compliance % (Most Recent QA)] < 0.9,4
			    )
		formatString: 0
		lineageTag: c4392441-c6db-44ea-a2c1-4060271ac686
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Catholic QA Compliance Tier (Sort)' =
			
			SWITCH(
