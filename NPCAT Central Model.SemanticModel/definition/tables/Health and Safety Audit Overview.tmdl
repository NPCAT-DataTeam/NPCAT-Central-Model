	column 'Is Most Recent Health and Safety Audit' =
			
			var __School = 'Health and Safety Audit Overview'[SUID]
			var __MostRecentDate = CALCULATE(MAX('Health and Safety Audit Overview'[Date of Audit]),ALL('Health and Safety Audit Overview'),'Health and Safety Audit Overview'[SUID] = __School)
			return
			IF('Health and Safety Audit Overview'[Date of Audit] = __MostRecentDate,"Yes","No")
