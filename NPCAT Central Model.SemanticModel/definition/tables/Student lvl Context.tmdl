table 'Student lvl Context'
	lineageTag: c588ebb9-387f-454c-8dcb-8bac36a00ae0

	calculationGroup
		precedence: 11

		calculationItem KS4 =
				
				VAR Student = SELECTEDVALUE('KS4 Assessments'[Unique Student ID])//,DISTINCT('KS4 Subject Assessments'[Unique Student ID]))
				RETURN
				    CALCULATE(
				        SELECTEDMEASURE(),
				        'Student Database (Full)'[Globally Unique Student ID] = Student
				    )

		calculationItem KS3 =
				
				VAR Student = SELECTEDVALUE('KS3 Summative Marks'[Globally Unique Student ID])
				RETURN
				    CALCULATE(
				        SELECTEDMEASURE(),
				        'Student Database (Full)'[Globally Unique Student ID] = Student
				    )

		calculationItem KS2 =
				
				VAR Student = SELECTEDVALUE('KS2 Tests & TA Results'[STUDENT_UNIQUE_ID])//,DISTINCT('KS4 Subject Assessments'[Unique Student ID]))
				RETURN
				    CALCULATE(
				        SELECTEDMEASURE(),
				        'Student Database (Full)'[Globally Unique Student ID] = Student
				    )

