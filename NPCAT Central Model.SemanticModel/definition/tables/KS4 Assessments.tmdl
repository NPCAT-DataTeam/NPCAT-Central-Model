	column 'P8 Field Value' = Calculate(AVERAGEX('KS4 Assessments',[Subject P8]),ALLEXCEPT('KS4 Assessments','KS4 Assessments'[Unique Student ID], 'KS4 Assessments'[School Year], 'KS4 Assessments'[PERIOD_NAME], 'KS4 Assessments'[P8 Slot (Bucket)]), 'KS4 Assessments'[P8 Slot (Bucket)] <> "Spare" )
		formatString: 0.00
		lineageTag: b04a2350-8848-431a-a402-be84218b53a4
		summarizeBy: none

		changedProperty = FormatString

		annotation SummarizationSetBy = User

	column 'Attendance on Assessment' =
			
			VAR _AssessmentDate = 0
			//assessment date to be put into model
			Return
			CALCULATE([Attendance Percentage YTD],'Calendar'[Date] =_AssessmentDate )
		lineageTag: da4390d1-d2bf-4978-8884-e5efb1111fd3
		summarizeBy: sum

		changedProperty = FormatString

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

