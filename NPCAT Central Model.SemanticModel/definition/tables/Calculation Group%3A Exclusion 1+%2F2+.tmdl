table 'Calculation Group: Exclusion 1+/2+'
	lineageTag: 82553711-de6c-4c87-8960-f064f44181ef

	calculationGroup

		calculationItem '1+ Suspension' =
				CALCULATE (
				    SELECTEDMEASURE (), 'Excluded Students'[Exclusions YTD] > 0
				)

		calculationItem '2+ Suspension' = CALCULATE ( SELECTEDMEASURE (), 'Excluded Students'[Exclusions YTD] > 1)

