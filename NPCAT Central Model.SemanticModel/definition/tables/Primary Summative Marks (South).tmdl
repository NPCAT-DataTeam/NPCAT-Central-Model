	column 'Baseline Name' =
			
			LOOKUPVALUE (
			    'Primary Summative Targets (South)'[Target Name],
			    'Primary Summative Targets (South)'[Target Key], 'Primary Summative Marks (South)'[Target Key],
			    'Primary Summative Targets (South)'[Target Type], "Progress Baseline",Blank()
			)
		lineageTag: a2ff1150-003c-417b-bce9-620b33d7f180
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Baseline Points' =
			
			LOOKUPVALUE (
			    'Primary Summative Targets (South)'[Target Points],
			    'Primary Summative Targets (South)'[Target Key], 'Primary Summative Marks (South)'[Target Key],
			    'Primary Summative Targets (South)'[Target Type], "Progress Baseline",Blank()
			)
		lineageTag: fee70e31-252f-4115-8bf3-c3d3824646f9
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Mandatory Assessment Status' =
			
			SWITCH(TRUE,
			    [Assessment Name] = "AOL - Communication" && [Year Group] IN {"N1", "N2", "Reception"}, "Core",
			    [Assessment Name] = "AOL - Expressive Arts" && [Year Group] IN {"Reception"}, "Core",
			    [Assessment Name] = "AOL - Literacy" && [Year Group] IN {"Reception"}, "Core",
			    [Assessment Name] = "AOL - Mathematics" && [Year Group] IN {"Reception"}, "Core",
			    [Assessment Name] = "AOL - Personal, Social & Emotional Development" && [Year Group] IN {"N1", "N2", "Reception"}, "Core",
			    [Assessment Name] = "AOL - Physical Development" && [Year Group] IN {"N1", "N2", "Reception"}, "Core",
			    [Assessment Name] = "AOL - Understanding The World" && [Year Group] IN {"Reception"}, "Core",
			    [Assessment Name] = "Maths", "Core",
			    [Assessment Name] = "Reading", "Core",
			    [Assessment Name] = "RE", "Core",
			    [Assessment Name] = "Science", "Core",
			    [Assessment Name] = "Writing", "Core",
			    "Optional"
			)
		lineageTag: b448036b-c171-4380-9631-6b550f6351c2
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Variation from Baseline' =
			
			IF (
			    LEN ( [Grade Points] ) = 0,
			    BLANK (),
			    IF (
			        LEN ( [Baseline Points] ) = 0,
			        BLANK (),
			        [Grade Points] - [Baseline Points]
			    )
			)
		dataType: int64
		lineageTag: a3a8ced3-9ace-4b06-b11e-2a90dd4a8689
		summarizeBy: sum

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Variation from ARE' =
			
			IF (
			    LEN ( [Grade Points] ) = 0,
			    BLANK (),
			        [Grade Points] - 4
			    )
		lineageTag: 62bc757c-55b4-4786-8506-51c72ae6dda4
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

