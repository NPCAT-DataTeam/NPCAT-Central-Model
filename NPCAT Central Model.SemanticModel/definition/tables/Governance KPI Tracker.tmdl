	column 'Days Late' =
			
			CALCULATE (
			        7 - [Average Number of days for Papers Received],
			        'Governance KPI Tracker'[Is Most Recent Govenor Meeting] = "Yes"
			    )
		lineageTag: 77faac1d-db33-4d8e-ad2d-8b6a54c2b3e0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

