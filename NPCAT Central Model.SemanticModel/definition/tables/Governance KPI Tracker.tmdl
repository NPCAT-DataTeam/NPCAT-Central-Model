	column 'Is Most Recent Govenor Meeting' =
			
			var __School = 'Governance KPI Tracker'[School / Governing Body]
			var __MostRecentDate = CALCULATE(MAX('Governance KPI Tracker'[Date of Meeting]),ALL('Governance KPI Tracker'),'Governance KPI Tracker'[School / Governing Body] = __School)
			return
			IF('Governance KPI Tracker'[Date of Meeting] = __MostRecentDate,"Yes","No")
		lineageTag: d5d9e089-aa9c-4345-a6a0-38da9539d928
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

