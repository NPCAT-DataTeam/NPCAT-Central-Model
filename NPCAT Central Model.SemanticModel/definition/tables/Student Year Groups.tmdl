		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'IDACI Decile' =
			FORMAT(IF(ISBLANK(
			LOOKUPVALUE(
			    'Student Indicies'[Decile],
			    'Student Indicies'[Globally Unique Student - Year], 'Student Year Groups'[Unique Student ID - Academic Year],
			    'Student Indicies'[Category],"IDACI",
			    'Student Indicies'[RELEASE_YEAR],2025
			)),"Undefined",
			 LOOKUPVALUE(
			    'Student Indicies'[Decile],
			    'Student Indicies'[Globally Unique Student - Year], 'Student Year Groups'[Unique Student ID - Academic Year],
			    'Student Indicies'[Category],"IDACI",
			    'Student Indicies'[RELEASE_YEAR],2025
			)),"0")
		lineageTag: e2343923-07a3-467b-b2ba-87a54bb444b9
		summarizeBy: none
		sortByColumn: 'IDACI Decile Sort'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

