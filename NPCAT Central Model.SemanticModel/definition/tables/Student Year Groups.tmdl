	column 'In Year Joiner' = ```
			IF ( MONTH([Start Date]) = 9 , "Not In Year Joiner", "In Year Joiner") 
			```
		lineageTag: 0b60fe51-e7fc-468d-a6fc-e9d9e7a7068e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Birthday Mark Check' =
			
			VAR  Birthday = LOOKUPVALUE('Student Database (Full)'[DOB],'Student Database (Full)'[Globally Unique Student ID],[Globally Unique Student ID])
			VAR  Birthday_Year = [Academic Year]+ (IF(MONTH(Birthday)>8,0,1))
			VAR  Academic_BDay = DATE(Birthday_Year,MONTH(Birthday),DAY(Birthday))
			VAR  Attendance_Mark = CALCULATE( COUNTROWS('Student Absences'),
			                                'Student Absences'[Start Date]<=Academic_BDay &&
			                                'Student Absences'[End Date]>=Academic_BDay,
			                                'Student Absences'[Sessions Missed] <= 20
			                                )
			VAR Student = [Unique Student ID - Academic Year]
			VAR Sessions = CALCULATE(
			                    MAX('Student Absences'[Sessions Missed]),
			                    'Student Absences'[Student - Year ID]=Student,
			                    'Student Absences'[Start Date]<=Academic_BDay &&
			                    'Student Absences'[End Date]>=Academic_BDay)
			RETURN
			        SWITCH(TRUE(),
			            Attendance_Mark = 0, "Present",
			            Sessions >= 20, "Unrelated Absence",
			            [End date]<Academic_BDay, "Unenrolled",
			            Attendance_Mark >= 1, "Absent over Birthday"
			            )
		lineageTag: dd47a2cd-7913-4583-8883-5692e3417b91
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Suspensions YTD' = ```
			
			VAR Incidents = CALCULATE(
			        COUNTROWS( 'Behaviour Sanctions'),
			        'Behaviour Sanctions'[Source Table] = "Suspension"
			        )
			VAR IncidentsNoBlank = IF(ISBLANK(Incidents),0,Incidents)
			RETURN
			    
			    IncidentsNoBlank
			
			
			
			```
		formatString: 0
		lineageTag: aad43ba9-7821-4046-8724-a1e5f174e41f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

