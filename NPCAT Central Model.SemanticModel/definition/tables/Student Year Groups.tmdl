	column 'Attendance YTD' = ```
			
			    Calculate(
			        Divide(
			            SUM(Attendance[Attendance]),
			            SUM(Attendance[Sessions])),
			        Attendance[Redaction Check]<>1,
			        Attendance[On Roll] <> "Unenrolled",
			        Attendance[Compulsory Age] = 1)
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 7623e129-d86f-486d-8d46-846840d6dcc2
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Attendance Rank' = ```
			
			SWITCH(TRUE(), 
			    ISBLANK([Attendance YTD]), "N/A",
			    [Attendance YTD] >= 0.97, "97%-100%",
			    [Attendance YTD] >= 0.94, "94%-97%",
			    [Attendance YTD] >= 0.90, "90%-94%",
			    [Attendance YTD] >= 0.75, "75%-90%",
			    [Attendance YTD] >= 0.50, "50%-75%",
			    [Attendance YTD] >= 0.25, "25%-50%",
			    [Attendance YTD] < 0.25,  "0%-25%"
			)
			```
		lineageTag: 5eee02d8-8486-41b7-b56e-81abe4d39112
		summarizeBy: none
		sortByColumn: 'Attendance Rank Sort'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Attendance Rank Sort' =
			
			VAR AttendanceYTD = [Attendance YTD]
			RETURN
			SWITCH(TRUE(),
			        ISBLANK(AttendanceYTD), 8,
			        AttendanceYTD >= 0.97, 1,
			        AttendanceYTD >= 0.94, 2,
			        AttendanceYTD >= 0.90, 3,
			        AttendanceYTD >= 0.75, 4,
			        AttendanceYTD >= 0.5, 5,
			        AttendanceYTD >= 0.25, 6,
			        AttendanceYTD < 0.25, 7
			        )
		formatString: 0
		lineageTag: 7866f4cd-83ce-483e-951e-695ff7030cf0
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'In Year Leaver Flag' = IF ( MONTH([End date]) = 8 , "Not In Year Leaver", "In Year Leaver")
