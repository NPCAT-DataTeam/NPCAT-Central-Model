	column 'Days Taken to Complete' =
			
			VAR _Complete = [Date Completed]
			RETURN
			IF( ISBLANK([Date Completed]),
			BLANK(),
			DATEDIFF([Date Sent],_Complete,DAY))
		formatString: 0
		lineageTag: cc2b67fd-faa2-4546-84ac-4e141213f5b7
		summarizeBy: sum

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Hour Completed on'
		dataType: string
		lineageTag: 01078a57-3b1c-4ed2-b9bd-534009656154
		summarizeBy: none
		sourceColumn: Hour Completed on

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Hour Sort'
		dataType: int64
		formatString: 0
		lineageTag: 8cbeba65-f39a-49c9-b3be-1749c8b77f36
		summarizeBy: sum
		sourceColumn: Hour Sort

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'RAGB Rating' =
			
			IF(ISBLANK([Date Completed]),"Incomplete",
			IF (
			    [Days Taken to Complete] >= 0 && [Days Taken to Complete] <= 14, "0-14 Days",
			    IF (
			        [Days Taken to Complete] >= 15 && [Days Taken to Complete] <= 29, "15-29 Days",
			        IF (
			            [Days Taken to Complete] >= 30 && [Days Taken to Complete] <= 59, "30-59 Days",
			            IF (
			                [Days Taken to Complete] >= 60, "60+ Days",
			                BLANK()
			            )
			        )
			    )
			)
			)
		lineageTag: 542ebd3c-9de6-4b72-bb55-e0f48ce05d6e
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Incomplete RAGB Rating' =
			
			VAR DaysTaken = IF(ISBLANK([Date Completed]),DATEDIFF([Date Sent],TODAY(),DAY),-1)
			
			RETURN
			
			IF(DaysTaken = -1,"Complete",
			    IF (
			        DaysTaken >= 0 && DaysTaken <= 14, "0-14 Days",
			        IF (
			            DaysTaken >= 15 && DaysTaken <= 29, "15-29 Days",
			            IF (
			                DaysTaken >= 30 && DaysTaken <= 59, "30-59 Days",
			                IF (
			                    DaysTaken >= 60, "60+ Days",
			                    BLANK()
			                )
			            )
			        )
			    )
			)
		lineageTag: b55c8e5a-2ebc-48c0-a4d6-a661188b37dc
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

