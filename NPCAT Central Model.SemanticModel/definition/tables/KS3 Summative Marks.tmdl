	column 'Current Band Point (School)' =
			
			SWITCH (
			    TRUE(),
			    'KS3 Summative Marks'[Percentile (School)] >= .9 , 6,
			    'KS3 Summative Marks'[Percentile (School)] >= .75 , 5,
			    'KS3 Summative Marks'[Percentile (School)] >= .5 , 4,
			    'KS3 Summative Marks'[Percentile (School)] >= .25 , 3,
			    'KS3 Summative Marks'[Percentile (School)] >= .1 , 2,
			    'KS3 Summative Marks'[Percentile (School)] < .1 , 1
			    )
		lineageTag: 5b340b7a-95b8-4459-9320-e637ba02e767
		summarizeBy: sum
		sortByColumn: 'Current Band Point (School) (Sort)'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Current Band Point (School) (Sort)' =
			
			SWITCH (
			    TRUE(),
			    'KS3 Summative Marks'[Percentile (School)] >= .9 , 1,
			    'KS3 Summative Marks'[Percentile (School)] >= .75 , 2,
			    'KS3 Summative Marks'[Percentile (School)] >= .5 , 3,
			    'KS3 Summative Marks'[Percentile (School)] >= .25 , 4,
			    'KS3 Summative Marks'[Percentile (School)] >= .1 , 5,
			    'KS3 Summative Marks'[Percentile (School)] < .1 , 6
			    )
		lineageTag: b0b7e775-428d-46fa-a73f-2197ccf4ec25
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Percentile (School)' =
			
			VAR StudentCount =
			    COUNTROWS (
			        FILTER (
			            'KS3 Summative Marks',
			            //'KS3 Summative Marks'[Year]              = EARLIER ( 'KS3 Summative Marks'[Year] )              &&
			            'KS3 Summative Marks'[School Arbor ID]   = EARLIER ( 'KS3 Summative Marks'[School Arbor ID] )   &&
			            //'KS3 Summative Marks'[Assessment Type]   = EARLIER ( 'KS3 Summative Marks'[Assessment Type] )   &&
			            'KS3 Summative Marks'[Academic Year Start]     = EARLIER ( 'KS3 Summative Marks'[Academic Year Start] )     &&
			            'KS3 Summative Marks'[Subject]           = EARLIER ( 'KS3 Summative Marks'[Subject] )           &&
			            'KS3 Summative Marks'[Period]            = EARLIER ( 'KS3 Summative Marks'[Period] )            &&
			            'KS3 Summative Marks'[Year Group]        = EARLIER ( 'KS3 Summative Marks'[Year Group] )        &&
			            NOT ISBLANK ( 'KS3 Summative Marks'[Grade Points] )
			        )
			    )
			
			VAR RankPos =
			    'KS3 Summative Marks'[Rank within Subject (School)]
			
			RETURN
			    DIVIDE ( StudentCount - RankPos, StudentCount )
		lineageTag: fe0597fc-62bb-4574-b68e-d94c39b7bd80
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Rank Change' = ```
			IF(NOT(ISBLANK([Baseline Rank])),
			'KS3 Summative Marks'[Baseline Rank]  - 'KS3 Summative Marks'[Rank within Subject (School)]) 
			```
		formatString: 0
		lineageTag: 72079e7b-1e19-43bd-af8d-d67591677d4f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Rank within Subject (School)' = ```
			
			RANKX( 
			    FILTER( 'KS3 Summative Marks' , 
			    'KS3 Summative Marks'[Academic Year Start] = EARLIER( 'KS3 Summative Marks'[Academic Year Start] ) &&
			    'KS3 Summative Marks'[Year Group] = EARLIER( 'KS3 Summative Marks'[Year Group] ) && 
			    //'KS3 Summative Marks'[Year] = EARLIER( 'KS3 Summative Marks'[Year] ) &&
			    'KS3 Summative Marks'[School Arbor ID] = EARLIER( 'KS3 Summative Marks'[School Arbor ID] ) && 
			    //'KS3 Summative Marks'[Assessment Type] = EARLIER( 'KS3 Summative Marks'[Assessment Type] ) &&
			    //'KS3 Summative Marks'[Academic Year Start] = EARLIER( 'KS3 Summative Marks'[Academic Year Start] ) &&
			    'KS3 Summative Marks'[Subject] = EARLIER( 'KS3 Summative Marks'[Subject] ) && 
			    'KS3 Summative Marks'[Period] = EARLIER( 'KS3 Summative Marks'[Period] ) && 
			    //'KS3 Summative Marks'[Year Group] = EARLIER( 'KS3 Summative Marks'[Year Group] ) && 
			    NOT ( ISBLANK ( 'KS3 Summative Marks'[Grade Points] ))),
			    'KS3 Summative Marks'[Grade Points],
			    ,
			    DESC
			)
			```
		formatString: 0
		lineageTag: 539b48e6-3475-45db-bacf-3994180e4207
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Rank within Subject (Trust)' = ```
			
			RANKX( 
			    FILTER( 'KS3 Summative Marks' , 
			    // 'KS3 Summative Marks'[Year] = EARLIER( 'KS3 Summative Marks'[Year] ) &&
			    // 'KS3 Summative Marks'[Assessment Type] = EARLIER( 'KS3 Summative Marks'[Assessment Type] ) &&
			    'KS3 Summative Marks'[Academic Year Start] = EARLIER( 'KS3 Summative Marks'[Academic Year Start] ) &&
