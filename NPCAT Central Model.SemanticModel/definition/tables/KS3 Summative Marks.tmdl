	column 'Current Band (School)' = ```
			
			SWITCH (
			    TRUE(),
			    'KS3 Summative Marks'[Percentile (School)] >= .9 , "Band A",
			    'KS3 Summative Marks'[Percentile (School)] >= .75 , "Band B",
			    'KS3 Summative Marks'[Percentile (School)] >= .5 , "Band C",
			    'KS3 Summative Marks'[Percentile (School)] >= .25 , "Band D",
			    'KS3 Summative Marks'[Percentile (School)] >= .1 , "Band E",
			    'KS3 Summative Marks'[Percentile (School)] < .1 , "Band F"
			    )
			    
			```
		lineageTag: dc9a761a-9408-4684-a22e-177019333298
		summarizeBy: none
		sortByColumn: 'Current Band Point (School) (Sort)'

