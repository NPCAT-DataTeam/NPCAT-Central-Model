	column 'Student - Year ID'
		dataType: string
		lineageTag: 2f2d5487-0154-4e62-9342-bd11ebc07c9e
		summarizeBy: none
		sourceColumn: Student - Year ID

		annotation SummarizationSetBy = Automatic

	column 'Birthday Check' =
			
			VAR  Birthday = LOOKUPVALUE('Student Database (Full)'[DOB],'Student Database (Full)'[Globally Unique Student ID],[STUDENT_UNIQUE_ID])
			VAR  Birthday_Year = VALUE([Academic Year])+ (IF(MONTH(Birthday)>8,0,1))
			VAR  Academic_BDay = IFERROR(DATE(Birthday_Year,MONTH(Birthday),DAY(Birthday)),"")
			RETURN
			    IF(Academic_BDay="","Unenrolled",
			        IF( 'Student Absences'[Start Date]<=Academic_BDay &&'Student Absences'[End Date]>=Academic_BDay,
			        "Yes",
			        "No"))
		lineageTag: 5107f783-0781-454a-8888-1c7c19cbbae7
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

