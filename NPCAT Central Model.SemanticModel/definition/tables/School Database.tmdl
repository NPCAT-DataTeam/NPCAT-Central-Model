table 'School Database'
	lineageTag: 205dadfa-55df-4c55-a49b-76067a1245d7

	/// 
	/// CALCULATE (
	/// FIRSTDATE ( 'Attendance Managers Actions'[Date Created] ),
	/// 'Attendance Managers Actions'[SO Code] = "SO2"
	/// )
	measure 'SO2 Date' =
			
			CALCULATE (
			    FIRSTDATE ( 'Attendance Managers Actions'[Date Created] ),
			    'Attendance Managers Actions'[SO Code] = "SO2"
			)
		formatString: dd mmmm yyyy
		lineageTag: 19997fd8-5e74-4d88-bcb6-7b2f0ef777a3

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	/// 
	/// CALCULATE ( COUNT ( Attendance[Sessions] ), Attendance[Mark] = "E" )
	measure 'Sessions Excluded' =
			
			CALCULATE ( COUNT ( Attendance[Sessions] ), Attendance[Mark] = "E" )
		formatString: 0
		lineageTag: fd79ce2d-fb97-44a7-b8dd-24534a654529

