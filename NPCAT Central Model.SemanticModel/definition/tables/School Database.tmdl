	column 'CSI - Catholic Life' = ```
			
			    
			VAR Lookup =     
			    LOOKUPVALUE(
			        Inspections[Outcome],
			        Inspections[Arbor ID], 'School Database'[Arbor ID],
			        Inspections[Inspection Offset], "0",
			        Inspections[Inspection Element], "Catholic Life",
			        Inspections[Inspection Type], "CSI"
			    )
			RETURN
			
			IF(ISBLANK(Lookup),"N/A",Lookup)
			```
