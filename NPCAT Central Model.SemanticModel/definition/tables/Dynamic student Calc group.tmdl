				    VALUES('Student Database (Full)'[Globally Unique Student ID])
				
				VAR FinalIDs =
				    INTERSECT( StudentsWithTag, CurrentStudents )
				
				RETURN
				CALCULATE(
				    SELECTEDMEASURE(),
				    
				    -- 3) Apply the Tag-based set of Student IDs to the Student table
				    TREATAS( FinalIDs, 'Student Database (Full)'[Globally Unique Student ID] )
				)
				```

		calculationItem 'SEN + Not FSM' = ```
				
				VAR CurrentMeasure = SELECTEDMEASURENAME()
				VAR BaseMaxDate    = MAX ( 'Calendar'[Date] )
				VAR CurrentOffset  = MAX ( 'Calendar'[Current School Year Offset] )
				
				-- Dynamic max date calculated directly inside the item
				VAR _MaxDate = 
				    SWITCH (
				        TRUE (),
				
				        -- 1. SPLY: Same point in time 12 months prior
				        CONTAINSSTRING ( CurrentMeasure, "SPLY" ),
				        EDATE ( BaseMaxDate, -12 ),
				
				        -- 2. -1 Years: Max date of previous school year
				        CONTAINSSTRING ( CurrentMeasure, "-1 Years" ),
				        CALCULATE (
				            MAX ( 'Calendar'[Date] ),
				            REMOVEFILTERS ( 'Calendar' ),
				            'Calendar'[Current School Year Offset] = CurrentOffset - 1
				        ),
				
				        -- 3. -2 Years: Max date of 2 school years ago
				        CONTAINSSTRING ( CurrentMeasure, "-2 Years" ),
				        CALCULATE (
				            MAX ( 'Calendar'[Date] ),
				            REMOVEFILTERS ( 'Calendar' ),
				            'Calendar'[Current School Year Offset] = CurrentOffset - 2
				        ),
				
				        -- Default: YTD or base date
				        BaseMaxDate
				    )
				
				VAR StudentsWithTag1 =
				    CALCULATETABLE(
				        VALUES('Student Database (Full)'[Globally Unique Student ID]),
				        FILTER(
				            'Demographics',
				            'Demographics'[Tag] = "SEN"
				            && 'Demographics'[Tag Start Date] <= _MaxDate
				            && 'Demographics'[Tag End Date]   >= _MaxDate
				        )
				    )
				
				
				-- 1) Gather the set of Student IDs who have Tag = "FSM" active at _MaxDate
				VAR StudentsWithTag2 =
				    CALCULATETABLE(
				        VALUES('Student Database (Full)'[Globally Unique Student ID]),
				        FILTER(
				            'Demographics',
				            'Demographics'[Tag] = "FSM"
				            && 'Demographics'[Tag Start Date] <= _MaxDate
				            && 'Demographics'[Tag End Date]   >= _MaxDate
				        )
				    )
				
				-- 2) Intersect with current filter context if needed.
				--    Usually you can rely on the existing School->Student context,
				--    but if you want to explicitly keep only students in the current context:
				VAR CurrentStudents =
				    VALUES('Student Database (Full)'[Globally Unique Student ID])
				
				VAR SENstudentIDs =
				    INTERSECT( StudentsWithTag1, CurrentStudents )
				
				VAR FinalIDs =
				    EXCEPT( SENstudentIDs, StudentsWithTag2 )
				
				RETURN
				CALCULATE(
				    SELECTEDMEASURE(),
				    
				    -- 3) Apply the Tag-based set of Student IDs to the Student table
				    TREATAS( FinalIDs, 'Student Database (Full)'[Globally Unique Student ID] )
				)
				```

		calculationItem 'Hidden Dis' = ```
				
				//Hidden Vulnerabilities
				VAR CurrentMeasure = SELECTEDMEASURENAME()
				VAR BaseMaxDate    = MAX ( 'Calendar'[Date] )
				VAR CurrentOffset  = MAX ( 'Calendar'[Current School Year Offset] )
				
				-- Dynamic max date calculated directly inside the item
				VAR _MaxDate = 
				    SWITCH (
				        TRUE (),
				
				        -- 1. SPLY: Same point in time 12 months prior
				        CONTAINSSTRING ( CurrentMeasure, "SPLY" ),
				        EDATE ( BaseMaxDate, -12 ),
				
				        -- 2. -1 Years: Max date of previous school year
				        CONTAINSSTRING ( CurrentMeasure, "-1 Years" ),
				        CALCULATE (
				            MAX ( 'Calendar'[Date] ),
				            REMOVEFILTERS ( 'Calendar' ),
				            'Calendar'[Current School Year Offset] = CurrentOffset - 1
				        ),
				
				        -- 3. -2 Years: Max date of 2 school years ago
				        CONTAINSSTRING ( CurrentMeasure, "-2 Years" ),
				        CALCULATE (
				            MAX ( 'Calendar'[Date] ),
				            REMOVEFILTERS ( 'Calendar' ),
				            'Calendar'[Current School Year Offset] = CurrentOffset - 2
				        ),
				
				        -- Default: YTD or base date
				        BaseMaxDate
				    )
				
				VAR StudentsWithTag1 =
				    CALCULATETABLE(
				        VALUES('Student Indicies'[Globally Unique Student ID]),
				        FILTER(
				            'Student Indicies',
				            'Student Indicies'[Decile] IN {"3","2","1"} &&
				            'Student Indicies'[RELEASE_YEAR] = 2025 &&
				            'Student Indicies'[Category] = "IDACI"
				            
				        )
				    )
				
				
				-- 1) Gather the set of Student IDs who have Tag = "FSM" active at _MaxDate
				VAR StudentsWithTag2 =
				    CALCULATETABLE(
				        VALUES('Student Database (Full)'[Globally Unique Student ID]),
				        FILTER(
				            'Demographics',
				            'Demographics'[Tag] = "FSM"
				            && 'Demographics'[Tag Start Date] <= _MaxDate
				            && 'Demographics'[Tag End Date]   >= _MaxDate
				        )
				    )
				
				VAR StudentsWithTag3 =
				    CALCULATETABLE(
				        VALUES('Student Database (Full)'[Globally Unique Student ID]),
				        FILTER(
				            'Demographics',
				            'Demographics'[Tag] = "SEN"
				            && 'Demographics'[Tag Start Date] <= _MaxDate
				            && 'Demographics'[Tag End Date]   >= _MaxDate
				        )
				    )
				
				-- 2) Intersect with current filter context if needed.
				--    Usually you can rely on the existing School->Student context,
				--    but if you want to explicitly keep only students in the current context:
				VAR CurrentStudents =
				    VALUES('Student Database (Full)'[Globally Unique Student ID])
				
				VAR IDACIStudentIDs =
				    INTERSECT(  CurrentStudents, StudentsWithTag1 )
				
				VAR studentIDs =
				    EXCEPT(  IDACIStudentIDs, StudentsWithTag2 )
				
				VAR FinalIDs =
				    EXCEPT( studentIDs, StudentsWithTag3 )
				
				RETURN
				CALCULATE(
				    SELECTEDMEASURE(),
				    
				    -- 3) Apply the Tag-based set of Student IDs to the Student table
				    TREATAS( FinalIDs, 'Student Database (Full)'[Globally Unique Student ID] )
				)
				```

