		calculationItem 'Attendance 97%-100%' =
				CALCULATE (
				    SELECTEDMEASURE (),
				    'Student Year Groups'[Attendance Rank] = "97%-100%"
				)

		calculationItem 'Attendance 94%-97%' =
				CALCULATE (
				    SELECTEDMEASURE (),
				   'Student Year Groups'[Attendance Rank] = "94%-97%"
				)

		calculationItem 'Attendance 90%-94%' =
				CALCULATE (
				    SELECTEDMEASURE (),
				    'Student Year Groups'[Attendance Rank] = "90%-94%"
				)

		calculationItem 'Attendance 75%-90%' =
				CALCULATE (
				    SELECTEDMEASURE (),
				    'Student Year Groups'[Attendance Rank] = "75%-90%"
				)

		calculationItem 'Attendance 50%-75%' =
				CALCULATE (
				    SELECTEDMEASURE (),
				    'Student Year Groups'[Attendance Rank] = "50%-75%"
				)

		calculationItem 'Attendance 25%-50%' =
				
				CALCULATE (
				    SELECTEDMEASURE (),
				    'Student Year Groups'[Attendance Rank] = "25%-50%"
				)

		calculationItem 'Attendance 0%-25%' =
				
				CALCULATE (
				    SELECTEDMEASURE (),
				    'Student Year Groups'[Attendance Rank] = "0%-25%"
				)

		calculationItem 'Suspension 0 Incidents' =
				CALCULATE (
				    SELECTEDMEASURE (),
				    'Student Year Groups'[Fixed Term Exclusions (0,1+,2+)] = 0
				)

		calculationItem 'Suspension 1+ Incidents' =
				CALCULATE (
				    SELECTEDMEASURE (),
				    'Student Year Groups'[Fixed Term Exclusions (0,1+,2+)] >= 1
				)

		calculationItem 'Suspension 2+ Incidents' =
				CALCULATE (
				    SELECTEDMEASURE (),
				    'Student Year Groups'[Fixed Term Exclusions (0,1+,2+)] >= 2
				)

