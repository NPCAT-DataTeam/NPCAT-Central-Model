				    SWITCH (
				        TRUE (),
				
				        -- 1. SPLY: Same point in time 12 months prior
				        CONTAINSSTRING ( CurrentMeasure, "SPLY" ),
				        EDATE ( BaseMaxDate, -12 ),
				
				        -- 2. -1 Years: Max date of previous school year
				        CONTAINSSTRING ( CurrentMeasure, "-1 Years" ),
				        CALCULATE (
				            MAX ( 'Calendar'[Date] ),
				            REMOVEFILTERS ( 'Calendar' ),
				            'Calendar'[Current School Year Offset] = CurrentOffset - 1
				        ),
				
				        -- 3. -2 Years: Max date of 2 school years ago
				        CONTAINSSTRING ( CurrentMeasure, "-2 Years" ),
