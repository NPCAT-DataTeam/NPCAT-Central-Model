				            MAX ( 'Calendar'[Date] ),
				            REMOVEFILTERS ( 'Calendar' ),
				            'Calendar'[Current School Year Offset] = CurrentOffset - 2
				        ),
				
				        -- Default: YTD or base date
				        BaseMaxDate
