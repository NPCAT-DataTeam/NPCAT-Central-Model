	column 'Is Most Recent Safeguarding Audit' =
			
			var thisSchool = 'Safeguarding Visits'[SUID]
			var mostRecentDate = CALCULATE(MAX('Safeguarding Visits'[Snapshot Date]),ALL('Safeguarding Visits'),'Safeguarding Visits'[SUID] = thisSchool,'Safeguarding Visits'[Supervision/Audit] = "Audit")
			return
			IF('Safeguarding Visits'[Snapshot Date] = mostRecentDate,"Yes","No")
		lineageTag: e40cb25f-b250-4cc1-9217-c91fd0555b99
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Safeguarding Statutory Tier' =
			
