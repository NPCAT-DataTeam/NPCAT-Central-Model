	column 'Is Most Recent Safeguarding Visit' =
			
			var thisSchool = 'Safeguarding Visits'[SUID]
			var mostRecentDate = CALCULATE(MAX('Safeguarding Visits'[Snapshot Date]),ALL('Safeguarding Visits'),'Safeguarding Visits'[SUID] = thisSchool)
			return
			IF('Safeguarding Visits'[Snapshot Date] = mostRecentDate,"Yes","No")
		lineageTag: a3277bae-fb2c-440e-b96e-19c975d9cc41
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Safeguarding Tier' =
			
			SWITCH(TRUE(),
			[Safeguarding Trust Compliance %] = 1,"Tier 1",
			[Safeguarding Trust Compliance %] > 0.95,"Tier 2",
			[Safeguarding Trust Compliance %] >= 0.9,"Tier 3",
			[Safeguarding Trust Compliance %] < 0.9,"Tier 4")
		lineageTag: 158cf743-131b-47dc-a717-b7683519c12f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Safeguarding Tier Sort' =
			
			SWITCH(TRUE(),
			[Safeguarding Trust Compliance %] = 1,1,
			[Safeguarding Trust Compliance %] > 0.66,2,
			[Safeguarding Trust Compliance %] > 0.33,3,
			[Safeguarding Trust Compliance %] >= 0,4)
		formatString: 0
		lineageTag: 2fc5fd96-41df-45c0-a1c5-8a19aba05af9
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

