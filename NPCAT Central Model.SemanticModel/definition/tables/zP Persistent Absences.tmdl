	partition 'zP Persistent Absences-5fd07c47-e1da-4295-9b3c-eb943868e659' = calculated
		mode: import
		source =
				
				VAR CurrentYear =CALCULATE(Max('Calendar'[School Year]),'Calendar'[Current School Year Offset] = 0)
				VAR LastYear =CALCULATE(Max('Calendar'[School Year]),'Calendar'[Current School Year Offset] = -1)
				VAR TwoYearAgo =CALCULATE(Max('Calendar'[School Year]),'Calendar'[Current School Year Offset] = -2)
				RETURN
				{
				    (TwoYearAgo, NAMEOF([PA Year End (-2 Years)]), 0),
				    (LastYear, NAMEOF([PA Year End (-1 Years)]), 1),
				    (CurrentYear, NAMEOF([Persistent Absence % YTD]), 2),
				    ("SPLY", NAMEOF([PA % YTD SPLY]), 3)
				}

	annotation PBI_Id = 8115442a65344598aacce5874e199205

