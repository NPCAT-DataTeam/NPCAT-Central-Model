		calculationItem 'School Value' =
				
				VAR _NatOrLA = CALCULATE(SELECTEDMEASURE(),'Primary Nationals Calc'[Name] = "National or LA Value")
				
				VAR _School = CALCULATE(SELECTEDMEASURE(),'Primary Nationals Calc'[Name] = "School Value into KPI")
				VAR _ConditionalDifference = IF(OR((_School ="N/A"),(_NatOrLA="N/A")),404,_School-_NatOrLA)
				RETURN
				IF (
				            CONTAINSSTRING ( SELECTEDMEASURENAME (), "Primary Conditional Formatting" ),
				            _ConditionalDifference,
				IF(ISBLANK(SELECTEDMEASURE()),"N/A",SELECTEDMEASURE()))

		calculationItem 'Vs National' = ```
				
				VAR _DemoVsNat = 
				    IF ( SELECTEDVALUE('zP Demographic vs Nat value'[Demo vs Nat]) = "Vs All Students" ,
				    "All Students",
				    SELECTEDVALUE ( 'Dynamic student Calc group'[Demographic Name] )
				    )
				VAR __SchoolValue = 
				CALCULATE ( SELECTEDMEASURE (), 'Primary Nationals Calc'[Name] = "School")
				
				VAR __NationalValue = 
				CALCULATE ( SELECTEDMEASURE (), 'Primary Nationals Calc'[Name] = "National", 'Dynamic student Calc group'[Demographic Name] = _DemoVsNat )
				
				VAR __ConditionalSchoolValue =
				CALCULATE(
				    IF(CONTAINSSTRING(SELECTEDMEASURENAME(),"%"),
				        FORMAT(SELECTEDMEASURE (),"0.0%"),
				        FORMAT(SELECTEDMEASURE (),"0.0")
				    ),
				    'Primary Nationals Calc'[Name] = "School" )
				VAR __ConditionalNationalValue =
				CALCULATE(
				    IF(CONTAINSSTRING(SELECTEDMEASURENAME(),"%"),
				        FORMAT(SELECTEDMEASURE (),"0.0%"),
				        FORMAT(SELECTEDMEASURE (),"0.0")
				    ),
				    'Primary Nationals Calc'[Name] = "National",
				    'Dynamic student Calc group'[Demographic Name] = _DemoVsNat
				)
				RETURN
				IF(
				    CONTAINSSTRING(SELECTEDMEASURENAME(),"Primary Conditional Formatting"),
				    "School: "&__ConditionalSchoolValue & UNICHAR ( 10 ) & "National: "& __ConditionalNationalValue,
				    IF (
				        OR ( ISBLANK ( __SchoolValue ), ISBLANK ( __NationalValue ) ),
				        BLANK (),
				        __SchoolValue - __NationalValue
				    )
				)
				```

		calculationItem 'Vs LA' = ```
				
				VAR _DemoVsNat = 
				    IF ( SELECTEDVALUE('zP Demographic vs Nat value'[Demo vs Nat]) = "Vs All Students" ,
				    "All Students",
				    SELECTEDVALUE ( 'Dynamic student Calc group'[Demographic Name] )
				    )
				VAR __SchoolValue = 
				CALCULATE ( SELECTEDMEASURE (), 'Primary Nationals Calc'[Name] = "School")
				
				VAR __LAValue =
				    CALCULATE ( SELECTEDMEASURE (), 'Primary Nationals Calc'[Name] = "LA", 'Dynamic student Calc group'[Demographic Name] = _DemoVsNat  )
				VAR __ConditionalSchoolValue =
				CALCULATE(
				    IF(CONTAINSSTRING(SELECTEDMEASURENAME(),"%"),
				        FORMAT(SELECTEDMEASURE (),"0.0%"),
				        FORMAT(SELECTEDMEASURE (),"0.0")
				    ),
				    'Primary Nationals Calc'[Name] = "School" )
				VAR __ConditionalLAValue =
				CALCULATE(
				    IF(CONTAINSSTRING(SELECTEDMEASURENAME(),"%"),
				        FORMAT(SELECTEDMEASURE (),"0.0%"),
				        FORMAT(SELECTEDMEASURE (),"0.0")
				    ),
				    'Primary Nationals Calc'[Name] = "LA",
				    'Dynamic student Calc group'[Demographic Name] = _DemoVsNat
				)
				RETURN
				IF(
				    CONTAINSSTRING(SELECTEDMEASURENAME(),"Primary Conditional Formatting"),
				    "School: "&__ConditionalSchoolValue & UNICHAR ( 10 ) & "LA: "& __ConditionalLAValue,
				    IF (
				        OR ( ISBLANK ( __SchoolValue ), ISBLANK ( __LAValue ) ),
				        BLANK (),
				        __SchoolValue - __LAValue
				    )
				)
				  
				```

		calculationItem 'Vs Trust' = ```
				
				VAR _DemoVsNat = 
				    IF ( SELECTEDVALUE('zP Demographic vs Nat value'[Demo vs Nat]) = "Vs All Students" ,
				    "All Students",
				    SELECTEDVALUE ( 'Dynamic student Calc group'[Demographic Name] )
				    )
				VAR __SchoolValue = 
				CALCULATE ( SELECTEDMEASURE (), 'Primary Nationals Calc'[Name] = "School")
				
				VAR __TrustValue =
				    CALCULATE ( SELECTEDMEASURE (), 'Primary Nationals Calc'[Name] = "Trust", 'Dynamic student Calc group'[Demographic Name] = _DemoVsNat  )
				VAR __ConditionalSchoolValue =
				CALCULATE(
				    IF(CONTAINSSTRING(SELECTEDMEASURENAME(),"%"),
				        FORMAT(SELECTEDMEASURE (),"0.0%"),
				        FORMAT(SELECTEDMEASURE (),"0.0")
				    ),
				    'Primary Nationals Calc'[Name] = "School" )
				VAR __ConditionalTrustValue =
				CALCULATE(
				    IF(CONTAINSSTRING(SELECTEDMEASURENAME(),"%"),
				        FORMAT(SELECTEDMEASURE (),"0.0%"),
				        FORMAT(SELECTEDMEASURE (),"0.0")
				    ),
				    'Primary Nationals Calc'[Name] = "Trust",
				    'Dynamic student Calc group'[Demographic Name] = _DemoVsNat
				)
				RETURN
				IF(
				    CONTAINSSTRING(SELECTEDMEASURENAME(),"Primary Conditional Formatting"),
				    "School: "&__ConditionalSchoolValue & UNICHAR ( 10 ) & "Trust: "& __ConditionalTrustValue,
				    IF (
				        OR ( ISBLANK ( __SchoolValue ), ISBLANK ( __TrustValue ) ),
				        BLANK (),
				        __SchoolValue - __TrustValue
				    )
				)
				```

