				```

		calculationItem Trust = ```
				
				// Trend code for Trust
				//CALCULATE(SELECTEDMEASURE(),REMOVEFILTERS('School Database'))
				
				VAR _DemoVsNat = 
				    IF ( SELECTEDVALUE('zP Demographic vs Nat value'[Demo vs Nat]) = "Vs All Students" ,
				    "All Students",
				    SELECTEDVALUE ( 'Dynamic student Calc group'[Demographic Name] )
				    )
				
				VAR _SelectedMeasure =
				    IF (
				        CONTAINSSTRING ( SELECTEDMEASURENAME (), "Primary Conditional Formatting" ),
				        SUBSTITUTE ( SELECTEDMEASURENAME (), "Primary Conditional Formatting ", "" ),
				        SELECTEDMEASURENAME ()
				    )
				VAR _ValuePercentage =
				    CALCULATE (
				        AVERAGE ( 'Primary Trust Averages'[Percentage] ),
				        'Primary Trust Averages'[Demographic Name] = _DemoVsNat,
				        'Primary Trust Averages'[Measure Name] = _SelectedMeasure
				    )
				VAR _ValueAverage =
				    CALCULATE (
				        AVERAGE ( 'Primary Trust Averages'[Average] ),
				        'Primary Trust Averages'[Demographic Name] = _DemoVsNat,
				        'Primary Trust Averages'[Measure Name] = _SelectedMeasure
				    )
				VAR _Value =
				    IF (
				        CONTAINSSTRING ( SELECTEDMEASURENAME (), "%" ),
				        _ValuePercentage,
				        _ValueAverage
				    )
				RETURN
				
				    IF ( ISBLANK ( _Value ), BLANK(), _Value )
				```

		calculationItem LA = ```
				
				VAR _SelectedMeasure =
				    IF (
				        CONTAINSSTRING ( SELECTEDMEASURENAME (), "Primary Conditional Formatting" ),
				        SUBSTITUTE ( SELECTEDMEASURENAME (), "Primary Conditional Formatting ", "" ),
				        SELECTEDMEASURENAME ()
				    )
				VAR _DemoVsNat = 
				    IF ( SELECTEDVALUE('zP Demographic vs Nat value'[Demo vs Nat]) = "Vs All Students" ,
				    "All Students",
				    SELECTEDVALUE ( 'Dynamic student Calc group'[Demographic Name] )
				    )
				VAR _LA = IF(ISBLANK(SELECTEDVALUE('School Database'[Local Authority])),"204",SELECTEDVALUE('School Database'[Local Authority]))
				VAR _ValuePercentage =
				    CALCULATE (
				        AVERAGE ( 'Primary Nationals'[Percentage] ),
				        'Primary Nationals'[Demographic]
				            = _DemoVsNat,
				        'Primary Nationals'[LA Name] = _LA,
				        'Primary National Measures'[Central Model Measure Name] = _SelectedMeasure
				    )
				VAR _ValueAverage =
				    CALCULATE (
				        AVERAGE ( 'Primary Nationals'[Average] ),
				        'Primary Nationals'[Demographic]
				            = _DemoVsNat,
				        'Primary Nationals'[LA Name] = _LA,
				        'Primary National Measures'[Central Model Measure Name] = _SelectedMeasure
				    )
				VAR _Value =
				    IF (
				        CONTAINSSTRING ( SELECTEDMEASURENAME (), "%" ),
				        _ValuePercentage,
				        _ValueAverage
				    )
				RETURN
				
				    IF ( ISBLANK ( _Value ), BLANK(), _Value )
				```

		calculationItem National = ```
				
				VAR _SelectedMeasure =
