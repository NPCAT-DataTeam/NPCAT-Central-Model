	column 'Type of Post Check'
		dataType: int64
		formatString: 0
		lineageTag: 6e965dd6-27ae-435a-97ec-b7e4d76f5d1b
		summarizeBy: sum
		sourceColumn: Type of Post Check

		annotation SummarizationSetBy = Automatic

	column 'Movement Type' = ```
			
			VAR NI         = 'Employee Job Roles'[NI Number]
			VAR ThisStart  = 'Employee Job Roles'[Post Start Date]
			VAR ThisEnd    = 'Employee Job Roles'[Post End Date]
			VAR ThisPost   = 'Employee Job Roles'[Employee Post Key]
			VAR ThisSchool = 'Employee Job Roles'[Every School ID]
			
			// — find the next assignment for the same person —
			VAR NextStart =
			    CALCULATE(
			        MIN ( 'Employee Job Roles'[Post Start Date] ),
			        FILTER(
			            ALLEXCEPT( 'Employee Job Roles', 'Employee Job Roles'[NI Number] ),
			            'Employee Job Roles'[Post Start Date] > ThisStart
			        )
			    )
			VAR NextSchool =
			    CALCULATE(
			        SELECTEDVALUE( 'Employee Job Roles'[Every School ID] ),
			        FILTER(
			            ALLEXCEPT( 'Employee Job Roles', 'Employee Job Roles'[NI Number] ),
			            'Employee Job Roles'[Post Start Date] = NextStart
			        )
			    )
			
			// — how many days between this end and the next start (blank if no next) —
			VAR GapDays =
			    IF(
			        ISBLANK( ThisEnd ) || ISBLANK( NextStart ),
			        BLANK(),
			        DATEDIFF( ThisEnd, NextStart, DAY )
			    )
			
			// — 1) Internal Move: SAME person, DIFFERENT school, NEGATIVE→+7-day gap —
			VAR IsInternal =
			       NOT( ISBLANK( NextStart ))
			    && GapDays <= 7
			    && NextSchool <> ThisSchool
			
			// — 2) Does the person still hold ANY other role *past* ThisEnd? —
			VAR HasOtherRole =
			    CALCULATE(
			        COUNTROWS( 'Employee Job Roles' ),
			        FILTER(
			            ALL( 'Employee Job Roles' ),
			            'Employee Job Roles'[NI Number] = NI
			            && 'Employee Job Roles'[Employee Post Key] <> ThisPost
			            && 'Employee Job Roles'[Post Start Date] <= ThisEnd
			            && (
			                 ISBLANK( 'Employee Job Roles'[Post End Date] )
			              ||  'Employee Job Roles'[Post End Date] > ThisEnd
			            )
			        )
			    ) > 0
			
			// — 3) Candidate exit: they have an end-date, no next start or gap > 7d, AND no other active role —
			VAR IsCandidateExit =
			       NOT( ISBLANK( ThisEnd ))
			    && ( ISBLANK( NextStart ) || GapDays > 7 )
			    && NOT( HasOtherRole )
			
			// — 4) Tie-break among all candidate exits on THIS End-Date —
			//    (a) highest FTE Salary
			VAR MaxFTE =
			    CALCULATE(
			        MAX( 'Employee Job Roles'[FTE Salary] ),
			        FILTER(
			            ALL( 'Employee Job Roles' ),
			            'Employee Job Roles'[NI Number] = NI
			            && 'Employee Job Roles'[Post End Date] = ThisEnd
			            && (
			                   NOT( ISBLANK( 'Employee Job Roles'[Post End Date] ))
			                && ( 
			                     ISBLANK(
			                       CALCULATE(
			                         MIN( 'Employee Job Roles'[Post Start Date] ),
			                         FILTER(
			                             ALL( 'Employee Job Roles' ),
			                             'Employee Job Roles'[NI Number] = NI
			                             && 'Employee Job Roles'[Post Start Date] > ThisStart
			                         )
			                       )
			                     )
			                  || DATEDIFF(
			                       ThisEnd,
			                       CALCULATE(
			                         MIN( 'Employee Job Roles'[Post Start Date] ),
			                         FILTER(
			                             ALLEXCEPT( 'Employee Job Roles', 'Employee Job Roles'[NI Number] ),
			                             'Employee Job Roles'[Post Start Date] > ThisStart
			                         )
			                       ),
			                       DAY
			                     ) > 7
			                )
			                && NOT(
			                    CALCULATE(
			                        COUNTROWS( 'Employee Job Roles' ),
			                        FILTER(
			                            ALL( 'Employee Job Roles' ),
			                            'Employee Job Roles'[NI Number] = NI
			                            && 'Employee Job Roles'[Employee Post Key] <> 'Employee Job Roles'[Employee Post Key]
			                            && 'Employee Job Roles'[Post Start Date] <= ThisEnd
			                            && (
			                                ISBLANK( 'Employee Job Roles'[Post End Date] )
			                             || 'Employee Job Roles'[Post End Date] > ThisEnd
			                            )
			                        )
			                    ) > 0
			                )
			        )
			    )
			)
			//    (b) among those, highest Years in Post
			VAR MaxYears =
			    CALCULATE(
			        MAX( 'Employee Job Roles'[Years in Post] ),
			        FILTER(
			            ALL( 'Employee Job Roles' ),
			            'Employee Job Roles'[NI Number] = NI
			            && 'Employee Job Roles'[Post End Date] = ThisEnd
			            && 'Employee Job Roles'[FTE Salary] = MaxFTE
			            && NOT(
			                CALCULATE(
			                    COUNTROWS( 'Employee Job Roles' ),
			                    FILTER(
			                        ALL( 'Employee Job Roles' ),
			                        'Employee Job Roles'[NI Number] = NI
			                        && 'Employee Job Roles'[Employee Post Key] <> 'Employee Job Roles'[Employee Post Key]
			                        && 'Employee Job Roles'[Post Start Date] <= ThisEnd
			                        && (
			                            ISBLANK( 'Employee Job Roles'[Post End Date] )
			                         || 'Employee Job Roles'[Post End Date] > ThisEnd
			                        )
			                    )
			                ) > 0
			            )
			        )
			    )
			//    (c) among *those*, lowest Employee ID
			VAR MinEmpID =
			    CALCULATE(
			        MIN( 'Employee Job Roles'[Employee ID] ),
			        FILTER(
			            ALL( 'Employee Job Roles' ),
			            'Employee Job Roles'[NI Number] = NI
			            && 'Employee Job Roles'[Post End Date] = ThisEnd
			            && 'Employee Job Roles'[FTE Salary] = MaxFTE
			            && 'Employee Job Roles'[Years in Post] = MaxYears
			            && NOT(
			                CALCULATE(
			                    COUNTROWS( 'Employee Job Roles' ),
			                    FILTER(
			                        ALL( 'Employee Job Roles' ),
			                        'Employee Job Roles'[NI Number] = NI
			                        && 'Employee Job Roles'[Employee Post Key] <> 'Employee Job Roles'[Employee Post Key]
			                        && 'Employee Job Roles'[Post Start Date] <= ThisEnd
			                        && (
			                            ISBLANK( 'Employee Job Roles'[Post End Date] )
			                         || 'Employee Job Roles'[Post End Date] > ThisEnd
			                        )
			                    )
			                ) > 0
			            )
			        )
			    )
			
			// — 5) Only that one becomes TRUE “Leaver” —
			VAR IsTieBreakLeaver =
			       IsCandidateExit
			    && 'Employee Job Roles'[FTE Salary]    = MaxFTE
			    && 'Employee Job Roles'[Years in Post] = MaxYears
			    && 'Employee Job Roles'[Employee ID]   = MinEmpID
			
			RETURN
			SWITCH(
			    TRUE(),
			      ISBLANK( NI ),            BLANK()
			    , IsInternal,               "Internal Move"
			    , IsTieBreakLeaver,         "Leaver"
			    , HasOtherRole,             "Role Ceased"
			    , IsCandidateExit,          "Role Ceased"
			    , BLANK()
			)
			
			```
		lineageTag: c4c6bc2a-84cb-4351-a60e-075d5134bd0a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

