	column 'Year 6' = ```
			
			
			VAR _School = [Feeder SUID]
			
			RETURN
			 CALCULATE(
			    [Students on roll], 
			    'Student Year Groups'[Year Group] = "Year 6",
			    'School Database'[SU ID] = _School,
			    'Calendar'[FutureDate] = "Past"
			 )
			```
		formatString: 0
