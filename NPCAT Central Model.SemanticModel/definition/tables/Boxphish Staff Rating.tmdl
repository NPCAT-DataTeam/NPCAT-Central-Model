	column 'Simulations failed YTD' = Calculate([Simulations Failed (Email)], 'Calendar'[Current School Year Offset] = 0)+0
		formatString: 0
		lineageTag: 6a888fee-e189-4dbd-b141-87eedf3e74e4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Simulations failed Last 2 Years' = CALCULATE([Simulations Failed (Email)],'Calendar'[Current School Year Offset] IN {0,-1,-2})+0
		formatString: 0
		lineageTag: 11673255-4db3-4364-b1ad-9d0a18513a25
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Simulations Failed SPLY' = ```
			
			VAR StartPrevSY =
			    CALCULATE(
			        MIN ( 'Calendar'[Date] ),
			        'Calendar'[Current School Year Offset] = -1
			    )
			VAR CurrentEndDate =
			    CALCULATE(
			        MAX ( 'Calendar'[Date] ),
			        'Calendar'[FutureDate] = "Past"          -- remove if FutureDate is TRUE/FALSE
			    )
			VAR EndSPLY =
			    EDATE ( CurrentEndDate, -12 )               -- same day last year (scalar)
			VAR Final = 
			    CALCULATE(
			    [Simulations Failed (Email)],
			    'Boxphish Phishing Simulations'[Date Email Clicked] >= StartPrevSY,
			    'Boxphish Phishing Simulations'[Date Email Clicked] <= EndSPLY
			    )
			RETURN
			Final + 0
			```
		formatString: 0
		lineageTag: 52bd9691-f1d9-42a6-9ba7-a2969a0b5272
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Simulations Failed YTD - SPLY' = 'Boxphish Staff Rating'[Simulations failed YTD] - 'Boxphish Staff Rating'[Simulations Failed SPLY]
		formatString: 0
		lineageTag: 269decf1-5ca8-47bd-bf5a-43600c74589a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Courses Failed/Incomplete over 2 Years' = CALCULATE([Number of Courses Failed]+[Number of Courses Incomplete]) + 0
		formatString: 0
		lineageTag: 298f2103-67a5-48d9-856f-6f8ba5602936
		summarizeBy: none

