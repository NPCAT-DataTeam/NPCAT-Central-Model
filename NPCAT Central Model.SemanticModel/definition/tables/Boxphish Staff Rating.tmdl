		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Simulations Bracket' = ```
			
			VAR n = COALESCE ( 'Boxphish Staff Rating'[Simulations failed Last 2 Years], 0 )
			RETURN
			SWITCH (
			    TRUE (),
			    n = 0, "0",
			    n = 1, "1",
			    n = 2, "2",
			    n = 3, "3",
			    n = 4, "4",
			    n >= 5 && n <= 7, "5-7",
			    n >= 8 && n <= 10, "8-10",
			    n >= 11 && n <= 13, "11-13",
			    n >= 14, "14+"
			)
			
			```
		lineageTag: 8dc5b71e-16a3-46c0-b95d-c42386eecdcd
		summarizeBy: none
		sortByColumn: 'Simulations Sort'

