	column 'Mobile KS1' =
			
			IF (
			    OR (
			        [Year Group at DOA] = "Year 2",
			        AND ( [Year Group at DOA] = "Year 1", MONTH ( [DOA] ) <> 9 )
			    ),
			    "KS1 Mobile",
			    "Not KS1 Mobile"
			)
		lineageTag: 15fcd34e-7709-4f26-92e3-b4da5058d668
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Mobile Lower KS2' =
			
			IF (
			    OR (
			        [Year Group at DOA] = "Year 4",
			        AND ( [Year Group at DOA] = "Year 3", MONTH ( [DOA] ) <> 9 )
			    ),
			    "Lower KS2 Mobile",
			    "Not Lower KS2 Mobile"
			)
		lineageTag: 038499e6-9a9b-4906-8f2b-d77ab70bd04a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Mobile Upper KS2' =
			
			IF (
			    OR (
			        [Year Group at DOA] = "Year 6",
			        AND ( [Year Group at DOA] = "Year 5", MONTH ( [DOA] ) <> 9 )
			    ),
			    "Upper KS2 Mobile",
			    "Not Upper KS2 Mobile"
			)
		lineageTag: 8ba73d08-3c31-4205-8f7e-6451586df807
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Mobile Student' =
			
			IF (
			    OR (
			        [Year Group at DOA] IN {"Early Year 1","Early Year 2", "Nursery 1","Nursery 2","Year 12", "Year 13"},
			        AND ( [Year Group at DOA] IN { "Reception", "Year 7"}, MONTH ( [DOA] ) = 9 )
			    ),
			    "Non Mobile",
			    "Mobile"
			)
		lineageTag: d2947c29-465a-4e1c-9d4b-be00d380caee
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Mobile KS3' =
			
			IF (
			    OR (
			        [Year Group at DOA] IN {"Year 8", "Year 9"},
			        AND ( [Year Group at DOA] = "Year 7", MONTH ( [DOA] ) <> 9 )
			    ),
			    "KS3 Mobile",
			    "Not KS3 Mobile"
			)
		lineageTag: e61c4881-b2cb-40d6-b9bd-64c4f4662d67
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Mobile KS4' =
			
			IF (
			    OR (
			        [Year Group at DOA] = "Year 11",
			        AND ( [Year Group at DOA] = "Year 10", MONTH ( [DOA] ) <> 9 )
			    ),
			    "KS4 Mobile",
			    "Not KS4 Mobile"
			)
		lineageTag: 17e0b612-daf2-4469-a9cd-dc43624d14c3
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

