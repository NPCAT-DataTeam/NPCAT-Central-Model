	column 'Email Validation' =
			
			VAR _StudentInitials = IF(CONTAINSSTRING([Email Address],"-"),LEFT([Forename],1) & "." & SUBSTITUTE(SUBSTITUTE([Legal Surname],"'","")," ","-"),LEFT([Forename],1) & "." & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE([Legal Surname],"-",""),"'","")," ",""))
			RETURN
			SWITCH(TRUE(),
			CONTAINSSTRING([Email Address],"npcat.org.uk"), IF(CONTAINSSTRING([Email Address],_StudentInitials),"Correct Email","Check this Email"),
			OR(ISBLANK([Email Address]),[Email Address] =""),"No Email Address",
			NOT(CONTAINSSTRING([Email Address],"npcat.org.uk")),"Invalid Email")
		lineageTag: 223a1358-1299-4d92-a2bb-60e85c86577c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

