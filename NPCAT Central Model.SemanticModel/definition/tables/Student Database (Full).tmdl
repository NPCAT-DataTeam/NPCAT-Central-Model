	column 'Term of Birth' = ```
			
			VAR Month = MONTH('Student Database (Full)'[DOB])
			RETURN
			SWITCH(Month, 1, "Spring", 2, "Spring", 3, "Spring", 4, "Spring"  
			               , 5, "Summer", 6, "Summer", 7, "Summer", 8, "Summer"  
			               , 9, "Autumn", 10, "Autumn", 11, "Autumn", 12, "Autumn")  
			```
		lineageTag: 1374da22-b03d-4b4d-aeca-ad916d9d98c6
