	partition 'Student Database (Full)-1e381c5c-d0be-40de-9b98-9e3a7e94d0e3' = m
		mode: import
		queryGroup: 'Student Data'
		source =
				let
				    Source = PowerBI.Dataflows(null),
				    #"eaf8df50-01b2-41b2-9aef-d580ee473a36" = Source{[workspaceId="eaf8df50-01b2-41b2-9aef-d580ee473a36"]}[Data],
				    #"949f5011-2a87-4ae2-8220-19a171813608" = #"eaf8df50-01b2-41b2-9aef-d580ee473a36"{[dataflowId="949f5011-2a87-4ae2-8220-19a171813608"]}[Data],
				    #"Arbor Student Database" = #"949f5011-2a87-4ae2-8220-19a171813608"{[entity="Arbor Student Database"]}[Data],
				    #"Filtered Rows" = Table.SelectRows(#"Arbor Student Database", each ([UPN] <> ""))
