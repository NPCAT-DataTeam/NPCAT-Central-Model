	column 'This Years Attendance Score' = ```
			
			 VAR _Attendance = RELATED('Student Year Groups'[Attendance YTD])
			 Return
			SWITCH(TRUE(),
			_Attendance>=0.95,0,
			_Attendance>=0.90,1,
			_Attendance>=0.85,2,
			_Attendance>=0.80,4,
			_Attendance>=0.75,6,
			_Attendance>=0.70,8,
			_Attendance<0.70,10
			)
			```
		formatString: 0
		lineageTag: 87194938-e76a-4bce-9e34-aeab5fd62389
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Previous Years Attendance Score' = ```
			
			 VAR _Attendance = 
			     LOOKUPVALUE('Student Year Groups'[Attendance YTD],'Student Year Groups'[Unique Student ID - Academic Year],[Unique Student ID - Previous Academic Year])
			 Return
			SWITCH(TRUE(),
			ISBLANK(_Attendance),0,
			_Attendance>=0.95,0,
			_Attendance>=0.90,1,
			_Attendance>=0.85,2,
			_Attendance>=0.80,4,
			_Attendance>=0.75,6,
			_Attendance>=0.70,8,
			_Attendance<0.70,10
			)
			```
		formatString: 0
		lineageTag: 6d86c34e-ca2e-4237-9424-955ead19cdea
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'RONI Score' = ```
			[KS2 PA Score]+ [NCY Score]+ [EAL Score]+ [SEN Score]+ [PP Score]+ [LAC Score]+ [CP Score]+ [This Years Attendance Score]+ [Previous Years Attendance Score]+ [Exclusion Score]+ [Deprivation Score] 
			```
		lineageTag: 09f295cb-5818-4ada-bcfc-470e3ddc6e3c
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Risk of NEET' =
			
			SWITCH( TRUE(),
			[RONI Score]<=5,"Very Low",
			[RONI Score]<=15,"Low",
			[RONI Score]<=25,"Medium",
			[RONI Score]<=35,"High",
			[RONI Score]<=45,"Very High",
			[RONI Score]>45,"Severe"
			)
		lineageTag: bb1dfb50-4251-4c47-82a2-6a3dc4aa33fa
		summarizeBy: none
		sortByColumn: 'Risk of NEET Sort'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Risk of NEET Sort' =
			
			SWITCH( TRUE(),
			[RONI Score]<=5,1,
			[RONI Score]<=15,2,
			[RONI Score]<=25,3,
			[RONI Score]<=35,4,
			[RONI Score]<=45,5,
			[RONI Score]>45,6
			)
		formatString: 0
		lineageTag: d4923e0c-a44d-4d4b-8fc6-ba232d992c7a
		summarizeBy: none

		annotation SummarizationSetBy = User

