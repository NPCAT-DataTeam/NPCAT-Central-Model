		sourceColumn: Mark Type

		annotation SummarizationSetBy = Automatic

	column 'On Roll' =
			
			VAR MarkDate = 'Lesson Attendance'[Mark Date]
			VAR StudentID = 'Lesson Attendance'[Student ID]
			VAR IsOnRoll =
			    CALCULATE(
			        COUNTROWS('Student Database (Full)'),
			        FILTER(
			            'Student Database (Full)',
			            'Student Database (Full)'[Globally Unique Student ID] = StudentID &&
			            MarkDate >= 'Student Database (Full)'[DOA] &&
			            MarkDate <= 'Student Database (Full)'[Leaving Date]
			        )
			    )
			RETURN
			    IF(IsOnRoll > 0, "On Roll", "Unenrolled")
		lineageTag: 18f7bc18-875a-4018-b6a6-2d10edc483c9
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

