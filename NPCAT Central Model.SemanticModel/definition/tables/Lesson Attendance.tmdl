				    #"Lesson Attendance1" = #"266a4959-748d-4b5a-ab5a-d8014ae5811b"{[entity="Lesson Attendance"]}[Data],
				    #"Added Mark Type" = Table.AddColumn(#"Lesson Attendance1", "Mark Type", each if [Attendance] = 1 then "Present" else if [Authorised Absence] = 1 then "Authorised Absence" else if [Unauthorised Absence] = 1 then "Unauthorised Absence" else "Other Code", type text)
				in
				    #"Added Mark Type"

	annotation PBI_ResultType = Table

