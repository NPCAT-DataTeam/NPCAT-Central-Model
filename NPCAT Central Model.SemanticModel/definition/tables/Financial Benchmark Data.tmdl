	partition 'Financial Benchmark Data-00b2a112-3520-41b4-ac93-da31f3f46964' = m
		mode: import
		queryGroup: Finance
		source = ```
				let
				    Source = #"Financial Benchmark Data (Staging)",
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"URN", type text}, {"Academy UPIN", type text}, {"Estab", type text}, {"LA", type text}, {"LAEstab", type text}, {"Total Expenditure", Currency.Type}, {"Total Academy Exp + per pupil share of Trust Exp", Currency.Type}}),
				    #"Removed Duplicates" = Table.Distinct(#"Changed Type", {"URN"}),
				    #"Divided Column" = Table.TransformColumns(#"Removed Duplicates", {{"% of pupils eligible for FSM", each _ / 100, Percentage.Type}, {"% of pupils with EHCP", each _ / 100, Percentage.Type}, {"% of pupils with SEN support", each _ / 100, Percentage.Type}, {"% of pupils with EAL", each _ / 100, Percentage.Type},{"% of pupils who are Boarders", each _ / 100, type number}}),
				    #"Inserted Addition" = Table.AddColumn(#"Divided Column", "% of pupils with Any SEN", each [#"% of pupils with EHCP"] + [#"% of pupils with SEN support"], Percentage.Type),
				    #"Added School Size" = Table.AddColumn(#"Inserted Addition", "School Size", each if [Overall Phase] = "Primary" and [No Pupils] < 100 then "Very Small" else if [Overall Phase] = "Primary" and [No Pupils] < 175 then "Small" else if [Overall Phase] = "Primary" and [No Pupils] < 375 then "Medium" else if [Overall Phase] = "Primary" and [No Pupils] >= 375 then "Large" else if [Overall Phase] = "Secondary" and [Has a 6th form] = "Has a sixth form" and [No Pupils] < 770 then "Small" else if [Overall Phase] = "Secondary" and [Has a 6th form] = "Has a sixth form" and [No Pupils] < 1300 then "Medium" else if [Overall Phase] = "Secondary" and [Has a 6th form] = "Has a sixth form" and [No Pupils] >= 1300 then "Large" else if [Overall Phase] = "Secondary" and [No Pupils] < 485 then "Small" else if [Overall Phase] = "Secondary" and [No Pupils] < 935 then "Medium" else if [Overall Phase] = "Secondary" and [No Pupils] >= 935 then "Large" else null),
				    #"Added FSM Banding" = Table.AddColumn(#"Added School Size", "FSM Banding", each if [Overall Phase] = "Primary" and [#"% of pupils eligible for FSM"] < 0.05 then "Low" else if [Overall Phase] = "Primary" and [#"% of pupils eligible for FSM"] < 0.18 then "Medium" else if [Overall Phase] = "Primary" and [#"% of pupils eligible for FSM"] >= 0.18 then "High" else if [Overall Phase] = "Secondary" and [Has a 6th form] = "Has a sixth form" and [#"% of pupils eligible for FSM"] < 0.06 then "Low" else if [Overall Phase] = "Secondary" and [Has a 6th form] = "Has a sixth form" and [#"% of pupils eligible for FSM"] < 0.165 then "Medium" else if [Overall Phase] = "Secondary" and [Has a 6th form] = "Has a sixth form" and [#"% of pupils eligible for FSM"] >= 0.165 then "High" else if [Overall Phase] = "Secondary" and [#"% of pupils eligible for FSM"] < 0.08 then "Low" else if [Overall Phase] = "Secondary" and [#"% of pupils eligible for FSM"] < 0.215 then "Medium" else if [Overall Phase] = "Secondary" and [#"% of pupils eligible for FSM"] >= 0.215 then "High" else null),
				    #"Added SEN Banding" = Table.AddColumn(
				    #"Added FSM Banding", 
				    "SEN Banding", 
				    each 
				      if [Overall Phase] = "Primary" and [#"% of pupils with Any SEN"] < 0.10 then
				        "Low"
				      else if [Overall Phase] = "Primary" and [#"% of pupils with Any SEN"] < 0.16 then
				        "Medium"
				      else if [Overall Phase] = "Primary" and [#"% of pupils with Any SEN"] >= 0.16 then
				        "High"
				      else if [Overall Phase]
				        = "Secondary" and [Has a 6th form]
				        = "Has a sixth form" and [#"% of pupils with Any SEN"]
				        < 0.10
				      then
				        "Low"
				      else if [Overall Phase]
				        = "Secondary" and [Has a 6th form]
				        = "Has a sixth form" and [#"% of pupils with Any SEN"]
				        < 0.15
				      then
				        "Medium"
				      else if [Overall Phase]
				        = "Secondary" and [Has a 6th form]
				        = "Has a sixth form" and [#"% of pupils with Any SEN"]
				        >= 0.15
				      then
				        "High"
				      else if [Overall Phase] = "Secondary" and [#"% of pupils with Any SEN"] < 0.13 then
				        "Low"
				      else if [Overall Phase] = "Secondary" and [#"% of pupils with Any SEN"] < 0.17 then
				        "Medium"
				      else if [Overall Phase] = "Secondary" and [#"% of pupils with Any SEN"] >= 0.17 then
				        "High"
				      else
				        null
				  ),
				    #"Added School Type" = Table.AddColumn(#"Added SEN Banding", "School Type", each if [Overall Phase] = "Secondary" and [Has a 6th form] = "Has a sixth form" then "Secondary With 6th Form" else if [Overall Phase] = "Secondary" then "Secondary Without 6th Form" else if [Overall Phase] = "Primary" then "Primary" else null),
				    #"Added Benchmark Group" = Table.AddColumn(#"Added School Type", "Benchmark Group", each [School Type]&"-"&[School Size]&"-"&[FSM Banding]&"-"&[SEN Banding]),
				    #"Inserted Benchmark Group (Full)" = Table.AddColumn(#"Added Benchmark Group", "Benchmark Group (Full)", each Text.Combine({[School Size], " ", [School Type], " with ", [FSM Banding], " FSM and ", [SEN Banding], " SEN"}), type text),
				    #"Filtered Nil Returns" = Table.SelectRows(#"Inserted Benchmark Group (Full)", each ([Total Expenditure] <> null)),
				    #"Merged Workforce Census" = Table.NestedJoin(#"Filtered Nil Returns", {"URN"}, #"Workforce Census", {"School URN"}, "Workforce Census", JoinKind.LeftOuter),
				    #"Expanded Workforce Census" = Table.ExpandTableColumn(#"Merged Workforce Census", "Workforce Census", {"FTE Workforce", "FTE All Teachers", "FTE Leadership Teachers", "FTE Teaching Assistants"}, {"FTE Workforce", "FTE All Teachers", "FTE Leadership Teachers", "FTE Teaching Assistants"}),
				    #"Added Spend on teaching staff as a percentage of total expenditure" = Table.AddColumn(#"Expanded Workforce Census", "Spend on teaching staff as a percentage of total expenditure", each ([Teaching staff] / [Total Expenditure]), Percentage.Type),
				    #"Added Spend on supply staff as a percentage of total expenditure" = Table.AddColumn(#"Added Spend on teaching staff as a percentage of total expenditure", "Spend on supply staff as a percentage of total expenditure", each (([Supply Staff] + [Supply teacher insurance] + [Agency supply teaching staff])/ [Total Expenditure]), Percentage.Type),
				    #"Added Spend on education support staff as a percentage of total expenditure" = Table.AddColumn(#"Added Spend on supply staff as a percentage of total expenditure", "Spend on education support staff as a percentage of total expenditure", each ([Education support staff] / [Total Expenditure]), Percentage.Type),
				    #"Added Spend on administrative and clerical staff as a percentage of total expenditure" = Table.AddColumn(#"Added Spend on education support staff as a percentage of total expenditure", "Spend on administrative and clerical staff as a percentage of total expenditure", each ([Administrative and clerical staff] / [Total Expenditure]), Percentage.Type),
				    #"Added Spend on other staff costs as a percentage of total expenditure" = Table.AddColumn(#"Added Spend on administrative and clerical staff as a percentage of total expenditure", "Spend on other staff costs as a percentage of total expenditure", each (([Other Staff Costs] + [Indirect employee expenses] + [Staff development and training] + [#"Staff-related insurance"]) / [Total Expenditure]), Percentage.Type),
				    #"Added Spend on all staff as a percentage of total expenditure" = Table.AddColumn(#"Added Spend on other staff costs as a percentage of total expenditure", "Spend on all staff costs as a percentage of total expenditure", each ([Staff Total]/ [Total Expenditure]), Percentage.Type),
				    #"Added Spend on premises (including staff) costs as a percentage of total expenditure" = Table.AddColumn(#"Added Spend on all staff as a percentage of total expenditure", "Spend on premises (including staff) costs as a percentage of total expenditure", each (([Premises staff] + [#"Maintenance & Improvement"] + [Cleaning and caretaking] + [Building and Grounds maintenance and improvement] + [PFI Charges]) / [Total Expenditure]), Percentage.Type),
				    #"Added Spend on teaching resources as a percentage of total expenditure" = Table.AddColumn(#"Added Spend on premises (including staff) costs as a percentage of total expenditure", "Spend on teaching resources as a percentage of total expenditure", each (([#"Learning resources (not ICT equipment)"] + [ICT learning resources] + [Examination fees]) / [Total Expenditure]), Percentage.Type),
				    #"Added Spend on energy as a percentage of total expenditure" = Table.AddColumn(#"Added Spend on teaching resources as a percentage of total expenditure", "Spend on energy as a percentage of total expenditure", each if [Energy] < 0 then 0 else [Energy] / [Total Expenditure], Percentage.Type),
				    #"Added Other spending as a percentage of total expenditure" = Table.AddColumn(#"Added Spend on energy as a percentage of total expenditure", "Other spending as a percentage of total expenditure", each (([Catering staff] + [Water and sewerage] + [Rent and Rates] + [Other occupation costs] + [Special facilities] + [Educational Consultancy] + [Catering supplies] + [Auditor costs] + [Other insurance premiums] + [#"Administrative supplies - non educational"] + [#"Direct revenue financing (Revenue contributions to capital)"] + [Supplies and Services] + [Interest charges for Loan and Bank]) / [Total Expenditure]), Percentage.Type),
				    #"Added In-year balance as a percentage of total income" = Table.AddColumn(#"Added Other spending as a percentage of total expenditure", "In-year balance as a percentage of total income", each (([Total Income] - [Total Expenditure]) / [Total Income]), Percentage.Type),
				    #"Added Revenue reserve as a percentage of total income" = Table.AddColumn(#"Added In-year balance as a percentage of total income", "Revenue reserve as a percentage of total income", each ([Revenue Reserve] / [Total Income]), Percentage.Type),
