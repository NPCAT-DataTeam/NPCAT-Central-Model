	/// 
	/// VAR __ALLTable =
	/// CALCULATETABLE (
	/// SUMMARIZE (
	/// 'EYFS ELGs/GLD',
	/// 'EYFS ELGs/GLD'[Globally Unique ID],
	/// "ALL Total", ROUNDDOWN ( DIVIDE ( SUM ( 'EYFS ELGs/GLD'[Grade Value] ), 34 ), 0 )
	/// ),
	/// 'EYFS ELGs/GLD'[Assessment Name]
	/// IN {
	/// "Listening, Attention and Understanding",
	/// "Speaking",
	/// "Self-Regulation",
	/// "Managing Self",
	/// "Building Relationships",
	/// "Gross Motor Skills",
	/// "Fine Motor Skills",
	/// "Comprehension",
	/// "Word Reading",
	/// "Writing",
	/// "Number",
	/// "Numerical Patterns",
	/// "Past and Present",
	/// "People, Culture and Communities",
	/// "The Natural World",
	/// "Creating with Materials",
	/// "Being Imaginative and Expressive"
	/// }
	/// )
	/// VAR __SUM =
	/// SUMX ( __ALLTable, [ALL Total] )
	/// RETURN
	/// __SUM
	measure 'ALL Areas #' =
			
			VAR __ALLTable =
			    CALCULATETABLE (
			        SUMMARIZE (
			            'EYFS ELGs/GLD',
			            'EYFS ELGs/GLD'[Globally Unique ID],
			            "ALL Total", ROUNDDOWN ( DIVIDE ( SUM ( 'EYFS ELGs/GLD'[Grade Value] ), 34 ), 0 )
			        ),
			        'EYFS ELGs/GLD'[Assessment Name]
			            IN {
			                "Listening, Attention and Understanding",
			                "Speaking",
			                "Self-Regulation",
			                "Managing Self",
			                "Building Relationships",
			                "Gross Motor Skills",
			                "Fine Motor Skills",
			                "Comprehension",
			                "Word Reading",
			                "Writing",
			                "Number",
			                "Numerical Patterns",
			                "Past and Present",
			                "People, Culture and Communities",
			                "The Natural World",
			                "Creating with Materials",
			                "Being Imaginative and Expressive"
			            }
			    )
			VAR __SUM =
			    SUMX ( __ALLTable, [ALL Total] )
			RETURN
			    __SUM
		displayFolder: Statutory EYFS
		lineageTag: 34d226d5-3259-46e7-83d0-3595b7a7de93

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// 
	/// VAR _ALLCount = [ALL Areas #]
	/// VAR _Denmonator =
	/// CALCULATE (
	/// DISTINCTCOUNT ( 'EYFS ELGs/GLD'[Globally Unique ID] ),
	/// 'EYFS ELGs/GLD'[Grade] <> "A"
	/// )
	/// RETURN
	/// IF (
	/// ISBLANK ( DIVIDE ( _ALLCount, _Denmonator ) ),
	/// IF ( ISBLANK ( _Denmonator ), BLANK (), 0 ),
	/// DIVIDE ( _ALLCount, _Denmonator )
	/// )
	measure 'ALL Exp %' =
			
			VAR _ALLCount = [ALL Areas #]
			VAR _Denmonator =
			    CALCULATE (
			        DISTINCTCOUNT ( 'EYFS ELGs/GLD'[Globally Unique ID] ),
			        'EYFS ELGs/GLD'[Grade] <> "A"
			    )
			RETURN
			    IF (
			        ISBLANK ( DIVIDE ( _ALLCount, _Denmonator ) ),
			        IF ( ISBLANK ( _Denmonator ), BLANK (), 0 ),
			        DIVIDE ( _ALLCount, _Denmonator )
			    )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Statutory EYFS
		lineageTag: d43d87cf-2e02-411a-905a-9d2b98a10bb8

		changedProperty = FormatString

