	/// 
	/// VAR startyear =
	/// CALCULATE (
	/// FIRSTDATE ( 'Calendar'[Date] ),
	/// 'Calendar'[Current School Year Offset] IN { -1 }
	/// )
	/// VAR enddate =
	/// (
	/// CALCULATE (
	/// LASTDATE ( 'Calendar'[Date] ),
	/// 'Calendar'[Current School Year Offset] IN { 0 }
	/// ) - 365
	/// )
	/// RETURN
	/// CALCULATE (
	/// [Attendance Percentage YTD],
	/// DATESBETWEEN ( Calendar[Date], startyear, enddate )
	/// )
	measure 'Attendance YTD SPLY (-1 Years)' =
			
			VAR startyear =
			    CALCULATE (
			        FIRSTDATE ( 'Calendar'[Date] ),
			        'Calendar'[Current School Year Offset] IN { -1 }
			    )
			VAR enddate =
			    (
			        CALCULATE (
			            LASTDATE ( 'Calendar'[Date] ),
			            'Calendar'[Current School Year Offset] IN { 0 }
			        ) - 365
			    )
			RETURN
			    CALCULATE (
			        [Attendance Percentage YTD],
			        DATESBETWEEN ( Calendar[Date], startyear, enddate )
			    )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Attendance Measures
		lineageTag: d66b65ff-2229-4756-9b9d-d1f6c21fdfe0

