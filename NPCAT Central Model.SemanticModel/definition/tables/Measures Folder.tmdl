	/// 
	/// CALCULATE (
	/// SUM ( 'Management Accounts'[Budget (Full Year)] ),
	/// FILTER (
	/// 'Management Accounts',
	/// NOT ( 'Management Accounts'[Expense Department] IN { "Income" } )
	/// )
	/// )
	measure 'Budgeted Expenses' =
			
			CALCULATE (
			    SUM ( 'Management Accounts'[Budget (Full Year)] ),
			    FILTER (
			        'Management Accounts',
			        NOT ( 'Management Accounts'[Expense Department] IN { "Income" } )
			    )
			)
		formatString: "£"#,0;-"£"#,0;"£"#,0
		displayFolder: Finance Measures\3. Budgeted Expenditure
		lineageTag: f6c0c49a-9940-49f6-849e-29683b1a0cae

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

