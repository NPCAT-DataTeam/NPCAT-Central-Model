	/// VAR TwoYearAgo = TODAY() - 730
	/// RETURN
	/// SUMMARIZECOLUMNS (
	/// 'Boxphish Phishing Simulations'[Email Address],
	/// "Fails YTD",
	/// CALCULATE (
	/// COUNTROWS ( 'Boxphish Phishing Simulations' ),
	/// 'Boxphish Phishing Simulations'[Email Simulation Outcome] = "Fail",
	/// 'Boxphish Phishing Simulations'[Date Email Clicked] >= OneYearAgo
	/// ),
	/// "Fails Last 2 Years",
	/// CALCULATE (
	/// COUNTROWS ( 'Boxphish Phishing Simulations' ),
	/// 'Boxphish Phishing Simulations'[Email Simulation Outcome] = "Fail",
	/// 'Boxphish Phishing Simulations'[Date Email Clicked] >= TwoYearAgo
	/// ),
	/// "Fails SPLY",
	/// CALCULATE (
	/// COUNTROWS ( 'Boxphish Phishing Simulations' ),
	/// 'Boxphish Phishing Simulations'[Email Simulation Outcome] = "Fail",
	/// 'Boxphish Phishing Simulations'[Date Email Clicked] >= TwoYearAgo,
	/// 'Boxphish Phishing Simulations'[Date Email Clicked] < OneYearAgo
	/// )
	/// )
	measure SimSummary =
			
			VAR OneYearAgo = TODAY() - 365
			VAR TwoYearAgo = TODAY() - 730
			RETURN
			SUMMARIZECOLUMNS (
			    'Boxphish Phishing Simulations'[Email Address],
			    "Fails YTD",
			        CALCULATE (
			            COUNTROWS ( 'Boxphish Phishing Simulations' ),
			            'Boxphish Phishing Simulations'[Email Simulation Outcome] = "Fail",
			            'Boxphish Phishing Simulations'[Date Email Clicked] >= OneYearAgo
			        ),
			    "Fails Last 2 Years",
			        CALCULATE (
			            COUNTROWS ( 'Boxphish Phishing Simulations' ),
			            'Boxphish Phishing Simulations'[Email Simulation Outcome] = "Fail",
			            'Boxphish Phishing Simulations'[Date Email Clicked] >= TwoYearAgo
			        ),
			    "Fails SPLY",
			        CALCULATE (
			            COUNTROWS ( 'Boxphish Phishing Simulations' ),
			            'Boxphish Phishing Simulations'[Email Simulation Outcome] = "Fail",
			            'Boxphish Phishing Simulations'[Date Email Clicked] >= TwoYearAgo,
			            'Boxphish Phishing Simulations'[Date Email Clicked] < OneYearAgo
			        )
			)
		displayFolder: Boxphish
		lineageTag: eeda98d0-eb58-4f90-aa1d-b15232b9e148

	/// 
	/// VAR MaxDate = MAX(Calendar[Date])
	/// VAR MonthDiff = SWITCH(TRUE(),MONTH(MaxDate) <= 8, 7,MONTH(MaxDate) = 1, 7,MONTH(MaxDate) > 8, 6)
	/// VAR _6Month = DATE(YEAR(MaxDate),MONTH(MaxDate)-MonthDiff,DAY(MaxDate))
	/// VAR SimFails =
	/// SUMMARIZECOLUMNS (
	/// 'Employees'[Work Email],
	/// "Past 6 Months",
	/// CALCULATE (
	/// COUNTROWS ( 'Boxphish Phishing Simulations' ),
	/// 'Boxphish Phishing Simulations'[Email Simulation Outcome] = "Fail",
	/// 'Boxphish Phishing Simulations'[Date Email Clicked] >= _6Month
	/// )
	/// 
	/// )
	/// VAR _2FailedSim =
	/// CALCULATE (
	/// [Staff Employed (Time)],
	/// FILTER(SimFails,[Past 6 Months] > 1)
	/// )
	/// 
	/// RETURN
	/// DIVIDE ( _2FailedSim, [Staff Employed (Time)] )
	measure '% Failed 2+ Simulations 6 Months' = ```
			
			VAR MaxDate = MAX(Calendar[Date])
			VAR MonthDiff = SWITCH(TRUE(),MONTH(MaxDate) <= 8, 7,MONTH(MaxDate) = 1, 7,MONTH(MaxDate) > 8, 6)
			VAR _6Month = DATE(YEAR(MaxDate),MONTH(MaxDate)-MonthDiff,DAY(MaxDate))
			VAR SimFails = 
			SUMMARIZECOLUMNS (
			    'Employees'[Work Email],
			    "Past 6 Months",
			        CALCULATE (
			            COUNTROWS ( 'Boxphish Phishing Simulations' ),
			            'Boxphish Phishing Simulations'[Email Simulation Outcome] = "Fail",
			            'Boxphish Phishing Simulations'[Date Email Clicked] >= _6Month
			        )
			   
			)
			VAR _2FailedSim =
			    CALCULATE (
			        [Staff Employed (Time)],
			        FILTER(SimFails,[Past 6 Months] > 1)
			    )
			
			RETURN
			DIVIDE ( _2FailedSim, [Staff Employed (Time)] )
			```
		formatString: 0.00%;-0.00%;0.00%
