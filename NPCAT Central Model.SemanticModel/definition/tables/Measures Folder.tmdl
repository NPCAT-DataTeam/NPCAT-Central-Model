	/// 
	/// VAR MealsPerSchool =
	/// SUMMARIZE (
	/// 'Catering Meals (Primary)',
	/// 'Catering Meals (Primary)'[School Code],
	/// "Meals Per Day", SUM ( 'Catering Meals (Primary)'[Meals Provided] )
	/// )
	/// VAR AVGMeals =
	/// AVERAGEX ( MealsPerSchool, [Meals Per Day] )
	/// RETURN
	/// AVGMeals
	measure 'Avg Meals' =
			
			VAR MealsPerSchool =
			    SUMMARIZE (
			        'Catering Meals (Primary)',
			        'Catering Meals (Primary)'[School Code],
			        "Meals Per Day", SUM ( 'Catering Meals (Primary)'[Meals Provided] )
			    )
			VAR AVGMeals =
			    AVERAGEX ( MealsPerSchool, [Meals Per Day] )
			RETURN
			    AVGMeals
		formatString: 0
		displayFolder: Catering Audit
		lineageTag: c2190de4-b5d7-41e6-a79e-11f94840f6c3

