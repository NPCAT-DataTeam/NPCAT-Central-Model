	/// BLANK (),
	/// FORMAT ( [Selected Subject National Percentage Grade 1+ Difference], "0.0%" )
	/// )
	/// VAR Operator =
	/// SWITCH (
	/// TRUE,
	/// ISBLANK ( Difference ), "",
	/// Op_Diff >= 0, " +",
	/// Op_Diff < 0, " "
	/// )
	/// VAR Actual =
	/// IF (
	/// ISBLANK ( [Subject Grade 1+] ),
	/// "N/A",
	/// FORMAT ( [Subject Grade 1+], "0.0%" )
	/// )
	/// VAR Final =
	/// Actual & UNICHAR ( 10 ) & "(" & NationalValue & ")" & Operator
	/// & IF ( ISBLANK ( Difference ), "", Difference )
	/// RETURN
	/// IF ( Actual = "N/A", BLANK (), Final )
	measure 'Selected Subject National Percentage Grade 1+ KPI' =
			
			VAR NationalValue =
			    IF (
			        ISBLANK ( [Selected Subject National Percentage Grade 1+] ),
			        "N/A",
			        FORMAT ( [Selected Subject National Percentage Grade 1+], "0.0%" )
			    )
			VAR Op_Diff = [Selected Subject National Percentage Grade 1+ Difference]
			VAR Difference =
			    IF (
			        ISBLANK ( [Selected Subject National Percentage Grade 1+ Difference] ),
			        BLANK (),
			        FORMAT ( [Selected Subject National Percentage Grade 1+ Difference], "0.0%" )
			    )
			VAR Operator =
			    SWITCH (
			        TRUE,
			        ISBLANK ( Difference ), "",
			        Op_Diff >= 0, " +",
			        Op_Diff < 0, " "
			    )
			VAR Actual =
			    IF (
			        ISBLANK ( [Subject Grade 1+] ),
			        "N/A",
			        FORMAT ( [Subject Grade 1+], "0.0%" )
			    )
			VAR Final =
			    Actual & UNICHAR ( 10 ) & "(" & NationalValue & ")" & Operator
			        & IF ( ISBLANK ( Difference ), "", Difference )
			RETURN
			    IF ( Actual = "N/A", BLANK (), Final )
		displayFolder: KS4 National Results
		lineageTag: 4a13b205-38c7-4041-9484-6645abf3aaba

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// 
	/// VAR _LastDate =
	/// MAX ( 'Calendar'[Date] )
	/// VAR _Table =
	/// FILTER (
	/// 'Student Indicies',
	/// NOT ( [Rank] = "Undefined" )
	/// && 'Student Indicies'[RELEASE_YEAR] = 2025 && 'Student Indicies'[Category] = "IDACI"
	/// )
	/// VAR _TableWithRank =
	/// ADDCOLUMNS ( _Table, "RankValue", VALUE ( 'Student Indicies'[Rank] ) )
	/// RETURN
	/// CALCULATE (
	/// AVERAGEX ( _TableWithRank, VALUE ( [Rank] ) ),
	/// 'Student Indicies'[Category] = "IDACI",
	/// 'Student Database (Full)'[DOA] <= _LastDate,
	/// 'Student Database (Full)'[Leaving date] > _LastDate
	/// || ISBLANK ( 'Student Database (Full)'[Leaving date] ),
	/// 'Calendar'[Date] = _LastDate
	/// )
	measure 'IDACI Rank' =
			
			VAR _LastDate =
			    MAX ( 'Calendar'[Date] )
			VAR _Table =
			    FILTER (
			        'Student Indicies',
			        NOT ( [Rank] = "Undefined" )
			            && 'Student Indicies'[RELEASE_YEAR] = 2025 && 'Student Indicies'[Category] = "IDACI"
			    )
			VAR _TableWithRank =
			    ADDCOLUMNS ( _Table, "RankValue", VALUE ( 'Student Indicies'[Rank] ) )
			RETURN
			    CALCULATE (
			        AVERAGEX ( _TableWithRank, VALUE ( [Rank] ) ),
			        'Student Indicies'[Category] = "IDACI",
			        'Student Database (Full)'[DOA] <= _LastDate,
			        'Student Database (Full)'[Leaving date] > _LastDate
			            || ISBLANK ( 'Student Database (Full)'[Leaving date] ),
			        'Calendar'[Date] = _LastDate
			    )
		formatString: #,##0
		displayFolder: Student Measures\IDACI Measures\Previous setting
		lineageTag: 2705acdb-a956-4eca-8bc5-666c173dfa23

