	/// 
	/// VAR _StudentCount =
	/// DISTINCTCOUNT ( 'Phonics'[Global Unique ID] )
	/// VAR _YearCount =
	/// DISTINCTCOUNT ( 'Phonics'[Academic Year] )
	/// RETURN
	/// DIVIDE ( _StudentCount, _YearCount )
	measure 'Phonics No. Pupils' =
			
			VAR _StudentCount =
			    DISTINCTCOUNT ( 'Phonics'[Global Unique ID] )
			VAR _YearCount =
			    DISTINCTCOUNT ( 'Phonics'[Academic Year] )
			RETURN
			    DIVIDE ( _StudentCount, _YearCount )
		formatString: 0
		displayFolder: Statutory Phonics
		lineageTag: 15b72c67-58e5-4ddd-b2ab-61e604a5982b

	/// 
	/// VAR _Numerator =
	/// CALCULATE (
	/// COUNTA ( 'Phonics'[MARK_GRADE] ),
	/// 'Phonics'[MARK_GRADE] IN { "Wa" },
	/// 'Phonics'[Year Group] IN { "Year 1" }
	/// )
	/// VAR _Denmonator =
	/// CALCULATE (
	/// COUNTA ( 'Phonics'[MARK_GRADE] ),
	/// 'Phonics'[Year Group] IN { "Year 1" }
	/// )
	/// RETURN
	/// IF (
	/// ISBLANK ( DIVIDE ( _Numerator, _Denmonator ) ),
	/// IF ( ISBLANK ( _Denmonator ), BLANK (), 0 ),
	/// DIVIDE ( _Numerator, _Denmonator )
	/// )
	measure 'Y1 Phonics WA %' =
			
			VAR _Numerator =
			    CALCULATE (
			        COUNTA ( 'Phonics'[MARK_GRADE] ),
			        'Phonics'[MARK_GRADE] IN { "Wa" },
			        'Phonics'[Year Group] IN { "Year 1" }
			    )
			VAR _Denmonator =
			    CALCULATE (
			        COUNTA ( 'Phonics'[MARK_GRADE] ),
			        'Phonics'[Year Group] IN { "Year 1" }
			    )
			RETURN
			    IF (
			        ISBLANK ( DIVIDE ( _Numerator, _Denmonator ) ),
			        IF ( ISBLANK ( _Denmonator ), BLANK (), 0 ),
			        DIVIDE ( _Numerator, _Denmonator )
			    )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Statutory Phonics
		lineageTag: 4c2bf271-6670-4c4f-8185-f81118306d15

	/// 
	/// VAR _Numerator =
	/// CALCULATE (
	/// COUNTA ( 'Phonics'[MARK_GRADE] ),
	/// 'Phonics'[MARK_GRADE] IN { "Wa" },
	/// 'Phonics'[Year Group] IN { "Year 2" }
	/// )
	/// VAR _Denmonator =
	/// CALCULATE (
	/// COUNTA ( 'Phonics'[MARK_GRADE] ),
	/// 'Phonics'[Year Group] IN { "Year 2" }
	/// )
	/// RETURN
	/// IF (
	/// ISBLANK ( DIVIDE ( _Numerator, _Denmonator ) ),
	/// IF ( ISBLANK ( _Denmonator ), BLANK (), 0 ),
	/// DIVIDE ( _Numerator, _Denmonator )
	/// )
	measure 'Y2 Phonics Resits WA %' =
			
			VAR _Numerator =
			    CALCULATE (
			        COUNTA ( 'Phonics'[MARK_GRADE] ),
			        'Phonics'[MARK_GRADE] IN { "Wa" },
			        'Phonics'[Year Group] IN { "Year 2" }
			    )
			VAR _Denmonator =
			    CALCULATE (
			        COUNTA ( 'Phonics'[MARK_GRADE] ),
			        'Phonics'[Year Group] IN { "Year 2" }
			    )
			RETURN
			    IF (
			        ISBLANK ( DIVIDE ( _Numerator, _Denmonator ) ),
			        IF ( ISBLANK ( _Denmonator ), BLANK (), 0 ),
			        DIVIDE ( _Numerator, _Denmonator )
			    )
