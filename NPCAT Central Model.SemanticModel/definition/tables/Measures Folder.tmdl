	/// 
	/// VAR __RWMCount =
	/// COUNTROWS (
	/// FILTER (
	/// SUMMARIZE (
	/// FILTER (
	/// 'KS2 Tests & TA Results',
	/// 'KS2 Tests & TA Results'[Subject] = "Reading"
	/// && 'KS2 Tests & TA Results'[Assessment Type] = "Test"
	/// && 'KS2 Tests & TA Results'[Mark] >= 110
	/// || 'KS2 Tests & TA Results'[Subject] = "Writing"
	/// && 'KS2 Tests & TA Results'[Assessment Type] = "TA"
	/// && 'KS2 Tests & TA Results'[Grade]
	/// IN { "GDS" }
	/// || 'KS2 Tests & TA Results'[Subject] = "Maths"
	/// && 'KS2 Tests & TA Results'[Assessment Type] = "Test"
	/// && 'KS2 Tests & TA Results'[Mark] >= 110
	/// ),
	/// 'KS2 Tests & TA Results'[Globally Unique Student ID],
	/// "Distinct_Count", DISTINCTCOUNT ( 'KS2 Tests & TA Results'[Subject] )
	/// ),
	/// [Distinct_Count] = 3
	/// )
	/// )
	/// VAR __EligibleKS2Pupils =
	/// COUNTROWS (
	/// FILTER (
	/// SUMMARIZE (
	/// FILTER (
	/// 'KS2 Tests & TA Results',
	/// 'KS2 Tests & TA Results'[Subject] = "Reading"
	/// && 'KS2 Tests & TA Results'[Assessment Type] = "Test"
	/// || 'KS2 Tests & TA Results'[Subject] = "Writing"
	/// && 'KS2 Tests & TA Results'[Assessment Type] = "TA"
	/// || 'KS2 Tests & TA Results'[Subject] = "Maths"
	/// && 'KS2 Tests & TA Results'[Assessment Type] = "Test"
	/// ),
	/// 'KS2 Tests & TA Results'[Globally Unique Student ID],
	/// "Distinct_Count", DISTINCTCOUNT ( 'KS2 Tests & TA Results'[Subject] )
	/// ),
	/// [Distinct_Count] = 3
	/// )
	/// )
	/// RETURN
	/// IF (
	/// ISBLANK ( DIVIDE ( __RWMCount, __EligibleKS2Pupils ) ),
	/// IF ( ISBLANK ( __EligibleKS2Pupils ), BLANK (), 0 ),
	/// DIVIDE ( __RWMCount, __EligibleKS2Pupils )
	/// )
	measure 'KS2 HS/GDS% - CRWM' =
			
			VAR __RWMCount =
			    COUNTROWS (
			        FILTER (
			            SUMMARIZE (
			                FILTER (
			                    'KS2 Tests & TA Results',
			                    'KS2 Tests & TA Results'[Subject] = "Reading"
			                        && 'KS2 Tests & TA Results'[Assessment Type] = "Test"
			                        && 'KS2 Tests & TA Results'[Mark] >= 110
			                        || 'KS2 Tests & TA Results'[Subject] = "Writing"
			                        && 'KS2 Tests & TA Results'[Assessment Type] = "TA"
			                        && 'KS2 Tests & TA Results'[Grade]
			                        IN { "GDS" }
			                            || 'KS2 Tests & TA Results'[Subject] = "Maths"
			                            && 'KS2 Tests & TA Results'[Assessment Type] = "Test"
			                            && 'KS2 Tests & TA Results'[Mark] >= 110
			                ),
			                'KS2 Tests & TA Results'[STUDENT_UNIQUE_ID],
			                "Distinct_Count", DISTINCTCOUNT ( 'KS2 Tests & TA Results'[Subject] )
			            ),
			            [Distinct_Count] = 3
			        )
			    )
			VAR __EligibleKS2Pupils =
			    COUNTROWS (
			        FILTER (
			            SUMMARIZE (
			                FILTER (
			                    'KS2 Tests & TA Results',
			                    'KS2 Tests & TA Results'[Subject] = "Reading"
			                        && 'KS2 Tests & TA Results'[Assessment Type] = "Test"
			                        || 'KS2 Tests & TA Results'[Subject] = "Writing"
			                        && 'KS2 Tests & TA Results'[Assessment Type] = "TA"
			                        || 'KS2 Tests & TA Results'[Subject] = "Maths"
			                        && 'KS2 Tests & TA Results'[Assessment Type] = "Test"
			                ),
			                'KS2 Tests & TA Results'[STUDENT_UNIQUE_ID],
			                "Distinct_Count", DISTINCTCOUNT ( 'KS2 Tests & TA Results'[Subject] )
			            ),
			            [Distinct_Count] = 3
			        )
			    )
			RETURN
			    IF (
			        ISBLANK ( DIVIDE ( __RWMCount, __EligibleKS2Pupils ) ),
			        IF ( ISBLANK ( __EligibleKS2Pupils ), BLANK (), 0 ),
			        DIVIDE ( __RWMCount, __EligibleKS2Pupils )
			    )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Statutory KS2
		lineageTag: 51aacf46-e7ab-4531-9d72-889a39399b54

		changedProperty = FormatString

