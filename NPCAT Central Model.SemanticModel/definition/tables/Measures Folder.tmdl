	/// 
	/// VAR Min_Pass_Mark = CALCULATE(MIN('Phonics'[MARK_NUMERIC]),'Phonics'[MARK_GRADE] = "Wa",REMOVEFILTERS('Phonics'[MARK_NUMERIC]))
	/// VAR Mark = SELECTEDVALUE('Phonics'[MARK_NUMERIC])
	/// RETURN
	/// 
	/// IF(Mark = 40, BLANK(),  Mark - Min_Pass_Mark)
	/// 
	measure 'Individual Mark Conditional Formatting' = ```
			
			VAR Min_Pass_Mark = CALCULATE(MIN('Phonics'[MARK_NUMERIC]),'Phonics'[MARK_GRADE] = "Wa",REMOVEFILTERS('Phonics'[MARK_NUMERIC]))
			VAR Mark = SELECTEDVALUE('Phonics'[MARK_NUMERIC]) 
			RETURN
			
			    IF(Mark = 40, BLANK(),  Mark - Min_Pass_Mark)
			
			```
		formatString: 0
		displayFolder: Statutory Phonics
		lineageTag: 7e6873aa-c52f-47bc-a9b9-1251551e422b

	/// 
	/// VAR Min_Pass_Mark = CALCULATE(MIN('Phonics'[MARK_NUMERIC]),REMOVEFILTERS('Phonics'[Mark Groups],'Phonics'[Mark Group Sort]),'Phonics'[MARK_GRADE] = "Wa")
	/// VAR GroupMark = SELECTEDVALUE('Phonics'[Mark Groups])
	/// VAR Mark = CALCULATE(MAX('Phonics'[MARK_NUMERIC]), REMOVEFILTERS('Phonics'[Mark Groups]),'Phonics'[Mark Groups] = GroupMark)
	/// RETURN
	/// IF(GroupMark = "A" || GroupMark = "D", BLANK(),
	/// IF(Mark = 40, 40,  Mark - Min_Pass_Mark)
	/// )
	/// 
	/// 
	measure 'Grouped Mark Conditional Formatting' = ```
			
			VAR Min_Pass_Mark = CALCULATE(MIN('Phonics'[MARK_NUMERIC]),REMOVEFILTERS('Phonics'[Mark Groups],'Phonics'[Mark Group Sort]),'Phonics'[MARK_GRADE] = "Wa")
			VAR GroupMark = SELECTEDVALUE('Phonics'[Mark Groups])
			VAR Mark = CALCULATE(MAX('Phonics'[MARK_NUMERIC]), REMOVEFILTERS('Phonics'[Mark Groups]),'Phonics'[Mark Groups] = GroupMark)
			RETURN
			IF(GroupMark = "A" || GroupMark = "D", BLANK(),
			    IF(Mark = 40, 40,  Mark - Min_Pass_Mark)
			)
			    
			
			```
		formatString: 0
		displayFolder: Statutory Phonics
		lineageTag: a41cfe48-9fc6-4e11-aa99-2c7e848efa77

