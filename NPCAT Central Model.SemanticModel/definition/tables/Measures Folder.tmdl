	/// 
	/// IF (
	/// ISBLANK (
	/// CALCULATE (
	/// TOTALYTD ( [Safeguarding Visits], 'Calendar'[Date], "31/08" ),
	/// REMOVEFILTERS ( 'Safeguarding Visits'[Is Most Recent Safeguarding Visit] )
	/// )
	/// ),
	/// 0,
	/// CALCULATE (
	/// TOTALYTD ( [Safeguarding Visits], 'Calendar'[Date], "31/08" ),
	/// REMOVEFILTERS ( 'Safeguarding Visits'[Is Most Recent Safeguarding Visit] )
	/// )
	/// )
	measure 'Visits this Year' =
			
			IF (
			    ISBLANK (
			        CALCULATE (
			            TOTALYTD ( [Safeguarding Visits], 'Calendar'[Date], "31/08" ),
			            REMOVEFILTERS ( 'Safeguarding Visits'[Is Most Recent Safeguarding Visit] )
			        )
			    ),
			    0,
			    CALCULATE (
			        TOTALYTD ( [Safeguarding Visits], 'Calendar'[Date], "31/08" ),
			        REMOVEFILTERS ( 'Safeguarding Visits'[Is Most Recent Safeguarding Visit] )
			    )
			)
		formatString: 0
		displayFolder: Safeguarding
		lineageTag: dbb298f0-9467-4625-942f-1330df266fb4

