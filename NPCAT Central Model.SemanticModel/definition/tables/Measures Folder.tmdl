	/// 
	/// COUNTROWS (
	/// FILTER (
	/// SUMMARIZE (
	/// FILTER (
	/// 'Primary Summative Marks (South)',
	/// 'Primary Summative Marks (South)'[Assessment Name] = "Reading"
	/// && 'Primary Summative Marks (South)'[Grade Points] >= 4
	/// || 'Primary Summative Marks (South)'[Assessment Name] = "Maths"
	/// && 'Primary Summative Marks (South)'[Grade Points] = 3
	/// || 'Primary Summative Marks (South)'[Assessment Name] = "Writing"
	/// && 'Primary Summative Marks (South)'[Grade Points] >= 4
	/// ),
	/// 'Primary Summative Marks (South)'[Globally Unique Student ID],
	/// 'Primary Summative Marks (South)'[Assessment Period],
	/// 'Primary Summative Marks (South)'[Academic Year Start],
	/// "Distinct_Count", DISTINCTCOUNT ( 'Primary Summative Marks (South)'[Assessment Name] )
	/// ),
	/// [Distinct_Count] = 3
	/// )
	/// )
	measure '2. At or Above (Period ARE Target) - Maths Int' =
			
			COUNTROWS (
			    FILTER (
			        SUMMARIZE (
			            FILTER (
			                'Primary Summative Marks (South)',
			                'Primary Summative Marks (South)'[Assessment Name] = "Reading"
			                    && 'Primary Summative Marks (South)'[Grade Points] >= 4
			                    || 'Primary Summative Marks (South)'[Assessment Name] = "Maths"
			                    && 'Primary Summative Marks (South)'[Grade Points] = 3
			                    || 'Primary Summative Marks (South)'[Assessment Name] = "Writing"
			                    && 'Primary Summative Marks (South)'[Grade Points] >= 4
			            ),
			            'Primary Summative Marks (South)'[Globally Unique Student ID],
			            'Primary Summative Marks (South)'[Assessment Period],
			            'Primary Summative Marks (South)'[Academic Year Start],
			            "Distinct_Count", DISTINCTCOUNT ( 'Primary Summative Marks (South)'[Assessment Name] )
			        ),
			        [Distinct_Count] = 3
			    )
			)
		formatString: 0
		displayFolder: Primary Summative(South)
		lineageTag: c24e3b3c-d77e-43b5-9484-a2dcb49b8dfc

