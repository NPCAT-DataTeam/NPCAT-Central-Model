	/// 
	/// VAR _Yearselector =
	/// MAX ( 'Calendar'[Current School Year Offset] ) - 1
	/// VAR _StudentCount =
	/// CALCULATE (
	/// DISTINCTCOUNT ( 'MTC'[Globally Unique ID] ),
	/// REMOVEFILTERS ( 'Calendar' ),
	/// 'MTC'[MARK_GRADE] <> "B",
	/// 'MTC'[MARK_GRADE] <> "A",
	/// 'MTC'[MARK_GRADE] <> "U",
	/// 'MTC'[MARK_GRADE] <> "X",
	/// 'MTC'[MARK_GRADE] <> "J",
	/// 'MTC'[MARK_GRADE] <> "L",
	/// 'MTC'[MARK_GRADE] <> "Q",
	/// 'Calendar'[Current School Year Offset] = _Yearselector
	/// )
	/// RETURN
	/// _StudentCount
	measure 'MTC No. Pupils (Took Check) PY' =
			
			VAR _Yearselector =
			    MAX ( 'Calendar'[Current School Year Offset] ) - 1
			VAR _StudentCount =
			    CALCULATE (
			        DISTINCTCOUNT ( 'MTC'[Globally Unique ID] ),
			        REMOVEFILTERS ( 'Calendar' ),
			        'MTC'[MARK_GRADE] <> "B",
			        'MTC'[MARK_GRADE] <> "A",
			        'MTC'[MARK_GRADE] <> "U",
			        'MTC'[MARK_GRADE] <> "X",
			        'MTC'[MARK_GRADE] <> "J",
			        'MTC'[MARK_GRADE] <> "L",
			        'MTC'[MARK_GRADE] <> "Q",
			        'Calendar'[Current School Year Offset] = _Yearselector
			    )
			RETURN
			    _StudentCount
		displayFolder: Statutory MTC
		lineageTag: 98e10412-2c83-4cb8-a8f5-fc87fc3c18b9

