	/// VAR __SelectedGrade =
	/// SELECTEDVALUE ( 'KS4 Assessments'[Grade Sort] )
	/// VAR __CumulativeGrade =
	/// CALCULATE (
	/// [Number of Grades],
	/// REMOVEFILTERS ( 'KS4 Assessments'[Grade], 'KS4 Assessments'[Grade Sort] ),
	/// 'KS4 Assessments'[Grade Sort] >= __SelectedGrade
	/// ) + 0
	/// VAR __CumulativePercentage =
	/// DIVIDE (
	/// __CumulativeGrade,
	/// CALCULATE (
	/// [Number of Grades],
	/// REMOVEFILTERS ( 'KS4 Assessments'[Grade], 'KS4 Assessments'[Grade Sort] )
	/// )
	/// ) + 0
	/// RETURN
	/// __CumulativePercentage
	measure 'Grade %+' =
			VAR __SelectedGrade =
			    SELECTEDVALUE ( 'KS4 Assessments'[Grade Sort] )
			VAR __CumulativeGrade =
			    CALCULATE (
			        [Number of Grades],
			        REMOVEFILTERS ( 'KS4 Assessments'[Grade], 'KS4 Assessments'[Grade Sort] ),
			        'KS4 Assessments'[Grade Sort] >= __SelectedGrade
			    ) + 0
			VAR __CumulativePercentage =
			    DIVIDE (
			        __CumulativeGrade,
			        CALCULATE (
			            [Number of Grades],
			            REMOVEFILTERS ( 'KS4 Assessments'[Grade], 'KS4 Assessments'[Grade Sort] )
			        )
			    ) + 0
			RETURN
			    __CumulativePercentage
		displayFolder: KS4 Assessment\KS4 Subject
		lineageTag: 5bff7e84-5a5d-43b1-b542-ea7c9fefd671

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// VAR CurrentGrade =
	/// MAX ( 'KS4 Assessments'[Grade Sort] )
	/// VAR CountOfGrades =
	/// CALCULATE (
	/// [Number of Grades],
	/// REMOVEFILTERS ( 'KS4 Assessments'[Grade], 'KS4 Assessments'[Grade Sort] ),
	/// 'KS4 Assessments'[Grade Sort] >= CurrentGrade
	/// )
	/// RETURN
	/// IF ( ISBLANK ( CurrentGrade ), BLANK (), CountOfGrades )
	measure 'Grade +' =
			VAR CurrentGrade =
			    MAX ( 'KS4 Assessments'[Grade Sort] )
			VAR CountOfGrades =
			    CALCULATE (
			        [Number of Grades],
			        REMOVEFILTERS ( 'KS4 Assessments'[Grade], 'KS4 Assessments'[Grade Sort] ),
			        'KS4 Assessments'[Grade Sort] >= CurrentGrade
			    )
			RETURN
			    IF ( ISBLANK ( CurrentGrade ), BLANK (), CountOfGrades )
		formatString: 0
		displayFolder: KS4 Assessment\KS4 Subject
		lineageTag: fe460d6f-78e8-48ae-a513-5cc4a93968e7

