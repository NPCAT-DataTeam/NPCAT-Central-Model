		lineageTag: 798bd669-9ec2-4d9e-9d09-b0676286fc8a

	/// 
	/// VAR _LastDate =
	/// MAX ( 'Calendar'[Date] )
	/// VAR _Offset =
	/// MAX ( 'Calendar'[Current School Year Offset] )
	/// RETURN
	/// CALCULATE (
	/// DISTINCTCOUNT ( 'Enrichment Attendance'[Globally Unique Student ID] ),
	/// 'Student Database (Full)'[DOA] <= _LastDate,
	/// 'Student Database (Full)'[Leaving date] >= _LastDate
	/// || ISBLANK ( 'Student Database (Full)'[Leaving date] ),
	/// 'Calendar'[Current School Year Offset] = _Offset
	/// )
	measure 'Students on Roll (Enrichment)' =
			
			VAR _LastDate =
			    MAX ( 'Calendar'[Date] )
			VAR _Offset =
			    MAX ( 'Calendar'[Current School Year Offset] )
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( 'Enrichment Attendance'[Globally Unique Student ID] ),
			        'Student Database (Full)'[DOA] <= _LastDate,
			        'Student Database (Full)'[Leaving date] >= _LastDate
			            || ISBLANK ( 'Student Database (Full)'[Leaving date] ),
			        'Calendar'[Current School Year Offset] = _Offset
			    )
		formatString: 0
		displayFolder: Clubs & Trips
		lineageTag: 086a824b-b270-4af6-8f9d-59053cf1d591

	/// 
	/// CALCULATE (
	/// DISTINCTCOUNT ( 'Enrichment Attendance'[Globally Unique Student ID] ),
	/// 'Enrichment Attendance'[IS_PRESENT] = 1
	/// )
	measure 'Students Present' =
			
			CALCULATE (
			    DISTINCTCOUNT ( 'Enrichment Attendance'[Globally Unique Student ID] ),
			    'Enrichment Attendance'[IS_PRESENT] = 1
			)
		formatString: 0
		displayFolder: Clubs & Trips
		lineageTag: 76c2c43a-19cf-41de-aedd-cfdbfd42c00d

	/// 
	/// CALCULATE (
	/// DISTINCTCOUNT ( 'Enrichment Attendance'[Globally Unique Student ID] ),
	/// FILTER (
	/// VALUES ( 'Enrichment Attendance'[Globally Unique Student ID] ),
	/// CALCULATE (
	/// DISTINCTCOUNT ( 'Enrichment Attendance'[ENRICHMENT_ID] ),
	/// 'Enrichment Attendance'[IS_PRESENT] = 1
	/// ) > 1
	/// )
	/// )
	measure 'Students Present at Multiple Enrichments' =
			
			CALCULATE (
			    DISTINCTCOUNT ( 'Enrichment Attendance'[Globally Unique Student ID] ),
			    FILTER (
			        VALUES ( 'Enrichment Attendance'[Globally Unique Student ID] ),
			        CALCULATE (
			            DISTINCTCOUNT ( 'Enrichment Attendance'[ENRICHMENT_ID] ),
			            'Enrichment Attendance'[IS_PRESENT] = 1
			        ) > 1
			    )
			)
		formatString: 0
		displayFolder: Clubs & Trips
		lineageTag: 0ce24a43-20b3-4764-98cc-61a12a6b6bfe

	/// 
	/// CALCULATE (
	/// DISTINCTCOUNT ( 'Enrichment Attendance'[Globally Unique Student ID] ),
	/// FILTER (
	/// VALUES ( 'Enrichment Attendance'[Globally Unique Student ID] ),
	/// CALCULATE (
	/// DISTINCTCOUNT ( 'Enrichment Attendance'[ENRICHMENT_ID] ),
	/// 'Enrichment Attendance'[IS_PRESENT] = 1
	/// ) = 1
	/// )
	/// )
	measure 'Students Present at Single Enrichment' =
			
			CALCULATE (
			    DISTINCTCOUNT ( 'Enrichment Attendance'[Globally Unique Student ID] ),
			    FILTER (
			        VALUES ( 'Enrichment Attendance'[Globally Unique Student ID] ),
			        CALCULATE (
			            DISTINCTCOUNT ( 'Enrichment Attendance'[ENRICHMENT_ID] ),
			            'Enrichment Attendance'[IS_PRESENT] = 1
			        ) = 1
			    )
			)
		formatString: 0
		displayFolder: Clubs & Trips
		lineageTag: a9181da9-449a-49c3-bbba-7a430ea649bc

