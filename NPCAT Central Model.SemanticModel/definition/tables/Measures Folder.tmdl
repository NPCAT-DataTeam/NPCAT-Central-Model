	/// 
	/// // This is an overall over a window
	/// VAR _LastDate =
	/// LASTDATE ( 'Calendar'[Date] )
	/// VAR _FirstDate =
	/// FIRSTDATE('Calendar'[Date])
	/// 
	/// VAR _Final =
	/// CALCULATE (
	/// DISTINCTCOUNT ( 'Employee Job Roles'[Employee ID] ),
	/// 'Employee Job Roles'[Post Start Date] <= _LastDate,
	/// 'Employee Job Roles'[Post End Date] > _FirstDate
	/// || ISBLANK ( 'Employee Job Roles'[Post End Date] )
	/// )
	/// RETURN
	/// _Final
	measure 'Staff Employed (Window)' = ```
			
			// This is an overall over a window
			VAR _LastDate =
			    LASTDATE ( 'Calendar'[Date] )
			VAR _FirstDate = 
			    FIRSTDATE('Calendar'[Date])
			
			VAR _Final =
			    CALCULATE (
			        DISTINCTCOUNT ( 'Employee Job Roles'[Employee ID] ),
			        'Employee Job Roles'[Post Start Date] <= _LastDate,
			        'Employee Job Roles'[Post End Date] > _FirstDate
			            || ISBLANK ( 'Employee Job Roles'[Post End Date] )
			    )
			RETURN
			    _Final
			```
		displayFolder: Employees/Retention
		lineageTag: 30a91f93-daa3-4cdd-89fa-b694e19e8330

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// 
	/// // This is an overall over a window of the Main Roles
	/// VAR _LastDate =
	/// LASTDATE ( 'Calendar'[Date] )
	/// VAR _FirstDate =
	/// FIRSTDATE('Calendar'[Date])
	/// 
	/// -- Step 1: Filter Employee Job Roles to keep only one role per employee
	/// VAR _FilteredJobRoles =
	/// ADDCOLUMNS(
	/// SUMMARIZE(
	/// 'Employee Job Roles',
	/// 'Employee Job Roles'[Employee ID]
	/// ),
	/// "SelectedRoleID",
	/// VAR _EmpID = [Employee ID]
	/// VAR _MaxHours =
	/// CALCULATE(
	/// MAX('Employee Job Roles'[Contract Hours]),
	/// 'Employee Job Roles'[Employee ID] = _EmpID
	/// )
	/// VAR _LatestStart =
	/// CALCULATE(
	/// MAX('Employee Job Roles'[Post Start Date]),
	/// 'Employee Job Roles'[Employee ID] = _EmpID,
	/// 'Employee Job Roles'[Contract Hours] = _MaxHours
	/// )
	/// RETURN
	/// CALCULATE(
	/// MAXX(
	/// FILTER(
	/// 'Employee Job Roles',
	/// 'Employee Job Roles'[Employee ID] = _EmpID
	/// && 'Employee Job Roles'[Contract Hours] = _MaxHours
	/// && 'Employee Job Roles'[Post Start Date] = _LatestStart
	/// ),
	/// 'Employee Job Roles'[Employee Post Key]  -- or any unique identifier
	/// )
	/// )
	/// )
	/// 
	/// -- Step 2: Get the subset of Employee Job Roles matching those selected Role IDs
	/// VAR _Prefiltered =
	/// FILTER(
	/// 'Employee Job Roles',
	/// 'Employee Job Roles'[Employee Post Key] IN SELECTCOLUMNS(_FilteredJobRoles, "SelectedRoleID", [SelectedRoleID])
	/// )
	/// 
	/// VAR _Final =
	/// CALCULATE (
	/// DISTINCTCOUNT ( 'Employee Job Roles'[Employee ID] ),
	/// KEEPFILTERS(_Prefiltered),
	/// 'Employee Job Roles'[Post Start Date] <= _LastDate,
	/// 'Employee Job Roles'[Post End Date] > _FirstDate
	/// || ISBLANK ( 'Employee Job Roles'[Post End Date] )
	/// )
	/// RETURN
	/// _Final
	measure 'Head Count (Window)' = ```
			
			// This is an overall over a window of the Main Roles
			VAR _LastDate =
			    LASTDATE ( 'Calendar'[Date] )
			VAR _FirstDate = 
			    FIRSTDATE('Calendar'[Date])
			
			-- Step 1: Filter Employee Job Roles to keep only one role per employee
			VAR _FilteredJobRoles =
			    ADDCOLUMNS(
			        SUMMARIZE(
			            'Employee Job Roles',
			            'Employee Job Roles'[Employee ID]
			        ),
			        "SelectedRoleID",
			        VAR _EmpID = [Employee ID]
			        VAR _MaxHours =
			            CALCULATE(
			                MAX('Employee Job Roles'[Contract Hours]),
			                'Employee Job Roles'[Employee ID] = _EmpID
			            )
			        VAR _LatestStart =
			            CALCULATE(
			                MAX('Employee Job Roles'[Post Start Date]),
			                'Employee Job Roles'[Employee ID] = _EmpID,
			                'Employee Job Roles'[Contract Hours] = _MaxHours
			            )
			        RETURN
			            CALCULATE(
			                MAXX(
			                    FILTER(
			                        'Employee Job Roles',
			                        'Employee Job Roles'[Employee ID] = _EmpID
			                            && 'Employee Job Roles'[Contract Hours] = _MaxHours
			                            && 'Employee Job Roles'[Post Start Date] = _LatestStart
			                    ),
			                    'Employee Job Roles'[Employee Post Key]  -- or any unique identifier
			                )
			            )
			    )
			
			-- Step 2: Get the subset of Employee Job Roles matching those selected Role IDs
			VAR _Prefiltered =
			    FILTER(
			        'Employee Job Roles',
			        'Employee Job Roles'[Employee Post Key] IN SELECTCOLUMNS(_FilteredJobRoles, "SelectedRoleID", [SelectedRoleID])
			    )
			
			VAR _Final =
			    CALCULATE (
			        DISTINCTCOUNT ( 'Employee Job Roles'[Employee ID] ),
			        KEEPFILTERS(_Prefiltered),
			        'Employee Job Roles'[Post Start Date] <= _LastDate,
			        'Employee Job Roles'[Post End Date] > _FirstDate
			            || ISBLANK ( 'Employee Job Roles'[Post End Date] )
			    )
			RETURN
			    _Final
			```
		formatString: 0
		displayFolder: Employees/Retention
		lineageTag: b62d42f6-8b13-443c-acf5-18aa83cc93d0

	/// 
	/// VAR _LastDate =
	/// LASTDATE ( 'Calendar'[Date] )
	/// VAR _FirstDate =
	/// FIRSTDATE ( 'Calendar'[Date] )
	/// 
	/// RETURN
	/// CALCULATE (
	/// SUM ( 'Employee Job Roles'[FTE Ratio] ),
	/// 'Employee Job Roles'[Post Start Date] <= _LastDate,
	/// 'Employee Job Roles'[Post End Date] > _FirstDate
	/// || ISBLANK ( 'Employee Job Roles'[Post End Date] )
	/// )
	measure 'Staff FTE (Window)' =
			
			VAR _LastDate =
			    LASTDATE ( 'Calendar'[Date] )
			VAR _FirstDate =
			    FIRSTDATE ( 'Calendar'[Date] )
			
			RETURN
			    CALCULATE (
			        SUM ( 'Employee Job Roles'[FTE Ratio] ),
			        'Employee Job Roles'[Post Start Date] <= _LastDate,
			        'Employee Job Roles'[Post End Date] > _FirstDate
			            || ISBLANK ( 'Employee Job Roles'[Post End Date] )
			    )
		displayFolder: Employees/Retention
		lineageTag: f7c5261d-609c-484f-8684-eabcd79ba84e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// 
	/// 
	/// VAR TotalSessionsToDate = SUM ( Attendance[Sessions] )
	/// 
	/// VAR P = CALCULATE(SUM ( Attendance[Sessions] ),Attendance[Attendance] = 1)
	/// VAR T = SUM ( Attendance[Sessions] )
	/// VAR Need = 9 * T - 10 * P
	/// VAR CutOff = 380-(MAX('Calendar'[School Month Number])-1)*40
	/// RETURN
	/// 
	/// IF(MAX( Need, 0 )>CutOff,"Confirmed PA",IF(Need >0, FORMAT(Need,0),FORMAT((Need/9)-1,0))
	/// 
	/// )
	measure 'Sessions needed until not PA' =
			
			
			VAR TotalSessionsToDate = SUM ( Attendance[Sessions] )
			
			VAR P = CALCULATE(SUM ( Attendance[Sessions] ),Attendance[Attendance] = 1)
			VAR T = SUM ( Attendance[Sessions] )
			VAR Need = 9 * T - 10 * P
			VAR CutOff = 380-(MAX('Calendar'[School Month Number])-1)*40
			RETURN
			
			IF(MAX( Need, 0 )>CutOff,"Confirmed PA",IF(Need >0, FORMAT(Need,0),FORMAT((Need/9)-1,0))
			
			)
		displayFolder: Attendance Measures
		lineageTag: b557b9fe-a32e-4a1b-8e59-017b971bad70

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// 
	/// 
	/// VAR TotalSessionsToDate = SUM ( Attendance[Sessions] )
	/// 
	/// VAR P = CALCULATE(SUM ( Attendance[Sessions] ),Attendance[Attendance] = 1)
	/// VAR T = SUM ( Attendance[Sessions] )
	/// VAR Need =( 9 * T - 10 * P)/2
	/// VAR CutOff = 190-(MAX('Calendar'[School Month Number])-1)*20
	/// RETURN
	/// IF(MAX( Need, 0 )>CutOff,"Confirmed PA",FORMAT(Need,0.0))
	/// 
	/// 
	measure 'Days needed until not PA' = ```
			
			
			VAR TotalSessionsToDate = SUM ( Attendance[Sessions] )
			
			VAR P = CALCULATE(SUM ( Attendance[Sessions] ),Attendance[Attendance] = 1)
			VAR T = SUM ( Attendance[Sessions] )
			VAR Need =( 9 * T - 10 * P)/2
			VAR CutOff = 190-(MAX('Calendar'[School Month Number])-1)*20
			RETURN
			IF(MAX( Need, 0 )>CutOff,"Confirmed PA",FORMAT(Need,0.0))
			
			
			```
		displayFolder: Attendance Measures
		lineageTag: db3d179a-9f87-44c7-b08d-dd5a14a051c3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// 
	/// VAR TotalSessionsToDate = SUM ( Attendance[Sessions] )
	/// 
	/// VAR P = CALCULATE(SUM ( Attendance[Sessions] ),Attendance[Attendance] = 1)
	/// VAR T = SUM ( Attendance[Sessions] )
	/// VAR Need =( 9 * T - 10 * P)/2
	/// VAR CutOff = 190-(MAX('Calendar'[School Month Number])-1)*20
	/// RETURN
	/// MIN( Need, CutOff )
	measure 'Sessions Needed Until not PA(Raw Number)' =
			
			VAR TotalSessionsToDate = SUM ( Attendance[Sessions] )
			
			VAR P = CALCULATE(SUM ( Attendance[Sessions] ),Attendance[Attendance] = 1)
			VAR T = SUM ( Attendance[Sessions] )
			VAR Need =( 9 * T - 10 * P)/2
			VAR CutOff = 190-(MAX('Calendar'[School Month Number])-1)*20
			RETURN
			MIN( Need, CutOff )
		displayFolder: Attendance Measures
		lineageTag: d05dae5a-af62-4dd8-a64b-3d42a4f511ab

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// 
	/// VAR ThisAttendance =
	/// [Attendance Percentage YTD]   -- current pupil / group context
	/// 
	/// VAR ThisPossible =
	/// CALCULATE (
	/// SUM ( Attendance[Sessions] ),
	/// Attendance[Redaction Check] <> 1,
	/// Attendance[On Roll] <> "Unenrolled",
	/// Attendance[Compulsory Age] = 1
	/// )
	/// 
	/// VAR TotalPossible =
	/// CALCULATE (
	/// SUM ( Attendance[Sessions] ),
	/// Attendance[Redaction Check] <> 1,
	/// Attendance[On Roll] <> "Unenrolled",
	/// Attendance[Compulsory Age] = 1,
	/// -- remove pupil / year-group filters but KEEP school context
	/// ALLEXCEPT('Student Database (Full)','Student Database (Full)'[School ID],'School Database'[School Short Name]),
	/// //REMOVEFILTERS ( 'Student Database (Full)'[Full Name],'Student Database (Full)'[Full Name: DOB] ),
	/// REMOVEFILTERS ( 'Student Year Groups' )      -- ignores Year Group rows
	/// )
	/// 
	/// VAR Weighting =
	/// DIVIDE ( ThisPossible, TotalPossible )
	/// 
	/// VAR WholeSchool =
	/// CALCULATE (
	/// [Attendance Percentage YTD],
	/// REMOVEFILTERS ( 'Student Database (Full)'[Full Name],'Student Database (Full)'[Full Name: DOB] ),
	/// REMOVEFILTERS ( 'Student Year Groups' )
	/// )
	/// 
	/// RETURN
	/// -- in percentage points
	/// ( ThisAttendance - WholeSchool ) * Weighting
	measure 'Attendance Contribution to the Whole School Average (ppt)' = ```
			
			VAR ThisAttendance =
			    [Attendance Percentage YTD]   -- current pupil / group context
			
			VAR ThisPossible =
			    CALCULATE (
			        SUM ( Attendance[Sessions] ),
			        Attendance[Redaction Check] <> 1,
			        Attendance[On Roll] <> "Unenrolled",
			        Attendance[Compulsory Age] = 1
			    )
			
			VAR TotalPossible =
			    CALCULATE (
			        SUM ( Attendance[Sessions] ),
			        Attendance[Redaction Check] <> 1,
			        Attendance[On Roll] <> "Unenrolled",
			        Attendance[Compulsory Age] = 1,
			        -- remove pupil / year-group filters but KEEP school context
			        ALLEXCEPT('Student Database (Full)','Student Database (Full)'[School ID],'School Database'[School Short Name]),
			        //REMOVEFILTERS ( 'Student Database (Full)'[Full Name],'Student Database (Full)'[Full Name: DOB] ),
			        REMOVEFILTERS ( 'Student Year Groups' )      -- ignores Year Group rows
			    )
			
			VAR Weighting =
			    DIVIDE ( ThisPossible, TotalPossible )
			
			VAR WholeSchool =
			    CALCULATE (
			        [Attendance Percentage YTD],
			        REMOVEFILTERS ( 'Student Database (Full)'[Full Name],'Student Database (Full)'[Full Name: DOB] ),
			        REMOVEFILTERS ( 'Student Year Groups' )
			    )
			
			RETURN
			    -- in percentage points
			    ( ThisAttendance - WholeSchool ) * Weighting  
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Attendance Measures
		lineageTag: 7280ccfb-d13e-4302-bac0-60b96393fcc7

	/// 
	/// VAR ThisAttendance =
	/// [Attendance Percentage YTD]   -- current pupil / group context
	/// 
	/// VAR ThisPossible =
	/// CALCULATE (
	/// SUM ( Attendance[Sessions] ),
	/// Attendance[Redaction Check] <> 1,
	/// Attendance[On Roll] <> "Unenrolled",
	/// Attendance[Compulsory Age] = 1
	/// )
	/// 
	/// VAR TotalPossible =
	/// CALCULATE (
	/// SUM ( Attendance[Sessions] ),
	/// Attendance[Redaction Check] <> 1,
	/// Attendance[On Roll] <> "Unenrolled",
	/// Attendance[Compulsory Age] = 1,
	/// -- remove pupil / year-group filters but KEEP school context
	/// REMOVEFILTERS('School Database'[SU ID]),
	/// REMOVEFILTERS ( 'Student Database (Full)'[Full Name],'Student Database (Full)'[Full Name: DOB]),
	/// REMOVEFILTERS ( 'Student Year Groups' )      -- ignores Year Group rows
	/// )
	/// 
	/// VAR Weighting =
	/// DIVIDE ( ThisPossible, TotalPossible )
	/// 
	/// VAR WholeTrust =
	/// CALCULATE (
	/// [Attendance Percentage YTD],
	/// REMOVEFILTERS('School Database'[SU ID]),
	/// REMOVEFILTERS ( 'Student Database (Full)'[Full Name],'Student Database (Full)'[Full Name: DOB] ),
	/// REMOVEFILTERS ( 'Student Year Groups' )
	/// )
	/// 
	/// RETURN
	/// -- in percentage points
	/// ( ThisAttendance - WholeTrust ) * Weighting
	measure 'Attendance Contribution to the Whole Trust Average (ppt)' = ```
			
			VAR ThisAttendance =
			    [Attendance Percentage YTD]   -- current pupil / group context
			
			VAR ThisPossible =
			    CALCULATE (
			        SUM ( Attendance[Sessions] ),
			        Attendance[Redaction Check] <> 1,
			        Attendance[On Roll] <> "Unenrolled",
			        Attendance[Compulsory Age] = 1
			    )
			
			VAR TotalPossible =
			    CALCULATE (
			        SUM ( Attendance[Sessions] ),
			        Attendance[Redaction Check] <> 1,
			        Attendance[On Roll] <> "Unenrolled",
			        Attendance[Compulsory Age] = 1,
			        -- remove pupil / year-group filters but KEEP school context
			        REMOVEFILTERS('School Database'[SU ID]),
			        REMOVEFILTERS ( 'Student Database (Full)'[Full Name],'Student Database (Full)'[Full Name: DOB]),
			        REMOVEFILTERS ( 'Student Year Groups' )      -- ignores Year Group rows
			    )
			
			VAR Weighting =
			    DIVIDE ( ThisPossible, TotalPossible )
			
			VAR WholeTrust =
			    CALCULATE (
			        [Attendance Percentage YTD],
			        REMOVEFILTERS('School Database'[SU ID]),
			        REMOVEFILTERS ( 'Student Database (Full)'[Full Name],'Student Database (Full)'[Full Name: DOB] ),
			        REMOVEFILTERS ( 'Student Year Groups' )
			    )
			
			RETURN
			    -- in percentage points
			    ( ThisAttendance - WholeTrust ) * Weighting  
			```
