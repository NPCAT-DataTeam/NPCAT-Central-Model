	/// 
	/// VAR _LastDate =
	/// MAX ( 'Calendar'[Date] )
	/// VAR _Offset =
	/// MAX ( 'Calendar'[Current School Year Offset] )
	/// VAR _FirstDate =
	/// CALCULATE(MIN ( 'Calendar'[Date] ),'Calendar'[Current School Year Offset] = _Offset)
	/// RETURN
	/// CALCULATE (
	/// DISTINCTCOUNT ( 'Attendance'[Unique Student ID] ),
	/// 'Student Database (Full)'[DOA] <= _LastDate,
	/// 'Student Database (Full)'[Leaving date] >= _FirstDate
	/// || ISBLANK ( 'Student Database (Full)'[Leaving date] ),
	/// 'Calendar'[Current School Year Offset] = _Offset
	/// )
	measure 'Students on Roll(This Year)' =
			
			VAR _LastDate =
			    MAX ( 'Calendar'[Date] )
			VAR _Offset =
			    MAX ( 'Calendar'[Current School Year Offset] )
			VAR _FirstDate =
			    CALCULATE(MIN ( 'Calendar'[Date] ),'Calendar'[Current School Year Offset] = _Offset)
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( 'Attendance'[Unique Student ID] ),
			        'Student Database (Full)'[DOA] <= _LastDate,
			        'Student Database (Full)'[Leaving date] >= _FirstDate
			            || ISBLANK ( 'Student Database (Full)'[Leaving date] ),
			        'Calendar'[Current School Year Offset] = _Offset
