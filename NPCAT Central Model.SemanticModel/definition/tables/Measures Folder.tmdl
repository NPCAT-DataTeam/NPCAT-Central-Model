	/// 
	/// CALCULATE (
	/// [Phonics No. Pupils],
	/// FILTER (
	/// CALCULATETABLE (
	/// SUMMARIZE ( 'Phonics', 'Phonics'[Mark Group Sort], 'Phonics'[Mark Groups] ),
	/// ALLSELECTED ( 'Phonics' )
	/// ),
	/// ISONORAFTER (
	/// 'Phonics'[Mark Group Sort], MIN ( 'Phonics'[Mark Group Sort] ), ASC,
	/// 'Phonics'[Mark Groups], MIN ( 'Phonics'[Mark Groups] ), ASC
	/// )
	/// )
	/// )
	measure 'Phonics No. Pupils Reverse running total in Mark Groups' =
			
			CALCULATE (
			    [Phonics No. Pupils],
			    FILTER (
			        CALCULATETABLE (
			            SUMMARIZE ( 'Phonics', 'Phonics'[Mark Group Sort], 'Phonics'[Mark Groups] ),
			            ALLSELECTED ( 'Phonics' )
			        ),
			        ISONORAFTER (
			            'Phonics'[Mark Group Sort], MIN ( 'Phonics'[Mark Group Sort] ), ASC,
			            'Phonics'[Mark Groups], MIN ( 'Phonics'[Mark Groups] ), ASC
			        )
			    )
			)
		formatString: 0
		displayFolder: Statutory Phonics
		lineageTag: c7a1e641-f261-4820-bc60-44c7d23cc294

	/// 
