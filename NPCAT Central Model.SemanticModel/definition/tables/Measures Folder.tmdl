	/// 
	/// DIVIDE (
	/// CALCULATE([Students on Roll (IDACI) (2025)],'Student Indicies'[Decile] IN {"1","2","3"}),
	/// CALCULATE (
	/// [Students on Roll (IDACI) (2025)],
	/// ALL ( 'Student Indicies'[Decile], 'Student Indicies'[Decile Sort] )
	/// )
	/// )
	measure '% Students (1-3 Decile) (2025)' =
			
			DIVIDE (
			    CALCULATE([Students on Roll (IDACI) (2025)],'Student Indicies'[Decile] IN {"1","2","3"}),
			    CALCULATE (
			        [Students on Roll (IDACI) (2025)],
			        ALL ( 'Student Indicies'[Decile], 'Student Indicies'[Decile Sort] )
			    )
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Student Measures\IDACI Measures\2025 IDACI\CY
		lineageTag: 455b92a5-6dbe-493b-b225-d0fbde9a2c41

