	/// 
	/// VAR _MAXDATE =
	/// MAX ( 'Calendar'[Date] )
	/// RETURN
	/// CALCULATE (
	/// [Total ICT Tickets],
	/// ALL ( 'Calendar'[Date] ),
	/// 'ICT Help Desk'[Create Date] <= _MAXDATE,
	/// 'ICT Help Desk'[Close Date] > _MAXDATE
	/// || ISBLANK ( 'ICT Help Desk'[Close Date] )
	/// )
	measure 'Open Tickets' =
			
			VAR _MAXDATE =
			    MAX ( 'Calendar'[Date] )
			RETURN
			    CALCULATE (
			        [Total ICT Tickets],
			        ALL ( 'Calendar'[Date] ),
			        'ICT Help Desk'[Create Date] <= _MAXDATE,
			        'ICT Help Desk'[Close Date] > _MAXDATE
			            || ISBLANK ( 'ICT Help Desk'[Close Date] )
			    )
