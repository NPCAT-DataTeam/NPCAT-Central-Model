	/// 
	/// CALCULATE(
	/// SUM('Attendance'[Authorised Absence])/2 + SUM('Attendance'[Unauthorised Absence])/2,
	/// Attendance[Redaction Check] <> 1,
	/// Attendance[On Roll] <> "Unenrolled",
	/// Attendance[Compulsory Age] = 1
	/// )
	measure 'Overall Days Missed(Attendance Tbl)' =
			
			CALCULATE(
			    SUM('Attendance'[Authorised Absence])/2 + SUM('Attendance'[Unauthorised Absence])/2,
			    Attendance[Redaction Check] <> 1,
			    Attendance[On Roll] <> "Unenrolled",
			    Attendance[Compulsory Age] = 1
			)
		formatString: #,0
		displayFolder: Student Absences
