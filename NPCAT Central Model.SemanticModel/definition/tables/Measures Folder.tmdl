	/// 
	/// 
	/// VAR __Attendancecore =
	/// CALCULATE (
	/// DIVIDE ((SUM(Attendance[Authorised Absence])+SUM(Attendance[Unauthorised Absence])) , SUM ( Attendance[Sessions] ) ),
	/// Attendance[Redaction Check] <> 1,
	/// Attendance[On Roll] <> "Unenrolled",
	/// Attendance[Compulsory Age] = 1,
	/// Attendance[Birthday Check] = "Yes"
	/// )
	/// 
	/// RETURN
	/// __Attendancecore
	measure 'Birthday Absence Percentage' =
			
			
			VAR __Attendancecore =
			    CALCULATE (
			        DIVIDE ((SUM(Attendance[Authorised Absence])+SUM(Attendance[Unauthorised Absence])) , SUM ( Attendance[Sessions] ) ),
			        Attendance[Redaction Check] <> 1,
			        Attendance[On Roll] <> "Unenrolled",
			        Attendance[Compulsory Age] = 1,
			        Attendance[Birthday Check] = "Yes"
			    )
			
			RETURN
			    __Attendancecore
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Student Absences
		lineageTag: 78d65326-a165-485e-91f7-fd467f595b85

