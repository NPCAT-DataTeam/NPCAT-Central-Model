	/// 
	/// CALCULATE (
	/// [Phonics No. Pupils],
	/// FILTER (
	/// CALCULATETABLE (
	/// SUMMARIZE ( 'Phonics', 'Phonics'[Mark Group Sort], 'Phonics'[Mark Groups] ),
	/// ALLSELECTED ( 'Phonics' )
	/// ),
	/// ISONORAFTER (
	/// 'Phonics'[Mark Group Sort], MAX ( 'Phonics'[Mark Group Sort] ), DESC,
	/// 'Phonics'[Mark Groups], MAX ( 'Phonics'[Mark Groups] ), DESC
	/// )
	/// )
	/// )
	measure 'Phonics No. Pupils running total in Mark Groups' =
			
			CALCULATE (
			    [Phonics No. Pupils],
			    FILTER (
			        CALCULATETABLE (
			            SUMMARIZE ( 'Phonics', 'Phonics'[Mark Group Sort], 'Phonics'[Mark Groups] ),
			            ALLSELECTED ( 'Phonics' )
			        ),
			        ISONORAFTER (
			            'Phonics'[Mark Group Sort], MAX ( 'Phonics'[Mark Group Sort] ), DESC,
			            'Phonics'[Mark Groups], MAX ( 'Phonics'[Mark Groups] ), DESC
