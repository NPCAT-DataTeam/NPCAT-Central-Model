	/// 
	/// VAR _Denominator =
	/// SUM ( 'Printing and Copying'[Pages Per Job] )
	/// VAR _Numerator =
	/// CALCULATE (
	/// SUM ( 'Printing and Copying'[Pages Per Job] ),
	/// 'Printing and Copying'[Duplex] = "Simplex"
	/// )
	/// RETURN
	/// DIVIDE ( _Numerator, _Denominator )
	measure 'Simplex %' =
			
			VAR _Denominator =
			    SUM ( 'Printing and Copying'[Pages Per Job] )
			VAR _Numerator =
			    CALCULATE (
			        SUM ( 'Printing and Copying'[Pages Per Job] ),
			        'Printing and Copying'[Duplex] = "Simplex"
			    )
			RETURN
			    DIVIDE ( _Numerator, _Denominator )
		formatString: 0.0%;-0.0%;0.0%
