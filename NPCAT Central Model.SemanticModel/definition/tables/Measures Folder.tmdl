	/// --Academic Year
	/// IF (
	/// ISFILTERED ( 'KS4 Assessments'[School Year] ),
	/// "Academic Year: "
	/// & REPT ( UNICHAR ( 10 ), COUNTROWS ( VALUES ( 'KS4 Assessments'[School Year] ) ) )
	/// )
	/// & --Year Group
	/// IF (
	/// ISFILTERED ( 'Student Year Groups'[Year Group] ),
	/// "Year Group: "
	/// & REPT (
	/// UNICHAR ( 10 ),
	/// COUNTROWS ( VALUES ( 'Student Year Groups'[Year Group] ) )
	/// )
	/// )
	/// & --Assessment Period
	/// IF (
	/// ISFILTERED ( 'KS4 Assessments'[PERIOD_NAME] ),
	/// "Asessment Period: "
	/// & REPT ( UNICHAR ( 10 ), COUNTROWS ( VALUES ( 'KS4 Assessments'[PERIOD_NAME] ) ) )
	/// )
	/// & --Gender
	/// IF (
	/// ISFILTERED ( 'Student Database (Full)'[Gender] ),
	/// "Gender: "
	/// & REPT (
	/// UNICHAR ( 10 ),
	/// COUNTROWS ( VALUES ( 'Student Database (Full)'[Gender] ) )
	/// )
	/// )
	/// & --Pupil Premium
	/// IF (
	/// ISFILTERED ( 'Student Database (Full)'[Pupil Premium Indicator(Short)] ),
	/// "Pupil Premium: "
	/// & REPT (
	/// UNICHAR ( 10 ),
	/// COUNTROWS (
	/// VALUES ( 'Student Database (Full)'[Pupil Premium Indicator(Short)] )
	/// )
	/// )
	/// )
	/// & --SEN Status
	/// IF (
	/// ISFILTERED ( 'Student Database (Full)'[SEN Status(Short)] ),
	/// "SEN Status: "
	/// & REPT (
	/// UNICHAR ( 10 ),
	/// COUNTROWS ( VALUES ( 'Student Database (Full)'[SEN Status(Short)] ) )
	/// )
	/// )
	/// & --Prior Attainment
	/// IF (
	/// ISFILTERED ( 'KS4 Assessments'[Prior Attainment] ),
	/// "Prior Attainment: "
	/// & REPT (
	/// UNICHAR ( 10 ),
	/// COUNTROWS ( VALUES ( 'KS4 Assessments'[Prior Attainment] ) )
	/// )
	/// )
	measure 'KS4 Show Filters (Headers)' =
			--Academic Year
			IF (
			    ISFILTERED ( 'KS4 Assessments'[School Year] ),
			    "Academic Year: "
			        & REPT ( UNICHAR ( 10 ), COUNTROWS ( VALUES ( 'KS4 Assessments'[School Year] ) ) )
			)
			    & --Year Group
			    IF (
			        ISFILTERED ( 'Student Year Groups'[Year Group] ),
			        "Year Group: "
			            & REPT (
			                UNICHAR ( 10 ),
			                COUNTROWS ( VALUES ( 'Student Year Groups'[Year Group] ) )
			            )
			    )
			    & --Assessment Period
			    IF (
			        ISFILTERED ( 'KS4 Assessments'[PERIOD_NAME] ),
			        "Asessment Period: "
			            & REPT ( UNICHAR ( 10 ), COUNTROWS ( VALUES ( 'KS4 Assessments'[PERIOD_NAME] ) ) )
			    )
			    & --Gender
			    IF (
			        ISFILTERED ( 'Student Database (Full)'[Gender] ),
			        "Gender: "
			            & REPT (
			                UNICHAR ( 10 ),
			                COUNTROWS ( VALUES ( 'Student Database (Full)'[Gender] ) )
			            )
			    )
			    & --Pupil Premium
			    IF (
			        ISFILTERED ( 'Student Database (Full)'[Pupil Premium Indicator(Short)] ),
			        "Pupil Premium: "
			            & REPT (
			                UNICHAR ( 10 ),
			                COUNTROWS (
			                    VALUES ( 'Student Database (Full)'[Pupil Premium Indicator(Short)] )
			                )
			            )
			    )
			    & --SEN Status
			    IF (
			        ISFILTERED ( 'Student Database (Full)'[SEN Status(Short)] ),
			        "SEN Status: "
			            & REPT (
			                UNICHAR ( 10 ),
			                COUNTROWS ( VALUES ( 'Student Database (Full)'[SEN Status(Short)] ) )
			            )
			    )
			    & --Prior Attainment
			    IF (
			        ISFILTERED ( 'KS4 Assessments'[Prior Attainment] ),
			        "Prior Attainment: "
			            & REPT (
			                UNICHAR ( 10 ),
			                COUNTROWS ( VALUES ( 'KS4 Assessments'[Prior Attainment] ) )
			            )
			    )
		displayFolder: KS4 Assessment\KS4 Subject
		lineageTag: 20a9c995-bcff-44b6-9240-58d25f794e48

