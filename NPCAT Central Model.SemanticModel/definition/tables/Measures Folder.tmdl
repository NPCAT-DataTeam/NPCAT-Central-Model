	/// 
	/// VAR _DaysOpen =
	/// SUMMARIZE (
	/// 'Health&Safety Actions Dates',
	/// 'Health&Safety Actions Dates'[Action Ref Number],
	/// "Days Open",
	/// CALCULATE (
	/// COUNTROWS ( 'Health&Safety Actions Dates' ),
	/// 'Health&Safety Actions Dates'[Weekday] IN { 0, 1, 2, 3, 4 }
	/// )
	/// )
	/// VAR _AVGDays =
	/// AVERAGEX ( _DaysOpen, [Days Open] )
	/// RETURN
	/// _AVGDays
	measure 'AVG Days Action Open' =
			
			VAR _DaysOpen =
			    SUMMARIZE (
			        'Health&Safety Actions Dates',
			        'Health&Safety Actions Dates'[Action Ref Number],
			        "Days Open",
			            CALCULATE (
			                COUNTROWS ( 'Health&Safety Actions Dates' ),
			                'Health&Safety Actions Dates'[Weekday] IN { 0, 1, 2, 3, 4 }
			            )
			    )
			VAR _AVGDays =
			    AVERAGEX ( _DaysOpen, [Days Open] )
			RETURN
			    _AVGDays
		displayFolder: H&S Actions
		lineageTag: b9ddd3eb-72c6-4338-bfdf-d13dbe681d35

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// 
	/// VAR _DaysOpen =
	/// SUMMARIZE (
	/// 'Health&Safety Actions Dates',
	/// 'Health&Safety Actions Dates'[Action Ref Number],
	/// "Days Open",
	/// CALCULATE (
	/// COUNTROWS ( 'Health&Safety Actions Dates' ),
	/// 'Health&Safety Actions Dates'[Late Check] = "Overdue",
	/// 'Health&Safety Actions Dates'[Weekday] IN { 0, 1, 2, 3, 4 }
	/// )
	/// )
	/// VAR _AVGDays =
	/// AVERAGEX ( _DaysOpen, [Days Open] )
	/// RETURN
	/// _AVGDays
	measure 'AVG Days Action Overdue' =
			
			VAR _DaysOpen =
			    SUMMARIZE (
			        'Health&Safety Actions Dates',
			        'Health&Safety Actions Dates'[Action Ref Number],
			        "Days Open",
			            CALCULATE (
			                COUNTROWS ( 'Health&Safety Actions Dates' ),
			                'Health&Safety Actions Dates'[Late Check] = "Overdue",
			                'Health&Safety Actions Dates'[Weekday] IN { 0, 1, 2, 3, 4 }
			            )
			    )
			VAR _AVGDays =
			    AVERAGEX ( _DaysOpen, [Days Open] )
