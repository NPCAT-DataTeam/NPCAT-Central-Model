	/// 
	/// VAR _Student =
	/// IF(
	/// ISBLANK(SELECTEDVALUE('KS4 Assessments'[KS4 Student DOB])),
	/// SELECTEDVALUE('KS4 Student Headlines'[Student Full Name: DOB]),
	/// SELECTEDVALUE('KS4 Assessments'[KS4 Student DOB])
	/// )
	/// RETURN
	/// CALCULATE(
	/// AVERAGE ( 'KS4 Student Headlines'[Overall P8] ),
	/// 'KS4 Student Headlines'[Student Full Name: DOB] = _Student)
	measure 'Student P8' = ```
			
			    VAR _Student = 
			        IF(
			            ISBLANK(SELECTEDVALUE('KS4 Assessments'[KS4 Student DOB])),
			            SELECTEDVALUE('KS4 Student Headlines'[Student Full Name: DOB]),
			            SELECTEDVALUE('KS4 Assessments'[KS4 Student DOB])
			        )
			RETURN
			    CALCULATE(
			    AVERAGE ( 'KS4 Student Headlines'[Overall P8] ),
			    'KS4 Student Headlines'[Student Full Name: DOB] = _Student)
			```
