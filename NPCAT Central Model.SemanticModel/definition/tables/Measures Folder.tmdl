	/// 
	/// //SELECTEDVALUE ( 'Student Database (Full)'[Pupil Premium Indicator(Short)] )
	/// 
	/// // VAR _MaxDate = [Dynamic Max Date]
	/// 
	/// // RETURN
	/// // CALCULATE (
	/// //     SELECTEDMEASURE (), 'Demographics Enrollment'[Date List]=_MaxDate,
	/// //     'Demographics Enrollment'[Pupil Premium] = 1
	/// // )
	/// VAR _MaxDate = [Dynamic Max Date]
	/// VAR _Gender = [Selected Gender]
	/// VAR _HasActivePP =
	/// CALCULATE(
	/// COUNTROWS('Demographics'),
	/// 'Demographics'[Tag] = "Pupil Premium",
	/// 'Demographics'[Tag Start Date] <= _MaxDate,
	/// 'Demographics'[Tag End Date] >= _MaxDate
	/// )
	/// RETURN
	/// IF(ISBLANK(_Gender),BLANK(),
	/// IF(_HasActivePP > 0, "PP", "No PP"))
	measure 'Selected PP' =
			
			//SELECTEDVALUE ( 'Student Database (Full)'[Pupil Premium Indicator(Short)] )
			
			// VAR _MaxDate = [Dynamic Max Date]
			
			// RETURN
			// CALCULATE (
			//     SELECTEDMEASURE (), 'Demographics Enrollment'[Date List]=_MaxDate,
			//     'Demographics Enrollment'[Pupil Premium] = 1
			// )
			VAR _MaxDate = [Dynamic Max Date]
			VAR _Gender = [Selected Gender]
			VAR _HasActivePP =
			    CALCULATE(
			        COUNTROWS('Demographics'),
			        'Demographics'[Tag] = "Pupil Premium",
			        'Demographics'[Tag Start Date] <= _MaxDate,
			        'Demographics'[Tag End Date] >= _MaxDate
			    )
			RETURN
			IF(ISBLANK(_Gender),BLANK(),
			IF(_HasActivePP > 0, "PP", "No PP"))
		displayFolder: Student Measures
		lineageTag: 6fc2eb83-c2fc-4f66-b497-0e51ccaf0b1d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// 
	/// VAR _MaxDate = [Dynamic Max Date]
	/// VAR _gender = [Selected Gender]
	/// VAR _Student = SELECTEDVALUE('Student Database (Full)'[Globally Unique Student ID])
	/// VAR _HasActiveSEN =
	/// CALCULATE(
	/// COUNTROWS('Demographics'),
	/// 'Demographics'[Person Unique ID] = _Student,
	/// 'Demographics'[Tag] = "SEN",
	/// 'Demographics'[Tag Start Date] <= _MaxDate,
	/// 'Demographics'[Tag End Date] >= _MaxDate
	/// )
	/// RETURN
	/// IF(ISBLANK(_gender),BLANK(),
	/// IF(_HasActiveSEN > 0, "SEN", "No SEN"))
	measure 'Selected SEN' =
			
			VAR _MaxDate = [Dynamic Max Date]
			VAR _gender = [Selected Gender]
			VAR _Student = SELECTEDVALUE('Student Database (Full)'[Globally Unique Student ID])
			VAR _HasActiveSEN =
			    CALCULATE(
			        COUNTROWS('Demographics'),
			        'Demographics'[Person Unique ID] = _Student,
			        'Demographics'[Tag] = "SEN",
			        'Demographics'[Tag Start Date] <= _MaxDate,
			        'Demographics'[Tag End Date] >= _MaxDate
			    )
			RETURN
			IF(ISBLANK(_gender),BLANK(),
			IF(_HasActiveSEN > 0, "SEN", "No SEN"))
		displayFolder: Student Measures
		lineageTag: ea365602-aca7-4d7b-9ac7-33977307eb76

		annotation PBI_FormatHint = {"isGeneralNumber":true}

