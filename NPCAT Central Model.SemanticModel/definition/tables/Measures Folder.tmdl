			    MAX ( 'Calendar'[Date] )
			VAR _MaxOffset =
			    MAX ( 'Calendar'[Current School Year Offset] )
			VAR _CountCY =
			    CALCULATE (
			        COUNTROWS ( RONI ),
			        'Student Database (Full)'[DOA] <= _LastDate,
			        'Student Database (Full)'[Leaving date] >= _LastDate
			            || ISBLANK ( 'Student Database (Full)'[Leaving date] )
			    )
			RETURN
			    _CountCY
		formatString: #,0
		displayFolder: RONI Measures
		lineageTag: d00901c2-13c8-45f6-88b5-84f9d5a87d9e

