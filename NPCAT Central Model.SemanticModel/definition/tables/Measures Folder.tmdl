	/// 
	/// CALCULATE (
	/// [SEN Compliance % (Most Recent QA)],
	/// 'SEN Audit Scores'[Statutory/Trust Mandated] = "Statutory"
	/// )
	measure 'SEN Statutory Compliance % (Most Recent QA)' =
			
			CALCULATE (
			    [SEN Compliance % (Most Recent QA)],
			    'SEN Audit Scores'[Statutory/Trust Mandated] = "Statutory"
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: SEN QA
		lineageTag: fbc3173d-e43e-457e-ad14-76961bc50746

	/// 
	/// VAR _MaxDate =
	/// MAX ( 'Calendar'[Date] )
	/// VAR _SENComplianceTable =
	/// CALCULATETABLE (
	/// SUMMARIZE (
	/// 'SEN Audit Scores',
	/// 'SEN Audit Visits'[SUID],
	/// "Numerator",
	/// CALCULATE (
	/// COUNTA ( 'SEN Audit Scores'[Answer] ),
	/// 'SEN Audit Scores'[Answer] IN { "Met" },
	/// 'SEN Audit Scores'[Question] <> "The SENCO is a qualified teacher and has the relevant qualifications."
	/// ) + 0,
	/// "Denomiator",
	/// CALCULATE (
	/// COUNTA ( 'SEN Audit Scores'[Answer] ),
	/// 'SEN Audit Scores'[Answer] IN { "Met", "Not Met", "Partially Met" },
	/// 'SEN Audit Scores'[Question] <> "The SENCO is a qualified teacher and has the relevant qualifications."
	/// )
	/// ),
	/// 'SEN Audit Scores'[QA Offset] = 0,
	/// ALL ( 'Calendar' ),
	/// 'SEN Audit Visits'[Date of QA] <= _MaxDate
	/// )
	/// VAR _Result =
	/// //DIVIDE (
	/// //SUMX( _SENComplianceTable, [Numerator] ),
	/// //SUMX( _SENComplianceTable, [Denomiator] )
	/// //)
	/// CALCULATE (
	/// [SEN Compliance % (Over Time)],
	/// 'SEN Audit Scores'[Statutory/Trust Mandated] = "Statutory"
	/// )
	/// RETURN
	/// _Result
	measure 'SEN Statutory Compliance % (Over Time)' =
			
			VAR _MaxDate =
			    MAX ( 'Calendar'[Date] )
			VAR _SENComplianceTable =
			    CALCULATETABLE (
			        SUMMARIZE (
			            'SEN Audit Scores',
			            'SEN Audit Visits'[SUID],
			            "Numerator",
			                CALCULATE (
			                    COUNTA ( 'SEN Audit Scores'[Answer] ),
			                    'SEN Audit Scores'[Answer] IN { "Met" },
			                    'SEN Audit Scores'[Question] <> "The SENCO is a qualified teacher and has the relevant qualifications."
			                ) + 0,
			            "Denomiator",
			                CALCULATE (
			                    COUNTA ( 'SEN Audit Scores'[Answer] ),
			                    'SEN Audit Scores'[Answer] IN { "Met", "Not Met", "Partially Met" },
			                    'SEN Audit Scores'[Question] <> "The SENCO is a qualified teacher and has the relevant qualifications."
			                )
			        ),
			        'SEN Audit Scores'[QA Offset] = 0,
			        ALL ( 'Calendar' ),
			        'SEN Audit Visits'[Date of QA] <= _MaxDate
			    )
			VAR _Result =
			    //DIVIDE (
			    //SUMX( _SENComplianceTable, [Numerator] ),
			    //SUMX( _SENComplianceTable, [Denomiator] )
			    //)
			    CALCULATE (
			        [SEN Compliance % (Over Time)],
			        'SEN Audit Scores'[Statutory/Trust Mandated] = "Statutory"
			    )
			RETURN
			    _Result
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: SEN QA
		lineageTag: 77442e93-06e9-4fcf-a353-7eee85029ae2

