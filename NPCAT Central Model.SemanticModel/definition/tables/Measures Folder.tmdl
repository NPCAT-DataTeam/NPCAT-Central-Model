	/// 
	/// CALCULATE (
	/// DIVIDE (
	/// CALCULATE ( COUNTA ( 'Attendance'[Mark] ), 'Attendance'[Mark] IN { "M" } ),
	/// SUM ( 'Attendance'[Sessions] )
	/// ),
	/// 'Calendar'[FutureDate] IN { "Past" }
	/// ) + 0
	measure 'Medical Absence %' =
			
			CALCULATE (
			    DIVIDE (
			        CALCULATE ( COUNTA ( 'Attendance'[Mark] ), 'Attendance'[Mark] IN { "M" } ),
			        SUM ( 'Attendance'[Sessions] )
			    ),
			    'Calendar'[FutureDate] IN { "Past" }
			) + 0
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Attendance Measures
		lineageTag: 700861d0-7c57-4194-80f6-014dbbbe141f

	/// 
	/// CALCULATE (
	/// DIVIDE (
	/// CALCULATE ( COUNTA ( 'Attendance'[Mark] ), 'Attendance'[Mark] IN { "H" } ),
	/// SUM ( 'Attendance'[Sessions] )
	/// ),
	/// 'Calendar'[FutureDate] IN { "Past" }
	/// ) + 0
	measure 'Agreed Family Holiday Absence %' =
			
			CALCULATE (
			    DIVIDE (
			        CALCULATE ( COUNTA ( 'Attendance'[Mark] ), 'Attendance'[Mark] IN { "H" } ),
			        SUM ( 'Attendance'[Sessions] )
			    ),
