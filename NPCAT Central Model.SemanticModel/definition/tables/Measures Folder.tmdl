	measure 'Suspension Days After 15 Days' = ```
			
			VAR TargetCategory = "Suspension"
			VAR ThresholdDays = 15
			
			RETURN
			SUMX(
			    VALUES('Behaviour Sanctions'[Globally Unique Student ID]),
			    VAR CurrentStudent = 'Behaviour Sanctions'[Globally Unique Student ID]
			
			    -- Step 1: Filter events strictly for this student and target category
			    VAR StudentEvents = 
			        CALCULATETABLE(
			            'Behaviour Sanctions',
			            'Behaviour Sanctions'[Source Table] = TargetCategory,
			            'Behaviour Sanctions'[Globally Unique Student ID] = CurrentStudent
			        )
			
			    -- Step 2: Calculate running total per event for this student
			    VAR EventsWithRunningTotal = 
			        ADDCOLUMNS(
			            StudentEvents,
			            "@RunningTotal",
			            VAR CurrentDate = 'Behaviour Sanctions'[Start Date]
			            VAR CurrentID = 'Behaviour Sanctions'[Event ID]
			            RETURN
			                SUMX(
			                    FILTER(
			                        StudentEvents,
			                        'Behaviour Sanctions'[Start Date] < CurrentDate 
			                            || ('Behaviour Sanctions'[Start Date] = CurrentDate && 'Behaviour Sanctions'[Event ID] <= CurrentID)
			                    ),
			                    'Behaviour Sanctions'[Days Suspended]
			                )
			        )
			
			    -- Step 3: Identify events where running total reaches or exceeds 15 days
			    VAR TriggerEvents = 
			        FILTER(
			            EventsWithRunningTotal,
			            [@RunningTotal] >= ThresholdDays
			        )
			
			    -- Step 4: Extract the exact date and ID of the 15-day trigger event
			    VAR TriggerDate = MINX(TriggerEvents, 'Behaviour Sanctions'[Start Date])
			    VAR TriggerID = 
			        MINX(
			            FILTER(TriggerEvents, 'Behaviour Sanctions'[Start Date] = TriggerDate),
			            'Behaviour Sanctions'[Event ID]
			        )
			
			    -- Step 5: Count events strictly AFTER the trigger event (returns 0 if total days < 15)
			    VAR PostThresholdCount = 
			        IF(
			            ISBLANK(TriggerDate),
			            0,
			            SUMX(
			                FILTER(
			                    StudentEvents,
			                    'Behaviour Sanctions'[Start Date] > TriggerDate 
			                        || ('Behaviour Sanctions'[Start Date] = TriggerDate && 'Behaviour Sanctions'[Event ID] > TriggerID)
			                ),
			                'Behaviour Sanctions'[Days Suspended]
			            )
			        )
			
			    RETURN
			        PostThresholdCount
			)
			```
		formatString: #,0
		displayFolder: Behaviour Sanctions\Suspensions
		lineageTag: a8b2103e-66af-4fb6-8857-f6f16a25b57e

	measure 'Suspension Students After 15 Days' = ```
			
			VAR TargetCategory = "Suspension"
			VAR ThresholdDays = 15
			
			RETURN
			SUMX(
			    VALUES('Behaviour Sanctions'[Globally Unique Student ID]),
			    VAR CurrentStudent = 'Behaviour Sanctions'[Globally Unique Student ID]
			
			    -- Step 1: Filter events strictly for this student and target category
			    VAR StudentEvents = 
			        CALCULATETABLE(
			            'Behaviour Sanctions',
			            'Behaviour Sanctions'[Source Table] = TargetCategory,
			            'Behaviour Sanctions'[Globally Unique Student ID] = CurrentStudent
			        )
			
			    -- Step 2: Calculate running total per event for this student
			    VAR EventsWithRunningTotal = 
			        ADDCOLUMNS(
			            StudentEvents,
			            "@RunningTotal",
			            VAR CurrentDate = 'Behaviour Sanctions'[Start Date]
			            VAR CurrentID = 'Behaviour Sanctions'[Event ID]
			            RETURN
			                SUMX(
			                    FILTER(
			                        StudentEvents,
			                        'Behaviour Sanctions'[Start Date] < CurrentDate 
			                            || ('Behaviour Sanctions'[Start Date] = CurrentDate && 'Behaviour Sanctions'[Event ID] <= CurrentID)
			                    ),
			                    'Behaviour Sanctions'[Days Suspended]
			                )
			        )
			
			    -- Step 3: Identify events where running total reaches or exceeds 15 days
			    VAR TriggerEvents = 
			        FILTER(
			            EventsWithRunningTotal,
			            [@RunningTotal] >= ThresholdDays
			        )
			
			    -- Step 4: Extract the exact date and ID of the 15-day trigger event
			    VAR TriggerDate = MINX(TriggerEvents, 'Behaviour Sanctions'[Start Date])
			    VAR TriggerID = 
			        MINX(
			            FILTER(TriggerEvents, 'Behaviour Sanctions'[Start Date] = TriggerDate),
			            'Behaviour Sanctions'[Event ID]
			        )
			
			    -- Step 5: Count events strictly AFTER the trigger event (returns 0 if total days < 15)
			    VAR PostThresholdEvents = 
			    FILTER(
			        StudentEvents,
			        'Behaviour Sanctions'[Start Date] > TriggerDate 
			            || ('Behaviour Sanctions'[Start Date] = TriggerDate && 'Behaviour Sanctions'[Event ID] > TriggerID)
			    )
			
			VAR PostThresholdCount = 
			    IF(
			        ISBLANK(TriggerDate) || ISEMPTY(PostThresholdEvents),
			        0,
			        1 -- Returns 1 so SUMX totals the distinct number of students
			    )
			    
			
			    RETURN
			        PostThresholdCount
			)
			```
		formatString: #,0
		displayFolder: Behaviour Sanctions\Suspensions
		lineageTag: 1b1ae9ec-eecb-4f09-b8e4-7b166fc3b6e8

