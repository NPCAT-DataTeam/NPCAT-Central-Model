	/// 
	/// VAR _MinDate =
	/// CALCULATE ( MIN ( 'Printing and Copying'[Date] ), ALL ( 'Calendar' ) )
	/// RETURN
	/// IF (
	/// ISBLANK ( _MinDate ),
	/// "",
	/// FORMAT ( TODAY () - _MinDate, "General Number" )
	/// )
	measure 'Printing Data Availability (Days Passed)' =
			
			VAR _MinDate =
			    CALCULATE ( MIN ( 'Printing and Copying'[Date] ), ALL ( 'Calendar' ) )
