	/// 
	/// SWITCH (
	/// TRUE (),
	/// [SEN Compliance % (Most Recent QA)] = 1, "Tier 1",
	/// [SEN Compliance % (Most Recent QA)] >= 0.95, "Tier 2",
	/// [SEN Compliance % (Most Recent QA)] >= 0.90, "Tier 3",
	/// [SEN Compliance % (Most Recent QA)] < 0.9, "Tier 4"
	/// )
	measure 'SEN Compliance Tier' =
			
			SWITCH (
			    TRUE (),
			    [SEN Compliance % (Most Recent QA)] = 1, "Tier 1",
			    [SEN Compliance % (Most Recent QA)] >= 0.95, "Tier 2",
			    [SEN Compliance % (Most Recent QA)] >= 0.90, "Tier 3",
			    [SEN Compliance % (Most Recent QA)] < 0.9, "Tier 4"
			)
		displayFolder: Unused
