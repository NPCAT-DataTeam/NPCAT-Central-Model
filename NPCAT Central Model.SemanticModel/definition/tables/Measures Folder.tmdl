	/// 
	/// VAR _MaxOffset =
	/// MAX ( 'Calendar'[Current School Year Offset] ) - 1
	/// VAR _MaxSchoolMonth =
	/// MAX ( 'Calendar'[School Month Number] )
	/// VAR _Yearselector =
	/// IF ( _MaxSchoolMonth < 10, _MaxOffset - 1, _MaxOffset )
	/// VAR _StudentCount =
	/// CALCULATE (
	/// DISTINCTCOUNT ( MTC[Globally Unique ID] ),
	/// REMOVEFILTERS ( 'Calendar' ),
	/// 'Calendar'[Current School Year Offset] = _Yearselector
	/// )
	/// RETURN
	/// _StudentCount
	measure 'MTC No. Pupils PY' =
			
			VAR _MaxOffset =
			    MAX ( 'Calendar'[Current School Year Offset] ) - 1
			VAR _MaxSchoolMonth =
			    MAX ( 'Calendar'[School Month Number] )
			VAR _Yearselector =
			    IF ( _MaxSchoolMonth < 10, _MaxOffset - 1, _MaxOffset )
			VAR _StudentCount =
			    CALCULATE (
			        DISTINCTCOUNT ( MTC[Globally Unique ID] ),
			        REMOVEFILTERS ( 'Calendar' ),
			        'Calendar'[Current School Year Offset] = _Yearselector
			    )
			RETURN
			    _StudentCount
		displayFolder: Unused
		lineageTag: be990f2a-db40-43ef-99b3-4705b6d0cbd7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// 
	/// CALCULATE (
	/// [MTC No. Pupils],
	/// FILTER (
	/// CALCULATETABLE (
	/// SUMMARIZE ( 'MTC', 'MTC'[Mark Groups Sort], 'MTC'[Mark Groups] ),
	/// ALLSELECTED ( 'MTC' )
	/// ),
	/// ISONORAFTER (
	/// 'MTC'[Mark Groups Sort], MAX ( 'MTC'[Mark Groups Sort] ), DESC,
	/// 'MTC'[Mark Groups], MAX ( 'MTC'[Mark Groups] ), DESC
	/// )
	/// )
	/// )
	measure 'MTC No. Pupils running total in Mark Groups' =
			
			CALCULATE (
			    [MTC No. Pupils],
			    FILTER (
			        CALCULATETABLE (
			            SUMMARIZE ( 'MTC', 'MTC'[Mark Groups Sort], 'MTC'[Mark Groups] ),
			            ALLSELECTED ( 'MTC' )
			        ),
			        ISONORAFTER (
			            'MTC'[Mark Groups Sort], MAX ( 'MTC'[Mark Groups Sort] ), DESC,
			            'MTC'[Mark Groups], MAX ( 'MTC'[Mark Groups] ), DESC
			        )
			    )
			)
