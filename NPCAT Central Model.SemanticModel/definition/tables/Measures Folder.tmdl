	/// "Being Imaginative and Expressive"
	/// },
	/// 'EYFS ELGs/GLD'[Grade] <> "A"
	/// )
	/// VAR __SUM =
	/// SUMX ( __SPECIFICTable, [SPECIFIC Total] )
	/// RETURN
	/// __SUM
	measure 'SPECIFIC #' =
			
			VAR __SPECIFICTable =
			    CALCULATETABLE (
			        SUMMARIZE (
			            'EYFS ELGs/GLD',
			            'EYFS ELGs/GLD'[Globally Unique ID],
			            "SPECIFIC Total", ROUNDDOWN ( DIVIDE ( SUM ( 'EYFS ELGs/GLD'[Grade Value] ), 20 ), 0 )
			        ),
			        'EYFS ELGs/GLD'[Assessment Name]
			            IN {
			                "Comprehension",
			                "Word Reading",
			                "Writing",
			                "Number",
			                "Numerical Patterns",
			                "Past and Present",
			                "People, Culture and Communities",
			                "The Natural World",
			                "Creating with Materials",
			                "Being Imaginative and Expressive"
			            },
			        'EYFS ELGs/GLD'[Grade] <> "A"
			    )
			VAR __SUM =
			    SUMX ( __SPECIFICTable, [SPECIFIC Total] )
			RETURN
			    __SUM
