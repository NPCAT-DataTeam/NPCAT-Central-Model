	/// )
	/// RETURN
	/// IF (
	/// ISBLANK ( DIVIDE ( _Numerator, _Denmonator ) ),
	/// IF ( ISBLANK ( _Denmonator ), BLANK (), 0 ),
	/// DIVIDE ( _Numerator, _Denmonator )
	/// )
	measure 'KS1 EXS+% - All' =
			
			VAR _Numerator =
			    CALCULATE (
			        COUNTA ( 'KS1 Teacher Assessments'[Grade] ),
			        'KS1 Teacher Assessments'[Grade] IN { "EXS", "GDS" }
			    )
			VAR _Denmonator =
			    CALCULATE (
			        COUNTA ( 'KS1 Teacher Assessments'[Grade] ),
			        ALLSELECTED ( 'KS1 Teacher Assessments'[Grade] )
			    )
			RETURN
			    IF (
