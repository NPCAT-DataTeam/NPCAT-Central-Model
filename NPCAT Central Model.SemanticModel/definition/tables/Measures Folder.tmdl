	/// 
	/// VAR _LastDate =
	/// MAX ( 'Calendar'[Date] )
	/// VAR _FirstDate =
	/// MIN ( 'Calendar'[Date] )
	/// VAR _Final =
	/// CALCULATE (
	/// DISTINCTCOUNT ( 'Employees'[Employee Key] ),
	/// 'Employee Job Roles'[Property Start Date] <= _LastDate - 180,
	/// 'Employee Job Roles'[Post End Date] >= _FirstDate
	/// || ISBLANK ( 'Employee Job Roles'[Post End Date] )
	/// )
	/// RETURN
	/// _Final
	measure 'Staff Employed (In Appraisal Cycle)' =
			
			VAR _LastDate =
			    MAX ( 'Calendar'[Date] )
			VAR _FirstDate =
			    MIN ( 'Calendar'[Date] )
			VAR _Final =
			    CALCULATE (
			        DISTINCTCOUNT ( 'Employees'[Employee Key] ),
			        'Employee Job Roles'[Property Start Date] <= _LastDate - 180,
			        'Employee Job Roles'[Post End Date] >= _FirstDate
			            || ISBLANK ( 'Employee Job Roles'[Post End Date] )
			    )
			RETURN
			    _Final
		formatString: 0
		displayFolder: Objectives
		lineageTag: 55865fef-e7d4-42e9-95e3-8033ee22168b

