	/// 
	/// CALCULATE(
	/// DISTINCTCOUNT('KS4 Student Headlines'[Unique Student ID]),
	/// 'KS4 Student Headlines'[Ebacc Entered in English]=1)
	measure 'Students Ebacc in English' =
			
