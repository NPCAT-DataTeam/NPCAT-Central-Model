	/// 
	/// VAR AllSchools =
	/// CALCULATE (
	/// [Students on Roll (Enrollment)],
	/// ALL ( 'School Database' ),
	/// 'School Database'[School Short Name] <> "NPCAT"
	/// )
	/// VAR SelectedOfsted =
	/// CALCULATE (
	/// [Students on Roll (Enrollment)],
	/// 'School Database'[Ofsted Grade] IN { "Good", "Outstanding" }
	/// )
	/// RETURN
	/// DIVIDE ( SelectedOfsted, AllSchools )
	measure 'Proportion of Pupils Attending Good or Outstanding Schools' =
			
			VAR AllSchools =
			    CALCULATE (
			        [Students on Roll (Enrollment)],
			        ALL ( 'School Database' ),
			        'School Database'[School Short Name] <> "NPCAT"
			    )
			VAR SelectedOfsted =
			    CALCULATE (
			        [Students on Roll (Enrollment)],
			        'School Database'[Ofsted Grade] IN { "Good", "Outstanding" }
			    )
			RETURN
			    DIVIDE ( SelectedOfsted, AllSchools )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Unused
		lineageTag: 5a3bde4b-4eb5-471f-92ad-e08beb62a4ee

	/// 
	/// VAR AllSchools =
	/// CALCULATE (
	/// COUNTROWS ( 'School Database' ),
	/// ALL ( 'School Database' ),
	/// 'School Database'[School Short Name] <> "NPCAT"
	/// )
	/// VAR SelectedOfsted =
	/// CALCULATE (
	/// COUNTROWS ( 'School Database' ),
	/// 'School Database'[Ofsted Grade] IN { "Good", "Outstanding" }
	/// )
	/// RETURN
	/// DIVIDE ( SelectedOfsted, AllSchools )
	measure 'Proportion of Schools Good or Outstanding Ofsted' =
			
			VAR AllSchools =
			    CALCULATE (
			        COUNTROWS ( 'School Database' ),
			        ALL ( 'School Database' ),
			        'School Database'[School Short Name] <> "NPCAT"
			    )
			VAR SelectedOfsted =
			    CALCULATE (
			        COUNTROWS ( 'School Database' ),
			        'School Database'[Ofsted Grade] IN { "Good", "Outstanding" }
			    )
			RETURN
			    DIVIDE ( SelectedOfsted, AllSchools )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Unused
		lineageTag: 4818eb74-bbe7-4293-9370-df9122b1d6c9

	/// 
	/// VAR __CurrentIndex =
	/// CALCULATE (
	/// MAX ( 'Health and Safety Audit Overview'[Subgroup Index] ),
	/// REMOVEFILTERS ( 'Health and Safety Audit Overview'[Is Most Recent Health and Safety Audit] )
	/// )
	/// VAR __PrevRecordIndex =
	/// CALCULATE (
	/// MAX ( 'Health and Safety Audit Overview'[Subgroup Index] ) - 1,
	/// REMOVEFILTERS ( 'Health and Safety Audit Overview'[Is Most Recent Health and Safety Audit] )
	/// )
	/// VAR __PreviousValue =
	/// IF (
	/// __PrevRecordIndex = 0,
	/// BLANK (),
	/// CALCULATE (
	/// SUM ( 'Health and Safety Audit Overview'[3 - Prudent Deficiencies (No Significant Risk)] ),
	/// REMOVEFILTERS ( 'Health and Safety Audit Overview'[Is Most Recent Health and Safety Audit] ),
	/// 'Health and Safety Audit Overview'[Subgroup Index] = __PrevRecordIndex
	/// )
	/// )
	/// VAR __CurrentValue =
	/// CALCULATE (
	/// SUM ( 'Health and Safety Audit Overview'[3 - Prudent Deficiencies (No Significant Risk)] ),
	/// REMOVEFILTERS ( 'Health and Safety Audit Overview'[Is Most Recent Health and Safety Audit] ),
	/// 'Health and Safety Audit Overview'[Subgroup Index] = __CurrentIndex
	/// )
	/// RETURN
	/// IF ( ISBLANK ( __PreviousValue ), BLANK (), __CurrentValue - __PreviousValue )
	measure 'Prudent Deficiencies Priority Task Change' =
			
			VAR __CurrentIndex =
			    CALCULATE (
			        MAX ( 'Health and Safety Audit Overview'[Subgroup Index] ),
			        REMOVEFILTERS ( 'Health and Safety Audit Overview'[Is Most Recent Health and Safety Audit] )
			    )
			VAR __PrevRecordIndex =
			    CALCULATE (
			        MAX ( 'Health and Safety Audit Overview'[Subgroup Index] ) - 1,
			        REMOVEFILTERS ( 'Health and Safety Audit Overview'[Is Most Recent Health and Safety Audit] )
			    )
			VAR __PreviousValue =
			    IF (
			        __PrevRecordIndex = 0,
			        BLANK (),
			        CALCULATE (
			            SUM ( 'Health and Safety Audit Overview'[3 - Prudent Deficiencies (No Significant Risk)] ),
			            REMOVEFILTERS ( 'Health and Safety Audit Overview'[Is Most Recent Health and Safety Audit] ),
			            'Health and Safety Audit Overview'[Subgroup Index] = __PrevRecordIndex
			        )
			    )
			VAR __CurrentValue =
			    CALCULATE (
			        SUM ( 'Health and Safety Audit Overview'[3 - Prudent Deficiencies (No Significant Risk)] ),
			        REMOVEFILTERS ( 'Health and Safety Audit Overview'[Is Most Recent Health and Safety Audit] ),
			        'Health and Safety Audit Overview'[Subgroup Index] = __CurrentIndex
			    )
			RETURN
			    IF ( ISBLANK ( __PreviousValue ), BLANK (), __CurrentValue - __PreviousValue )
		formatString: 0
		displayFolder: Unused
		lineageTag: fe58c855-6fec-48cd-969f-03276f95a61c

