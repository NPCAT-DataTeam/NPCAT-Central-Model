	/// 
	/// VAR NationalValue =
	/// IF (
	/// [Selected National P8 Overall] = "N/A",
	/// "N/A",
	/// FORMAT ( ROUND ( [Selected National P8 Overall], 2 ), "0.00" )
	/// )
	/// VAR Difference =
	/// IF (
	/// [Selected National P8 Overall Difference] = "N/A",
	/// "",
	/// ROUND ( [Selected National P8 Overall Difference], 2 )
	/// )
	/// VAR Operator =
	/// SWITCH ( TRUE, Difference = "", "", Difference >= 0, " +", Difference < 0, " " )
	/// VAR Actual =
	/// IF (
	/// ISBLANK ( [Headline Overall P8] ),
	/// "N/A",
	/// FORMAT ( ROUND ( [Headline Overall P8], 2 ), "0.00" )
	/// )
	/// VAR Final =
	/// Actual & UNICHAR ( 10 ) & "(" & NationalValue & ")" & Operator & Difference
	/// RETURN
	/// IF (
	/// Actual = "N/A",
	/// (
	/// Actual & UNICHAR ( 10 ) & "(" & NationalValue & ")"
	/// ),
	/// Final
	/// )
	measure 'Selected National P8 Overall KPI' =
			
			VAR NationalValue =
			    IF (
			        [Selected National P8 Overall] = "N/A",
			        "N/A",
			        FORMAT ( ROUND ( [Selected National P8 Overall], 2 ), "0.00" )
			    )
			VAR Difference =
			    IF (
			        [Selected National P8 Overall Difference] = "N/A",
			        "",
			        ROUND ( [Selected National P8 Overall Difference], 2 )
			    )
			VAR Operator =
			    SWITCH ( TRUE, Difference = "", "", Difference >= 0, " +", Difference < 0, " " )
			VAR Actual =
			    IF (
			        ISBLANK ( [Headline Overall P8] ),
			        "N/A",
