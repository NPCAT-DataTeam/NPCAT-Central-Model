	/// 
	/// VAR _MaxWeekOffset =
	/// MAX ( 'Calendar'[CurWeekOffset] )
	/// VAR _PW =
	/// MAX ( 'Calendar'[CurWeekOffset] ) - 1
	/// VAR _PreviousPeriod =
	/// CALCULATE (
	/// [Percentage Excluded],
	/// FILTER ( ALL ( 'Calendar' ), 'Calendar'[CurWeekOffset] = _PW )
	/// )
	/// VAR _CW =
	/// CALCULATE ( [Percentage Excluded], 'Calendar'[CurWeekOffset] = _MaxWeekOffset )
	/// RETURN
	/// _CW - _PreviousPeriod
	measure 'Percentage Excluded WoW' =
			
			VAR _MaxWeekOffset =
			    MAX ( 'Calendar'[CurWeekOffset] )
			VAR _PW =
			    MAX ( 'Calendar'[CurWeekOffset] ) - 1
			VAR _PreviousPeriod =
			    CALCULATE (
			        [Percentage Excluded],
			        FILTER ( ALL ( 'Calendar' ), 'Calendar'[CurWeekOffset] = _PW )
			    )
			VAR _CW =
			    CALCULATE ( [Percentage Excluded], 'Calendar'[CurWeekOffset] = _MaxWeekOffset )
			RETURN
			    _CW - _PreviousPeriod
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Exclusion Measures (Old)
		lineageTag: ecb012be-a03a-42af-8395-b63998f3b6b0

	/// 
	/// VAR _LastDate =
	/// LASTDATE ( 'Calendar'[Date] )
	/// VAR _StartDate =
	/// FIRSTDATE ( 'Calendar'[Date] )
	/// RETURN
	/// CALCULATE (
	/// SUM ( 'Employee Job Roles'[FTE Ratio] ),
	/// 'Employee Job Roles'[Post End Date] <= _LastDate,
	/// 'Employee Job Roles'[Post End Date] >= _StartDate,
	/// 'Employee Job Roles'[Movement Type] = "Leaver"
	/// )
	measure 'Staff FTE Turnover (Time)' =
			
			VAR _LastDate =
			    LASTDATE ( 'Calendar'[Date] )
			VAR _StartDate =
			    FIRSTDATE ( 'Calendar'[Date] )
			RETURN
			    CALCULATE (
			        SUM ( 'Employee Job Roles'[FTE Ratio] ),
			        'Employee Job Roles'[Post End Date] <= _LastDate,
			        'Employee Job Roles'[Post End Date] >= _StartDate,
			        'Employee Job Roles'[Movement Type] = "Leaver"
			    )
		formatString: 0.00
		displayFolder: Employees/Retention
		lineageTag: e3540652-7ca0-4723-9313-d3b4ab96afcc

