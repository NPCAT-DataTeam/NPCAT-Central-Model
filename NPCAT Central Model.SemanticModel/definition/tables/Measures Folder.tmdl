	/// )
	measure 'KS4 Show Filters' =
			--Academic Year
			IF (
			    ISFILTERED ( 'KS4 Assessments'[School Year] ),
			    VAR items =
			        VALUES ( 'KS4 Assessments'[School Year] )
			    VAR itemscombined =
			        CONCATENATEX ( items, 'KS4 Assessments'[School Year], UNICHAR ( 10 ) )
			    RETURN
			        itemscombined & UNICHAR ( ( 10 ) )
			            & --Year Group
			            IF (
			                ISFILTERED ( 'Student Year Groups'[Year Group] ),
			                VAR items =
			                    VALUES ( 'Student Year Groups'[Year Group] )
			                VAR itemscombined =
			                    CONCATENATEX ( items, 'Student Year Groups'[Year Group], UNICHAR ( 10 ) )
			                RETURN
			                    itemscombined & UNICHAR ( ( 10 ) )
			                        & --Assessment Period
			                        IF (
			                            ISFILTERED ( 'KS4 Assessments'[PERIOD_NAME] ),
			                            VAR items =
			                                VALUES ( 'KS4 Assessments'[PERIOD_NAME] )
			                            VAR itemscombined =
