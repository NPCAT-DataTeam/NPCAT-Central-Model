	/// 
	/// VAR _CurrentPeriodIndex =
	/// MAX ( 'Primary Summative Marks (South)'[Assessment Index] )
	/// VAR _PreviousPeriodIndex =
	/// IF ( LEN ( _CurrentPeriodIndex - 1 ) = 0, BLANK (), _CurrentPeriodIndex - 1 )
	/// VAR _Current =
	/// CALCULATE (
	/// [2. Avg Period Points],
	/// 'Primary Summative Marks (South)'[Assessment Index] = _CurrentPeriodIndex
	/// )
	/// VAR _Previous =
	/// CALCULATE (
	/// [2. Avg Period Points],
	/// REMOVEFILTERS (
	/// 'Primary Summative Marks (South)'[Assessment Index],
	/// 'Primary Summative Marks (South)'[Assessment Period],
	/// 'Primary Summative Marks (South)'[Assessment Period Sort]
	/// ),
	/// 'Primary Summative Marks (South)'[Assessment Index] = _PreviousPeriodIndex
	/// )
	/// VAR _Final = _Current - _Previous
	/// RETURN
	/// _Final
	measure '2. Avg Variation Previous Period Offset Measure' =
			
			VAR _CurrentPeriodIndex =
			    MAX ( 'Primary Summative Marks (South)'[Assessment Index] )
			VAR _PreviousPeriodIndex =
			    IF ( LEN ( _CurrentPeriodIndex - 1 ) = 0, BLANK (), _CurrentPeriodIndex - 1 )
			VAR _Current =
			    CALCULATE (
			        [2. Avg Period Points],
			        'Primary Summative Marks (South)'[Assessment Index] = _CurrentPeriodIndex
			    )
			VAR _Previous =
			    CALCULATE (
			        [2. Avg Period Points],
			        REMOVEFILTERS (
			            'Primary Summative Marks (South)'[Assessment Index],
			            'Primary Summative Marks (South)'[Assessment Period],
			            'Primary Summative Marks (South)'[Assessment Period Sort]
			        ),
			        'Primary Summative Marks (South)'[Assessment Index] = _PreviousPeriodIndex
			    )
			VAR _Final = _Current - _Previous
			RETURN
			    _Final
		displayFolder: Unused
		lineageTag: 043a5d6c-e0f0-46e6-aea3-a3196823b8d0

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isGeneralNumber":true}

