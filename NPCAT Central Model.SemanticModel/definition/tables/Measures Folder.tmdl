	/// 
	/// VAR TotalWeekdays =
	/// COUNTROWS (
	/// FILTER (
	/// DISTINCT ( 'ICT Help Desk'[Create Date] ),
	/// WEEKDAY ( 'ICT Help Desk'[Create Date], 2 ) < 6
	/// )
	/// )
	/// RETURN
	/// IF (
	/// TotalWeekdays <> 0,
	/// DIVIDE ( [Total ICT Tickets], TotalWeekdays ),
	/// BLANK ()
	/// )
	/// // AVERAGEX (
	/// //     KEEPFILTERS ( VALUES ( 'ICT Help Desk'[Create Date] ) ),
	/// //     CALCULATE (
	/// //         [Total ICT Tickets],
	/// //         NOT ( 'Calendar'[Weekday] IN { "Sat", "Sun" } )
	/// //     )
	/// // ))
	measure 'Tickets Per Day Average' =
			
			VAR TotalWeekdays =
			    COUNTROWS (
			        FILTER (
			            DISTINCT ( 'ICT Help Desk'[Create Date] ),
			            WEEKDAY ( 'ICT Help Desk'[Create Date], 2 ) < 6
			        )
			    )
			RETURN
			    IF (
			        TotalWeekdays <> 0,
			        DIVIDE ( [Total ICT Tickets], TotalWeekdays ),
			        BLANK ()
			    )
			// AVERAGEX (
			//     KEEPFILTERS ( VALUES ( 'ICT Help Desk'[Create Date] ) ),
			//     CALCULATE (
			//         [Total ICT Tickets],
			//         NOT ( 'Calendar'[Weekday] IN { "Sat", "Sun" } )
			//     )
			// ))
		displayFolder: ICT Measures\ICT Helpdesk
		lineageTag: 35edcd18-4e8b-4836-8032-c0218cf3534e

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "AveragePerCategory"
				}

