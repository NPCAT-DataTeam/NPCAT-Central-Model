	/// 
	/// VAR Blank_Effort =
	/// ISBLANK ( [Avg Effort] )
	/// VAR Effort_Grade =
	/// SWITCH (
	/// TRUE (),
	/// ROUND ( [Avg Effort], 1 ) >= 5, "E1",
	/// ROUND ( [Avg Effort], 1 ) >= 4, "E2",
	/// ROUND ( [Avg Effort], 1 ) >= 3, "E3",
	/// ROUND ( [Avg Effort], 1 ) >= 2, "E4",
	/// ROUND ( [Avg Effort], 1 ) >= 1, "E5",
	/// ROUND ( [Avg Effort], 1 ) >= 0, "E6"
	/// )
	/// RETURN
	/// IF ( Blank_Effort = TRUE (), BLANK (), Effort_Grade )
	measure 'Avg Effort Grade' =
			
			VAR Blank_Effort =
			    ISBLANK ( [Avg Effort] )
			VAR Effort_Grade =
			    SWITCH (
			        TRUE (),
			        ROUND ( [Avg Effort], 1 ) >= 5, "E1",
			        ROUND ( [Avg Effort], 1 ) >= 4, "E2",
			        ROUND ( [Avg Effort], 1 ) >= 3, "E3",
			        ROUND ( [Avg Effort], 1 ) >= 2, "E4",
			        ROUND ( [Avg Effort], 1 ) >= 1, "E5",
			        ROUND ( [Avg Effort], 1 ) >= 0, "E6"
			    )
			RETURN
			    IF ( Blank_Effort = TRUE (), BLANK (), Effort_Grade )
		displayFolder: KS3 Summative
		lineageTag: 02198d3a-4ae7-4d18-8264-a90c484bb05e

