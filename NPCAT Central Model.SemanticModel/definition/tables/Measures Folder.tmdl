	/// 
	/// VAR _WorkingTowardsorAboveCount =
	/// CALCULATE (
	/// COUNT ( 'Primary Summative Marks (South)'[Globally Unique Student ID] ),
	/// 'Primary Summative Marks (South)'[Grade Name]
	/// IN { "Working Towards ARE", "At ARE", "Above ARE" }
	/// )
	/// RETURN
	/// DIVIDE ( _WorkingTowardsorAboveCount, [2. Number of Primary Assessments] )
	measure '2. Working Towards or Above %' =
			
			VAR _WorkingTowardsorAboveCount =
			    CALCULATE (
			        COUNT ( 'Primary Summative Marks (South)'[Globally Unique Student ID] ),
			        'Primary Summative Marks (South)'[Grade Name]
			            IN { "Working Towards ARE", "At ARE", "Above ARE" }
			    )
			RETURN
			    DIVIDE ( _WorkingTowardsorAboveCount, [2. Number of Primary Assessments] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Primary Summative(South)
		lineageTag: 06285cb3-b1c5-4519-9eba-68017833f54a

		changedProperty = FormatString

	/// 
	/// VAR _CurrentPeriodIndex =
	/// MAX ( 'Primary Summative Marks (South)'[Assessment Index] )
	/// VAR _PreviousPeriodIndex = _CurrentPeriodIndex - 1
	/// VAR _Current =
	/// IF (
	/// _CurrentPeriodIndex = 0,
	/// 0,
	/// CALCULATE (
	/// [2. Working Towards or Above %],
	/// 'Primary Summative Marks (South)'[Assessment Index] = _CurrentPeriodIndex
	/// ) * 100
	/// )
	/// VAR _Previous =
	/// CALCULATE (
	/// [2. Working Towards or Above %],
	/// REMOVEFILTERS (
	/// 'Primary Summative Marks (South)'[Assessment Index],
	/// 'Primary Summative Marks (South)'[Assessment Period],
	/// 'Primary Summative Marks (South)'[Period Sort],
	/// 'Primary Summative Marks (South)'[Assessment Period Sort]
	/// ),
	/// 'Primary Summative Marks (South)'[Assessment Index] = _PreviousPeriodIndex
	/// ) * 100
	/// VAR _Final = _Current - _Previous
	/// RETURN
	/// _Final
	measure '2. ARE - Working Towards+ Period Offset Measure' =
			
			VAR _CurrentPeriodIndex =
			    MAX ( 'Primary Summative Marks (South)'[Assessment Index] )
			VAR _PreviousPeriodIndex = _CurrentPeriodIndex - 1
			VAR _Current =
			    IF (
			        _CurrentPeriodIndex = 0,
			        0,
			        CALCULATE (
			            [2. Working Towards or Above %],
			            'Primary Summative Marks (South)'[Assessment Index] = _CurrentPeriodIndex
			        ) * 100
			    )
			VAR _Previous =
			    CALCULATE (
			        [2. Working Towards or Above %],
			        REMOVEFILTERS (
			            'Primary Summative Marks (South)'[Assessment Index],
			            'Primary Summative Marks (South)'[Assessment Period],
			            'Primary Summative Marks (South)'[Period Sort],
			            'Primary Summative Marks (South)'[Assessment Period Sort]
			        ),
			        'Primary Summative Marks (South)'[Assessment Index] = _PreviousPeriodIndex
			    ) * 100
			VAR _Final = _Current - _Previous
			RETURN
			    _Final
		formatString: 0.0
		displayFolder: Primary Summative(South)
		lineageTag: 4729d7a4-eb20-40b8-8dac-3032c74b687e

		changedProperty = FormatString

