	/// 
	/// VAR _Offset = MAX('Calendar'[Current School Year Offset])
	/// VAR _Current = CALCULATE([School Pan Difference %],'Calendar'[Current School Year Offset] = _Offset+0)
	/// VAR _3YearAgo = CALCULATE([School Pan Difference %],REMOVEFILTERS('Calendar'),'Calendar'[Current School Year Offset] = _Offset+-2)
	/// 
	/// RETURN
	/// _Current-_3YearAgo
	measure 'School Pan Variance from 3 Years ago %' =
			
			VAR _Offset = MAX('Calendar'[Current School Year Offset])
			VAR _Current = CALCULATE([School Pan Difference %],'Calendar'[Current School Year Offset] = _Offset+0)
			VAR _3YearAgo = CALCULATE([School Pan Difference %],REMOVEFILTERS('Calendar'),'Calendar'[Current School Year Offset] = _Offset+-2)
			
			RETURN
			_Current-_3YearAgo
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: School Measures
		lineageTag: 7972ff8b-2f69-4471-96eb-584d2b42ae05

	/// 
	/// VAR _SchoolType = SELECTEDVALUE('School Database'[School Type])
	/// RETURN
	/// SWITCH(TRUE(),
	/// _SchoolType="Primary",[School Pan Difference]*3900,
	/// _SchoolType ="Secondary",[School Pan Difference]*5750)
	measure 'PAN Income lost' =
			
			VAR _SchoolType = SELECTEDVALUE('School Database'[School Type])
			RETURN
			SWITCH(TRUE(),
			    _SchoolType="Primary",[School Pan Difference]*3900,
			    _SchoolType ="Secondary",[School Pan Difference]*5750)
