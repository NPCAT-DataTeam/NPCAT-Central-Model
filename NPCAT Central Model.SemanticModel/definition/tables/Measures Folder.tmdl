	/// 
	/// COUNTROWS (
	/// FILTER (
	/// SUMMARIZE (
	/// FILTER (
	/// 'Primary Statutory Predictions',
	/// 'Primary Statutory Predictions'[ASSESSMENT_NAME] = "KS2 Reading"
	/// && 'Primary Statutory Predictions'[Grade Points] >= 3
	/// || 'Primary Statutory Predictions'[ASSESSMENT_NAME] = "KS2 Writing"
	/// && 'Primary Statutory Predictions'[Grade Points] >= 3
	/// || 'Primary Statutory Predictions'[ASSESSMENT_NAME] = "KS2 Maths"
	/// && 'Primary Statutory Predictions'[Grade Points] >= 3
	/// ),
	/// 'Primary Statutory Predictions'[Globally Unique Student ID],
	/// 'Primary Statutory Predictions'[Academic Year Start],
	/// "Distinct_Count", DISTINCTCOUNT ( 'Primary Statutory Predictions'[ASSESSMENT_NAME] )
	/// ),
	/// [Distinct_Count] = 3
	/// )
	/// )
	measure '# KS2 EXS+ CRWM (Predictions)' =
			
			COUNTROWS (
			    FILTER (
			        SUMMARIZE (
			            FILTER (
			                'Primary Statutory Predictions',
			                'Primary Statutory Predictions'[ASSESSMENT_NAME] = "KS2 Reading"
			                    && 'Primary Statutory Predictions'[Grade Points] >= 3
			                    || 'Primary Statutory Predictions'[ASSESSMENT_NAME] = "KS2 Writing"
			                    && 'Primary Statutory Predictions'[Grade Points] >= 3
			                    || 'Primary Statutory Predictions'[ASSESSMENT_NAME] = "KS2 Maths"
			                    && 'Primary Statutory Predictions'[Grade Points] >= 3
			            ),
			            'Primary Statutory Predictions'[Globally Unique Student ID],
			            'Primary Statutory Predictions'[Academic Year Start],
			            "Distinct_Count", DISTINCTCOUNT ( 'Primary Statutory Predictions'[ASSESSMENT_NAME] )
			        ),
			        [Distinct_Count] = 3
			    )
			)
		formatString: 0
		displayFolder: Primary Predictions\Predictions KS2
		lineageTag: 08a853af-7a14-472d-8696-a51f82696edf

