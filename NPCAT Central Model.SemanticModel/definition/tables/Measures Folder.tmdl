	/// VAR _Numerator =
	/// CALCULATE (
	/// COUNTA ( 'EYFS ELGs/GLD'[Grade Value] ),
	/// 'EYFS ELGs/GLD'[Grade Value] IN { 2 }
	/// )
	/// VAR _Denomonator =
	/// CALCULATE (
	/// COUNT ( 'EYFS ELGs/GLD'[Grade Value] ),
	/// ALLSELECTED ( 'EYFS ELGs/GLD'[Grade Value] ),
	/// 'EYFS ELGs/GLD'[Grade] <> "A"
	/// )
	/// RETURN
	/// _Numerator & " of " & _Denomonator
	measure 'Expected # out of No. EYFS' =
			
			VAR _Numerator =
			    CALCULATE (
			        COUNTA ( 'EYFS ELGs/GLD'[Grade Value] ),
			        'EYFS ELGs/GLD'[Grade Value] IN { 2 }
			    )
			VAR _Denomonator =
			    CALCULATE (
			        COUNT ( 'EYFS ELGs/GLD'[Grade Value] ),
			        ALLSELECTED ( 'EYFS ELGs/GLD'[Grade Value] ),
			        'EYFS ELGs/GLD'[Grade] <> "A"
			    )
			RETURN
			    _Numerator & " of " & _Denomonator
		displayFolder: Unused
		lineageTag: b7196131-a26c-41bd-bdf0-0b14becbbeed

