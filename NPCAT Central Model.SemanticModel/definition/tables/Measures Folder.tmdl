	/// CALCULATE (
	/// DISTINCTCOUNT ( 'Health&Safety Actions'[Action Ref Number] ),
	/// FILTER (
	/// 'Health&Safety Actions',
	/// 'Health&Safety Actions'[Audit Date] <= MAX ( 'Calendar'[Date] )
	/// ),
	/// FILTER (
	/// 'Health&Safety Actions',
	/// 'Health&Safety Actions'[Audit Date]
	/// >= MAX ( 'Calendar'[Date] ) - 30
	/// )
	/// )
	/// RETURN
	/// IF ( __NEW = BLANK (), 0, __NEW )
	measure 'New Actions Added' =
			
			VAR __NEW =
			    CALCULATE (
			        DISTINCTCOUNT ( 'Health&Safety Actions'[Action Ref Number] ),
			        FILTER (
			            'Health&Safety Actions',
			            'Health&Safety Actions'[Audit Date] <= MAX ( 'Calendar'[Date] )
			        ),
			        FILTER (
			            'Health&Safety Actions',
			            'Health&Safety Actions'[Audit Date]
			                >= MAX ( 'Calendar'[Date] ) - 30
			        )
			    )
			RETURN
			    IF ( __NEW = BLANK (), 0, __NEW )
