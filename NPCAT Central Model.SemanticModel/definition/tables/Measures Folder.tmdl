	/// 
	/// VAR ComplianceTable =
	/// CALCULATETABLE (
	/// SUMMARIZE (
	/// 'Safeguarding Visit Scores',
	/// 'Safeguarding Visit Scores'[SUID],
	/// "CIN",
	/// CALCULATE (
	/// SUM ( 'Safeguarding Visits'[Part Time Students] ),
	/// 'Safeguarding Visits'[Snapshot Date]
	/// = MAX ( 'Safeguarding Visits'[Snapshot Date] )
	/// ),
	/// "Date", MAX ( 'Safeguarding Visits'[Snapshot Date] )
	/// )
	/// )
	/// RETURN
	/// SUMX ( ComplianceTable, [CIN] )
	measure 'Part Time Students (Safeguarding)' =
			
			VAR ComplianceTable =
			    CALCULATETABLE (
			        SUMMARIZE (
			            'Safeguarding Visit Scores',
			            'Safeguarding Visit Scores'[SUID],
			            "CIN",
			                CALCULATE (
			                    SUM ( 'Safeguarding Visits'[Part Time Students] ),
			                    'Safeguarding Visits'[Snapshot Date]
			                        = MAX ( 'Safeguarding Visits'[Snapshot Date] )
			                ),
			            "Date", MAX ( 'Safeguarding Visits'[Snapshot Date] )
			        )
			    )
			RETURN
			    SUMX ( ComplianceTable, [CIN] )
		displayFolder: Safeguarding
		lineageTag: b3755ca0-7fc8-44d9-b7d1-92e15f441aaf

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// 
	/// VAR __CurrentIndex =
	/// CALCULATE (
	/// MAX ( 'Safeguarding Visits'[Subgroup Index] ),
	/// REMOVEFILTERS ( 'Safeguarding Visits'[Is Most Recent Safeguarding Visit] )
	/// )
	/// VAR __PrevRecordIndex =
	/// CALCULATE (
	/// MAX ( 'Safeguarding Visits'[Subgroup Index] ) - 1,
	/// REMOVEFILTERS ( 'Safeguarding Visits'[Is Most Recent Safeguarding Visit] )
	/// )
	/// VAR __PreviousValue =
	/// IF (
	/// __PrevRecordIndex = 0,
	/// BLANK (),
	/// CALCULATE (
	/// SUM ( 'Safeguarding Visits'[Part Time Students] ),
	/// REMOVEFILTERS ( 'Safeguarding Visits'[Is Most Recent Safeguarding Visit] ),
	/// 'Safeguarding Visit Scores'[Subgroup Index] = __PrevRecordIndex
	/// )
	/// )
	/// VAR __CurrentValue =
	/// CALCULATE (
	/// SUM ( 'Safeguarding Visits'[Part Time Students] ),
	/// REMOVEFILTERS ( 'Safeguarding Visits'[Is Most Recent Safeguarding Visit] ),
	/// 'Safeguarding Visit Scores'[Subgroup Index] = __CurrentIndex
	/// )
	/// RETURN
	/// IF ( ISBLANK ( __PreviousValue ), BLANK (), __CurrentValue - __PreviousValue )
	measure 'Part Time Students Change (Safeguarding)' =
			
			VAR __CurrentIndex =
			    CALCULATE (
			        MAX ( 'Safeguarding Visits'[Subgroup Index] ),
			        REMOVEFILTERS ( 'Safeguarding Visits'[Is Most Recent Safeguarding Visit] )
			    )
			VAR __PrevRecordIndex =
			    CALCULATE (
			        MAX ( 'Safeguarding Visits'[Subgroup Index] ) - 1,
			        REMOVEFILTERS ( 'Safeguarding Visits'[Is Most Recent Safeguarding Visit] )
			    )
			VAR __PreviousValue =
			    IF (
			        __PrevRecordIndex = 0,
			        BLANK (),
			        CALCULATE (
			            SUM ( 'Safeguarding Visits'[Part Time Students] ),
			            REMOVEFILTERS ( 'Safeguarding Visits'[Is Most Recent Safeguarding Visit] ),
			            'Safeguarding Visit Scores'[Subgroup Index] = __PrevRecordIndex
			        )
			    )
			VAR __CurrentValue =
			    CALCULATE (
			        SUM ( 'Safeguarding Visits'[Part Time Students] ),
			        REMOVEFILTERS ( 'Safeguarding Visits'[Is Most Recent Safeguarding Visit] ),
			        'Safeguarding Visit Scores'[Subgroup Index] = __CurrentIndex
			    )
			RETURN
			    IF ( ISBLANK ( __PreviousValue ), BLANK (), __CurrentValue - __PreviousValue )
		displayFolder: Safeguarding
		lineageTag: b14c1fde-669d-43f1-8056-671e97b064b8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

