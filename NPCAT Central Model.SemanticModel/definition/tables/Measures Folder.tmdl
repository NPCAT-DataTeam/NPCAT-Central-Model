	/// 
	/// VAR Total = [Total % of Possible (Latest)]   // 0–1
	/// RETURN
	/// SWITCH (
	/// TRUE (),
	/// ISBLANK ( Total ), BLANK (),
	/// Total < 0.6, 4,
	/// Total < 0.7, 3,
	/// Total < 0.8, 2,
	/// 1
	/// )
	measure 'Overall Score (1–4) (Latest)' =
			
			VAR Total = [Total % of Possible (Latest)]   // 0–1
			RETURN
			SWITCH (
			    TRUE (),
			    ISBLANK ( Total ), BLANK (),
			    Total < 0.6, 4,
			    Total < 0.7, 3,
			    Total < 0.8, 2,
			    1
