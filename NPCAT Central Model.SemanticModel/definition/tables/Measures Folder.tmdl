	/// && 'KS1 Teacher Assessments'[Grade]
	/// IN { "EXS", "GDS" }
	/// || 'KS1 Teacher Assessments'[Assessment Name] = "Writing"
	/// && 'KS1 Teacher Assessments'[Grade]
	/// IN { "EXS", "GDS" }
	/// || 'KS1 Teacher Assessments'[Assessment Name] = "Mathematics"
	/// && 'KS1 Teacher Assessments'[Grade] IN { "EXS", "GDS" }
	/// ),
	/// 'KS1 Teacher Assessments'[Globally Unique ID],
	/// "Distinct_Count", DISTINCTCOUNT ( 'KS1 Teacher Assessments'[Assessment Name] )
	/// ),
	/// [Distinct_Count] = 3
	/// )
	/// )
	/// VAR __KS1Pupils =
	/// DISTINCTCOUNT ( 'KS1 Teacher Assessments'[Globally Unique ID] )
	/// RETURN
	/// IF (
	/// ISBLANK ( DIVIDE ( __RWMCount, __KS1Pupils ) ),
	/// IF ( ISBLANK ( __KS1Pupils ), BLANK (), 0 ),
	/// DIVIDE ( __RWMCount, __KS1Pupils )
	/// )
	measure 'KS1 EXS+% - CRWM TA' =
			
			VAR __RWMCount =
			    COUNTROWS (
			        FILTER (
			            SUMMARIZE (
			                FILTER (
			                    'KS1 Teacher Assessments',
			                    'KS1 Teacher Assessments'[Assessment Name] = "Reading"
			                        && 'KS1 Teacher Assessments'[Grade]
			                        IN { "EXS", "GDS" }
			                            || 'KS1 Teacher Assessments'[Assessment Name] = "Writing"
			                            && 'KS1 Teacher Assessments'[Grade]
			                            IN { "EXS", "GDS" }
			                                || 'KS1 Teacher Assessments'[Assessment Name] = "Mathematics"
			                                && 'KS1 Teacher Assessments'[Grade] IN { "EXS", "GDS" }
			                ),
			                'KS1 Teacher Assessments'[Globally Unique ID],
			                "Distinct_Count", DISTINCTCOUNT ( 'KS1 Teacher Assessments'[Assessment Name] )
			            ),
			            [Distinct_Count] = 3
			        )
			    )
			VAR __KS1Pupils =
			    DISTINCTCOUNT ( 'KS1 Teacher Assessments'[Globally Unique ID] )
			RETURN
			    IF (
