	/// [% Students (1-3 Decile) (2025)]          -- returns 0.72, 0.93 etc (NOT 72, 93)
	/// )
	/// VAR _pad = 0.1                    -- 1 percentage point padding
	/// VAR _raw = _minVal - _pad
	/// -- Round down to whole % and put a sensible floor so it never drops to 0
	/// RETURN
	/// //MAX(0.60,
	/// ROUND(_raw , 2)
	/// 
	measure 'Indicies 1-3 Axis Min (Local Authority)' = ```
			
			VAR _minVal =
			    MINX(
			        ALLSELECTED('School Database'[Local Authority]),
			        [% Students (1-3 Decile) (2025)]          -- returns 0.72, 0.93 etc (NOT 72, 93)
			    )
			VAR _pad = 0.1                    -- 1 percentage point padding
			VAR _raw = _minVal - _pad
			-- Round down to whole % and put a sensible floor so it never drops to 0
			RETURN 
			//MAX(0.60, 
			ROUND(_raw , 2)
			
			```
		displayFolder: Student Measures\IDACI Measures\2025 IDACI
		lineageTag: 5069cd76-851b-4d78-b5fb-cf53d2477064

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// 
	/// VAR _minVal =
	/// MINX(
	/// ALLSELECTED('Student Year Groups'[Year Group]),
	/// [% Students (1-3 Decile) (2025)]          -- returns 0.72, 0.93 etc (NOT 72, 93)
	/// )
	/// VAR _pad = 0.1                    -- 1 percentage point padding
	/// VAR _raw = _minVal - _pad
	/// -- Round down to whole % and put a sensible floor so it never drops to 0
	/// RETURN
	/// //MAX(0.60,
	/// ROUND(_raw , 2)
	/// 
	measure 'Indicies 1-3 Axis Min (Year Group)' = ```
			
			VAR _minVal =
			    MINX(
			        ALLSELECTED('Student Year Groups'[Year Group]),
			        [% Students (1-3 Decile) (2025)]          -- returns 0.72, 0.93 etc (NOT 72, 93)
			    )
			VAR _pad = 0.1                    -- 1 percentage point padding
			VAR _raw = _minVal - _pad
			-- Round down to whole % and put a sensible floor so it never drops to 0
			RETURN 
			//MAX(0.60, 
			ROUND(_raw , 2)
			
			```
		displayFolder: Student Measures\IDACI Measures\2025 IDACI
		lineageTag: e25cb772-b95f-4218-9379-ad43a51cadc3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// 
	/// VAR _LastDate =
	/// CALCULATE ( MAX ( 'Calendar'[Date] ), DATEADD ( 'Calendar'[Date], -1, YEAR ) )
	/// VAR _Table =
	/// FILTER (
	/// 'Student Indicies',
	/// NOT ( [Rank] = "Undefined" )
	/// && 'Student Indicies'[RELEASE_YEAR] = 2025 && 'Student Indicies'[Category] = "IDACI"
	/// )
	/// VAR _TableWithRank =
	/// ADDCOLUMNS ( _Table, "RankValue", VALUE ( 'Student Indicies'[Rank] ) )
	/// RETURN
	/// CALCULATE (
	/// AVERAGEX ( _TableWithRank, VALUE ( [Rank] ) ),
	/// 'Student Indicies'[Category] = "IDACI",
	/// 'Student Database (Full)'[DOA] <= _LastDate,
	/// 'Student Database (Full)'[Leaving date] > _LastDate
	/// || ISBLANK ( 'Student Database (Full)'[Leaving date] ),
	/// 'Calendar'[Date] = _LastDate
	/// )
	measure 'IDACI Rank PY (2025)' =
			
			VAR _LastDate =
			    CALCULATE ( MAX ( 'Calendar'[Date] ), DATEADD ( 'Calendar'[Date], -1, YEAR ) )
			VAR _Table =
			    FILTER (
			        'Student Indicies',
			        NOT ( [Rank] = "Undefined" )
			            && 'Student Indicies'[RELEASE_YEAR] = 2025 && 'Student Indicies'[Category] = "IDACI"
			    )
			VAR _TableWithRank =
			    ADDCOLUMNS ( _Table, "RankValue", VALUE ( 'Student Indicies'[Rank] ) )
			RETURN
			    CALCULATE (
			        AVERAGEX ( _TableWithRank, VALUE ( [Rank] ) ),
			        'Student Indicies'[Category] = "IDACI",
			        'Student Database (Full)'[DOA] <= _LastDate,
			        'Student Database (Full)'[Leaving date] > _LastDate
			            || ISBLANK ( 'Student Database (Full)'[Leaving date] ),
			        'Calendar'[Date] = _LastDate
			    )
		displayFolder: Student Measures\IDACI Measures\2025 IDACI\PY
		lineageTag: 5139aad2-b295-48e8-a7ba-c4abe793b05b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

