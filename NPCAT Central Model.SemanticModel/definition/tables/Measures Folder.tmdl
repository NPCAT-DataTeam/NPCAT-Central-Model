	/// 
	/// VAR _Cutoff = [Dynamic Max Date]
	/// RETURN
	/// CALCULATE (
	/// SUM ( Creditors[Value] ),
	/// //ALL( Creditors ),
	/// ALL ( 'Calendar' ),
	/// //Creditors[Status] IN { "O","D" } &&
	/// Creditors[Invoice Date] <= _Cutoff
	/// && (
	/// ISBLANK ( Creditors[Pay Date] )
	/// || Creditors[Pay Date] > _Cutoff
	/// )
	/// )
	measure 'AP Balance (£)' =
			
			VAR _Cutoff = [Dynamic Max Date]
			RETURN
			    CALCULATE (
			        SUM ( Creditors[Value] ),
			        //ALL( Creditors ),
			        ALL ( 'Calendar' ),
			        //Creditors[Status] IN { "O","D" } &&
			        Creditors[Invoice Date] <= _Cutoff
			            && (
			                ISBLANK ( Creditors[Pay Date] )
			                    || Creditors[Pay Date] > _Cutoff
			            )
			    )
		formatString: "£"#,0.0;-"£"#,0.0;"£"#,0.0
		displayFolder: Finance Measures\Creditors
		lineageTag: b70ca13b-8d3c-42da-9a30-c213eb086599

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	/// 
	/// CALCULATE ( [AP Balance (£)], SAMEPERIODLASTYEAR ( 'Calendar'[Date] ) )
	measure 'AP Balance SPLY (£)' =
			
			CALCULATE ( [AP Balance (£)], SAMEPERIODLASTYEAR ( 'Calendar'[Date] ) )
		formatString: "£"#,0.0;-"£"#,0.0;"£"#,0.0
		displayFolder: Finance Measures\Creditors
		lineageTag: 48e9e7d8-eb27-4faa-8bc0-3ecf0631e6c4

	/// 
	/// CALCULATE ( [AP Balance (£)], DATEADD ( 'Calendar'[Date], -1, MONTH ) )
	measure 'AP Balance SPLM (£)' =
			
			CALCULATE ( [AP Balance (£)], DATEADD ( 'Calendar'[Date], -1, MONTH ) )
		formatString: "£"#,0.0;-"£"#,0.0;"£"#,0.0
		displayFolder: Finance Measures\Creditors
		lineageTag: 2c7916a6-cb88-44ad-be76-9cafe25e2fb2

	/// 
	/// [AP Balance (£)] - [AP Balance SPLM (£)]
	measure 'MoM AP Balance (£)' =
			
			[AP Balance (£)] - [AP Balance SPLM (£)]
		formatString: "£"#,0.0;-"£"#,0.0;"£"#,0.0
		displayFolder: Finance Measures\Creditors
		lineageTag: 6dd91b6a-06b3-4b95-8e07-c9460874b736

	/// 
	/// DIVIDE ( [AP Balance (£)] - [AP Balance SPLY (£)], [AP Balance SPLY (£)] )
	measure 'YoY AP Balance %' =
			
			DIVIDE ( [AP Balance (£)] - [AP Balance SPLY (£)], [AP Balance SPLY (£)] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Finance Measures\Creditors
		lineageTag: a326d869-9a45-4b77-881c-d971149ea806

	/// 
	/// CALCULATE (
	/// [AP Balance (£)],
	/// DATESINPERIOD ( 'Calendar'[Date], MAX ( 'Calendar'[Date] ), -12, MONTH )
	/// )
	measure 'Rolling 12 M AP Balance (£)' =
			
			CALCULATE (
			    [AP Balance (£)],
			    DATESINPERIOD ( 'Calendar'[Date], MAX ( 'Calendar'[Date] ), -12, MONTH )
			)
		formatString: "£"#,0.0;-"£"#,0.0;"£"#,0.0
		displayFolder: Finance Measures\Creditors
		lineageTag: c71939f4-b186-43cf-af42-44c1d792c762

	/// 
	/// VAR _Cutoff = [Dynamic Max Date]
	/// RETURN
	/// CALCULATE (
	/// DISTINCTCOUNT ( Creditors[Invoice ID] ),
	/// REMOVEFILTERS ( Calendar[Date] ),
	/// Creditors[Invoice Date] <= _Cutoff
	/// && (
	/// ISBLANK ( Creditors[Pay Date] )
	/// || Creditors[Pay Date] > _Cutoff
	/// )
	/// )
	measure 'Invoices Open' =
			
			VAR _Cutoff = [Dynamic Max Date]
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( Creditors[Invoice ID] ),
			        REMOVEFILTERS ( Calendar[Date] ),
			        Creditors[Invoice Date] <= _Cutoff
			            && (
			                ISBLANK ( Creditors[Pay Date] )
			                    || Creditors[Pay Date] > _Cutoff
			            )
			    )
		formatString: 0
		displayFolder: Finance Measures\Creditors
