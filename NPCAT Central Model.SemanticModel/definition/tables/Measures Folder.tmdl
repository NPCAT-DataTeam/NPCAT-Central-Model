	/// 
	/// VAR Schools = COUNTROWS('School Database')
	/// VAR LA =
	/// CALCULATE(AVERAGE('LA Indicies'[Decile]),
	/// TREATAS(
	/// VALUES('Student Indicies'[Category]),
	/// 'LA Indicies'[Category]
	/// ),
	/// 'LA Indicies'[RELEASE_YEAR] = "2025",
	/// 'LA Indicies'[Indicies Region] <> "Trust"
	/// )
	/// 
	/// RETURN
	/// IF(Schools=1,FORMAT(LA,"0.0"),"N/A")
	measure 'LA Indicies (2025)' = ```
			
			VAR Schools = COUNTROWS('School Database')
			VAR LA = 
			    CALCULATE(AVERAGE('LA Indicies'[Decile]),
			        TREATAS(
			        VALUES('Student Indicies'[Category]), 
			        'LA Indicies'[Category]
			        ),
			        'LA Indicies'[RELEASE_YEAR] = "2025",
			        'LA Indicies'[Indicies Region] <> "Trust"
			       )
			
			RETURN
			        IF(Schools=1,FORMAT(LA,"0.0"),"N/A")
			```
		displayFolder: Student Measures\IDACI Measures\2025 IDACI\Comparisons
		lineageTag: 15f8d58a-14c4-4542-adcd-facd57911766

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// 
	/// VAR _Category = SELECTEDVALUE('Student Indicies'[Category])
	/// RETURN
	/// CALCULATE(AVERAGE('LA Indicies'[Decile]),
	/// TREATAS(
	/// VALUES('Student Indicies'[Category]),
	/// 'LA Indicies'[Category]
	/// ),
	/// 'LA Indicies'[RELEASE_YEAR] = "2025",
	/// REMOVEFILTERS('School Database'),
	/// 'LA Indicies'[Indicies Region] = "Trust"
	/// )
	measure 'Trust Indicies (2025)' = ```
			
			    VAR _Category = SELECTEDVALUE('Student Indicies'[Category])
			RETURN
			    CALCULATE(AVERAGE('LA Indicies'[Decile]),
			        TREATAS(
			        VALUES('Student Indicies'[Category]), 
			        'LA Indicies'[Category]
			        ),
			        'LA Indicies'[RELEASE_YEAR] = "2025",
			        REMOVEFILTERS('School Database'),
			        'LA Indicies'[Indicies Region] = "Trust"
			       )
			```
		displayFolder: Student Measures\IDACI Measures\2025 IDACI\Comparisons
		lineageTag: ec45237a-10ff-4291-82ec-77d1abeafc40

		annotation PBI_FormatHint = {"isGeneralNumber":true}

