	/// )
	/// VAR _Denmonator =
	/// CALCULATE (
	/// COUNT ( 'EYFS ELGs/GLD'[Grade Value] ),
	/// ALLSELECTED ( 'EYFS ELGs/GLD'[Grade Value] ),
	/// 'EYFS ELGs/GLD'[Grade] <> "A"
	/// )
	/// RETURN
	/// IF (
	/// ISBLANK ( DIVIDE ( _Numerator, _Denmonator ) ),
	/// IF ( ISBLANK ( _Denmonator ), BLANK (), 0 ),
	/// DIVIDE ( _Numerator, _Denmonator )
	/// )
