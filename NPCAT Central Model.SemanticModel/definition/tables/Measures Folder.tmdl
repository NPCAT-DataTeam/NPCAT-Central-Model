	/// 
	/// VAR __COMLITTable =
	/// CALCULATETABLE (
	/// SUMMARIZE (
	/// 'EYFS ELGs/GLD',
	/// 'EYFS ELGs/GLD'[Globally Unique ID],
	/// "COM & LIT Total", ROUNDDOWN ( DIVIDE ( SUM ( 'EYFS ELGs/GLD'[Grade Value] ), 10 ), 0 )
	/// ),
	/// 'EYFS ELGs/GLD'[Assessment Name]
	/// IN {
	/// "Listening, Attention and Understanding",
	/// "Speaking",
	/// "Comprehension",
	/// "Word Reading",
	/// "Writing"
	/// },
	/// 'EYFS ELGs/GLD'[Grade] <> "A"
	/// )
	/// VAR __SUM =
	/// SUMX ( __COMLITTable, [COM & LIT Total] )
	/// RETURN
	/// __SUM
	measure 'COM & LIT #' =
			
			VAR __COMLITTable =
			    CALCULATETABLE (
			        SUMMARIZE (
			            'EYFS ELGs/GLD',
			            'EYFS ELGs/GLD'[Globally Unique ID],
			            "COM & LIT Total", ROUNDDOWN ( DIVIDE ( SUM ( 'EYFS ELGs/GLD'[Grade Value] ), 10 ), 0 )
			        ),
			        'EYFS ELGs/GLD'[Assessment Name]
			            IN {
			                "Listening, Attention and Understanding",
			                "Speaking",
			                "Comprehension",
			                "Word Reading",
			                "Writing"
			            },
			        'EYFS ELGs/GLD'[Grade] <> "A"
			    )
			VAR __SUM =
			    SUMX ( __COMLITTable, [COM & LIT Total] )
			RETURN
			    __SUM
		displayFolder: Statutory EYFS
		lineageTag: 384b162e-2a3b-4fa6-8f8b-a9262072efbb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// 
	/// VAR _COMLITCount = [COM & LIT #]
	/// VAR _Denmonator =
	/// CALCULATE (
	/// DISTINCTCOUNT ( 'EYFS ELGs/GLD'[Globally Unique ID] ),
	/// 'EYFS ELGs/GLD'[Grade] <> "A"
	/// )
	/// RETURN
	/// IF (
	/// ISBLANK ( DIVIDE ( _COMLITCount, _Denmonator ) ),
	/// IF ( ISBLANK ( _Denmonator ), BLANK (), 0 ),
	/// DIVIDE ( _COMLITCount, _Denmonator )
	/// )
	measure 'COM & LIT Exp %' =
			
			VAR _COMLITCount = [COM & LIT #]
			VAR _Denmonator =
			    CALCULATE (
			        DISTINCTCOUNT ( 'EYFS ELGs/GLD'[Globally Unique ID] ),
			        'EYFS ELGs/GLD'[Grade] <> "A"
			    )
			RETURN
			    IF (
			        ISBLANK ( DIVIDE ( _COMLITCount, _Denmonator ) ),
			        IF ( ISBLANK ( _Denmonator ), BLANK (), 0 ),
			        DIVIDE ( _COMLITCount, _Denmonator )
			    )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Statutory EYFS
		lineageTag: bd70b9d3-ed62-4ef4-8afc-31567e4b1895

