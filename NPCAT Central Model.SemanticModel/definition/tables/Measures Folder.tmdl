	/// 
	/// CALCULATE (
	/// DIVIDE (
	/// CALCULATE (
	/// COUNTA ( 'Catholic Standards Scores'[Answer] ),
	/// 'Catholic Standards Scores'[Answer] IN { "Yes" }
	/// ) + 0,
	/// CALCULATE (
	/// COUNTA ( 'Catholic Standards Scores'[Answer] ),
	/// 'Catholic Standards Scores'[Answer] IN { "Yes", "Not Met", "Partial" }
	/// )
	/// ),
	/// 'Catholic Standards Scores'[QA Offset] = 0
	/// )
	measure 'Catholic QA Compliance % (Most Recent QA)' =
			
			CALCULATE (
			    DIVIDE (
			        CALCULATE (
			            COUNTA ( 'Catholic Standards Scores'[Answer] ),
			            'Catholic Standards Scores'[Answer] IN { "Yes" }
			        ) + 0,
			        CALCULATE (
			            COUNTA ( 'Catholic Standards Scores'[Answer] ),
			            'Catholic Standards Scores'[Answer] IN { "Yes", "Not Met", "Partial" }
			        )
			    ),
			    'Catholic Standards Scores'[QA Offset] = 0
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Catholic QA Measures
		lineageTag: dcfae47d-7231-44cb-bcf5-01d532695969

	/// 
	/// VAR _MaxDate =
	/// MAX ( 'Calendar'[Date] )
	/// VAR _SENComplianceTable =
	/// CALCULATETABLE (
	/// SUMMARIZE (
	/// 'Catholic Standards Scores',
	/// 'Catholic Standards Visits'[SUID],
	/// "Numerator",
	/// CALCULATE (
	/// COUNTA ( 'Catholic Standards Scores'[Answer] ),
	/// 'Catholic Standards Scores'[Answer] IN { "Yes" },
	/// 'Catholic Standards Visits'[Date of Review] = MAX('Catholic Standards Visits'[Date of Review])
	/// ) + 0,
	/// "Denomiator",
	/// CALCULATE (
	/// COUNTA ( 'Catholic Standards Scores'[Answer] ),
	/// 'Catholic Standards Scores'[Answer] IN { "Yes", "Not Met", "Partial" },
	/// 'Catholic Standards Visits'[Date of Review] = MAX('Catholic Standards Visits'[Date of Review])
	/// )
	/// ),
	/// ALL ( 'Calendar' ),
	/// 'Catholic Standards Visits'[Date of Review] <= _MaxDate
	/// )
	/// VAR _Result =
	/// CALCULATE (
	/// DIVIDE (
	/// SUMX ( _SENComplianceTable, [Numerator] ),
	/// SUMX ( _SENComplianceTable, [Denomiator] )
	/// )
	/// )
	/// RETURN
	/// _Result
	measure 'Catholic QA Compliance % (Over Time)' =
			
			VAR _MaxDate =
			    MAX ( 'Calendar'[Date] )
			VAR _SENComplianceTable =
			    CALCULATETABLE (
			        SUMMARIZE (
			            'Catholic Standards Scores',
			            'Catholic Standards Visits'[SUID],
			            "Numerator",
			                CALCULATE (
			                    COUNTA ( 'Catholic Standards Scores'[Answer] ),
			                    'Catholic Standards Scores'[Answer] IN { "Yes" },
			                    'Catholic Standards Visits'[Date of Review] = MAX('Catholic Standards Visits'[Date of Review])
			                ) + 0,
			            "Denomiator",
			                CALCULATE (
			                    COUNTA ( 'Catholic Standards Scores'[Answer] ),
			                    'Catholic Standards Scores'[Answer] IN { "Yes", "Not Met", "Partial" },
			                    'Catholic Standards Visits'[Date of Review] = MAX('Catholic Standards Visits'[Date of Review])
			                )
			        ),
			        ALL ( 'Calendar' ),
			        'Catholic Standards Visits'[Date of Review] <= _MaxDate
			    )
			VAR _Result =
			    CALCULATE (
			        DIVIDE (
			            SUMX ( _SENComplianceTable, [Numerator] ),
			            SUMX ( _SENComplianceTable, [Denomiator] )
			        )
			    )
			RETURN
			    _Result
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Catholic QA Measures
		lineageTag: 76a5c360-88fc-4619-b9eb-7fc1b42c6b97

	/// 
	/// CALCULATE (
	/// DIVIDE (
	/// CALCULATE (
	/// COUNTA ( 'Catholic Standards Scores'[Answer] ),
	/// 'Catholic Standards Scores'[Answer] IN { "Yes" }
	/// ) + 0,
	/// CALCULATE (
	/// COUNTA ( 'Catholic Standards Scores'[Answer] ),
	/// 'Catholic Standards Scores'[Answer] IN { "Yes", "Not Met", "Partial" }
	/// )
	/// ),
	/// 'Catholic Standards Scores'[QA Offset] = -1
	/// )
	measure 'Catholic QA Compliance % (Previous QA)' =
			
			CALCULATE (
			    DIVIDE (
			        CALCULATE (
			            COUNTA ( 'Catholic Standards Scores'[Answer] ),
			            'Catholic Standards Scores'[Answer] IN { "Yes" }
			        ) + 0,
			        CALCULATE (
			            COUNTA ( 'Catholic Standards Scores'[Answer] ),
			            'Catholic Standards Scores'[Answer] IN { "Yes", "Not Met", "Partial" }
			        )
			    ),
			    'Catholic Standards Scores'[QA Offset] = -1
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Catholic QA Measures
		lineageTag: 52b632a7-e35d-4881-96ac-d518ed6dd88d

	/// 
