	/// 
	/// COUNTROWS (
	/// FILTER (
	/// SUMMARIZE (
	/// FILTER (
	/// 'Primary Summative Marks (South)',
	/// 'Primary Summative Marks (South)'[Area of Learning] = "Communication and Language"
	/// && 'Primary Summative Marks (South)'[Grade Points] = 3
	/// || 'Primary Summative Marks (South)'[Area of Learning] = "Personal, Social & Emotional Development"
	/// && 'Primary Summative Marks (South)'[Grade Points] = 3
	/// || 'Primary Summative Marks (South)'[Area of Learning] = "Physical Development"
	/// && 'Primary Summative Marks (South)'[Grade Points] = 3
	/// ),
	/// 'Primary Summative Marks (South)'[Globally Unique Student ID],
	/// 'Primary Summative Marks (South)'[Academic Year Start],
	/// "Distinct_Count", DISTINCTCOUNT ( 'Primary Summative Marks (South)'[Area of Learning] )
	/// ),
	/// [Distinct_Count] = 3
	/// )
	/// )
	measure '1. Prime AOLs' =
			
			COUNTROWS (
			    FILTER (
			        SUMMARIZE (
			            FILTER (
			                'Primary Summative Marks (South)',
			                'Primary Summative Marks (South)'[Area of Learning] = "Communication and Language"
			                    && 'Primary Summative Marks (South)'[Grade Points] = 3
			                    || 'Primary Summative Marks (South)'[Area of Learning] = "Personal, Social & Emotional Development"
			                    && 'Primary Summative Marks (South)'[Grade Points] = 3
			                    || 'Primary Summative Marks (South)'[Area of Learning] = "Physical Development"
			                    && 'Primary Summative Marks (South)'[Grade Points] = 3
			            ),
			            'Primary Summative Marks (South)'[Globally Unique Student ID],
			            'Primary Summative Marks (South)'[Academic Year Start],
			            "Distinct_Count", DISTINCTCOUNT ( 'Primary Summative Marks (South)'[Area of Learning] )
			        ),
			        [Distinct_Count] = 3
			    )
			)
		displayFolder: Primary Summative(South)
		lineageTag: 3f9ca043-5d3a-474e-80dc-3b29ea0dfa78

		annotation PBI_FormatHint = {"isGeneralNumber":true}

