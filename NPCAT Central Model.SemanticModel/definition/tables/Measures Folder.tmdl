	/// 
	/// VAR _MaxWeekOffset =
	/// MAX ( 'Calendar'[CurWeekOffset] )
	/// VAR _PW =
	/// MAX ( 'Calendar'[CurWeekOffset] ) - 1
	/// VAR _PreviousPeriod =
	/// CALCULATE (
	/// [Absence Insurance Claims Count],
	/// FILTER ( ALL ( 'Calendar' ), 'Calendar'[CurWeekOffset] = _PW )
	/// )
	/// VAR _CW =
	/// CALCULATE (
	/// [Absence Insurance Claims Count],
	/// 'Calendar'[CurWeekOffset] = _MaxWeekOffset
	/// )
	/// RETURN
	/// _CW - _PreviousPeriod
	measure 'Absence Insurance WoW' =
			
			VAR _MaxWeekOffset =
			    MAX ( 'Calendar'[CurWeekOffset] )
			VAR _PW =
			    MAX ( 'Calendar'[CurWeekOffset] ) - 1
			VAR _PreviousPeriod =
			    CALCULATE (
			        [Absence Insurance Claims Count],
			        FILTER ( ALL ( 'Calendar' ), 'Calendar'[CurWeekOffset] = _PW )
			    )
			VAR _CW =
			    CALCULATE (
			        [Absence Insurance Claims Count],
			        'Calendar'[CurWeekOffset] = _MaxWeekOffset
			    )
			RETURN
			    _CW - _PreviousPeriod
		formatString: #,0
		displayFolder: Unused
		lineageTag: aa3f5944-aecb-4a6e-a4f6-80315fdc41e9

		changedProperty = FormatString

