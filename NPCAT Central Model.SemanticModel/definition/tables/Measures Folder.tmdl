	/// 
	/// VAR _Denominator =
	/// CALCULATE (
	/// IF (
	/// [Students on Roll] < [# GLD Predictions],
	/// [# GLD Predictions],
	/// [Students on Roll]
	/// ),
	/// 'Student Year Groups'[Year Group] = "Reception"
	/// )
	/// VAR _final =
	/// DIVIDE ( [# GLD Predictions], _Denominator )
	/// RETURN
	/// _final
	measure '% GLD Completion Rate' =
			
			VAR _Denominator =
			    CALCULATE (
			        IF (
			            [Students on Roll] < [# GLD Predictions],
			            [# GLD Predictions],
			            [Students on Roll]
			        ),
			        'Student Year Groups'[Year Group] = "Reception"
			    )
			VAR _final =
			    DIVIDE ( [# GLD Predictions], _Denominator )
			RETURN
			    _final
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Primary Predictions\Predictions EYFS
		lineageTag: c0d518d0-cb26-4233-8746-a437c7cdaba9

	/// 
	/// VAR _Numerator =
	/// CALCULATE (
	/// [# KS1 Predictions],
	/// 'Primary Statutory Predictions'[ASSESSMENT_NAME] = "KS1 Maths"
	/// )
	/// VAR _Denominator =
	/// CALCULATE (
	/// IF (
	/// [Students on Roll] < [# KS1 Predictions],
	/// [# KS1 Predictions],
	/// [Students on Roll]
	/// ),
	/// 'Student Year Groups'[Year Group] = "Year 2",
	/// 'Primary Statutory Predictions'[ASSESSMENT_NAME] = "KS1 Maths"
	/// )
	/// VAR _final =
	/// DIVIDE ( _Numerator, _Denominator )
	/// RETURN
	/// _final
	measure '% KS1 Completion Rate - Maths' =
			
			VAR _Numerator =
			    CALCULATE (
			        [# KS1 Predictions],
			        'Primary Statutory Predictions'[ASSESSMENT_NAME] = "KS1 Maths"
			    )
			VAR _Denominator =
			    CALCULATE (
			        IF (
			            [Students on Roll] < [# KS1 Predictions],
			            [# KS1 Predictions],
			            [Students on Roll]
			        ),
			        'Student Year Groups'[Year Group] = "Year 2",
			        'Primary Statutory Predictions'[ASSESSMENT_NAME] = "KS1 Maths"
			    )
			VAR _final =
			    DIVIDE ( _Numerator, _Denominator )
			RETURN
			    _final
