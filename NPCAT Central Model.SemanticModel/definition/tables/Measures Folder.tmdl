	/// 
	/// VAR _Year = MAX('Calendar'[Current School Year Offset])
	/// VAR _Today = CALCULATE(MIN(Calendar[Date]),'Calendar'[Current School Year Offset] = _Year)
	/// RETURN
	/// CALCULATE(
	/// DISTINCTCOUNT('AP Placements'[STUDENT_UNIQUE_ID]),
	/// 'AP Placements'[End Date] >= _Today ||
	/// ISBLANK('AP Placements'[End Date])
	/// )
	measure 'Total AP Pupils' =
			
			VAR _Year = MAX('Calendar'[Current School Year Offset])
			VAR _Today = CALCULATE(MIN(Calendar[Date]),'Calendar'[Current School Year Offset] = _Year)
			RETURN
			CALCULATE(
			    DISTINCTCOUNT('AP Placements'[STUDENT_UNIQUE_ID]),
			    'AP Placements'[End Date] >= _Today ||
			    ISBLANK('AP Placements'[End Date])
			)
		displayFolder: AP Students
		lineageTag: ba69e699-5843-4098-b9ab-e53241df50a6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// 
	/// AVERAGEX(
	/// FILTER(
	/// 'AP Placements',
	/// NOT ISBLANK('AP Placements'[End Date])
	/// ),
	/// NETWORKDAYS(
	/// 'AP Placements'[Start Date],
	/// 'AP Placements'[End Date]
	/// )
	/// )
	measure 'Average Placement Duration' =
			
			AVERAGEX(
			    FILTER(
			        'AP Placements',
			        NOT ISBLANK('AP Placements'[End Date])
			    ),
			    NETWORKDAYS(
			        'AP Placements'[Start Date],
			        'AP Placements'[End Date]
			    )
			)
		displayFolder: AP Students
		lineageTag: a6c5a6cc-f64a-45a9-88ce-0d0cad00f499

		annotation PBI_FormatHint = {"isGeneralNumber":true}

