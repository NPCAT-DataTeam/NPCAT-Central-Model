			VAR _1plus =
			    CALCULATE (
			        [Staff Employed (Time)],
			        NOT 'Boxphish Staff Rating'[Course Incomplete Bracket] IN { "0", BLANK () }
			    )
			VAR _Staff = [Staff Employed (Time)]
			RETURN
			    DIVIDE ( _1plus, _Staff )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Boxphish
		lineageTag: 08ce131d-9ffa-4757-bf71-893e294fe175

