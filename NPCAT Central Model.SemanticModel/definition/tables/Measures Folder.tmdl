	/// 
	/// IF (
	/// OR ( ISBLANK ( [COM & LIT Exp % CY] ), ISBLANK ( [COM & LIT Exp % PY] ) ),
	/// "",
	/// [COM & LIT Exp % CY] - [COM & LIT Exp % PY]
	/// )
	measure 'COM & LIT Exp % YoY' =
			
			IF (
			    OR ( ISBLANK ( [COM & LIT Exp % CY] ), ISBLANK ( [COM & LIT Exp % PY] ) ),
			    "",
			    [COM & LIT Exp % CY] - [COM & LIT Exp % PY]
			)
		formatString: 0.0%;-0.0%;0.0%
