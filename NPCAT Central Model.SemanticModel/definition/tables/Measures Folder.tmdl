	/// CALCULATE (
	/// DIVIDE (
	/// CALCULATE ( COUNTA ( 'Attendance'[Mark] ), 'Attendance'[Mark] IN { "R" } ),
	/// SUM ( 'Attendance'[Sessions] )
	/// ),
	/// 'Calendar'[FutureDate] IN { "Past" }
