	/// 
	/// COUNTROWS (
	/// FILTER (
	/// VALUES ( 'Student Database (Full)'[Globally Unique Student ID] ),
	/// AND (
	/// AND ( [Attendance Percentage YTD] <= 1, [Attendance Percentage YTD] >= 0.97 ),
	/// CALCULATE ( SUM ( Attendance[Sessions] ) >= 1 )
	/// )
	/// )
	/// )
	measure 'Students With Good Attendance (100% - 97%)' =
			
			COUNTROWS (
			    FILTER (
			        VALUES ( 'Student Database (Full)'[Globally Unique Student ID] ),
			        AND (
			            AND ( [Attendance Percentage YTD] <= 1, [Attendance Percentage YTD] >= 0.97 ),
			            CALCULATE ( SUM ( Attendance[Sessions] ) >= 1 )
			        )
			    )
			)
		formatString: 0
		displayFolder: Attendance Measures
		lineageTag: dcb76cf4-779f-40a0-9aad-f685ec460c96

	/// 
	/// COUNTROWS (
	/// FILTER (
	/// VALUES ( 'Student Database (Full)'[Globally Unique Student ID] ),
	/// AND (
	/// [Attendance Percentage YTD] < 0.97,
	/// AND (
	/// [Attendance Percentage YTD] >= 0.94,
	/// CALCULATE ( SUM ( Attendance[Sessions] ) >= 1 )
	/// )
	/// )
	/// )
	/// )
	measure 'Students With Attendance Showing Emerging Concerns (97% - 94%)' =
			
			COUNTROWS (
			    FILTER (
			        VALUES ( 'Student Database (Full)'[Globally Unique Student ID] ),
			        AND (
			            [Attendance Percentage YTD] < 0.97,
			            AND (
