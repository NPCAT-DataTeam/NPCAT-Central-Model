			                                        RETURN
			                                            itemscombined & UNICHAR ( ( 10 ) )
			                                                & --Pupil Premium
			                                                IF (
			                                                    ISFILTERED ( 'Student Database (Full)'[Pupil Premium Indicator(Short)] ),
			                                                    VAR items =
			                                                        VALUES ( 'Student Database (Full)'[Pupil Premium Indicator(Short)] )
			                                                    VAR itemscombined =
			                                                        CONCATENATEX (
			                                                            items,
			                                                            'Student Database (Full)'[Pupil Premium Indicator(Short)],
			                                                            UNICHAR ( 10 )
			                                                        )
			                                                    RETURN
			                                                        itemscombined & UNICHAR ( ( 10 ) )
			                                                            & --SEN Stauts
			                                                            IF (
			                                                                ISFILTERED ( 'Student Database (Full)'[SEN Status(Short)] ),
			                                                                VAR items =
			                                                                    VALUES ( 'Student Database (Full)'[SEN Status(Short)] )
			                                                                VAR itemscombined =
			                                                                    CONCATENATEX (
			                                                                        items,
			                                                                        'Student Database (Full)'[SEN Status(Short)],
			                                                                        UNICHAR ( 10 )
			                                                                    )
			                                                                RETURN
			                                                                    itemscombined & UNICHAR ( ( 10 ) )
			                                                                        & --Prior Attainemnt
			                                                                        IF (
			                                                                            ISFILTERED ( 'Student Database (Full)'[Prior Attainment] ),
			                                                                            VAR items =
			                                                                                VALUES ( 'Student Database (Full)'[Prior Attainment] )
			                                                                            VAR itemscombined =
			                                                                                CONCATENATEX (
			                                                                                    items,
			                                                                                    'Student Database (Full)'[Prior Attainment],
			                                                                                    UNICHAR ( 10 )
			                                                                                )
			                                                                            RETURN
			                                                                                itemscombined & UNICHAR ( ( 10 ) )
			                                                                        )
			                                                            )
			                                                )
			                                    )
			                        )
			            )
			)
