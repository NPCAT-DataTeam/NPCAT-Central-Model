	/// 
	/// VAR _StudentCount =
	/// CALCULATE (
	/// DISTINCTCOUNT ( 'EYFS ELGs/GLD'[Globally Unique ID] ),
	/// 'EYFS ELGs/GLD'[Grade] <> "A"
	/// )
	/// VAR _YearCount =
	/// DISTINCTCOUNT ( 'EYFS ELGs/GLD'[Academic Year] )
	/// RETURN
	/// DIVIDE ( _StudentCount, _YearCount )
	measure 'EYFS No. Pupils (Included in Calc)' =
			
			VAR _StudentCount =
			    CALCULATE (
			        DISTINCTCOUNT ( 'EYFS ELGs/GLD'[Globally Unique ID] ),
			        'EYFS ELGs/GLD'[Grade] <> "A"
			    )
			VAR _YearCount =
			    DISTINCTCOUNT ( 'EYFS ELGs/GLD'[Academic Year] )
			RETURN
			    DIVIDE ( _StudentCount, _YearCount )
		formatString: 0
		displayFolder: Statutory EYFS
