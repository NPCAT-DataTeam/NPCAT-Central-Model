	/// )
	/// RETURN
	/// IF ( ISBLANK ( __PREV_MONTH ), 0, [Suspension MTD] - __PREV_MONTH )
	measure 'Suspension Students MoM Change' =
			
			VAR __PREV_MONTH =
			    CALCULATE (
			        [Suspension Students MTD],
