	/// 'Management Accounts'[Management Grouping]
	/// IN { "B0", "B1", "B2", "B3", "B4", "B5", "B6" }
	/// || 'Management Accounts'[CoreNominal] IN { "5164", "5167", "5175", "5185" }
	/// )
	/// )
	measure 'Forecast Total Staff Cost' =
			
			CALCULATE (
			    SUM ( 'Management Accounts'[Forecast (Full Year)] ),
			    FILTER (
			        'Management Accounts',
			        'Management Accounts'[Management Grouping]
			            IN { "B0", "B1", "B2", "B3", "B4", "B5", "B6" }
			                || 'Management Accounts'[CoreNominal] IN { "5164", "5167", "5175", "5185" }
			    )
			)
		displayFolder: Finance Measures\2. Forecast Expenditure
		lineageTag: 0e669825-8c8e-40a4-8017-32a47109519c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

