	/// 
	/// CALCULATE (
	/// [MTC No. Pupils],
	/// FILTER (
	/// CALCULATETABLE (
	/// SUMMARIZE ( 'MTC', 'MTC'[Mark Groups Sort], 'MTC'[Mark Groups] ),
	/// ALLSELECTED ( 'MTC' )
	/// ),
	/// ISONORAFTER (
	/// 'MTC'[Mark Groups Sort], MIN ( 'MTC'[Mark Groups Sort] ), ASC,
	/// 'MTC'[Mark Groups], MIN ( 'MTC'[Mark Groups] ), ASC
	/// )
	/// )
	/// )
	measure 'MTC No. Pupils Reverse running total in Mark Groups' =
			
			CALCULATE (
			    [MTC No. Pupils],
			    FILTER (
			        CALCULATETABLE (
			            SUMMARIZE ( 'MTC', 'MTC'[Mark Groups Sort], 'MTC'[Mark Groups] ),
			            ALLSELECTED ( 'MTC' )
			        ),
			        ISONORAFTER (
			            'MTC'[Mark Groups Sort], MIN ( 'MTC'[Mark Groups Sort] ), ASC,
			            'MTC'[Mark Groups], MIN ( 'MTC'[Mark Groups] ), ASC
			        )
