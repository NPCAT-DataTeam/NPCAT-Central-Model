	/// VAR __SelectedGrade =
	/// SELECTEDVALUE ( 'KS4 Distinct Grades'[Grade Sort] )
	/// VAR __GradeCount =
	/// IF (
	/// ISBLANK ( [Number of Grades] ),
	/// CALCULATE ( [Number of Grades], ALL ( 'KS4 Distinct Grades' ) )
	/// - CALCULATE ( [Number of Grades], ALL ( 'KS4 Distinct Grades' ) ),
	/// [Number of Grades]
	/// )
	/// VAR __CumulativeGradeStaging =
	/// CALCULATE (
	/// [Number of Grades],
	/// ALL ( 'KS4 Distinct Grades' ),
	/// 'KS4 Distinct Grades'[Grade Sort] >= __SelectedGrade
	/// )
	/// VAR __CumulativeGrade =
	/// IF (
	/// ISBLANK ( __CumulativeGradeStaging ),
	/// CALCULATE ( [Number of Grades], ALL ( 'KS4 Distinct Grades' ) )
	/// - CALCULATE ( [Number of Grades], ALL ( 'KS4 Distinct Grades' ) ),
	/// __CumulativeGradeStaging
	/// )
	/// VAR __GradePercent =
	/// IF (
	/// ISBLANK ( [Number of Grades] ),
	/// CALCULATE ( [Number of Grades], ALL ( 'KS4 Distinct Grades' ) )
	/// - CALCULATE ( [Number of Grades], ALL ( 'KS4 Distinct Grades' ) ),
	/// DIVIDE (
	/// [Number of Grades],
	/// CALCULATE (
	/// [Number of Grades],
	/// REMOVEFILTERS ( 'KS4 Assessments'[Grade], 'KS4 Assessments'[Grade Sort] ),
	/// ALL ( 'KS4 Distinct Grades' )
	/// )
	/// )
	/// )
	/// VAR __CumulativePercentage =
	/// DIVIDE (
	/// __CumulativeGrade,
	/// CALCULATE ( [Number of Grades], ALL ( 'KS4 Distinct Grades' ) )
	/// )
	/// VAR __SelectedDynamic =
	/// SELECTEDVALUE ( 'zP KS4 Grade Distribution'[KS4 Grade Distribution Order] )
	/// RETURN
	/// SWITCH (
	/// TRUE (),
	/// __SelectedDynamic = 0, __GradeCount,
	/// __SelectedDynamic = 1, __CumulativeGrade,
	/// __SelectedDynamic = 2, __GradePercent,
	/// __SelectedDynamic = 3, __CumulativePercentage
	/// )
	measure 'KS4 Dynamic Grade Distribution Measure' =
			VAR __SelectedGrade =
			    SELECTEDVALUE ( 'KS4 Distinct Grades'[Grade Sort] )
			VAR __GradeCount =
			    IF (
			        ISBLANK ( [Number of Grades] ),
			        CALCULATE ( [Number of Grades], ALL ( 'KS4 Distinct Grades' ) )
			            - CALCULATE ( [Number of Grades], ALL ( 'KS4 Distinct Grades' ) ),
			        [Number of Grades]
			    )
			VAR __CumulativeGradeStaging =
			    CALCULATE (
			        [Number of Grades],
			        ALL ( 'KS4 Distinct Grades' ),
			        'KS4 Distinct Grades'[Grade Sort] >= __SelectedGrade
			    )
			VAR __CumulativeGrade =
			    IF (
			        ISBLANK ( __CumulativeGradeStaging ),
			        CALCULATE ( [Number of Grades], ALL ( 'KS4 Distinct Grades' ) )
			            - CALCULATE ( [Number of Grades], ALL ( 'KS4 Distinct Grades' ) ),
			        __CumulativeGradeStaging
			    )
			VAR __GradePercent =
			    IF (
			        ISBLANK ( [Number of Grades] ),
			        CALCULATE ( [Number of Grades], ALL ( 'KS4 Distinct Grades' ) )
			            - CALCULATE ( [Number of Grades], ALL ( 'KS4 Distinct Grades' ) ),
			        DIVIDE (
			            [Number of Grades],
			            CALCULATE (
			                [Number of Grades],
			                REMOVEFILTERS ( 'KS4 Assessments'[Grade], 'KS4 Assessments'[Grade Sort] ),
			                ALL ( 'KS4 Distinct Grades' )
			            )
			        )
			    )
			VAR __CumulativePercentage =
			    DIVIDE (
			        __CumulativeGrade,
			        CALCULATE ( [Number of Grades], ALL ( 'KS4 Distinct Grades' ) )
			    )
			VAR __SelectedDynamic =
			    SELECTEDVALUE ( 'zP KS4 Grade Distribution'[KS4 Grade Distribution Order] )
			RETURN
			    SWITCH (
			        TRUE (),
			        __SelectedDynamic = 0, __GradeCount,
			        __SelectedDynamic = 1, __CumulativeGrade,
			        __SelectedDynamic = 2, __GradePercent,
			        __SelectedDynamic = 3, __CumulativePercentage
			    )
		displayFolder: KS4 Assessment\KS4 Subject
		lineageTag: 9bc0978e-57e0-41f2-a09d-a2f49699174b

		formatStringDefinition =
				VAR __SelectedDynamic =
				    SELECTEDVALUE ( 'zP KS4 Grade Distribution'[KS4 Grade Distribution Order] )
				RETURN
				    SWITCH (
				        TRUE (),
				        __SelectedDynamic = 0, "0;-0;0",
				        __SelectedDynamic = 1, "0;-0;0",
				        __SelectedDynamic = 2, "0.0%;-0.0%;0.0%",
				        __SelectedDynamic = 3, "0.0%;-0.0%;0.0%"
				    )

