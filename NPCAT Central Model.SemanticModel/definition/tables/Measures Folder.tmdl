	/// 
	/// VAR _minVal =
	/// MINX(
	/// ALLSELECTED('Student Indicies'[Decile]),
	/// [Attendance Percentage YTD]          -- returns 0.72, 0.93 etc (NOT 72, 93)
	/// )
	/// VAR _pad = 0.05                    -- 1 percentage point padding
	/// VAR _raw = _minVal - _pad
	/// -- Round down to whole % and put a sensible floor so it never drops to 0
	/// RETURN
	/// //MAX(0.60,
	/// ROUND(_raw , 2)
	/// 
	measure 'Attendance Axis Min (Indicies Decile)' = ```
			
			VAR _minVal =
			    MINX(
			        ALLSELECTED('Student Indicies'[Decile]),
			        [Attendance Percentage YTD]          -- returns 0.72, 0.93 etc (NOT 72, 93)
			    )
			VAR _pad = 0.05                    -- 1 percentage point padding
			VAR _raw = _minVal - _pad
			-- Round down to whole % and put a sensible floor so it never drops to 0
			RETURN 
			//MAX(0.60, 
			ROUND(_raw , 2)
			
			```
		displayFolder: Attendance Measures
		lineageTag: 649c3aa4-cbfd-447b-8c42-f1fd7d95b4d7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// 
	/// VAR CurrentYearOffset =
	/// MAX ( 'Calendar'[Current School Year Offset] )
	/// VAR LastYear = CurrentYearOffset - 1
	/// RETURN
	/// CALCULATE (
	/// [Mobile %],
	/// 'Calendar'[Current School Year Offset] = LastYear,
	/// REMOVEFILTERS ( 'Calendar'[School Year] )
	/// )
	measure 'Mobile % Prev Year' =
			
			VAR CurrentYearOffset =
			    MAX ( 'Calendar'[Current School Year Offset] )
			VAR LastYear = CurrentYearOffset - 1
			RETURN
			    CALCULATE (
			        [Mobile %],
			        'Calendar'[Current School Year Offset] = LastYear,
			        REMOVEFILTERS ( 'Calendar'[School Year] )
			    )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Student Measures
		lineageTag: 86f4d413-7ee4-4596-8e51-71c6c3b584f9

