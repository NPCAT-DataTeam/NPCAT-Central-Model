	/// VAR _LastDate =
	/// MAX ( 'Calendar'[Date] )
	/// VAR _Offset =
	/// MAX ( 'Calendar'[Current School Year Offset] )
	/// RETURN
	/// CALCULATE (
	/// DISTINCTCOUNT ( 'AP Placements'[AP Name] ),
	/// 'Student Database (Full)'[DOA] <= _LastDate,
	/// 'Student Database (Full)'[Leaving date] >= _LastDate
	/// || ISBLANK ( 'Student Database (Full)'[Leaving date] ),
	/// //'Calendar'[Current School Year Offset] = _Offset,
	/// 'AP Placements'[End Date] >= _LastDate || ISBLANK('AP Placements'[End Date]),
	/// ISBLANK('AP Placements'[AP School Name])=false
	/// )
	measure 'AP Schools' =
			VAR _LastDate =
			    MAX ( 'Calendar'[Date] )
			VAR _Offset =
			    MAX ( 'Calendar'[Current School Year Offset] )
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( 'AP Placements'[AP Name] ),
			        'Student Database (Full)'[DOA] <= _LastDate,
			        'Student Database (Full)'[Leaving date] >= _LastDate
			            || ISBLANK ( 'Student Database (Full)'[Leaving date] ),
			        //'Calendar'[Current School Year Offset] = _Offset,
			        'AP Placements'[End Date] >= _LastDate || ISBLANK('AP Placements'[End Date]),
			        ISBLANK('AP Placements'[AP School Name])=false
			    )
		displayFolder: AP Students
		lineageTag: b7f53752-62f6-459b-8918-89154dbd99a9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// VAR _LastDate =
	/// MAX ( 'Calendar'[Date] )
	/// VAR _Offset =
	/// MAX ( 'Calendar'[Current School Year Offset] )
	/// RETURN
	/// CALCULATE (
	/// DISTINCTCOUNT ( 'AP Placements'[AP Name] ),
	/// 'Student Database (Full)'[DOA] <= _LastDate,
	/// 'Student Database (Full)'[Leaving date] >= _LastDate
	/// || ISBLANK ( 'Student Database (Full)'[Leaving date] ),
	/// //'Calendar'[Current School Year Offset] = _Offset,
	/// 'AP Placements'[End Date] >= _LastDate && 'AP Placements'[Start Date] <= _LastDate,
	/// ISBLANK('AP Placements'[Company Name])=false
	/// )
	measure Companies =
			VAR _LastDate =
			    MAX ( 'Calendar'[Date] )
			VAR _Offset =
			    MAX ( 'Calendar'[Current School Year Offset] )
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( 'AP Placements'[AP Name] ),
			        'Student Database (Full)'[DOA] <= _LastDate,
			        'Student Database (Full)'[Leaving date] >= _LastDate
			            || ISBLANK ( 'Student Database (Full)'[Leaving date] ),
			        //'Calendar'[Current School Year Offset] = _Offset,
			        'AP Placements'[End Date] >= _LastDate && 'AP Placements'[Start Date] <= _LastDate,
			        ISBLANK('AP Placements'[Company Name])=false
			    )
		displayFolder: AP Students
		lineageTag: 6b6071a3-3464-487a-a908-9a1e09832136

		annotation PBI_FormatHint = {"isGeneralNumber":true}

