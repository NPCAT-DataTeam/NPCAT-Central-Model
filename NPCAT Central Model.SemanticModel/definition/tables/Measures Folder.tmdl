	/// 
	/// VAR SelectedSchoolType =
	/// SELECTEDVALUE ( 'School Database'[School Type] )
	/// RETURN
	/// SWITCH (
	/// TRUE (),
	/// SelectedSchoolType = "Primary", 0.135,
	/// SelectedSchoolType = "Secondary", 0.243,
	/// 0.187
	/// )
	measure 'DfE Target Persistent Absence %' =
			
			VAR SelectedSchoolType =
			    SELECTEDVALUE ( 'School Database'[School Type] )
			RETURN
			    SWITCH (
			        TRUE (),
			        SelectedSchoolType = "Primary", 0.139,
			        SelectedSchoolType = "Secondary", 0.242,
			        0.191
			    )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Persistent Absence
