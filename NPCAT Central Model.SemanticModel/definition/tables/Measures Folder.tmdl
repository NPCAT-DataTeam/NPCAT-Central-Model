	/// 
	/// CALCULATE (
	/// SUM ( 'Management Accounts'[Forecast (Full Year)] ),
	/// FILTER (
	/// 'Management Accounts',
	/// NOT ( 'Management Accounts'[Management Grouping]
	/// IN { "B0", "B1", "B2", "B3", "B4", "B5", "B6", "C0", "C1", "D0" }
	/// || 'Management Accounts'[CoreNominal]
	/// IN { "3210", "3205" }
	/// || 'Management Accounts'[Expense Department]
	/// IN {
	/// "Income",
	/// "Teaching Resources",
	/// "Teaching Staff",
	/// "Premises (Including Staff Costs)",
	/// "Leadership Staff",
	/// "Other Staff Costs",
	/// "Education Support Staff",
	/// "Administrative and Clerical Staff"
	/// } )
	/// )
	/// )
	measure 'Forecast Other Cost' =
			
			CALCULATE (
			    SUM ( 'Management Accounts'[Forecast (Full Year)] ),
			    FILTER (
			        'Management Accounts',
			        NOT ( 'Management Accounts'[Management Grouping]
			            IN { "B0", "B1", "B2", "B3", "B4", "B5", "B6", "C0", "C1", "D0" }
			                || 'Management Accounts'[CoreNominal]
			                IN { "3210", "3205" }
			                    || 'Management Accounts'[Expense Department]
			                    IN {
			                        "Income",
			                        "Teaching Resources",
			                        "Teaching Staff",
			                        "Premises (Including Staff Costs)",
			                        "Leadership Staff",
			                        "Other Staff Costs",
			                        "Education Support Staff",
			                        "Administrative and Clerical Staff"
			                    } )
			    )
			)
		displayFolder: Finance Measures\2. Forecast Expenditure
		lineageTag: c4c6c618-8c11-4b77-8826-fc0ac5a4b51f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

