	/// 
	/// VAR _LastDate =
	/// CALCULATE (
	/// LASTDATE ( 'Calendar'[Date] ),
	/// 'Calendar'[Current School Year Offset] = 0
	/// )
	/// VAR _Final =
	/// CALCULATE (
	/// DISTINCTCOUNT ( 'Employee Job Roles'[Employee ID] ),
	/// 'Employee Job Roles'[Property Start Date] <= _LastDate,
	/// 'Employee Job Roles'[Post End Date] > _LastDate
	/// || ISBLANK ( 'Employee Job Roles'[Post End Date] )
	/// )
	/// RETURN
	/// _Final
	measure 'Staff Employed (Time) Current School Year' =
			
			VAR _LastDate =
			    CALCULATE (
			        LASTDATE ( 'Calendar'[Date] ),
			        'Calendar'[Current School Year Offset] = 0
			    )
			VAR _Final =
			    CALCULATE (
			        DISTINCTCOUNT ( 'Employee Job Roles'[Employee ID] ),
			        'Employee Job Roles'[Property Start Date] <= _LastDate,
			        'Employee Job Roles'[Post End Date] > _LastDate
			            || ISBLANK ( 'Employee Job Roles'[Post End Date] )
			    )
			RETURN
			    _Final
		formatString: 0
		displayFolder: Unused
		lineageTag: 6cbd98af-5b52-4108-af74-7ed08eaeb0b9

