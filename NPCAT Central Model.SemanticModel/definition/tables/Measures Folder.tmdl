	/// 
	/// IF ( SELECTEDVALUE ( Employees[Next Of Kin (1) Relationship] ) = "", 1, 0 )
	measure 'Next of Kin Relationship Conditional Formatting' =
			
			IF ( SELECTEDVALUE ( Employees[Next Of Kin (1) Relationship] ) = "", 1, 0 )
		formatString: 0
		displayFolder: Every HR Checks
		lineageTag: 90a58242-fe89-44c7-8f84-d043aaa35f65

	/// 
	/// IF (
	/// LEN ( SELECTEDVALUE ( 'Employees'[Next Of Kin (1) Mobile] ) ) <> 11
	/// && LEN ( SELECTEDVALUE ( Employees[Next Of Kin (1) Phone] ) ) <> 11,
	/// 1,
	/// 0
	/// )
	measure 'Next of Kin Mobile/Phone Conditional Formatting' =
			
			IF (
			    LEN ( SELECTEDVALUE ( 'Employees'[Next Of Kin (1) Mobile] ) ) <> 11
			        && LEN ( SELECTEDVALUE ( Employees[Next Of Kin (1) Phone] ) ) <> 11,
			    1,
			    0
			)
		formatString: 0
		displayFolder: Every HR Checks
		lineageTag: aaa51bbb-ea30-4e18-b9a0-800e2697406b

