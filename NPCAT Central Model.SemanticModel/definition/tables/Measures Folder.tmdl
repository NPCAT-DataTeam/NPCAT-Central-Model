	/// 
	/// VAR _LastDate =
	/// MAX ( 'Calendar'[Date] )
	/// RETURN
	/// CALCULATE (
	/// DISTINCTCOUNT ( 'Student Indicies'[Globally Unique Student ID] ),
	/// 'Student Indicies'[RELEASE_YEAR] = 2019,
	/// 'Student Database (Full)'[DOA] <= _LastDate,
	/// 'Student Database (Full)'[Leaving date] >= _LastDate
	/// || ISBLANK ( 'Student Database (Full)'[Leaving date] ),
	/// 'Calendar'[Date] = _LastDate
	/// )
	measure 'Students on Roll (IDACI) (2019)' =
			
			VAR _LastDate =
			    MAX ( 'Calendar'[Date] )
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( 'Student Indicies'[Globally Unique Student ID] ),
			        'Student Indicies'[RELEASE_YEAR] = 2019,
			        'Student Database (Full)'[DOA] <= _LastDate,
			        'Student Database (Full)'[Leaving date] >= _LastDate
			            || ISBLANK ( 'Student Database (Full)'[Leaving date] ),
			        'Calendar'[Date] = _LastDate
			    )
		formatString: 0
		displayFolder: Student Measures\IDACI Measures\2019 IDACI
		lineageTag: 5248e2f4-b2f5-4dd9-b20a-3b7931a1a339

		annotation PBI_FormatHint = {"isGeneralNumber":true}

