	/// 
	/// VAR StaffList =
	/// CONCATENATEX (
	/// VALUES ( Employees[Full Name] ),
	/// Employees[Full Name],
	/// ", ",
	/// Employees[Full Name], ASC
	/// )
	/// RETURN
	/// IF (
	/// ISBLANK ( StaffList ),
	/// "No staff selected",
	/// StaffList
	/// )
	measure 'Selected Staff' =
			
			VAR StaffList =
			    CONCATENATEX (
			        VALUES ( Employees[Full Name] ),
			        Employees[Full Name],
			        ", ",
			        Employees[Full Name], ASC
			    )
			RETURN
			IF (
			    ISBLANK ( StaffList ),
			    "No staff selected",
			    StaffList
			)
