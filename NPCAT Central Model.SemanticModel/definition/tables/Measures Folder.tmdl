	/// 
	/// VAR __PREV_MONTH =
	/// CALCULATE (
	/// [Attendance Percentage MTD],
	/// DATEADD ( 'Calendar'[Date], -1, MONTH )
	/// )
	/// RETURN
	/// IF ( ISBLANK ( __PREV_MONTH ), 0, [Attendance Percentage MTD] - __PREV_MONTH )
	measure 'Attendance Percentage MTD MoM Change' =
			
			VAR __PREV_MONTH =
			    CALCULATE (
			        [Attendance Percentage MTD],
			        DATEADD ( 'Calendar'[Date], -1, MONTH )
			    )
			RETURN
			    IF ( ISBLANK ( __PREV_MONTH ), 0, [Attendance Percentage MTD] - __PREV_MONTH )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Attendance Measures
		lineageTag: d0796612-ffcc-4692-ab36-7f0bf96d9efe

