	/// 
	/// VAR SubjectAvgGradePoints =
	/// AVERAGE ( 'KS4 Assessments'[Pts] )
	/// VAR AverageGradePoints =
	/// CALCULATE (
	/// AVERAGE ( 'KS4 Assessments'[Pts] ),
	/// 'KS4 Assessments'[Combined Science 2 Check] = "No",
	/// REMOVEFILTERS (
	/// 'KS4 Assessments'[Grade],
	/// 'KS4 Assessments'[Grade Sort],
	/// 'KS4 Assessments'[Subject],
	/// 'KS4 Assessments'[Subject-Gradeset],
	/// 'KS4 Assessments'[P8 Slot],
	/// 'KS4 Assessments'[P8 Slot Sort],
	/// 'KS4 Assessments'[Pts],
	/// 'KS4 Assessments'[Grade KPI]
	/// )
	/// )
	/// VAR AllStudentAverageGradePoints =
	/// CALCULATE (
	/// AVERAGE ( 'KS4 Assessments'[Pts] ),
	/// 'KS4 Assessments'[Combined Science 2 Check] = "No",
	/// REMOVEFILTERS (
	/// 'KS4 Assessments'[Grade],
	/// 'KS4 Assessments'[Grade Sort],
	/// 'KS4 Assessments'[Subject],
	/// 'KS4 Assessments'[Subject-Gradeset],
	/// 'KS4 Assessments'[P8 Slot],
	/// 'KS4 Assessments'[P8 Slot Sort],
	/// 'KS4 Assessments'[Pts],
	/// 'KS4 Assessments'[Grade KPI]
	/// ),
	/// REMOVEFILTERS ( 'Student Database (Full)' )
	/// )
	/// VAR FinalResult =
	/// IF (
	/// ISINSCOPE ( 'KS4 Assessments'[P8 Slot] ),
	/// SubjectAvgGradePoints - AverageGradePoints,
	/// AverageGradePoints - AllStudentAverageGradePoints
	/// )
	/// RETURN
	/// IF ( ISBLANK ( SubjectAvgGradePoints ), BLANK (), FinalResult )
	measure 'Student Residual Grade' =
			
			VAR SubjectAvgGradePoints =
			    AVERAGE ( 'KS4 Assessments'[Pts] )
			VAR AverageGradePoints =
			    CALCULATE (
			        AVERAGE ( 'KS4 Assessments'[Pts] ),
			        'KS4 Assessments'[Combined Science 2 Check] = "No",
			        REMOVEFILTERS (
			            'KS4 Assessments'[Grade],
			            'KS4 Assessments'[Grade Sort],
			            'KS4 Assessments'[Subject],
			            'KS4 Assessments'[Subject-Gradeset],
			            'KS4 Assessments'[P8 Slot],
			            'KS4 Assessments'[P8 Slot Sort],
			            'KS4 Assessments'[Pts],
			            'KS4 Assessments'[Grade KPI]
			        )
			    )
			VAR AllStudentAverageGradePoints =
			    CALCULATE (
			        AVERAGE ( 'KS4 Assessments'[Pts] ),
			        'KS4 Assessments'[Combined Science 2 Check] = "No",
			        REMOVEFILTERS (
			            'KS4 Assessments'[Grade],
			            'KS4 Assessments'[Grade Sort],
			            'KS4 Assessments'[Subject],
			            'KS4 Assessments'[Subject-Gradeset],
			            'KS4 Assessments'[P8 Slot],
			            'KS4 Assessments'[P8 Slot Sort],
			            'KS4 Assessments'[Pts],
			            'KS4 Assessments'[Grade KPI]
			            ),
			        REMOVEFILTERS ( 'Student Database (Full)' )
			    )
			VAR FinalResult =
			    IF (
			        ISINSCOPE ( 'KS4 Assessments'[P8 Slot] ),
			        SubjectAvgGradePoints - AverageGradePoints,
			        AverageGradePoints - AllStudentAverageGradePoints
			    )
			RETURN
			    IF ( ISBLANK ( SubjectAvgGradePoints ), BLANK (), FinalResult )
		displayFolder: KS4 Assessment\KS4 Subject
		lineageTag: 8309d83c-0032-4028-9e66-76215019fe8a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

