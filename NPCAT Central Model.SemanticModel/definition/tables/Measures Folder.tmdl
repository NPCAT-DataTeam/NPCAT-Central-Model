	/// 
	/// VAR _Numerator =
	/// CALCULATE (
	/// COUNTROWS ( 'Purchasing Details' ),
	/// 'Purchasing Details'[GRN Process Compliance] <> "Red"
	/// )
	/// VAR _Denominator =
	/// CALCULATE (
	/// COUNTROWS ( 'Purchasing Details' ),
	/// ALL (
	/// 'Purchasing Details'[GRN Process Compliance],
	/// 'Purchasing Details'[GRN Process Compliance (Sort)]
	/// )
	/// )
	/// RETURN
	/// DIVIDE ( IF ( ISBLANK ( _Numerator ), 0, _Numerator ), _Denominator )
	measure 'GRN Process Compliance %' =
			
			VAR _Numerator =
			    CALCULATE (
			        COUNTROWS ( 'Purchasing Details' ),
			        'Purchasing Details'[GRN Process Compliance] <> "Red"
			    )
			VAR _Denominator =
			    CALCULATE (
			        COUNTROWS ( 'Purchasing Details' ),
			        ALL (
			            'Purchasing Details'[GRN Process Compliance],
			            'Purchasing Details'[GRN Process Compliance (Sort)]
			        )
			    )
			RETURN
			    DIVIDE ( IF ( ISBLANK ( _Numerator ), 0, _Numerator ), _Denominator )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Finance Measures\Purchase Process
		lineageTag: d7abec22-dbcb-4ca9-b3fa-c4a49c981d5e

