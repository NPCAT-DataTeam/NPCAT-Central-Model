	/// 
	/// COUNTA ( Accidents[Accident Category] )
	measure Accidents =
			
			COUNTA ( Accidents[Accident Category] )
		formatString: 0
		displayFolder: Accidents and Near Misses
		lineageTag: 1fb83ac8-0126-4c74-832c-72b1a3b00043

	/// 
	/// VAR __PreviousPeriod =
	/// CALCULATE (
	/// [Accidents],
	/// DATESBETWEEN (
	/// 'Calendar'[Date],
	/// MAX ( 'Calendar'[Date] ) - 60,
	/// MAX ( 'Calendar'[Date] ) - 30
	/// )
	/// )
	/// RETURN
	/// [Accidents Last 30 Days] - __PreviousPeriod
	measure 'Accidents MoM +/-' =
			
			VAR __PreviousPeriod =
			    CALCULATE (
			        [Accidents],
			        DATESBETWEEN (
			            'Calendar'[Date],
			            MAX ( 'Calendar'[Date] ) - 60,
			            MAX ( 'Calendar'[Date] ) - 30
			        )
			    )
			RETURN
			    [Accidents Last 30 Days] - __PreviousPeriod
		formatString: 0
		displayFolder: Accidents and Near Misses
		lineageTag: 31dd2d3c-f73e-4335-ad44-b571306c4a7c

	/// 
	/// CALCULATE (
	/// [Accidents],
	/// DATESBETWEEN (
	/// 'Calendar'[Date],
	/// MAX ( 'Calendar'[Date] ) - 7,
	/// MAX ( 'Calendar'[Date] )
	/// )
	/// )
	measure 'Accidents Last 7 Days' =
			
			CALCULATE (
			    [Accidents],
			    DATESBETWEEN (
			        'Calendar'[Date],
			        MAX ( 'Calendar'[Date] ) - 7,
			        MAX ( 'Calendar'[Date] )
			    )
			)
		formatString: 0
		displayFolder: Accidents and Near Misses
		lineageTag: 8ee4dc76-2335-494f-8c12-8d541657d5ed

	/// 
	/// VAR __PreviousPeriod =
	/// CALCULATE (
	/// [Accidents],
	/// DATESBETWEEN (
	/// 'Calendar'[Date],
	/// MAX ( 'Calendar'[Date] ) - 14,
	/// MAX ( 'Calendar'[Date] ) - 7
	/// )
	/// )
	/// RETURN
	/// [Accidents Last 7 Days] - __PreviousPeriod
	measure 'Accidents WoW +/-' =
			
			VAR __PreviousPeriod =
			    CALCULATE (
			        [Accidents],
			        DATESBETWEEN (
			            'Calendar'[Date],
			            MAX ( 'Calendar'[Date] ) - 14,
			            MAX ( 'Calendar'[Date] ) - 7
			        )
			    )
			RETURN
			    [Accidents Last 7 Days] - __PreviousPeriod
		formatString: 0
		displayFolder: Accidents and Near Misses
		lineageTag: 542abcff-dc36-4ace-a634-960a20fa836e

	/// 
	/// IF (
	/// ISBLANK ( TOTALYTD ( [RIDDORS], 'Calendar'[Date], "31/08" ) ),
	/// 0,
	/// TOTALYTD ( [RIDDORS], 'Calendar'[Date], "31/08" )
	/// )
	measure 'RIDDORS YTD' =
			
			IF (
			    ISBLANK ( TOTALYTD ( [RIDDORS], 'Calendar'[Date], "31/08" ) ),
			    0,
			    TOTALYTD ( [RIDDORS], 'Calendar'[Date], "31/08" )
			)
		formatString: 0
		displayFolder: Accidents and Near Misses
		lineageTag: 8eede1b3-2c5e-42a5-b692-62a0f124329e

	/// 
	/// VAR __MaxDate =
	/// MAX ( 'Calendar'[Current School Year Offset] )
	/// RETURN
	/// CALCULATE ( [Accidents], 'Calendar'[Current School Year Offset] = __MaxDate )
	measure 'Accidents In Period' =
			
			VAR __MaxDate =
			    MAX ( 'Calendar'[Current School Year Offset] )
			RETURN
			    CALCULATE ( [Accidents], 'Calendar'[Current School Year Offset] = __MaxDate )
		formatString: 0
		displayFolder: Accidents and Near Misses
		lineageTag: 65acc0fc-2aef-4690-9c83-51a8bcf28b86

	/// 
	/// VAR __MaxCalendarDate =
	/// MAX ( 'Calendar'[Date] )
	/// VAR __LastSigIncidentDate =
	/// CALCULATE (
	/// MAX ( Accidents[Date of Accident] ),
	/// Accidents[Accident Category] <> "Minor Accident or Injury to a Student"
	/// )
	/// VAR __Result =
	/// DATEDIFF ( __LastSigIncidentDate, __MaxCalendarDate, DAY ) & " days since the last significant accident."
	/// RETURN
	/// IF (
	/// ISBLANK ( __LastSigIncidentDate ),
	/// "No significant accidents reported.",
	/// __Result
	/// )
	measure 'Days Since Last Significant Accident' =
			
			VAR __MaxCalendarDate =
			    MAX ( 'Calendar'[Date] )
			VAR __LastSigIncidentDate =
			    CALCULATE (
			        MAX ( Accidents[Date of Accident] ),
			        Accidents[Accident Category] <> "Minor Accident or Injury to a Student"
			    )
			VAR __Result =
			    DATEDIFF ( __LastSigIncidentDate, __MaxCalendarDate, DAY ) & " days since the last significant accident."
			RETURN
			    IF (
			        ISBLANK ( __LastSigIncidentDate ),
			        "No significant accidents reported.",
			        __Result
			    )
		displayFolder: Accidents and Near Misses
		lineageTag: 43da3c00-128d-4afc-83f6-ebd79c0772a4

	/// 
