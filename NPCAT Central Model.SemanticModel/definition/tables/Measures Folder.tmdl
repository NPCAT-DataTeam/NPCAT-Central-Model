			        'Student Year Groups'[Year Group] = "Year 2",
			        'Primary Statutory Predictions'[ASSESSMENT_NAME] = "KS1 Science"
			    )
			VAR _final =
			    DIVIDE ( _Numerator, _Denominator )
			RETURN
			    _final
