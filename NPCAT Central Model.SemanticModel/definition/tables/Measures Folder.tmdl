	/// 
	/// VAR _LastDate =
	/// MAX ( 'Calendar'[Date] )
	/// RETURN
	/// CALCULATE (
	/// DISTINCTCOUNT ( 'Absences'[Employee ID] ),
	/// 'Absences'[Absence Start Date] <= _LastDate,
	/// 'Absences'[Absence End Date] >= _LastDate
	/// || ISBLANK ( 'Absences'[Absence End Date] ),
	/// CROSSFILTER ( 'Absences'[Absence Start Date], 'Calendar'[Date], NONE ),
	/// 'Absences'[LTS Flag] = "LTS"
	/// )
	measure 'LTS Current Sickness Staff (Count)' =
			
			VAR _LastDate =
			    MAX ( 'Calendar'[Date] )
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( 'Absences'[Employee ID] ),
			        'Absences'[Absence Start Date] <= _LastDate,
			        'Absences'[Absence End Date] >= _LastDate
			            || ISBLANK ( 'Absences'[Absence End Date] ),
			        CROSSFILTER ( 'Absences'[Absence Start Date], 'Calendar'[Date], NONE ),
			        'Absences'[LTS Flag] = "LTS"
			    )
		formatString: 0
		displayFolder: Unused
		lineageTag: a503dd0d-09da-4f61-bc5e-738e3bc90683

