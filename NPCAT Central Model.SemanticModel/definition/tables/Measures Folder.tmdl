	/// 
	/// VAR __Denominator =
	/// DISTINCTCOUNT ( 'Financial Benchmark Data'[URN] )
	/// VAR __Numerator =
	/// CALCULATE (
	/// DISTINCTCOUNT ( 'Financial Benchmark Data'[URN] ),
	/// FILTER (
	/// 'Financial Benchmark Data',
	/// 'Financial Benchmark Data'[Spend on teaching staff as a percentage of total expenditure] <= [Spend on Teaching Staff as % Total Expenditure]
	/// )
	/// )
	/// VAR __NumeratorErrorHandling =
	/// IF ( ISBLANK ( __Numerator ), 1, 0 )
	/// VAR __NumeratorFinal =
	/// IF (
	/// __NumeratorErrorHandling = 0,
	/// __Numerator,
	/// IF (
	/// [Spend on Teaching Staff as % Total Expenditure]
	/// < MIN ( 'Financial Benchmark Data'[Spend on teaching staff as a percentage of total expenditure] ),
	/// 1,
	/// __Denominator
	/// )
	/// )
	/// RETURN
	/// DIVIDE ( __NumeratorFinal, __Denominator ) * 100
	measure 'Forecast Spend on Teaching Staff Percentile' =
			
			VAR __Denominator =
			    DISTINCTCOUNT ( 'Financial Benchmark Data'[URN] )
			VAR __Numerator =
			    CALCULATE (
			        DISTINCTCOUNT ( 'Financial Benchmark Data'[URN] ),
			        FILTER (
			            'Financial Benchmark Data',
			            'Financial Benchmark Data'[Spend on teaching staff as a percentage of total expenditure] <= [Spend on Teaching Staff as % Total Expenditure]
			        )
			    )
			VAR __NumeratorErrorHandling =
			    IF ( ISBLANK ( __Numerator ), 1, 0 )
			VAR __NumeratorFinal =
			    IF (
			        __NumeratorErrorHandling = 0,
			        __Numerator,
			        IF (
			            [Spend on Teaching Staff as % Total Expenditure]
			                < MIN ( 'Financial Benchmark Data'[Spend on teaching staff as a percentage of total expenditure] ),
			            1,
			            __Denominator
			        )
			    )
			RETURN
			    DIVIDE ( __NumeratorFinal, __Denominator ) * 100
		formatString: 0
		displayFolder: Finance Measures\4. Benchmark Percentiles
		lineageTag: 9fbedc80-58c3-468a-ba80-0e3ed13de10e

		annotation PBI_FormatHint = {"isDecimal":true}

	/// 
	/// VAR __Denominator =
	/// DISTINCTCOUNT ( 'Financial Benchmark Data'[URN] )
	/// VAR __Numerator =
	/// CALCULATE (
	/// DISTINCTCOUNT ( 'Financial Benchmark Data'[URN] ),
	/// FILTER (
	/// 'Financial Benchmark Data',
	/// 'Financial Benchmark Data'[Spend on supply staff as a percentage of total expenditure] <= [Spend on Supply Staff as % Total Expenditure]
	/// )
	/// )
	/// VAR __NumeratorErrorHandling =
	/// IF ( ISBLANK ( __Numerator ), 1, 0 )
	/// VAR __NumeratorFinal =
	/// IF (
	/// __NumeratorErrorHandling = 0,
	/// __Numerator,
	/// IF (
	/// [Spend on Supply Staff as % Total Expenditure]
	/// < MIN ( 'Financial Benchmark Data'[Spend on supply staff as a percentage of total expenditure] ),
	/// 1,
	/// __Denominator
	/// )
	/// )
	/// RETURN
	/// IF (
	/// [Spend on Supply Staff as % Total Expenditure] = 0,
	/// 0,
	/// DIVIDE ( __NumeratorFinal, __Denominator ) * 100
	/// )
	measure 'Forecast Spend on Supply Staff Percentile' =
			
			VAR __Denominator =
			    DISTINCTCOUNT ( 'Financial Benchmark Data'[URN] )
			VAR __Numerator =
			    CALCULATE (
			        DISTINCTCOUNT ( 'Financial Benchmark Data'[URN] ),
			        FILTER (
			            'Financial Benchmark Data',
			            'Financial Benchmark Data'[Spend on supply staff as a percentage of total expenditure] <= [Spend on Supply Staff as % Total Expenditure]
			        )
			    )
			VAR __NumeratorErrorHandling =
			    IF ( ISBLANK ( __Numerator ), 1, 0 )
			VAR __NumeratorFinal =
			    IF (
			        __NumeratorErrorHandling = 0,
			        __Numerator,
			        IF (
			            [Spend on Supply Staff as % Total Expenditure]
			                < MIN ( 'Financial Benchmark Data'[Spend on supply staff as a percentage of total expenditure] ),
			            1,
			            __Denominator
			        )
			    )
			RETURN
			    IF (
			        [Spend on Supply Staff as % Total Expenditure] = 0,
			        0,
			        DIVIDE ( __NumeratorFinal, __Denominator ) * 100
			    )
		formatString: 0
		displayFolder: Finance Measures\4. Benchmark Percentiles
		lineageTag: 385194c7-a0d0-4b25-9b26-0cbc98f7829e

		annotation PBI_FormatHint = {"isDecimal":true}

	/// 
	/// VAR __Denominator =
	/// DISTINCTCOUNT ( 'Financial Benchmark Data'[URN] )
	/// VAR __Numerator =
	/// CALCULATE (
