	/// 
	/// VAR _CurrentPeriodIndex =
	/// MAX ( 'Primary Summative Marks (South)'[Assessment Index] )
	/// VAR _PreviousPeriodIndex = _CurrentPeriodIndex - 1
	/// VAR _Previous =
	/// CALCULATE (
	/// [2. At or Above % (Period ARE Target) - CRWM],
	/// REMOVEFILTERS (
	/// 'Primary Summative Marks (South)'[Assessment Index],
	/// 'Primary Summative Marks (South)'[Assessment Period],
	/// 'Primary Summative Marks (South)'[Period Sort],
	/// 'Primary Summative Marks (South)'[Assessment Period Sort]
	/// ),
	/// 'Primary Summative Marks (South)'[Assessment Index] = _PreviousPeriodIndex
	/// )
	/// 
	/// RETURN
	/// _Previous
	measure '2. ARE - At Previous Period Measure - CRWM' =
			
			VAR _CurrentPeriodIndex =
			    MAX ( 'Primary Summative Marks (South)'[Assessment Index] )
			VAR _PreviousPeriodIndex = _CurrentPeriodIndex - 1
			VAR _Previous =
			    CALCULATE (
			        [2. At or Above % (Period ARE Target) - CRWM],
			        REMOVEFILTERS (
			            'Primary Summative Marks (South)'[Assessment Index],
			            'Primary Summative Marks (South)'[Assessment Period],
			            'Primary Summative Marks (South)'[Period Sort],
			            'Primary Summative Marks (South)'[Assessment Period Sort]
			        ),
			        'Primary Summative Marks (South)'[Assessment Index] = _PreviousPeriodIndex
			    )
			
			RETURN
			    _Previous
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Primary Summative(South)
		lineageTag: 7563bdb9-42ef-4725-8fde-11b7fcf312a2

