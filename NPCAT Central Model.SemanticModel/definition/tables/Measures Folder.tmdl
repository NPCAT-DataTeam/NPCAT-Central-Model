	/// 
	/// VAR _LastDate =
	/// MAX ( 'Calendar'[Date] )
	/// VAR _FirstDate =
	/// MIN ( 'Calendar'[Date] )
	/// VAR __Final =
	/// CALCULATE (
	/// SUM ( 'Absence Insurance Claims'[Claimable Days] ),
	/// 'Absence Insurance Claims'[Absence Start Date] >= _FirstDate,
	/// 'Absence Insurance Claims'[Absence Start Date] <= _LastDate,
	/// 'Absence Insurance Claims'[Absence End Date] <= _LastDate
	/// || ISBLANK ( 'Absence Insurance Claims'[Absence End Date] )
	/// )
	/// RETURN
	/// CALCULATE ( __Final )
	measure 'Absence Insurance Total Claimable Days Lost' =
			
			VAR _LastDate =
			    MAX ( 'Calendar'[Date] )
			VAR _FirstDate =
			    MIN ( 'Calendar'[Date] )
			VAR __Final =
			    CALCULATE (
			        SUM ( 'Absence Insurance Claims'[Claimable Days] ),
			        'Absence Insurance Claims'[Absence Start Date] >= _FirstDate,
			        'Absence Insurance Claims'[Absence Start Date] <= _LastDate,
			        'Absence Insurance Claims'[Absence End Date] <= _LastDate
			            || ISBLANK ( 'Absence Insurance Claims'[Absence End Date] )
			    )
			RETURN
			    CALCULATE ( __Final )
		formatString: #,0.0
		displayFolder: Absence Insurance Claims
		lineageTag: 577936c9-5e21-4b36-b63e-8bc04f1ecfc8

		changedProperty = FormatString

