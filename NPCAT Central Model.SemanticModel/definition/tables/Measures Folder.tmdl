	/// 
	/// CALCULATE (
	/// SUM ( 'Management Accounts'[Variance (Full Year)] ),
	/// FILTER (
	/// 'Management Accounts',
	/// NOT ( 'Management Accounts'[Expense Department] IN { "Income" } )
	/// )
	/// )
	measure 'Variance Expenses' =
			
			CALCULATE (
			    SUM ( 'Management Accounts'[Variance (Full Year)] ),
			    FILTER (
			        'Management Accounts',
			        NOT ( 'Management Accounts'[Expense Department] IN { "Income" } )
			    )
			)
		formatString: "£"#,0;-"£"#,0;"£"#,0
		displayFolder: Finance Measures\5. Variance Expenditure
		lineageTag: a47aec59-64f6-4e9a-88a1-30167c0f283b

