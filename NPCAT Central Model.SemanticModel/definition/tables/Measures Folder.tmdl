	/// 
	/// VAR _LastDate =
	/// MAX ( 'Calendar'[Date] )
	/// VAR _Table =
	/// FILTER (
	/// 'Student Indicies',
	/// NOT ( [Rank] = "Undefined" )
	/// && 'Student Indicies'[Category] = "Health"
	/// )
	/// VAR _TableWithRank =
	/// ADDCOLUMNS ( _Table, "RankValue", VALUE ( 'Student Indicies'[Rank] ) )
	/// RETURN
	/// CALCULATE (
	/// AVERAGEX ( _TableWithRank, VALUE ( [Rank] ) ),
	/// 'Student Indicies'[Category] = "Health",
	/// 'Student Database (Full)'[DOA] <= _LastDate,
	/// 'Student Database (Full)'[Leaving date] > _LastDate
	/// || ISBLANK ( 'Student Database (Full)'[Leaving date] ),
	/// 'Calendar'[Date] = _LastDate
	/// )
	measure 'Health Rank' =
			
			VAR _LastDate =
			    MAX ( 'Calendar'[Date] )
			VAR _Table =
			    FILTER (
			        'Student Indicies',
			        NOT ( [Rank] = "Undefined" )
			            && 'Student Indicies'[Category] = "Health"
			    )
			VAR _TableWithRank =
			    ADDCOLUMNS ( _Table, "RankValue", VALUE ( 'Student Indicies'[Rank] ) )
			RETURN
			    CALCULATE (
			        AVERAGEX ( _TableWithRank, VALUE ( [Rank] ) ),
			        'Student Indicies'[Category] = "Health",
			        'Student Database (Full)'[DOA] <= _LastDate,
			        'Student Database (Full)'[Leaving date] > _LastDate
			            || ISBLANK ( 'Student Database (Full)'[Leaving date] ),
			        'Calendar'[Date] = _LastDate
			    )
		formatString: #,##0
		displayFolder: Unused
		lineageTag: bfe602a3-8b16-4899-b66d-587072c05a6a

