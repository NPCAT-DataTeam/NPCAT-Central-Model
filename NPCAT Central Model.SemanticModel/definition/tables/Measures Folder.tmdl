	/// 
	/// 
	/// VAR _Start = MIN('Calendar'[Date])
	/// VAR _End = MAX('Calendar'[Date])
	/// RETURN
	/// 
	/// 
	/// CALCULATE(
	/// SUM('Student Absences'[Sessions Missed]),
	/// 'Student Absences'[Birthday Check]="Yes",
	/// 'Student Year Groups'[Birthday Mark Check] = "Absent over Birthday",
	/// 'Student Absences'[Start Date] >= _Start ||
	/// 'Student Absences'[End Date] >= _Start,
	/// 'Student Absences'[End Date] <=_End
	/// )
	measure 'Sessions Absent Arround BDay' = ```
			
			
			VAR _Start = MIN('Calendar'[Date])
			VAR _End = MAX('Calendar'[Date])
			RETURN
			
			    
			    CALCULATE(
			        SUM('Student Absences'[Sessions Missed]),
			        'Student Absences'[Birthday Check]="Yes",
			        'Student Year Groups'[Birthday Mark Check] = "Absent over Birthday",
			        'Student Absences'[Start Date] >= _Start ||
			        'Student Absences'[End Date] >= _Start,
			        'Student Absences'[End Date] <=_End
			    )
			```
		formatString: 0
		displayFolder: Student Absences
		lineageTag: 22240499-77ed-42f0-9d4f-6888b45d0188

