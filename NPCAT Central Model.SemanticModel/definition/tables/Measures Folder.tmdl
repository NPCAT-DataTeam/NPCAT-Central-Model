	/// 
	/// COUNTROWS(
	/// FILTER(
	/// VALUES('Calendar'[School Week]), -- Iterates week by week
	/// VAR PositivePoints =
	/// CALCULATE(
	/// SUM('Behaviour Points'[Severity]),
	/// 'Behaviour Points'[Severity] > 0
	/// )
	/// VAR NegativePointsCount =
	/// CALCULATE(
	/// COUNTROWS('Behaviour Points'),
	/// 'Behaviour Points'[Severity] < 0
	/// )
	/// RETURN
	/// PositivePoints >= 10 && ISBLANK(NegativePointsCount)
	/// )
	/// )
	measure 'Reward Weeks Count' = ```
			
			COUNTROWS(
			    FILTER(
			        VALUES('Calendar'[School Week]), -- Iterates week by week
			        VAR PositivePoints = 
			            CALCULATE(
			                SUM('Behaviour Points'[Severity]), 
			                'Behaviour Points'[Severity] > 0
			            )
			        VAR NegativePointsCount = 
			            CALCULATE(
			                COUNTROWS('Behaviour Points'), 
			                'Behaviour Points'[Severity] < 0
			            )
			        RETURN
			            PositivePoints >= 10 && ISBLANK(NegativePointsCount)
			    )
			)
			```
		formatString: 0
		displayFolder: Behaviour Measures
		lineageTag: e7328b45-ebe3-4dcb-ae17-b3b474bd4387

