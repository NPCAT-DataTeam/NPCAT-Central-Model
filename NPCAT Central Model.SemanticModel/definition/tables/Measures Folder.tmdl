	/// 
	/// VAR _Yearselector =
	/// MAX ( 'Calendar'[Primary Assessment Year Offset] )
	/// 
	/// RETURN
	/// CALCULATE (
	/// [KS2 Paper %],
	/// 'Calendar'[Primary Assessment Year Offset] = _Yearselector
	/// )
	measure 'KS2 Paper % CY' = ```
			
			VAR _Yearselector =
			    MAX ( 'Calendar'[Primary Assessment Year Offset] )
			    
			RETURN
			    CALCULATE (
			        [KS2 Paper %],
			        'Calendar'[Primary Assessment Year Offset] = _Yearselector
			    )
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Statutory KS2
		lineageTag: 46c98376-a59d-4ce8-be57-99e974dbea2c

	/// 
	/// VAR _Yearselector =
	/// MAX ( 'Calendar'[Primary Assessment Year Offset] ) - 1
	/// VAR _DateSelector =
	/// CALCULATE (
	/// MAX ( 'Calendar'[Date] ),
	/// 'Calendar'[Primary Assessment Year Offset] = _Yearselector
	/// )
	/// RETURN
	/// CALCULATE (
	/// [KS2 Paper %],
	/// ALLEXCEPT ( 'Calendar', 'Calendar'[FutureDate] ),
	/// 'Calendar'[Primary Assessment Year Offset] = _Yearselector
	/// )
	measure 'KS2 Paper % PY' =
			
			VAR _Yearselector =
			    MAX ( 'Calendar'[Primary Assessment Year Offset] ) - 1
			VAR _DateSelector =
			    CALCULATE (
			        MAX ( 'Calendar'[Date] ),
			        'Calendar'[Primary Assessment Year Offset] = _Yearselector
			    )
			RETURN
			    CALCULATE (
			        [KS2 Paper %],
			        ALLEXCEPT ( 'Calendar', 'Calendar'[FutureDate] ),
			        'Calendar'[Primary Assessment Year Offset] = _Yearselector
			    )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Statutory KS2
		lineageTag: 0b5918d5-b39d-4825-aa00-310b36505c83

