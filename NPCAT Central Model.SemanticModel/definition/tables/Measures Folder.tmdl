	/// 
	/// VAR _MaxWeekOffset =
	/// MAX ( 'Calendar'[CurWeekOffset] )
	/// VAR _PW =
	/// MAX ( 'Calendar'[CurWeekOffset] ) - 1
	/// VAR _PreviousPeriod =
	/// CALCULATE (
	/// [General Absence (Count)],
	/// FILTER ( ALL ( 'Calendar' ), 'Calendar'[CurWeekOffset] = _PW )
	/// )
	/// VAR _CW =
	/// CALCULATE (
	/// [General Absence (Count)],
	/// 'Calendar'[CurWeekOffset] = _MaxWeekOffset
	/// )
	/// RETURN
	/// _CW - _PreviousPeriod
	measure 'General Absence WoW' =
			
			VAR _MaxWeekOffset =
			    MAX ( 'Calendar'[CurWeekOffset] )
			VAR _PW =
			    MAX ( 'Calendar'[CurWeekOffset] ) - 1
			VAR _PreviousPeriod =
			    CALCULATE (
			        [General Absence (Count)],
			        FILTER ( ALL ( 'Calendar' ), 'Calendar'[CurWeekOffset] = _PW )
			    )
			VAR _CW =
			    CALCULATE (
			        [General Absence (Count)],
			        'Calendar'[CurWeekOffset] = _MaxWeekOffset
			    )
			RETURN
			    _CW - _PreviousPeriod
		formatString: #,0
		displayFolder: Unused
		lineageTag: 16c99431-e9a8-4d92-9e8f-7bb66717e7df

		changedProperty = FormatString

