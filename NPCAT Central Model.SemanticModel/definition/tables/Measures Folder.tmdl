	/// 
	/// VAR _LastDate =
	/// MAX ( 'Calendar'[Date] )
	/// VAR _Table =
	/// FILTER ( 'Student Indicies', NOT ( [Rank] = "Undefined" ) && 'Student Indicies'[RELEASE_YEAR] = 2025 )
	/// VAR _TableWithRank =
	/// ADDCOLUMNS ( _Table, "RankValue", VALUE ( 'Student Indicies'[Rank] ) )
	/// RETURN
	/// CALCULATE (
	/// AVERAGEX ( _TableWithRank, VALUE ( [Rank] ) ),
	/// 'Student Database (Full)'[DOA] <= _LastDate,
	/// 'Student Database (Full)'[Leaving date] > _LastDate
	/// || ISBLANK ( 'Student Database (Full)'[Leaving date] ),
	/// 'Calendar'[Date] = _LastDate
	/// )
	measure 'Indicies Rank' =
			
			VAR _LastDate =
			    MAX ( 'Calendar'[Date] )
			VAR _Table =
			    FILTER ( 'Student Indicies', NOT ( [Rank] = "Undefined" ) && 'Student Indicies'[RELEASE_YEAR] = 2025 )
			VAR _TableWithRank =
			    ADDCOLUMNS ( _Table, "RankValue", VALUE ( 'Student Indicies'[Rank] ) )
			RETURN
			    CALCULATE (
			        AVERAGEX ( _TableWithRank, VALUE ( [Rank] ) ),
			        'Student Database (Full)'[DOA] <= _LastDate,
			        'Student Database (Full)'[Leaving date] > _LastDate
			            || ISBLANK ( 'Student Database (Full)'[Leaving date] ),
			        'Calendar'[Date] = _LastDate
			    )
		formatString: #,##0
		displayFolder: Student Measures\IDACI Measures\Previous setting
		lineageTag: 6152be60-6f51-42ce-934a-ec07bdb98119

