	/// 
	/// VAR _CurrentPeriodIndex =
	/// MAX ( 'Primary Summative Marks (South)'[Assessment Index] )
	/// VAR _PreviousPeriodIndex = _CurrentPeriodIndex - 1
	/// VAR _Current =
	/// IF (
	/// _CurrentPeriodIndex = 0,
	/// 0,
	/// CALCULATE (
	/// [2. Above % (Period ARE Target) - CRWM],
	/// 'Primary Summative Marks (South)'[Assessment Index] = _CurrentPeriodIndex
	/// ) * 100
	/// )
	/// VAR _Previous =
	/// CALCULATE (
	/// [2. Above % (Period ARE Target) - CRWM],
	/// REMOVEFILTERS (
	/// 'Primary Summative Marks (South)'[Assessment Index],
	/// 'Primary Summative Marks (South)'[Assessment Period],
	/// 'Primary Summative Marks (South)'[Period Sort],
	/// 'Primary Summative Marks (South)'[Assessment Period Sort]
	/// ),
	/// 'Primary Summative Marks (South)'[Assessment Index] = _PreviousPeriodIndex
	/// ) * 100
	/// VAR _Final = _Current - _Previous
	/// RETURN
	/// _Final
	measure '2. ARE - Above Period Offset Measure - CRWM' =
			
			VAR _CurrentPeriodIndex =
			    MAX ( 'Primary Summative Marks (South)'[Assessment Index] )
			VAR _PreviousPeriodIndex = _CurrentPeriodIndex - 1
			VAR _Current =
			    IF (
			        _CurrentPeriodIndex = 0,
			        0,
			        CALCULATE (
			            [2. Above % (Period ARE Target) - CRWM],
			            'Primary Summative Marks (South)'[Assessment Index] = _CurrentPeriodIndex
			        ) * 100
			    )
			VAR _Previous =
			    CALCULATE (
			        [2. Above % (Period ARE Target) - CRWM],
			        REMOVEFILTERS (
			            'Primary Summative Marks (South)'[Assessment Index],
			            'Primary Summative Marks (South)'[Assessment Period],
			            'Primary Summative Marks (South)'[Period Sort],
			            'Primary Summative Marks (South)'[Assessment Period Sort]
			        ),
			        'Primary Summative Marks (South)'[Assessment Index] = _PreviousPeriodIndex
			    ) * 100
			VAR _Final = _Current - _Previous
			RETURN
			    _Final
		formatString: 0.0
		displayFolder: Primary Summative(South)
		lineageTag: 3401089c-4642-4edd-8b9d-1e646b7b1280

		changedProperty = FormatString

	/// 
	/// VAR _CurrentPeriodIndex =
	/// MAX ( 'Primary Summative Marks (South)'[Assessment Index] )
	/// VAR _PreviousPeriodIndex = _CurrentPeriodIndex - 1
	/// VAR _Current =
	/// IF (
	/// _CurrentPeriodIndex = 0,
	/// 0,
	/// CALCULATE (
	/// [2. At or Above % (Period ARE Target) - CRWM],
	/// 'Primary Summative Marks (South)'[Assessment Index] = _CurrentPeriodIndex
	/// ) * 100
	/// )
	/// VAR _Previous =
	/// CALCULATE (
	/// [2. At or Above % (Period ARE Target) - CRWM],
	/// REMOVEFILTERS (
	/// 'Primary Summative Marks (South)'[Assessment Index],
	/// 'Primary Summative Marks (South)'[Assessment Period],
	/// 'Primary Summative Marks (South)'[Period Sort],
	/// 'Primary Summative Marks (South)'[Assessment Period Sort]
	/// ),
	/// 'Primary Summative Marks (South)'[Assessment Index] = _PreviousPeriodIndex
	/// ) * 100
	/// VAR _Final = _Current - _Previous
	/// RETURN
	/// _Final
	measure '2. ARE - At Period Offset Measure - CRWM' =
			
			VAR _CurrentPeriodIndex =
			    MAX ( 'Primary Summative Marks (South)'[Assessment Index] )
			VAR _PreviousPeriodIndex = _CurrentPeriodIndex - 1
			VAR _Current =
			    IF (
			        _CurrentPeriodIndex = 0,
			        0,
			        CALCULATE (
			            [2. At or Above % (Period ARE Target) - CRWM],
			            'Primary Summative Marks (South)'[Assessment Index] = _CurrentPeriodIndex
			        ) * 100
			    )
			VAR _Previous =
			    CALCULATE (
			        [2. At or Above % (Period ARE Target) - CRWM],
			        REMOVEFILTERS (
			            'Primary Summative Marks (South)'[Assessment Index],
			            'Primary Summative Marks (South)'[Assessment Period],
			            'Primary Summative Marks (South)'[Period Sort],
			            'Primary Summative Marks (South)'[Assessment Period Sort]
			        ),
			        'Primary Summative Marks (South)'[Assessment Index] = _PreviousPeriodIndex
			    ) * 100
			VAR _Final = _Current - _Previous
			RETURN
			    _Final
		formatString: 0.0
		displayFolder: Primary Summative(South)
		lineageTag: a64ecb92-c7bc-4074-b019-238aadbe3d62

