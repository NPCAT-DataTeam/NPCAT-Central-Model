	/// MINX (
	/// TOPN (
	/// 1,
	/// ADDCOLUMNS (
	/// VALUES ( 'KS4 Assessments'[Grade] ),
	/// "Frequency", CALCULATE ( COUNT ( 'KS4 Assessments'[Grade] ) )
	/// ),
	/// [Frequency], 0
	/// ),
	/// 'KS4 Assessments'[Grade]
	/// )
	measure 'Mode Grade Value' =
			MINX (
			    TOPN (
			        1,
			        ADDCOLUMNS (
			            VALUES ( 'KS4 Assessments'[Grade] ),
			            "Frequency", CALCULATE ( COUNT ( 'KS4 Assessments'[Grade] ) )
			        ),
			        [Frequency], 0
			    ),
			    'KS4 Assessments'[Grade]
			)
		displayFolder: KS4 Assessment\KS4 Subject
		lineageTag: cc983438-fd72-4f26-ac8e-7355440ac739

