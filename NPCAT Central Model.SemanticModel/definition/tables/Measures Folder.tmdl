	/// 
	/// VAR CutOff = [Dynamic Max Date] // helper = MAX('Calendar'[Date])
	/// VAR InvoicesPaid =
	/// CALCULATE (
	/// // denominator
	/// DISTINCTCOUNT ( Creditors[Invoice ID] ),
	/// REMOVEFILTERS ( Calendar[Date] ),
	/// //Creditors[Invoice Date] <= CutOff &&
	/// //( ISBLANK ( Creditors[Pay Date] ) || Creditors[Pay Date] > CutOff ),
	/// Creditors[Due Date] < CutOff
	/// )
	/// VAR InvoicesPaidOnTime =
	/// CALCULATE (
	/// // numerator
	/// DISTINCTCOUNT ( Creditors[Invoice ID] ),
	/// REMOVEFILTERS ( Calendar[Date] ),
	/// //Creditors[Invoice Date] <= CutOff &&
	/// Creditors[Pay Date] <= CutOff,
	/// Creditors[Pay Date] <= Creditors[Due Date] // on / before due
	/// )
	/// RETURN
	/// DIVIDE ( InvoicesPaidOnTime, InvoicesPaid )
	/// //"Numerator: " & InvoicesPaidOnTime & "  Denominator: " & InvoicesPaid
	measure 'On-time Payment %' =
			
			VAR CutOff = [Dynamic Max Date] // helper = MAX('Calendar'[Date])
			VAR InvoicesPaid =
			    CALCULATE (
			        // denominator
			        DISTINCTCOUNT ( Creditors[Invoice ID] ),
			        REMOVEFILTERS ( Calendar[Date] ),
			        //Creditors[Invoice Date] <= CutOff &&
			        //( ISBLANK ( Creditors[Pay Date] ) || Creditors[Pay Date] > CutOff ),
			        Creditors[Due Date] < CutOff
			    )
			VAR InvoicesPaidOnTime =
			    CALCULATE (
			        // numerator
			        DISTINCTCOUNT ( Creditors[Invoice ID] ),
			        REMOVEFILTERS ( Calendar[Date] ),
			        //Creditors[Invoice Date] <= CutOff &&
			        Creditors[Pay Date] <= CutOff,
			        Creditors[Pay Date] <= Creditors[Due Date] // on / before due
			    )
			RETURN
			    DIVIDE ( InvoicesPaidOnTime, InvoicesPaid )
			//"Numerator: " & InvoicesPaidOnTime & "  Denominator: " & InvoicesPaid
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Finance Measures\Creditors
		lineageTag: fb0afdb1-760e-42db-aab7-175c1755f78d

