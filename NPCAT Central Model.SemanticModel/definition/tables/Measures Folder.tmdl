	/// // VAR _Yearselector = IF(_MaxSchoolMonth<10,_MaxOffset-1,_MaxOffset)-1
	/// VAR _Yearselector =
	/// MAX ( 'Calendar'[Current School Year Offset] ) - 1
	/// RETURN
	/// CALCULATE (
	/// [GLD %],
	/// FILTER (
	/// ALLEXCEPT ( 'Calendar', 'Calendar'[FutureDate] ),
	/// 'Calendar'[Current School Year Offset] = _Yearselector
	/// )
	/// )
	measure 'EYFS GLD % PY' =
			
			// VAR _MaxOffset = MAX('Calendar'[Current School Year Offset])-1
			// VAR _MaxSchoolMonth = MAX('Calendar'[School Month Number])
			// VAR _Yearselector = IF(_MaxSchoolMonth<10,_MaxOffset-1,_MaxOffset)-1
			VAR _Yearselector =
