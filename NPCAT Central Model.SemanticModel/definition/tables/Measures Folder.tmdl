	/// 
	/// CALCULATE (
	/// DIVIDE (
	/// CALCULATE ( SUM( 'Attendance'[Sessions] ), 'Attendance'[Mark] = "H"|| 'Attendance'[Mark] = "G"),
	/// SUM ( 'Attendance'[Sessions] )
	/// )
	/// )
	measure 'Holiday Absence %' =
			
			CALCULATE (
			    DIVIDE (
			        CALCULATE ( SUM( 'Attendance'[Sessions] ), 'Attendance'[Mark] = "H"|| 'Attendance'[Mark] = "G"),
			        SUM ( 'Attendance'[Sessions] )
			    )
