	/// 
	/// VAR __CurrentIndex =
	/// CALCULATE (
	/// MAX ( 'Catholic Standards Visits'[ID] ),
	/// REMOVEFILTERS ( 'Catholic Standards Visits'[QA Offset] )
	/// )
	/// VAR __LastAuditDate =
	/// CALCULATE (
	/// MAX ( 'Catholic Standards Visits'[Date of Review] ),
	/// REMOVEFILTERS ( 'Catholic Standards Visits'[QA Offset] ),
	/// 'Catholic Standards Visits'[ID] = __CurrentIndex
	/// )
	/// RETURN
	/// IF (
	/// ISBLANK ( __LastAuditDate ),
	/// BLANK (),
	/// COUNTROWS ( DATESBETWEEN ( 'Calendar'[Date], __LastAuditDate, TODAY () ) ) - 1
	/// )
	measure 'Days Since Last Catholic QA Audit Date' =
			
			VAR __CurrentIndex =
			    CALCULATE (
			        MAX ( 'Catholic Standards Visits'[ID] ),
			        REMOVEFILTERS ( 'Catholic Standards Visits'[QA Offset] )
			    )
			VAR __LastAuditDate =
			    CALCULATE (
			        MAX ( 'Catholic Standards Visits'[Date of Review] ),
			        REMOVEFILTERS ( 'Catholic Standards Visits'[QA Offset] ),
			        'Catholic Standards Visits'[ID] = __CurrentIndex
			    )
			RETURN
			    IF (
			        ISBLANK ( __LastAuditDate ),
			        BLANK (),
			        COUNTROWS ( DATESBETWEEN ( 'Calendar'[Date], __LastAuditDate, TODAY () ) ) - 1
			    )
		formatString: #,0
		displayFolder: Catholic QA Measures
		lineageTag: 4e70b09d-a1d8-4a15-b1ce-f7d165ed7cc8

	/// 
	/// VAR __MaxDate =
	/// MAX ( 'Catholic Standards Visits'[Date of Review] )
	/// VAR __Numerator =
	/// CALCULATE (
	/// COUNTA ( 'Catholic Standards Scores'[Answer] ),
	/// 'Catholic Standards Scores'[Answer] IN { "Yes" }
	/// )
	/// VAR __Denominator =
	/// CALCULATE (
	/// COUNTA ( 'Catholic Standards Scores'[Answer] ),
	/// 'Catholic Standards Scores'[Answer] IN { "Yes", "Not Met", "Partial" }
	/// )
	/// RETURN
	/// CALCULATE (
	/// IF (
	/// ISBLANK ( [Catholic QA Compliance % (Most Recent QA)] ),
	/// "",
	/// __Numerator & " of " & __Denominator
	/// )
	/// )
	measure 'Catholic QA Activities x of y' =
			
			VAR __MaxDate =
			    MAX ( 'Catholic Standards Visits'[Date of Review] )
			VAR __Numerator =
			    CALCULATE (
			        COUNTA ( 'Catholic Standards Scores'[Answer] ),
			        'Catholic Standards Scores'[Answer] IN { "Yes" }
			    )
			VAR __Denominator =
			    CALCULATE (
			        COUNTA ( 'Catholic Standards Scores'[Answer] ),
			        'Catholic Standards Scores'[Answer] IN { "Yes", "Not Met", "Partial" }
			    )
			RETURN
			    CALCULATE (
			        IF (
			            ISBLANK ( [Catholic QA Compliance % (Most Recent QA)] ),
			            "",
			            __Numerator & " of " & __Denominator
			        )
			    )
		displayFolder: Catholic QA Measures
		lineageTag: cd100995-1e11-426f-ac8e-a1b22baa81d5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// 
