	/// 
	/// VAR Full_AP_Balance = CALCULATE([AP Balance (£)], REMOVEFILTERS(Creditors[Account]))
	/// VAR Top10 =
	/// TOPN ( 10, VALUES ( Creditors[Account] ), [AP Balance (£)] )
	/// RETURN
	/// DIVIDE ( CALCULATE ( [AP Balance (£)], Top10 ), Full_AP_Balance )
	measure 'Top-10 Supplier Share %' =
			
			VAR Full_AP_Balance = CALCULATE([AP Balance (£)], REMOVEFILTERS(Creditors[Account]))
			VAR Top10 =
			    TOPN ( 10, VALUES ( Creditors[Account] ), [AP Balance (£)] )
			RETURN
			    DIVIDE ( CALCULATE ( [AP Balance (£)], Top10 ), Full_AP_Balance )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Finance Measures\Creditors
		lineageTag: 7e876fa9-7b7c-4671-9200-b4ba7b83f537

