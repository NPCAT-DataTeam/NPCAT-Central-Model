	/// 
	/// VAR _MaxDate =
	/// LASTDATE ( 'Calendar'[Date] )
	/// RETURN
	/// CALCULATE (
	/// CONCATENATEX (
	/// RELATEDTABLE ( 'Employee Job Roles' ),
	/// 'Employee Job Roles'[Job Title],
	/// ", "
	/// ),
	/// 'Employee Job Roles'[Post Start Date] <= _MaxDate
	/// && OR (
	/// 'Employee Job Roles'[Post End Date] >= _MaxDate,
	/// ISBLANK ( 'Employee Job Roles'[Post End Date] )
	/// )
	/// )
	measure 'Selected Employee Job roles' =
			
			VAR _MaxDate =
			    LASTDATE ( 'Calendar'[Date] )
			RETURN
			    CALCULATE (
			        CONCATENATEX (
			            RELATEDTABLE ( 'Employee Job Roles' ),
			            'Employee Job Roles'[Job Title],
			            ", "
			        ),
			        'Employee Job Roles'[Post Start Date] <= _MaxDate
			            && OR (
			                'Employee Job Roles'[Post End Date] >= _MaxDate,
			                ISBLANK ( 'Employee Job Roles'[Post End Date] )
			            )
			    )
		displayFolder: Employee Job Roles
		lineageTag: 00814062-3410-4444-9f1a-53d5dc023bd3

