	/// 
	/// VAR __PREV_YEAR =
	/// CALCULATE ( [Positive Behaviour Instances YTD], DATEADD ( 'Calendar'[Date], -1, YEAR ) )
	/// RETURN
	/// IF (
	/// ISBLANK ( __PREV_YEAR ),
	/// BLANK (),
	/// [Positive Behaviour Instances YTD] - __PREV_YEAR
	/// )
	measure 'Positive Behaviour Instances YoY' =
			
			VAR __PREV_YEAR =
			    CALCULATE ( [Positive Behaviour Instances YTD], DATEADD ( 'Calendar'[Date], -1, YEAR ) )
			RETURN
			    IF (
			        ISBLANK ( __PREV_YEAR ),
			        BLANK (),
			        [Positive Behaviour Instances YTD] - __PREV_YEAR
			    )
		formatString: #,0
		displayFolder: Behaviour Sanctions\Points
		lineageTag: d5ace0b7-389d-4bd4-bc7f-74879ddede96

