	/// 
	/// VAR _MAXWeek =
	/// MAX ( 'Calendar'[CurWeekOffset] )
	/// RETURN
	/// CALCULATE ( [Suspension Students], 'Calendar'[CurWeekOffset] = _MAXWeek )
	measure 'Suspension Students CW' =
			
			VAR _MAXWeek =
			    MAX ( 'Calendar'[CurWeekOffset] )
			RETURN
			    CALCULATE ( [Suspension Students], 'Calendar'[CurWeekOffset] = _MAXWeek )
		formatString: #,0
		displayFolder: Behaviour Sanctions\Suspensions
		lineageTag: 8ec24070-ded5-4e24-af2d-19ee7f030b4c

	/// 
	/// VAR _MaxWeekOffset =
	/// MAX ( 'Calendar'[CurWeekOffset] )
	/// VAR _PW =
	/// MAX ( 'Calendar'[CurWeekOffset] ) - 1
	/// VAR _PreviousPeriod =
	/// CALCULATE (
	/// [Suspension Students],
	/// FILTER ( ALL ( 'Calendar' ), 'Calendar'[CurWeekOffset] = _PW )
	/// )
	/// VAR _CW =
	/// CALCULATE (
	/// [Suspension Students],
	/// 'Calendar'[CurWeekOffset] = _MaxWeekOffset
	/// )
	/// RETURN
	/// _CW - _PreviousPeriod
	measure 'Suspension Students WoW' =
			
			VAR _MaxWeekOffset =
			    MAX ( 'Calendar'[CurWeekOffset] )
			VAR _PW =
			    MAX ( 'Calendar'[CurWeekOffset] ) - 1
			VAR _PreviousPeriod =
			    CALCULATE (
			        [Suspension Students],
			        FILTER ( ALL ( 'Calendar' ), 'Calendar'[CurWeekOffset] = _PW )
			    )
			VAR _CW =
			    CALCULATE (
			        [Suspension Students],
			        'Calendar'[CurWeekOffset] = _MaxWeekOffset
			    )
			RETURN
			    _CW - _PreviousPeriod
		formatString: 0
		displayFolder: Behaviour Sanctions\Suspensions
		lineageTag: 47d0bf88-1442-4e31-9fb5-9624a552a577

