	/// 
	/// CALCULATE(
	/// SUM('Attendance'[Authorised Absence]) + SUM('Attendance'[Unauthorised Absence]),
	/// Attendance[Redaction Check] <> 1,
	/// Attendance[On Roll] <> "Unenrolled",
	/// Attendance[Compulsory Age] = 1
	/// )
	measure 'Overall Absence Sessions (Attendance Tbl)' =
			
			CALCULATE(
			    SUM('Attendance'[Authorised Absence]) + SUM('Attendance'[Unauthorised Absence]),
			    Attendance[Redaction Check] <> 1,
			    Attendance[On Roll] <> "Unenrolled",
			    Attendance[Compulsory Age] = 1
			)
		displayFolder: Student Absences
		lineageTag: ea12f6f7-90b3-443e-bdd3-3b8f188a8e53

	/// 
	/// VAR _LastDate =
	/// MAX ( 'Calendar'[Date] )
	/// VAR _Table =
	/// FILTER (
	/// 'Student Indicies',
	/// NOT ( [Decile] = "Undefined" )
	/// && 'Student Indicies'[RELEASE_YEAR] = 2025 && 'Student Indicies'[Category] = "IDACI"
	/// )
	/// VAR _TableWithDecile =
	/// ADDCOLUMNS ( _Table, "DecileValue", VALUE ( 'Student Indicies'[Decile] ) )
	/// RETURN
	/// CALCULATE (
	/// AVERAGEX ( _TableWithDecile, VALUE ( [Decile] ) ),
	/// 'Student Indicies'[Category] = "IDACI",
	/// 'Student Database (Full)'[DOA] <= _LastDate,
	/// 'Student Database (Full)'[Leaving date] > _LastDate
	/// || ISBLANK ( 'Student Database (Full)'[Leaving date] ),
	/// 'Calendar'[Date] = _LastDate
	/// )
	measure 'IDACI Decile (2025)' =
			
			VAR _LastDate =
			    MAX ( 'Calendar'[Date] )
			VAR _Table =
			    FILTER (
			        'Student Indicies',
			        NOT ( [Decile] = "Undefined" )
			            && 'Student Indicies'[RELEASE_YEAR] = 2025 && 'Student Indicies'[Category] = "IDACI"
			    )
			VAR _TableWithDecile =
			    ADDCOLUMNS ( _Table, "DecileValue", VALUE ( 'Student Indicies'[Decile] ) )
			RETURN
			    CALCULATE (
			        AVERAGEX ( _TableWithDecile, VALUE ( [Decile] ) ),
			        'Student Indicies'[Category] = "IDACI",
			        'Student Database (Full)'[DOA] <= _LastDate,
			        'Student Database (Full)'[Leaving date] > _LastDate
			            || ISBLANK ( 'Student Database (Full)'[Leaving date] )
			    )
		formatString: 0.0
		displayFolder: Student Measures\IDACI Measures\2025 IDACI\CY
		lineageTag: e15df500-869b-4760-8945-f3d67ab77514

		changedProperty = FormatString

