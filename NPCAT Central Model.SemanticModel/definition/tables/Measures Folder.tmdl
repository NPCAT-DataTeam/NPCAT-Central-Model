	measure 'Average Behaviour Points per Student-Year' =
			
			VAR _StudentYearSummary =
			    ADDCOLUMNS (
			        SUMMARIZE (
			            'Behaviour Points',
			            'Behaviour Points'[Unique Student ID - Academic Year]
			        ),
			        "TotalSeverity", CALCULATE ( SUM ( 'Behaviour Points'[Severity] ) )
			    )
			RETURN
			    AVERAGEX (
			        _StudentYearSummary,
			        [TotalSeverity]
			    )
