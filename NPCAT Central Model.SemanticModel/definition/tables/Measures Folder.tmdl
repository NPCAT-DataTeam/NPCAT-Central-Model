	/// 
	/// VAR _BorderlinePass =
	/// IF (
	/// [Selected KS2 Reading Variance to Pass] >= -3
	/// && [Selected KS2 Reading Variance to Pass] <= -1,
	/// TRUE (),
	/// FALSE ()
	/// )
	/// VAR _BorderlineGreaterDepth =
	/// IF (
	/// [Selected KS2 Reading Variance to Greater Depth] >= -3
	/// && [Selected KS2 Reading Variance to Greater Depth] <= -1,
	/// TRUE (),
	/// FALSE ()
	/// )
	/// RETURN
	/// SWITCH (
	/// TRUE (),
	/// _BorderlinePass, "Light Blue",
	/// _BorderlineGreaterDepth, "Light Green",
	/// BLANK ()
	/// )
	measure 'KS2 Reading Raw Score (Format)' =
			
			VAR _BorderlinePass =
			    IF (
			        [Selected KS2 Reading Variance to Pass] >= -3
			            && [Selected KS2 Reading Variance to Pass] <= -1,
			        TRUE (),
			        FALSE ()
			    )
			VAR _BorderlineGreaterDepth =
			    IF (
			        [Selected KS2 Reading Variance to Greater Depth] >= -3
			            && [Selected KS2 Reading Variance to Greater Depth] <= -1,
			        TRUE (),
			        FALSE ()
			    )
			RETURN
			    SWITCH (
			        TRUE (),
			        _BorderlinePass, "Light Blue",
			        _BorderlineGreaterDepth, "Light Green",
			        BLANK ()
			    )
		displayFolder: Statutory KS2
