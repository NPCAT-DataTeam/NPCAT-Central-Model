	/// 
	/// VAR _MaxDayOffset =
	/// MAX ( 'Calendar'[CurDayOffset] )
	/// VAR _PW =
	/// MAX ( 'Calendar'[CurDayOffset] ) - 7
	/// VAR _PreviousPeriod =
	/// CALCULATE (
	/// [Attendance Sessions],
	/// FILTER ( ALL ( 'Calendar' ), 'Calendar'[CurDayOffset] = _PW )
	/// )
	/// VAR _CW =
	/// CALCULATE ( [Attendance Sessions], 'Calendar'[CurDayOffset] = _MaxDayOffset )
	/// RETURN
	/// _CW - _PreviousPeriod
	measure 'Attendance Sessions Rolling WoW' =
			
			VAR _MaxDayOffset =
			    MAX ( 'Calendar'[CurDayOffset] )
			VAR _PW =
			    MAX ( 'Calendar'[CurDayOffset] ) - 7
			VAR _PreviousPeriod =
			    CALCULATE (
			        [Attendance Sessions],
			        FILTER ( ALL ( 'Calendar' ), 'Calendar'[CurDayOffset] = _PW )
			    )
			VAR _CW =
			    CALCULATE ( [Attendance Sessions], 'Calendar'[CurDayOffset] = _MaxDayOffset )
			RETURN
			    _CW - _PreviousPeriod
		formatString: #,0
		displayFolder: Unused
		lineageTag: 9a129e78-99cf-4810-ada8-23cd28d6be0b

		changedProperty = FormatString

