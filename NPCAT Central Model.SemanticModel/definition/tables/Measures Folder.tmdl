	/// 
	/// VAR _LastDate =
	/// MAX ( 'Calendar'[Date] )
	/// VAR _Offset =
	/// MAX ( 'Calendar'[Current School Year Offset] )
	/// VAR __PACore =
	/// CALCULATE (
	/// DISTINCTCOUNT ( Attendance[Unique Student ID] ),
	/// FILTER (
	/// VALUES ( Attendance[Unique Student ID] ),
	/// [Attendance Percentage YTD] <= 0.90
	/// ),
	/// NOT ( Attendance[Mark] IN { "#", "Z", "-","D" } ),
	/// Attendance[Compulsory Age] = 1,
	/// Attendance[Redaction Check] <> 1,
	/// Attendance[On Roll] <> "Unenrolled"
	/// // 'Student Database (Full)'[DOA] <= _LastDate,
	/// // 'Student Database (Full)'[Leaving date] >= _LastDate
	/// //     || ISBLANK ( 'Student Database (Full)'[Leaving date]),
	/// // 'Calendar'[Current School Year Offset] = _Offset
	/// )
	/// RETURN
	/// CALCULATE ( __PACore )
	measure 'Persistent Absence' = ```
			
			 VAR _LastDate =
			    MAX ( 'Calendar'[Date] )
			VAR _Offset =
			    MAX ( 'Calendar'[Current School Year Offset] )
			VAR __PACore =
			    CALCULATE (
			        DISTINCTCOUNT ( Attendance[Unique Student ID] ),
			        FILTER (
			            VALUES ( Attendance[Unique Student ID] ),
			            [Attendance Percentage YTD] <= 0.90
			        ),
			        NOT ( Attendance[Mark] IN { "#", "Z", "-","D" } ),
			        Attendance[Compulsory Age] = 1,
			        Attendance[Redaction Check] <> 1,
			        Attendance[On Roll] <> "Unenrolled"
			        // 'Student Database (Full)'[DOA] <= _LastDate,
			        // 'Student Database (Full)'[Leaving date] >= _LastDate
			        //     || ISBLANK ( 'Student Database (Full)'[Leaving date]),
			        // 'Calendar'[Current School Year Offset] = _Offset
			    )
			RETURN
			    CALCULATE ( __PACore )
			```
		displayFolder: Persistent Absence
		lineageTag: 7a631619-0f27-4691-9397-387470559f12

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// 
	/// CALCULATE (
	/// DISTINCTCOUNT ( 'Excluded Students'[Globally Unique Student ID] ),
	/// FILTER (
	/// VALUES ( 'Excluded Students'[Globally Unique Student ID] ),
	/// [Fixed Term Exclusion Sessions YTD] >= 20
	/// )
	/// ) + 0
	measure '20 Sessions or Excluded YTD' =
			
			CALCULATE (
			    DISTINCTCOUNT ( 'Excluded Students'[Globally Unique Student ID] ),
			    FILTER (
