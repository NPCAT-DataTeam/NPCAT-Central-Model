	/// 
	/// IF (
	/// ISINSCOPE ( 'Student Year Groups'[Year Group] ),
	/// CALCULATE (
	/// [Attendance Percentage YTD],
	/// FILTER (
	/// VALUES ( 'Attendance'[Unique Student ID] ),
	/// [Attendance Percentage YTD] > 0.90
	/// )
	/// ),
	/// CALCULATE (
	/// [Attendance Percentage YTD],
	/// FILTER (
	/// VALUES ( 'Attendance'[Unique Student ID] ),
	/// [Attendance Percentage YTD] > 0.90
	/// ),
	/// NOT ( 'Student Year Groups'[Year Group] IN { "N1", "N2", "EY1", "EY2", "Reception" } )
	/// )
	/// )
	measure 'Non Persistent Absence Attendance %' =
			
			IF (
			    ISINSCOPE ( 'Student Year Groups'[Year Group] ),
			    CALCULATE (
			        [Attendance Percentage YTD],
			        FILTER (
			            VALUES ( 'Attendance'[Unique Student ID] ),
			            [Attendance Percentage YTD] > 0.90
			        )
			    ),
			    CALCULATE (
			        [Attendance Percentage YTD],
			        FILTER (
			            VALUES ( 'Attendance'[Unique Student ID] ),
			            [Attendance Percentage YTD] > 0.90
			        ),
			        NOT ( 'Student Year Groups'[Year Group] IN { "N1", "N2", "EY1", "EY2", "Reception" } )
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Persistent Absence
		lineageTag: 64b5fa60-e570-4c0d-b344-8a94abc5b927

	/// 
	/// IF (
	/// ISINSCOPE ( 'Student Year Groups'[Year Group] ),
	/// CALCULATE (
	/// [Attendance Percentage YTD],
	/// FILTER (
	/// VALUES ( 'Attendance'[Unique Student ID] ),
	/// [Attendance Percentage YTD] <= 0.90
	/// )
	/// ),
	/// CALCULATE (
	/// [Attendance Percentage YTD],
	/// FILTER (
	/// VALUES ( 'Attendance'[Unique Student ID] ),
	/// [Attendance Percentage YTD] <= 0.90
	/// ),
	/// NOT ( 'Student Year Groups'[Year Group] IN { "N1", "N2", "EY1", "EY2", "Reception" } )
	/// )
	/// )
	measure 'Persistent Absence Attendance %' =
			
			IF (
			    ISINSCOPE ( 'Student Year Groups'[Year Group] ),
			    CALCULATE (
			        [Attendance Percentage YTD],
			        FILTER (
			            VALUES ( 'Attendance'[Unique Student ID] ),
			            [Attendance Percentage YTD] <= 0.90
			        )
			    ),
			    CALCULATE (
			        [Attendance Percentage YTD],
			        FILTER (
			            VALUES ( 'Attendance'[Unique Student ID] ),
			            [Attendance Percentage YTD] <= 0.90
			        ),
			        NOT ( 'Student Year Groups'[Year Group] IN { "N1", "N2", "EY1", "EY2", "Reception" } )
			    )
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Persistent Absence
		lineageTag: 28d29091-20d6-4af0-9b50-0aa24f80e05b

