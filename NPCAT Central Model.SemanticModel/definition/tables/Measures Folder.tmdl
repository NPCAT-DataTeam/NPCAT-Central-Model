	/// 
	/// CALCULATE (
	/// DIVIDE (
	/// //Trust Standard
	/// CALCULATE (
	/// COUNTA ( 'Secondary Standards QA Questions'[Answer] ),
	/// 'Secondary Standards QA Questions'[Answer]
	/// IN { "Seen" } //, "Partially Met" }
	/// ) + 0,
	/// CALCULATE (
	/// COUNTA ( 'Secondary Standards QA Questions'[Answer] ),
	/// 'Secondary Standards QA Questions'[Answer] IN { "Seen", "Not Seen" }
	/// )
	/// ),
	/// 'Secondary Standards QA Forms'[Date of QA Form]
	/// = MAX ( 'Secondary Standards QA Forms'[Date of QA Form] )
	/// )
	measure 'Observation %' =
			
			CALCULATE (
			    DIVIDE (
			        //Trust Standard
			        CALCULATE (
			            COUNTA ( 'Secondary Standards QA Questions'[Answer] ),
			            'Secondary Standards QA Questions'[Answer]
			                IN { "Seen" } //, "Partially Met" }
			        ) + 0,
			        CALCULATE (
			            COUNTA ( 'Secondary Standards QA Questions'[Answer] ),
			            'Secondary Standards QA Questions'[Answer] IN { "Seen", "Not Seen" }
			        )
			    ),
			    'Secondary Standards QA Forms'[Date of QA Form]
			        = MAX ( 'Secondary Standards QA Forms'[Date of QA Form] )
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Secondary QA\Lesson Observations
		lineageTag: 3e382ff4-1d95-460f-8f03-fc4202daa73a

