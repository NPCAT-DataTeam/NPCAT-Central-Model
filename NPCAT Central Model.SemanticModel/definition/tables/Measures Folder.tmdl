	/// 
	/// VAR __CurrentIndex =
	/// CALCULATE (
	/// MAX ( 'Health and Safety Audit Overview'[ID] ),
	/// REMOVEFILTERS ( 'Health and Safety Audit Overview'[Is Most Recent Health and Safety Audit] )
	/// )
	/// VAR __LastAuditDate =
	/// CALCULATE (
	/// MAX ( 'Health and Safety Audit Overview'[Date of Audit] ),
	/// REMOVEFILTERS ( 'Health and Safety Audit Overview'[Is Most Recent Health and Safety Audit] ),
	/// 'Health and Safety Audit Overview'[ID] = __CurrentIndex
	/// )
	/// RETURN
	/// COUNTROWS ( DATESBETWEEN ( 'Calendar'[Date], __LastAuditDate, TODAY () ) ) - 1
	measure 'Days Since Last Audit Date' =
			
			VAR __CurrentIndex =
			    CALCULATE (
			        MAX ( 'Health and Safety Audit Overview'[ID] ),
			        REMOVEFILTERS ( 'Health and Safety Audit Overview'[Is Most Recent Health and Safety Audit] )
			    )
			VAR __LastAuditDate =
			    CALCULATE (
			        MAX ( 'Health and Safety Audit Overview'[Date of Audit] ),
			        REMOVEFILTERS ( 'Health and Safety Audit Overview'[Is Most Recent Health and Safety Audit] ),
			        'Health and Safety Audit Overview'[ID] = __CurrentIndex
			    )
			RETURN
