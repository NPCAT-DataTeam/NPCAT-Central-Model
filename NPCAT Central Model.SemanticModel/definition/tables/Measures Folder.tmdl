	/// VAR enddate =
	/// (
	/// CALCULATE (
	/// LASTDATE ( 'Calendar'[Date] ),
	/// 'Calendar'[Current School Year Offset] IN { 0 }
	/// ) - 365
	/// )
	/// RETURN
	/// CALCULATE (
	/// [ICT Tickets YTD],
	/// DATESBETWEEN ( Calendar[Date], startyear, enddate )
	/// )
	measure 'ICT tickets YTD SPLY (-1 Years)' =
			
			VAR startyear =
			    CALCULATE (
			        FIRSTDATE ( 'Calendar'[Date] ),
			        'Calendar'[Current School Year Offset] IN { -1 }
			    )
			VAR enddate =
			    (
			        CALCULATE (
			            LASTDATE ( 'Calendar'[Date] ),
			            'Calendar'[Current School Year Offset] IN { 0 }
			        ) - 365
			    )
			RETURN
			    CALCULATE (
			        [ICT Tickets YTD],
			        DATESBETWEEN ( Calendar[Date], startyear, enddate )
			    )
		displayFolder: Unused
		lineageTag: e3405111-ce5e-4476-a53b-4526ae8f71e0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// 
	/// CALCULATE (
	/// DIVIDE (
	/// CALCULATE ( COUNTA ( 'Attendance'[Mark] ), 'Attendance'[Mark] IN { "O", "I" } ),
	/// SUM ( 'Attendance'[Sessions] )
	/// ),
	/// 'Calendar'[FutureDate] IN { "Past" }
	/// )
	measure 'Illness or O Code Absence Percentage' =
			
			CALCULATE (
			    DIVIDE (
			        CALCULATE ( COUNTA ( 'Attendance'[Mark] ), 'Attendance'[Mark] IN { "O", "I" } ),
			        SUM ( 'Attendance'[Sessions] )
			    ),
			    'Calendar'[FutureDate] IN { "Past" }
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Unused
		lineageTag: d7227c51-2423-466d-af02-2a98d220f018

