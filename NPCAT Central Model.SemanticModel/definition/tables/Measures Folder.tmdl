	/// 
	/// 
	/// DIVIDE([Suspension Incidents YTD SPLY],[Students on Roll Prev Year])*100
	measure 'Suspension Rate -2 Year' =
			
			VAR CurrentYearOffset =
			    MAX ( 'Calendar'[Current School Year Offset] )
			VAR LastYear = CurrentYearOffset - 2
			VAR SchoolYr = FORMAT(CALCULATE(MAX('Calendar'[Academic Year Start]),'Calendar'[Current School Year Offset] = LastYear),"0000")
			RETURN
			CALCULATE (
			    [Suspension Rate YTD],
			    'Calendar'[Current School Year Offset] = LastYear,
			    'Student Year Groups'[Academic Year] = SchoolYr
			)
		displayFolder: Behaviour Sanctions\Suspensions
		lineageTag: e4af2014-650a-42f0-9eb2-81adc6bfdb00

		annotation PBI_FormatHint = {"isGeneralNumber":true}

