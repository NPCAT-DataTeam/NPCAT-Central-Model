	/// 
	/// VAR CutOff = [Dynamic Max Date]
	/// VAR _Date_Diff_Tbl =
	/// SUMMARIZE(
	/// FILTER('Creditors',
	/// Creditors[Invoice Date] <= CutOff
	/// && (
	/// ISBLANK ( Creditors[Pay Date] )
	/// || Creditors[Pay Date] > CutOff
	/// )
	/// && Creditors[Due Date] < CutOff),
	/// 
	/// 'Creditors'[Invoice ID],
	/// "DATE_DIFF", DATEDIFF(MAX('Creditors'[Due Date]),CutOff, DAY)
	/// )
	/// 
	/// RETURN
	/// AVERAGEX(_Date_Diff_Tbl,[DATE_DIFF])
	measure 'Days Average Late' = ```
			
			VAR CutOff = [Dynamic Max Date]
			VAR _Date_Diff_Tbl =  
			        SUMMARIZE(
			            FILTER('Creditors',
			            Creditors[Invoice Date] <= CutOff
			            && (
			                ISBLANK ( Creditors[Pay Date] )
			                    || Creditors[Pay Date] > CutOff
			            )
			            && Creditors[Due Date] < CutOff),
			
			        'Creditors'[Invoice ID],
			        "DATE_DIFF", DATEDIFF(MAX('Creditors'[Due Date]),CutOff, DAY)
			        )
			        
			RETURN
			        AVERAGEX(_Date_Diff_Tbl,[DATE_DIFF])
			```
		displayFolder: Finance Measures\Creditors
		lineageTag: 506dc425-204a-49ce-8d01-c91a071f34c5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

