	/// 
	/// 
	/// // CALCULATE (
	/// //     SELECTEDVALUE ( 'KS4 Assessments'[Grade] ),
	/// //     'KS4 Assessments'[P8 Slot (Bucket)] = "English"
	/// // )
	/// VAR _LookupValue =
	/// LOOKUPVALUE (
	/// 'KS4 Assessments'[Grade],                    -- Column to return (Grade)
	/// 'KS4 Assessments'[Unique Student ID - Academic Year],                 -- Lookup column (Student ID)
	/// SELECTEDVALUE('KS4 Student Headlines'[Unique Student ID - Academic Year]),         -- Current row's Student ID
	/// 'KS4 Assessments'[AP-Grade Type],                    -- Lookup column (Period)
	/// SELECTEDVALUE('AP-Grade Type'[AP-Grade Type]),             -- Current slicer's selected period
	/// 'KS4 Assessments'[P8 Slot (Bucket)],         -- Lookup column (Bucket)
	/// "English"                                    -- Fixed value for English subject
	/// )
	/// RETURN
	/// 
	/// IFERROR(_LookupValue,
	/// "Multiple Grades"
	/// )
	measure 'English Bucket Grade' = ```
			
			
			// CALCULATE (
			//     SELECTEDVALUE ( 'KS4 Assessments'[Grade] ),
			//     'KS4 Assessments'[P8 Slot (Bucket)] = "English"
			// )
			VAR _LookupValue = 
			LOOKUPVALUE (
			    'KS4 Assessments'[Grade],                    -- Column to return (Grade)
			    'KS4 Assessments'[Unique Student ID - Academic Year],                 -- Lookup column (Student ID)
			    SELECTEDVALUE('KS4 Student Headlines'[Unique Student ID - Academic Year]),         -- Current row's Student ID
			    'KS4 Assessments'[AP-Grade Type],                    -- Lookup column (Period)
			    SELECTEDVALUE('AP-Grade Type'[AP-Grade Type]),             -- Current slicer's selected period
			    'KS4 Assessments'[P8 Slot (Bucket)],         -- Lookup column (Bucket)
			    "English"                                    -- Fixed value for English subject
