	/// 
	/// VAR __MaxDate =
	/// MAX ( 'SEN Audit Visits'[Date of QA] )
	/// VAR __Numerator =
	/// CALCULATE (
	/// COUNTA ( 'SEN Audit Scores'[Answer] ),
	/// 'SEN Audit Scores'[Answer] IN { "Met" },
	/// 'SEN Audit Scores'[Question] <> "The SENCO is a qualified teacher and has the relevant qualifications."
	/// )
	/// VAR __Denominator =
	/// CALCULATE (
	/// COUNTA ( 'SEN Audit Scores'[Answer] ),
	/// 'SEN Audit Scores'[Answer] IN { "Met", "Not Met", "Partially Met" },
	/// 'SEN Audit Scores'[Question] <> "The SENCO is a qualified teacher and has the relevant qualifications."
	/// )
	/// RETURN
	/// CALCULATE (
	/// IF (
	/// ISBLANK ( [SEN Compliance % (Most Recent QA)] ),
	/// "",
	/// __Numerator & " of " & __Denominator
	/// )
	/// )
	measure 'SEN Activities x of y' =
			
			VAR __MaxDate =
			    MAX ( 'SEN Audit Visits'[Date of QA] )
			VAR __Numerator =
			    CALCULATE (
			        COUNTA ( 'SEN Audit Scores'[Answer] ),
			        'SEN Audit Scores'[Answer] IN { "Met" },
			        'SEN Audit Scores'[Question] <> "The SENCO is a qualified teacher and has the relevant qualifications."
			    )
			VAR __Denominator =
			    CALCULATE (
			        COUNTA ( 'SEN Audit Scores'[Answer] ),
			        'SEN Audit Scores'[Answer] IN { "Met", "Not Met", "Partially Met" },
			        'SEN Audit Scores'[Question] <> "The SENCO is a qualified teacher and has the relevant qualifications."
			    )
			RETURN
			    CALCULATE (
			        IF (
			            ISBLANK ( [SEN Compliance % (Most Recent QA)] ),
			            "",
			            __Numerator & " of " & __Denominator
			        )
			    )
		displayFolder: SEN QA
		lineageTag: 2b9ec825-2e78-4c0e-97d9-270693fb2270

		annotation PBI_FormatHint = {"isGeneralNumber":true}

