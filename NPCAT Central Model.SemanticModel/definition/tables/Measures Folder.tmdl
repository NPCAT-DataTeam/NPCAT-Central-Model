	/// 
	/// //This is the risk over the inherent risk associated with human factors
	/// VAR _SimFail      = ROUND(MIN ( [% of Simulations Failed YTD] / 0.15 , 1 ),2)
	/// VAR _CourseFail   = ROUND(MIN ( [% of Courses Failed YTD] / 0.10 , 1 ),2)
	/// VAR _CourseInc    = ROUND(MIN ( [% of Courses Incomplete] / 0.2 , 1 ),2)
	/// VAR _Sim2plus = ROUND(MIN ( [% Failed 2+ Simulation] / 0.50 , 1 ),2)
	/// VAR _Course2plus = ROUND(MIN ( [% Failed 2+ Course] / 0.50 , 1 ),2)
	/// 
	/// VAR _Final = ROUND(
	/// (0.35*_SimFail)+
	/// (0.1*_CourseFail)+
	/// (0.15*_CourseInc)+
	/// (0.25*_Sim2plus)+
	/// (0.15*_Course2plus)
	/// ,2)
	/// 
	/// RETURN
	/// _Final *100
	measure 'Weighted Residual Risk (0-100) (YTD)' =
			
			//This is the risk over the inherent risk associated with human factors
			VAR _SimFail      = ROUND(MIN ( [% of Simulations Failed YTD] / 0.15 , 1 ),2)
			VAR _CourseFail   = ROUND(MIN ( [% of Courses Failed YTD] / 0.10 , 1 ),2)
			VAR _CourseInc    = ROUND(MIN ( [% of Courses Incomplete] / 0.2 , 1 ),2)
			VAR _Sim2plus = ROUND(MIN ( [% Failed 2+ Simulation] / 0.50 , 1 ),2)
			VAR _Course2plus = ROUND(MIN ( [% Failed 2+ Course] / 0.50 , 1 ),2)
			
			VAR _Final = ROUND(
			    (0.35*_SimFail)+
			    (0.1*_CourseFail)+
			    (0.15*_CourseInc)+
			    (0.25*_Sim2plus)+
			    (0.15*_Course2plus)
			,2)
			
			RETURN
			_Final *100
		formatString: 0
		displayFolder: Boxphish
		lineageTag: 071d55ef-9f29-4638-8423-e8b93fed23c9

	/// 
	/// 
	/// VAR MaxDate = MAX(Calendar[Date])
	/// VAR MonthDiff = SWITCH(TRUE(),MONTH(MaxDate) <= 8, 7,MONTH(MaxDate) = 1, 7,MONTH(MaxDate) > 8, 6)
	/// VAR _6Month = DATE(YEAR(MaxDate),MONTH(MaxDate)-MonthDiff,DAY(MaxDate))
	/// VAR _1Month = DATE(YEAR(MaxDate),MONTH(MaxDate)-1,DAY(MaxDate))
	/// RETURN
	/// CALCULATE (
	/// DIVIDE ( [Number of Courses Incomplete], [Total Boxphish Courses Sent] ),
	/// 'Boxphish Courses'[Date Sent]>=_6Month,
	/// 'Boxphish Courses'[Date Sent]<=_1Month,
	/// 'Employee Job Roles'[Property Start Date] <= _6Month,
	/// 'Employee Job Roles'[Post End Date] > _6Month
	/// || ISBLANK ( 'Employee Job Roles'[Post End Date] )
	/// )
	measure '% of Courses Incomplete (6 Months)' =
			
			
			VAR MaxDate = MAX(Calendar[Date])
			VAR MonthDiff = SWITCH(TRUE(),MONTH(MaxDate) <= 8, 7,MONTH(MaxDate) = 1, 7,MONTH(MaxDate) > 8, 6)
			VAR _6Month = DATE(YEAR(MaxDate),MONTH(MaxDate)-MonthDiff,DAY(MaxDate))
			VAR _1Month = DATE(YEAR(MaxDate),MONTH(MaxDate)-1,DAY(MaxDate))
			RETURN
			CALCULATE (
			    DIVIDE ( [Number of Courses Incomplete], [Total Boxphish Courses Sent] ),
			        'Boxphish Courses'[Date Sent]>=_6Month,
			        'Boxphish Courses'[Date Sent]<=_1Month,
			        'Employee Job Roles'[Property Start Date] <= _6Month,
			        'Employee Job Roles'[Post End Date] > _6Month
			            || ISBLANK ( 'Employee Job Roles'[Post End Date] )
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Boxphish
		lineageTag: 4427fb26-9637-4783-9cd6-ff34d7c3517f

