	/// VAR NotFailedCourses = CALCULATE(COUNTROWS('Boxphish Courses'), NOT 'Boxphish Courses'[Course Outcome] IN { "Fail" })
	/// 
	/// RETURN
	/// 
	/// CALCULATE (
	/// TotalCourses - NotFailedCourses
	/// )
	/// // CALCULATE (
	/// //     COUNTA ( 'Boxphish Courses'[Course Outcome] ),
	/// //     'Boxphish Courses'[Course Outcome] IN { "Fail" }
