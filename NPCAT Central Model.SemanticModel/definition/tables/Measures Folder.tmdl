	/// 
	/// VAR __CO2Levels =
	/// FILTER (
	/// UNION (
	/// SELECTCOLUMNS (
	/// 'Catering Audit',
	/// "ID", [ID],
	/// "School", [SUID],
	/// "Co2 Levels", [Co2 Reading PPM - Main Kitchen]
	/// ),
	/// SELECTCOLUMNS (
	/// 'Catering Audit',
	/// "ID", [ID],
	/// "School", [SUID],
	/// "Co2 Levels", [Co2 Reading PPM - Inside Canopy]
	/// ),
	/// SELECTCOLUMNS (
	/// 'Catering Audit',
	/// "ID", [ID],
	/// "School", [SUID],
	/// "Co2 Levels", [Co2 Reading PPM - Outside Canopy]
	/// )
	/// ),
	/// [Co2 Levels] <> ""
	/// )
	/// VAR _CO2Table =
	/// SUMMARIZE (
	/// 'Catering Audit',
	/// 'Catering Audit'[ID],
	/// "Avg co2", AVERAGEX ( __CO2Levels, [Co2 Levels] )
	/// )
	/// RETURN
	/// AVERAGEX ( _CO2Table, [Avg co2] )
	measure 'Average CO2 levels ppm' =
			
			VAR __CO2Levels =
			    FILTER (
			        UNION (
			            SELECTCOLUMNS (
			                'Catering Audit',
			                "ID", [ID],
			                "School", [SUID],
			                "Co2 Levels", [Co2 Reading PPM - Main Kitchen]
			            ),
			            SELECTCOLUMNS (
			                'Catering Audit',
			                "ID", [ID],
			                "School", [SUID],
			                "Co2 Levels", [Co2 Reading PPM - Inside Canopy]
			            ),
			            SELECTCOLUMNS (
			                'Catering Audit',
			                "ID", [ID],
			                "School", [SUID],
			                "Co2 Levels", [Co2 Reading PPM - Outside Canopy]
			            )
			        ),
			        [Co2 Levels] <> ""
			    )
			VAR _CO2Table =
			    SUMMARIZE (
			        'Catering Audit',
			        'Catering Audit'[ID],
			        "Avg co2", AVERAGEX ( __CO2Levels, [Co2 Levels] )
			    )
			RETURN
			    AVERAGEX ( _CO2Table, [Avg co2] )
		formatString: 0
		displayFolder: Unused
		lineageTag: 0c533c1f-ec18-4e66-8172-639b6256b2a7

