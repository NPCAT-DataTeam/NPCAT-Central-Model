	/// 
	/// VAR _LastDate =
	/// MAX ( 'Calendar'[Date] )
	/// VAR _Table =
	/// FILTER (
	/// 'Student Indicies',
	/// NOT ( [Rank] = "Undefined" )
	/// && 'Student Indicies'[Category] = "IMD"
	/// )
	/// VAR _TableWithRank =
	/// ADDCOLUMNS ( _Table, "RankValue", VALUE ( 'Student Indicies'[Rank] ) )
	/// RETURN
	/// CALCULATE (
	/// AVERAGEX ( _TableWithRank, VALUE ( [Rank] ) ),
	/// 'Student Indicies'[Category] = "IMD",
	/// 'Student Database (Full)'[DOA] <= _LastDate,
	/// 'Student Database (Full)'[Leaving date] > _LastDate
	/// || ISBLANK ( 'Student Database (Full)'[Leaving date] ),
	/// 'Calendar'[Date] = _LastDate
	/// )
	measure 'IMD Rank' =
			
			VAR _LastDate =
			    MAX ( 'Calendar'[Date] )
			VAR _Table =
			    FILTER (
			        'Student Indicies',
			        NOT ( [Rank] = "Undefined" )
			            && 'Student Indicies'[Category] = "IMD"
			    )
			VAR _TableWithRank =
			    ADDCOLUMNS ( _Table, "RankValue", VALUE ( 'Student Indicies'[Rank] ) )
			RETURN
			    CALCULATE (
			        AVERAGEX ( _TableWithRank, VALUE ( [Rank] ) ),
			        'Student Indicies'[Category] = "IMD",
			        'Student Database (Full)'[DOA] <= _LastDate,
			        'Student Database (Full)'[Leaving date] > _LastDate
			            || ISBLANK ( 'Student Database (Full)'[Leaving date] ),
			        'Calendar'[Date] = _LastDate
			    )
		formatString: #,##0
		displayFolder: Unused
		lineageTag: 5c3edb90-4bd1-4bf2-b398-2f1801e98e4e

