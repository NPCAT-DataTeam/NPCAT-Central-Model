	/// 
	/// VAR CurrentYearOffset =
	/// MAX ( 'Calendar'[Current School Year Offset] )
	/// VAR LastYear = CurrentYearOffset - 1
	/// RETURN
	/// CALCULATE (
	/// [SEN Support Students],
	/// 'Calendar'[Current School Year Offset] = LastYear,
	/// REMOVEFILTERS ( 'Calendar'[School Year] )
	/// )
	measure 'SEN Support Students Prev Year' =
			
			VAR CurrentYearOffset =
			    MAX ( 'Calendar'[Current School Year Offset] )
			VAR LastYear = CurrentYearOffset - 1
			RETURN
			    CALCULATE (
			        [SEN Support Students],
			        'Calendar'[Current School Year Offset] = LastYear,
			        REMOVEFILTERS ( 'Calendar'[School Year] )
			    )
		formatString: #,0
		displayFolder: Student Measures
		lineageTag: ac452ed6-0177-4055-95d9-d0f616777d73

	/// 
	/// CALCULATE (
	/// DIVIDE (
	/// SUM ( 'KS2 Tests & TA Results'[Mark] ),
	/// SUM ( 'KS2 Tests & TA Results'[Max Mark] ),
	/// BLANK ()
	/// ),
	/// KEEPFILTERS ( 'KS2 Tests & TA Results'[Assessment Type] = "Test" ),
	/// KEEPFILTERS ( NOT ( 'KS2 Tests & TA Results'[Type] IN { "Outcome", "Scaled Score" } ) )
	/// )
	measure 'KS2 Paper %' =
			
			CALCULATE (
			    DIVIDE (
			        SUM ( 'KS2 Tests & TA Results'[Mark] ),
			        SUM ( 'KS2 Tests & TA Results'[Max Mark] ),
			        BLANK ()
			    ),
			    KEEPFILTERS ( 'KS2 Tests & TA Results'[Assessment Type] = "Test" ),
			    KEEPFILTERS ( NOT ( 'KS2 Tests & TA Results'[Type] IN { "Outcome", "Scaled Score" } ) )
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Statutory KS2
		lineageTag: b1b2a5ff-ff7d-413e-b41b-285a202aac15

