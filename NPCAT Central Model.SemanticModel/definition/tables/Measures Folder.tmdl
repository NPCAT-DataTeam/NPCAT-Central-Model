	/// 
	/// VAR _LastDate =
	/// LASTDATE ( 'Calendar'[Date] )
	/// RETURN
	/// CALCULATE (
	/// SUM ( 'Employee Job Roles'[FTE Salary] ),
	/// 'Employee Job Roles'[Property Start Date] <= _LastDate,
	/// 'Employee Job Roles'[Post End Date] > _LastDate
	/// || ISBLANK ( 'Employee Job Roles'[Post End Date] )
	/// )
	measure 'Total FTE Salary' =
			
			VAR _LastDate =
			    LASTDATE ( 'Calendar'[Date] )
			RETURN
			    CALCULATE (
			        SUM ( 'Employee Job Roles'[FTE Salary] ),
			        'Employee Job Roles'[Property Start Date] <= _LastDate,
			        'Employee Job Roles'[Post End Date] > _LastDate
			            || ISBLANK ( 'Employee Job Roles'[Post End Date] )
			    )
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		displayFolder: Employees/Retention
		lineageTag: 95d2ecce-786c-4260-8e20-31bafc77d87c

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

