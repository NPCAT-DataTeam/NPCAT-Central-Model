	/// 
	/// CALCULATE (
	/// DIVIDE (
	/// CALCULATE ( COUNTA ( 'Attendance'[Mark] ), 'Attendance'[Mark] IN { "C" } ),
	/// SUM ( 'Attendance'[Sessions] )
	/// ),
	/// 'Calendar'[FutureDate] IN { "Past" }
	/// ) + 0
	measure 'C Code %' =
			
			CALCULATE (
			    DIVIDE (
			        CALCULATE ( COUNTA ( 'Attendance'[Mark] ), 'Attendance'[Mark] IN { "C" } ),
			        SUM ( 'Attendance'[Sessions] )
			    ),
			    'Calendar'[FutureDate] IN { "Past" }
			) + 0
		formatString: 0.00%;-0.00%;0.00%
