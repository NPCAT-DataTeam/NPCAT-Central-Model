	/// 
	/// VAR _LastDate =
	/// MAX ( 'Calendar'[Date] )
	/// VAR _FirstDate =
	/// MIN ( 'Calendar'[Date] )
	/// VAR __Final =
	/// CALCULATE (
	/// SUM ( 'Absences'[Working Days Lost] ),
	/// 'Absences'[Absence Start Date] >= _FirstDate,
	/// 'Absences'[Absence Start Date] <= _LastDate,
	/// 'Absences'[Absence End Date] <= _LastDate
	/// || ISBLANK ( 'Absences'[Absence End Date] )
	/// )
	/// RETURN
	/// CALCULATE ( __Final, 'Absences'[LTS Flag] = "LTS" )
	measure 'LTS Total Days Lost' =
			
			VAR _LastDate =
			    MAX ( 'Calendar'[Date] )
			VAR _FirstDate =
			    MIN ( 'Calendar'[Date] )
			VAR __Final =
			    CALCULATE (
			        SUM ( 'Absences'[Working Days Lost] ),
			        'Absences'[Absence Start Date] >= _FirstDate,
			        'Absences'[Absence Start Date] <= _LastDate,
			        'Absences'[Absence End Date] <= _LastDate
			            || ISBLANK ( 'Absences'[Absence End Date] )
			    )
			RETURN
			    CALCULATE ( __Final, 'Absences'[LTS Flag] = "LTS" )
		formatString: 0.0
		displayFolder: Human Resources\Long Term Sickness
		lineageTag: ba536236-cc8a-4512-a02f-3cf2772b9cfb

	/// 
	/// TOTALYTD ( [LTS Total Days Lost], 'Calendar'[Date], "31/08" )
	measure 'LTS Total Days Lost YTD' =
			
