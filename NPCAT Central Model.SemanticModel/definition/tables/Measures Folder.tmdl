	/// 
	/// //This is the risk over the inherent risk associated with human factors
	/// VAR _SimFail      = ROUND(MIN ( [% of Simmulations Failed 6Months]/ 0.15 , 1 ),2)
	/// VAR _CourseFail   = ROUND(MIN ( [% of Courses Failed 6Months] / 0.10 , 1 ),2)
	/// VAR _CourseInc    = ROUND(MIN ( [% of Courses Incomplete (6 Months)] / 0.2 , 1 ),2)
	/// VAR _Sim2plus = ROUND(MIN ( [% Failed 2+ Simulations 6 Months] / 0.50 , 1 ),2)
	/// VAR _Course2plus = ROUND(MIN ( [% Failed 2+ Courses 6 Months] / 0.50 , 1 ),2)
	/// 
	/// VAR _Final = ROUND(
	/// (0.35*_SimFail)+
	/// (0.1*_CourseFail)+
	/// (0.15*_CourseInc)+
	/// (0.25*_Sim2plus)+
	/// (0.15*_Course2plus)
	/// ,2)
	/// 
	/// RETURN
	/// _Final *100
	measure 'Weighted Residual Risk (0-100)' =
			
			//This is the risk over the inherent risk associated with human factors
			VAR _SimFail      = ROUND(MIN ( [% of Simmulations Failed 6Months]/ 0.15 , 1 ),2)
			VAR _CourseFail   = ROUND(MIN ( [% of Courses Failed 6Months] / 0.10 , 1 ),2)
			VAR _CourseInc    = ROUND(MIN ( [% of Courses Incomplete (6 Months)] / 0.2 , 1 ),2)
			VAR _Sim2plus = ROUND(MIN ( [% Failed 2+ Simulations 6 Months] / 0.50 , 1 ),2)
			VAR _Course2plus = ROUND(MIN ( [% Failed 2+ Courses 6 Months] / 0.50 , 1 ),2)
			
			VAR _Final = ROUND(
			    (0.35*_SimFail)+
			    (0.1*_CourseFail)+
			    (0.15*_CourseInc)+
			    (0.25*_Sim2plus)+
			    (0.15*_Course2plus)
			,2)
			
			RETURN
			_Final *100
		formatString: 0
		displayFolder: Boxphish
		lineageTag: bf6b9046-8834-4eae-a18f-9a32a63a50b8

		annotation PBI_FormatHint = {"isDecimal":true}

