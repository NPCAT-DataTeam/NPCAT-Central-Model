	/// 
	/// VAR LatestVisitDatePerPlace =
	/// CALCULATE (
	/// MAX ( 'Safeguarding Visits'[Snapshot Date] ),
	/// ALLEXCEPT (
	/// 'Safeguarding Visits',
	/// 'Safeguarding Visits'[SUID],
	/// 'Calendar'[Date]
	/// )
	/// )
	/// VAR DistintTable =
	/// SUMMARIZE (
	/// 'Safeguarding Visits',
	/// 'Safeguarding Visits'[SUID],
	/// "Most Recent Date", LatestVisitDatePerPlace
	/// )
	/// RETURN
	/// CALCULATE (
	/// COUNTROWS ( DistintTable ),
	/// REMOVEFILTERS (
	/// 'Safeguarding Visits'[Safeguarding Tier],
	/// 'Safeguarding Visits'[Safeguarding Statutory Tier]
	/// )
	/// )
	measure 'Most Recent Visits' =
			
			VAR LatestVisitDatePerPlace =
			    CALCULATE (
			        MAX ( 'Safeguarding Visits'[Snapshot Date] ),
			        ALLEXCEPT (
			            'Safeguarding Visits',
			            'Safeguarding Visits'[SUID],
			            'Calendar'[Date]
			        )
			    )
			VAR DistintTable =
			    SUMMARIZE (
			        'Safeguarding Visits',
			        'Safeguarding Visits'[SUID],
			        "Most Recent Date", LatestVisitDatePerPlace
			    )
			RETURN
			    CALCULATE (
			        COUNTROWS ( DistintTable ),
			        REMOVEFILTERS (
			            'Safeguarding Visits'[Safeguarding Tier],
			            'Safeguarding Visits'[Safeguarding Statutory Tier]
			        )
			    )
		displayFolder: Safeguarding
		lineageTag: 7abe60af-a685-4fc7-acc3-ab62bb1e25cc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// 
	/// COUNTROWS (
	/// FILTER (
	/// SUMMARIZE (
	/// FILTER (
	/// 'Primary Summative Marks (South)',
	/// 'Primary Summative Marks (South)'[Assessment Name] = "Reading"
	/// && 'Primary Summative Marks (South)'[Variation from ARE] >= 0
	/// || 'Primary Summative Marks (South)'[Assessment Name] = "Writing"
	/// && 'Primary Summative Marks (South)'[Variation from ARE] >= 0
	/// || 'Primary Summative Marks (South)'[Assessment Name] = "Maths"
	/// && 'Primary Summative Marks (South)'[Variation from ARE] >= 0
	/// ),
	/// 'Primary Summative Marks (South)'[Globally Unique Student ID],
	/// 'Primary Summative Marks (South)'[Assessment Period],
	/// 'Primary Summative Marks (South)'[Academic Year Start],
	/// "Distinct_Count", DISTINCTCOUNT ( 'Primary Summative Marks (South)'[Assessment Name] )
	/// ),
	/// [Distinct_Count] = 3
	/// )
	/// )
	measure '2. At or Above (Period ARE Target) - CRWM' =
			
			COUNTROWS (
			    FILTER (
			        SUMMARIZE (
			            FILTER (
			                'Primary Summative Marks (South)',
			                'Primary Summative Marks (South)'[Assessment Name] = "Reading"
			                    && 'Primary Summative Marks (South)'[Variation from ARE] >= 0
			                    || 'Primary Summative Marks (South)'[Assessment Name] = "Writing"
			                    && 'Primary Summative Marks (South)'[Variation from ARE] >= 0
			                    || 'Primary Summative Marks (South)'[Assessment Name] = "Maths"
			                    && 'Primary Summative Marks (South)'[Variation from ARE] >= 0
			            ),
			            'Primary Summative Marks (South)'[Globally Unique Student ID],
			            'Primary Summative Marks (South)'[Assessment Period],
			            'Primary Summative Marks (South)'[Academic Year Start],
			            "Distinct_Count", DISTINCTCOUNT ( 'Primary Summative Marks (South)'[Assessment Name] )
			        ),
			        [Distinct_Count] = 3
			    )
			)
		formatString: 0
