	/// 
	/// VAR _LastDate =
	/// MAX ( 'Calendar'[Date] )
	/// RETURN
	/// CALCULATE (
	/// DISTINCTCOUNT ( 'Student Indicies'[Globally Unique Student ID] ),
	/// 'Student Indicies'[RELEASE_YEAR] = 2025,
	/// 'Student Database (Full)'[DOA] <= _LastDate,
	/// 'Student Database (Full)'[Leaving date] >= _LastDate
	/// || ISBLANK ( 'Student Database (Full)'[Leaving date] ),
	/// 'Calendar'[Date] = _LastDate
	/// )
	measure 'Students on Roll (IDACI)' =
			
			VAR _LastDate =
			    MAX ( 'Calendar'[Date] )
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( 'Student Indicies'[Globally Unique Student ID] ),
			        'Student Indicies'[RELEASE_YEAR] = 2025,
			        'Student Database (Full)'[DOA] <= _LastDate,
			        'Student Database (Full)'[Leaving date] >= _LastDate
			            || ISBLANK ( 'Student Database (Full)'[Leaving date] ),
			        'Calendar'[Date] = _LastDate
			    )
		formatString: 0
		displayFolder: Student Measures\IDACI Measures\Previous setting
		lineageTag: 77a25785-b321-4d6b-88e2-08b550ca05c7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

