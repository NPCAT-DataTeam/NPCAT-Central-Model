	/// 
	/// VAR __PREV_YEAR =
	/// CALCULATE ( [Persistent Absence %], DATEADD ( 'Calendar'[Date], -1, YEAR ) )
	/// RETURN
	/// DIVIDE ( [Persistent Absence %] - __PREV_YEAR, __PREV_YEAR )
	measure 'Persistent Absence % YoY %' =
			
			VAR __PREV_YEAR =
			    CALCULATE ( [Persistent Absence %], DATEADD ( 'Calendar'[Date], -1, YEAR ) )
			RETURN
			    DIVIDE ( [Persistent Absence %] - __PREV_YEAR, __PREV_YEAR )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Persistent Absence
		lineageTag: 2e7954ca-8774-4676-a7c9-e7e0d29022a6

