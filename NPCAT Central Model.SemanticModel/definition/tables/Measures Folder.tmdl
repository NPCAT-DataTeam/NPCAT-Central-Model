	/// )
	/// VAR Op_Diff = [Selected Subject National Percentage Grade 9 Difference]
	/// VAR Difference =
	/// IF (
	/// ISBLANK ( [Selected Subject National Percentage Grade 9 Difference] ),
	/// BLANK (),
	/// FORMAT ( [Selected Subject National Percentage Grade 9 Difference], "0.0%" )
	/// )
	/// VAR Operator =
	/// SWITCH (
	/// TRUE,
	/// ISBLANK ( Difference ), "",
	/// Op_Diff >= 0, " +",
	/// Op_Diff < 0, " "
	/// )
	/// VAR Actual =
	/// IF (
	/// ISBLANK ( [Subject Grade 9+] ),
	/// BLANK (),
	/// FORMAT ( [Subject Grade 9+], "0.0%" )
	/// )
	/// VAR Final =
	/// Actual & UNICHAR ( 10 ) & "(" & NationalValue & ")" & Operator
	/// & IF ( ISBLANK ( Difference ), "", Difference )
	/// RETURN
	/// IF ( ISBLANK ( Actual ), BLANK (), Final )
	measure 'Selected Subject National Percentage Grade 9 KPI' =
			
			VAR NationalValue =
			    IF (
			        ISBLANK ( [Selected Subject National Percentage Grade 9] ),
			        "N/A",
			        FORMAT ( [Selected Subject National Percentage Grade 9], "0.0%" )
			    )
			VAR Op_Diff = [Selected Subject National Percentage Grade 9 Difference]
			VAR Difference =
			    IF (
			        ISBLANK ( [Selected Subject National Percentage Grade 9 Difference] ),
			        BLANK (),
			        FORMAT ( [Selected Subject National Percentage Grade 9 Difference], "0.0%" )
			    )
			VAR Operator =
			    SWITCH (
			        TRUE,
			        ISBLANK ( Difference ), "",
			        Op_Diff >= 0, " +",
			        Op_Diff < 0, " "
			    )
			VAR Actual =
			    IF (
			        ISBLANK ( [Subject Grade 9+] ),
			        BLANK (),
			        FORMAT ( [Subject Grade 9+], "0.0%" )
			    )
			VAR Final =
			    Actual & UNICHAR ( 10 ) & "(" & NationalValue & ")" & Operator
			        & IF ( ISBLANK ( Difference ), "", Difference )
			RETURN
			    IF ( ISBLANK ( Actual ), BLANK (), Final )
