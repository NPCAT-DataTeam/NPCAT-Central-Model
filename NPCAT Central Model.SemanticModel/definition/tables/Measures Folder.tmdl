	/// 
	/// VAR _LastDate =
	/// MAX ( 'Calendar'[Date] )
	/// VAR _Table =
	/// FILTER (
	/// 'Student Indicies',
	/// NOT ( [Decile] = "Undefined" )
	/// && 'Student Indicies'[RELEASE_YEAR] = 2025 && 'Student Indicies'[Category] = "IDACI"
	/// )
	/// VAR _TableWithDecile =
	/// ADDCOLUMNS ( _Table, "DecileValue", VALUE ( 'Student Indicies'[Decile] ) )
	/// RETURN
	/// CALCULATE (
	/// AVERAGEX ( _TableWithDecile, VALUE ( [Decile] ) ),
	/// 'Student Indicies'[Category] = "IDACI",
	/// 'Student Database (Full)'[DOA] <= _LastDate,
	/// 'Student Database (Full)'[Leaving date] > _LastDate
	/// || ISBLANK ( 'Student Database (Full)'[Leaving date] ),
	/// 'Calendar'[Date] = _LastDate
	/// )
	measure 'IDACI Decile' =
			
			VAR _LastDate =
			    MAX ( 'Calendar'[Date] )
			VAR _Table =
			    FILTER (
			        'Student Indicies',
			        NOT ( [Decile] = "Undefined" )
			            && 'Student Indicies'[RELEASE_YEAR] = 2025 && 'Student Indicies'[Category] = "IDACI"
			    )
			VAR _TableWithDecile =
			    ADDCOLUMNS ( _Table, "DecileValue", VALUE ( 'Student Indicies'[Decile] ) )
			RETURN
			    CALCULATE (
			        AVERAGEX ( _TableWithDecile, VALUE ( [Decile] ) ),
			        'Student Indicies'[Category] = "IDACI",
			        'Student Database (Full)'[DOA] <= _LastDate,
			        'Student Database (Full)'[Leaving date] > _LastDate
			            || ISBLANK ( 'Student Database (Full)'[Leaving date] ),
			        'Calendar'[Date] = _LastDate
			    )
		formatString: 0.0
		displayFolder: Student Measures\IDACI Measures\Previous setting
		lineageTag: cabc9c67-028b-4fa5-bdbf-b9693fc60077

		changedProperty = FormatString

