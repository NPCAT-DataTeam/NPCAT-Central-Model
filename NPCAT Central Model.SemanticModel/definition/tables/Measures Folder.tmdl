	/// REMOVEFILTERS ( Suppliers[Supplier Name] )
	/// )
	/// RETURN
	/// DIVIDE ( Supplier, Overall )
	measure 'Supplier Share %' =
			
			VAR Supplier = [AP Balance (£)]
			VAR Overall =
			    CALCULATE (
			        [AP Balance (£)],
			        REMOVEFILTERS ( Creditors[Account] ),
			        REMOVEFILTERS ( Suppliers[Supplier Name] )
			    )
			RETURN
			    DIVIDE ( Supplier, Overall )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Finance Measures\Creditors
		lineageTag: b695cbe1-9783-4b2e-8f49-3434f7321798

