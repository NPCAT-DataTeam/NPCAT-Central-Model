	/// 
	/// CALCULATE (
	/// DISTINCTCOUNT ( 'Student Database (Full)'[Globally Unique Student ID] ),
	/// NOT ( 'Student Database (Full)'[Year] IN { "Leaver", "Nursery" } )
	/// )
	/// + (
	/// CALCULATE (
	/// DISTINCTCOUNT ( 'Student Database (Full)'[Globally Unique Student ID] ),
	/// 'Student Database (Full)'[Year] IN { "Nursery" }
	/// ) * 0.5
	/// )
	measure 'Students On Roll FTE (Current Students on Roll with Nursery as 0.5)' =
			
			CALCULATE (
			    DISTINCTCOUNT ( 'Student Database (Full)'[Globally Unique Student ID] ),
			    NOT ( 'Student Database (Full)'[Year] IN { "Leaver", "Nursery" } )
			)
			    + (
			        CALCULATE (
			            DISTINCTCOUNT ( 'Student Database (Full)'[Globally Unique Student ID] ),
			            'Student Database (Full)'[Year] IN { "Nursery" }
			        ) * 0.5
			    )
		formatString: #,0.0
		displayFolder: Finance Measures
		lineageTag: de8c7f68-e6eb-4d04-9244-dcf9d70ade8d

	/// 
	/// DIVIDE (
	/// [Persistent Absence YTD],
	/// CALCULATE (
	/// DISTINCTCOUNT ( Attendance[Unique Student ID] ),
	/// Attendance[Redaction Check] <> 1,
	/// Attendance[On Roll] <> "Unenrolled",
	/// Attendance[Compulsory Age] = 1
	/// )
	/// )
	measure 'Persistent Absence %' =
			
			DIVIDE (
			    [Persistent Absence YTD],
			    CALCULATE (
			        DISTINCTCOUNT ( Attendance[Unique Student ID] ),
			        Attendance[Redaction Check] <> 1,
			        Attendance[On Roll] <> "Unenrolled",
			        Attendance[Compulsory Age] = 1
			    )
