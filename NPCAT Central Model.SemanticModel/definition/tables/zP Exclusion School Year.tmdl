	partition 'zP Exclusion School Year-71ef1192-e074-437d-99ac-e419019b1cfd' = calculated
		mode: import
		source =
				
				VAR CurrentYear =CALCULATE(Max('Calendar'[School Year]),'Calendar'[Current School Year Offset] = 0)
				VAR LastYear =CALCULATE(Max('Calendar'[School Year]),'Calendar'[Current School Year Offset] = -1)
				VAR TwoYearAgo =CALCULATE(Max('Calendar'[School Year]),'Calendar'[Current School Year Offset] = -2)
				
				
				RETURN
				{
				    (TwoYearAgo, NAMEOF('Measures Folder'[Fixed Term Exclusion Students -2 Years]), 0),
				    (LastYear, NAMEOF('Measures Folder'[Fixed Term Exclusion Students -1 Years]), 1),
				    (CurrentYear, NAMEOF('Measures Folder'[Fixed Term Exclusion Students YTD]), 2),
				    ("SPLY", NAMEOF('Measures Folder'[Fixed Term Exclusion Students YTD SPLY]), 3),
				    (TwoYearAgo, NAMEOF([Percentage Excluded -2 Years]), 4),
				    (LastYear, NAMEOF([Percentage Excluded -1 Years]), 5),
				    (CurrentYear, NAMEOF([Percentage Excluded YTD]), 6),
				    ("SPLY", NAMEOF([Percentage Excluded YTD SPLY]), 7),
				    (TwoYearAgo, NAMEOF([Fixed Term Exclusions Incidents -2 Years]), 8),
				    (LastYear, NAMEOF([Fixed Term Exclusions Incidents -1 Years]), 9),
				    (CurrentYear, NAMEOF([Fixed Term Exclusions Incidents YTD]), 10),
				    ("SPLY", NAMEOF([Fixed Term Exclusions Incidents YTD SPLY]), 11),
				    (TwoYearAgo ,NAMEOF([Fixed Term Exclusion Sessions -2 Years]),12),
				    (LastYear ,NAMEOF([Fixed Term Exclusion Sessions -1 Years]),13),
				    (CurrentYear ,NAMEOF([Fixed Term Exclusion Sessions YTD]),14),
				    ("SPLY" ,NAMEOF([Fixed Term Exclusion Sessions SPLY]),15)
				}

	annotation PBI_Id = 8423d71a02754bcea41bea958da7e8cf

