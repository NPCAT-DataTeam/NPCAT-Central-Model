	column 'Measure Type' =
			
			SWITCH (TRUE(),
			    CONTAINSSTRING (
			        [Zp Exclusion School Year Fields],
			        "Percentage"
			    ), "Percentage",
			    CONTAINSSTRING (
			        [Zp Exclusion School Year Fields],
			        "Students"),
			        "# Students",
			    CONTAINSSTRING (
			        [Zp Exclusion School Year Fields],
			        "Incidents"),
			        "# Incidents",
