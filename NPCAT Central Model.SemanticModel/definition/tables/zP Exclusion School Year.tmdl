	column YTD =
			
			SWITCH (TRUE(),
			    CONTAINSSTRING (
			        [Zp Exclusion School Year Fields],
			        "SPLY"
			    ), "SPLY",
			    CONTAINSSTRING (
			        [Zp Exclusion School Year Fields],
