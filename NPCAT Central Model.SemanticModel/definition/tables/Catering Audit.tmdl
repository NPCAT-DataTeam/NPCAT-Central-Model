	column SUID-Audit
		dataType: string
		lineageTag: 0c403d62-483f-4d0d-895d-d5c6b2f4a122
		summarizeBy: none
		sourceColumn: SUID-Audit

		annotation SummarizationSetBy = Automatic

	column 'Is Most Recent Catering Audit' =
			
			var __School = 'Catering Audit'[SUID]
			var __MostRecentDate = CALCULATE(MAX('Catering Audit'[Date of Quality Standards Audit]), ALL('Catering Audit'),'Catering Audit'[SUID]=__School)
			
			Return
			If ('Catering Audit'[Date of Quality Standards Audit] = __MostRecentDate,"Yes","No")
		lineageTag: ccd08f79-aee0-4d43-beb3-8a2c2eba48c2
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Last Catering Audit SubIndex' =
			
			var __School = 'Catering Audit'[SUID]
			var __MostRecentDate = CALCULATE(MAX('Catering Audit'[Subgroup Index]), ALL('Catering Audit'),'Catering Audit'[SUID]=__School)
			var _LastAuditID = (__School &"-" & __MostRecentDate-1)
			Return
			IF('Catering Audit'[Merged ID] = _LastAuditID,"Yes","No")
		lineageTag: 25fae2a5-ab54-453f-9db4-af8509d07505
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Average CO2 Levels' =
			
			DIVIDE (
			    [Co2 Reading PPM - Main Kitchen] + 'Catering Audit'[Co2 Reading PPM - Inside Canopy] + 'Catering Audit'[Co2 Reading PPM - Outside Canopy],
			    CALCULATE (
			        COUNTA ( 'Catering Audit'[Co2 Reading PPM - Main Kitchen] )
			            + COUNTA ( 'Catering Audit'[Co2 Reading PPM - Inside Canopy] )
			            + COUNTA ( 'Catering Audit'[Co2 Reading PPM - Outside Canopy] )
			    )
			)
		lineageTag: ec1ca29e-d0b6-44a1-a5f9-eeb799730588
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

