	partition 'zP Behaviour Incidents-783f7ff4-917d-44e7-9d92-fe38ff955a71' = calculated
		mode: import
		source =
				
				
				VAR CurrentYear =CALCULATE(Max('Calendar'[School Year]),'Calendar'[Current School Year Offset] = 0)
				VAR LastYear =CALCULATE(Max('Calendar'[School Year]),'Calendar'[Current School Year Offset] = -1)
				VAR TwoYearAgo =CALCULATE(Max('Calendar'[School Year]),'Calendar'[Current School Year Offset] = -2)
				
				RETURN
				
				{
				    (TwoYearAgo, NAMEOF('Measures Folder'[Behaviour Incidents -2 Years]), 0),
				    (LastYear, NAMEOF('Measures Folder'[Behaviour Incidents -1 Years]), 1),
				    (CurrentYear, NAMEOF('Measures Folder'[Behaviour Incidents YTD]), 2),
				    ("SPLY", NAMEOF('Measures Folder'[Behaviour Incidents SPLY]), 3)
				}

	annotation PBI_Id = 9a8ad97550dd47518c0cc6e50b1ab03d

