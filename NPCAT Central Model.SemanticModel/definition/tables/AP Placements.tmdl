	partition 'AP Placements' = m
		mode: import
		queryGroup: 'Student Data'
		source =
				let
				    Source = PowerPlatform.Dataflows(null),
				    Workspaces = Source{[Id="Workspaces"]}[Data],
				    #"eaf8df50-01b2-41b2-9aef-d580ee473a36" = Workspaces{[workspaceId="eaf8df50-01b2-41b2-9aef-d580ee473a36"]}[Data],
				    #"934b8a2d-49b8-483f-b74f-7a62d47f97b6" = #"eaf8df50-01b2-41b2-9aef-d580ee473a36"{[dataflowId="934b8a2d-49b8-483f-b74f-7a62d47f97b6"]}[Data],
				    #"AP Placements_" = #"934b8a2d-49b8-483f-b74f-7a62d47f97b6"{[entity="AP Placements",version=""]}[Data],
				    #"Added Custom" = Table.AddColumn(#"AP Placements_", "Academic Year", each if Date.Month([Start Date]) >= 9
				    then Date.Year([Start Date])
				    else Date.Year([Start Date]) - 1),
				    #"Inserted Merged Column" = Table.AddColumn(#"Added Custom", "STUDENT UNIQUE YEAR ID", each Text.Combine({[STUDENT_UNIQUE_ID], Text.From([Academic Year], "en-GB")}, "-"), type text)
				in
				    #"Inserted Merged Column"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

