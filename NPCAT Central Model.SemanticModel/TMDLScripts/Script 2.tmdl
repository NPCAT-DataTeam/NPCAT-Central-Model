			/// 
			/// VAR _ELGTable =
			///     CALCULATETABLE (
			///         SUMMARIZE (
			///             'EYFS ELGs/GLD',
			///             'EYFS ELGs/GLD'[Globally Unique ID],
			///             "COUNT of EXP ELGs", COUNTROWS ( 'EYFS ELGs/GLD' )
			///         ),
			///         'EYFS ELGs/GLD'[Grade] = "2"
			///     )
			/// VAR _YearCount =
			///     DISTINCTCOUNT ( 'EYFS ELGs/GLD'[Academic Year] )
			/// VAR _Avg =
			///     DIVIDE (
			///         DIVIDE ( SUMX ( _ELGTable, [COUNT of EXP ELGs] ), _YearCount ),
			///         [EYFS No. Pupils (Included in Calc)]
			///     )
			/// RETURN
			///     IF (
			///         ISBLANK ( _Avg ),
			///         IF ( ISBLANK ( [EYFS No. Pupils (Included in Calc)] ), BLANK (), 0 ),
			///         _Avg
			///     )
			measure 'EYFS AVG No of ELG''s at EXP' =
					
					VAR _ELGTable =
					    CALCULATETABLE (
					        SUMMARIZE (
					            'EYFS ELGs/GLD',
					            'EYFS ELGs/GLD'[Globally Unique ID],
					            "COUNT of EXP ELGs", COUNTROWS ( 'EYFS ELGs/GLD' )
					        ),
					        'EYFS ELGs/GLD'[Grade] = "2"
					    )
					VAR _YearCount =
					    DISTINCTCOUNT ( 'EYFS ELGs/GLD'[Academic Year] )
					VAR _Avg =
					    DIVIDE (
					        DIVIDE ( SUMX ( _ELGTable, [COUNT of EXP ELGs] ), _YearCount ),
					        [EYFS No. Pupils (Included in Calc)]
					    )
					RETURN
					    IF (
					        ISBLANK ( _Avg ),
					        IF ( ISBLANK ( [EYFS No. Pupils (Included in Calc)] ), BLANK (), 0 ),
					        _Avg
					    )
				formatString: 0.0
				displayFolder: Statutory EYFS
				lineageTag: b0db0741-9b7b-4b96-bd68-f7ac2778a18e

			/// 
