			column 'On Roll' =
					
					VAR MarkDate = Attendance[Mark Date]
					VAR StudentID = Attendance[Unique Sudent ID - Academic Year]
					VAR IsOnRoll =
					    CALCULATE(
					        COUNTROWS('Student Year Groups'),
					        FILTER(
					            'Student Year Groups',
					            'Student Year Groups'[Unique Student ID - Academic Year] = StudentID &&
					            MarkDate >= 'Student Year Groups'[Start Date] &&
					            MarkDate <= 'Student Year Groups'[End Date]
					        )
					    )
					RETURN
					    IF(IsOnRoll > 0, "On Roll", "Unenrolled")
				lineageTag: 95e3aeed-4c58-43dc-8e60-d1dc3a670645
				summarizeBy: none

				annotation SummarizationSetBy = Automatic

			column 'Compulsory Age' =
					VAR _Result = CALCULATE(
					    SELECTEDVALUE('Demographics'[Tag]),
					    FILTER(
					        'Demographics',
					        'Demographics'[Person Unique ID] = Attendance[Unique Student ID]
					        && 'Demographics'[Tag] = "Compulsory School Age"
					        && 'Demographics'[Tag Start Date] <= Attendance[Mark Date]
					        && 'Demographics'[Tag End Date] >= Attendance[Mark Date]
					    )
					)
					RETURN
					IF(ISBLANK(_Result),0,1)
				formatString: 0
				lineageTag: d05b1256-2fbf-4a88-a632-37ebe89c5207
				summarizeBy: sum

				annotation SummarizationSetBy = Automatic

			column 'Minutes Late'
				dataType: int64
				formatString: 0
				lineageTag: 72fbc730-5a17-4719-8809-6bef4bb72512
				summarizeBy: sum
				sourceColumn: Minutes Late

				annotation SummarizationSetBy = Automatic

			column 'Attendance Bracket' =
					
					IF (
					    'Attendance'[mark] = "L",
					    SWITCH (
					        TRUE(),
					        'Attendance'[Minutes Late] <= 5, "1-5 Mins (Grace)",
					        'Attendance'[Minutes Late] <= 15, "6-15 Mins",
					        'Attendance'[Minutes Late] <= 60, "16-60 Mins",
					        "Over 60 Mins"
					    ),
					    "Not Late Mark" -- This is what shows if the mark is NOT "L"
					)
				lineageTag: da6d430d-2709-4c91-8f6a-9f3ba7270c5b
				summarizeBy: none

				annotation SummarizationSetBy = Automatic

