			measure 'LTS Total Days Lost YTD SPLY' =
					
					CALCULATE ( [LTS Total Days Lost YTD], SAMEPERIODLASTYEAR ( 'Calendar'[Date] ) )
				formatString: #,0.0
				displayFolder: Human Resources\Long Term Sickness
