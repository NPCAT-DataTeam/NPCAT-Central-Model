			/// VAR Actual =
			///     IF (
			///         ISBLANK ( [Headline Overall P8] ),
			///         "N/A",
			///         FORMAT ( ROUND ( [Headline Overall P8], 2 ), "0.00" )
			///     )
			/// VAR Final =
			///     Actual & UNICHAR ( 10 ) & "(" & NationalValue & ")" & Operator & Difference
			/// RETURN
			///     IF (
			///         Actual = "N/A",
			///         (
			///             Actual & UNICHAR ( 10 ) & "(" & NationalValue & ")"
			///         ),
			///         Final
			///     )
			measure 'Selected National P8 Overall KPI' =
					
