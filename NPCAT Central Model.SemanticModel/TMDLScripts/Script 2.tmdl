			/// 
			/// VAR _MaxDate =
			///     MAX ( 'Calendar'[Date] )
			/// VAR _MinDate =
			///     MIN ( 'Calendar'[Date] )
			/// RETURN
			///     CALCULATE (
			///         DISTINCTCOUNT ( 'Attendance'[Unique Student ID] ),
			///         AND (
			///             'Student Year Groups'[Start Date] >= _MinDate,
			///             'Student Year Groups'[Start Date] <= _MaxDate
			///         ),
			///         'Student Year Groups'[In Year Joiner] = "In Year Joiner"
			///     )
			measure 'In Year Joiners' =
					
					VAR _MaxDate =
					    MAX ( 'Calendar'[Date] )
					VAR _MinDate =
					    MIN ( 'Calendar'[Date] )
					RETURN
					    CALCULATE (
					        DISTINCTCOUNT ( 'Attendance'[Unique Student ID] ),
					        AND (
					            'Student Year Groups'[Start Date] >= _MinDate,
					            'Student Year Groups'[Start Date] <= _MaxDate
					        ),
					        'Student Year Groups'[In Year Joiner] = "In Year Joiner"
					    )
				displayFolder: Student Measures
				lineageTag: ef13e072-b38b-49b5-b1ef-d82d2e6b43de

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			/// 
			/// VAR _MaxDate =
			///     MAX ( 'Calendar'[Date] )
			/// VAR _MinDate =
			///     MIN ( 'Calendar'[Date] )
			/// RETURN
			///     CALCULATE (
			///         DISTINCTCOUNT ( 'Attendance'[Unique Student ID] ),
			///         AND (
			///             'Student Year Groups'[End date] >= _MinDate,
			///             'Student Year Groups'[End Date] <= _MaxDate
			///         ),
			///         //'Student Database (Full)'[DOA] >= _LastDate,
			///         //'Student Database (Full)'[Leaving date] <= _LastDate,
			///         //'Demographics Enrollment'[Date List] = _LastDate,
			///         //'Demographics Enrollment'[Enrollment Flag] = "Unenrolled"
			///         'Student Year Groups'[In Year Leaver Flag] = "In Year Leaver"
			///     )
			measure 'In Year Leavers' =
					
					VAR _MaxDate =
					    MAX ( 'Calendar'[Date] )
					VAR _MinDate =
					    MIN ( 'Calendar'[Date] )
					RETURN
					    CALCULATE (
					        DISTINCTCOUNT ( 'Attendance'[Unique Student ID] ),
					        AND (
					            'Student Year Groups'[End date] >= _MinDate,
					            'Student Year Groups'[End Date] <= _MaxDate
					        ),
					        //'Student Database (Full)'[DOA] >= _LastDate,
					        //'Student Database (Full)'[Leaving date] <= _LastDate,
					        //'Demographics Enrollment'[Date List] = _LastDate,
					        //'Demographics Enrollment'[Enrollment Flag] = "Unenrolled"
					        'Student Year Groups'[In Year Leaver Flag] = "In Year Leaver"
					    )
				formatString: 0
				displayFolder: Student Measures
				lineageTag: 77680171-7254-4107-b400-622417b753b4

