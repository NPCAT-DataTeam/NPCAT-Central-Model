			/// 
			/// VAR _Yearselector =
			///     MAX ( 'Calendar'[Current School Year Offset] ) - 1
			/// VAR _StudentCount =
			///     CALCULATE (
			///         DISTINCTCOUNT ( Phonics[Global Unique ID] ),
			///         REMOVEFILTERS ( 'Calendar' ),
			///         'Calendar'[Current School Year Offset] = _Yearselector
			///     )
			/// RETURN
			///     _StudentCount
			measure 'Phonics No. Pupils PY' =
					
					VAR _Yearselector =
					    MAX ( 'Calendar'[Current School Year Offset] ) - 1
					VAR _StudentCount =
					    CALCULATE (
					        DISTINCTCOUNT ( Phonics[Global Unique ID] ),
					        REMOVEFILTERS ( 'Calendar' ),
					        'Calendar'[Current School Year Offset] = _Yearselector
					    )
					RETURN
					    _StudentCount
