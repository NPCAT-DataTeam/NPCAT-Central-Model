			/// 
			/// TOTALYTD (
			///     CALCULATE (
			///         DIVIDE (
			///             CALCULATE ( COUNTA ( 'Attendance'[Mark] ), 'Attendance'[Mark] IN { "N" } ),
			///             SUM ( 'Attendance'[Sessions] )
			///         ),
			///         'Calendar'[FutureDate] IN { "Past" }
			///     ),
			///     'Calendar'[Date],
			///     "31/08"
			/// ) + 0
			measure 'No Reason Absence % YTD' =
					
					TOTALYTD (
					    CALCULATE (
					        DIVIDE (
					            CALCULATE ( COUNTA ( 'Attendance'[Mark] ), 'Attendance'[Mark] IN { "N" } ),
					            SUM ( 'Attendance'[Sessions] )
					        ),
					        'Calendar'[FutureDate] IN { "Past" }
					    ),
					    'Calendar'[Date],
					    "31/08"
					) + 0
