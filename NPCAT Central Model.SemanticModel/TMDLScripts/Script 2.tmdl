			/// 
			/// VAR _LastDate =
			///     MAX ( 'Calendar'[Date] )
			/// VAR _Table =
			///     FILTER (
			///         'Student Indicies',
			///         NOT ( [Rank] = "Undefined" )
			///             && 'Student Indicies'[Category] = "Barriers"
			///     )
			/// VAR _TableWithRank =
			///     ADDCOLUMNS ( _Table, "RankValue", VALUE ( 'Student Indicies'[Rank] ) )
			/// RETURN
			///     CALCULATE (
			///         AVERAGEX ( _TableWithRank, VALUE ( [Rank] ) ),
			///         'Student Indicies'[Category] = "Barriers",
			///         'Student Database (Full)'[DOA] <= _LastDate,
			///         'Student Database (Full)'[Leaving date] > _LastDate
			///             || ISBLANK ( 'Student Database (Full)'[Leaving date] ),
			///         'Calendar'[Date] = _LastDate
			///     )
			measure 'Barriers Rank' =
					
					VAR _LastDate =
					    MAX ( 'Calendar'[Date] )
					VAR _Table =
					    FILTER (
					        'Student Indicies',
					        NOT ( [Rank] = "Undefined" )
					            && 'Student Indicies'[Category] = "Barriers"
					    )
					VAR _TableWithRank =
					    ADDCOLUMNS ( _Table, "RankValue", VALUE ( 'Student Indicies'[Rank] ) )
					RETURN
					    CALCULATE (
					        AVERAGEX ( _TableWithRank, VALUE ( [Rank] ) ),
					        'Student Indicies'[Category] = "Barriers",
					        'Student Database (Full)'[DOA] <= _LastDate,
					        'Student Database (Full)'[Leaving date] > _LastDate
					            || ISBLANK ( 'Student Database (Full)'[Leaving date] ),
					        'Calendar'[Date] = _LastDate
					    )
				formatString: #,##0
				displayFolder: Unused
				lineageTag: 3226809e-5ea0-432a-b6f4-9a6fdfe96989

			/// 
			/// DIVIDE (
			///     [Most Books] + [Some Books] + [No Books],
