			/// 
			/// SWITCH (
			///     TRUE,
			///     [2. Avg Baseline Points] = 0, "No Baseline",
			///     [2. Avg Baseline Points] < 2.5, "Below",
			///     [2. Avg Baseline Points] < 3.5, "Working Towards",
			///     [2. Avg Baseline Points] < 4.5, "At",
			///     [2. Avg Baseline Points] >= 4.5, "Above",
			///     "N/A"
			/// )
			measure '2. Avg Baseline Grade' =
					
					SWITCH (
					    TRUE,
					    [2. Avg Baseline Points] = 0, "No Baseline",
					    [2. Avg Baseline Points] < 2.5, "Below",
					    [2. Avg Baseline Points] < 3.5, "Working Towards",
					    [2. Avg Baseline Points] < 4.5, "At",
					    [2. Avg Baseline Points] >= 4.5, "Above",
