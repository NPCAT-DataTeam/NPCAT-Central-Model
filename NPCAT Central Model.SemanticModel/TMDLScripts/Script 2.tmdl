			/// 
			/// VAR MaxDate = MAX(Calendar[Date])
			/// VAR MonthDiff = SWITCH(TRUE(),MONTH(MaxDate) <= 8, 7,MONTH(MaxDate) = 1, 7,MONTH(MaxDate) > 8, 6)
			/// VAR _6Month = DATE(YEAR(MaxDate),MONTH(MaxDate)-MonthDiff,DAY(MaxDate))
			/// VAR _1Month = DATE(YEAR(MaxDate),MONTH(MaxDate)-1,DAY(MaxDate))
			/// VAR CourseFails = 
			/// SUMMARIZECOLUMNS (
			///     'Employees'[Work Email],
			///     "Past 6 Months",
			///         CALCULATE (
			///             COUNTROWS ( 'Boxphish Courses' ),
			///             OR('Boxphish Courses'[Course Outcome] = "Fail", 'Boxphish Courses'[Course Outcome] = "Incomplete"),
			///             'Boxphish Courses'[Date Completed] >= _6Month,
			///             'Boxphish Courses'[Date Sent]<=_1Month
			///         )
			///    
			/// )
			/// VAR _2FailedCourse =
			///     CALCULATE (
			///         [Staff Employed (Time)],
			///         FILTER(CourseFails,[Past 6 Months] > 1)
			///     )
			/// 
			/// RETURN
			/// DIVIDE ( _2FailedCourse, [Staff Employed (Time)] )
			measure '% Failed 2+ Courses 6 Months' = ```
					
					VAR MaxDate = MAX(Calendar[Date])
					VAR MonthDiff = SWITCH(TRUE(),MONTH(MaxDate) <= 8, 7,MONTH(MaxDate) = 1, 7,MONTH(MaxDate) > 8, 6)
					VAR _6Month = DATE(YEAR(MaxDate),MONTH(MaxDate)-MonthDiff,DAY(MaxDate))
					VAR _1Month = DATE(YEAR(MaxDate),MONTH(MaxDate)-1,DAY(MaxDate))
					VAR CourseFails = 
					SUMMARIZECOLUMNS (
					    'Employees'[Work Email],
					    "Past 6 Months",
					        CALCULATE (
					            COUNTROWS ( 'Boxphish Courses' ),
					            OR('Boxphish Courses'[Course Outcome] = "Fail", 'Boxphish Courses'[Course Outcome] = "Incomplete"),
					            'Boxphish Courses'[Date Completed] >= _6Month,
					            'Boxphish Courses'[Date Sent]<=_1Month
					        )
					   
					)
					VAR _2FailedCourse =
					    CALCULATE (
					        [Staff Employed (Time)],
					        FILTER(CourseFails,[Past 6 Months] > 1)
					    )
					
					RETURN
					DIVIDE ( _2FailedCourse, [Staff Employed (Time)] )
