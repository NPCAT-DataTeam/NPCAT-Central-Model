			/// 
			/// VAR _Total = [Students on Roll]
			/// VAR _EthinicBackground =
			///     CALCULATE (
			///         [Students on Roll],
			///         NOT 'Student Database (Full)'[Ethnicity Code]
			///             IN { "WBRI", "WENG", "WIRI", "WOWB", "WSCO", "WWEL", "NOBT", "REFU" }
			///     ) + 0
			/// RETURN
			///     DIVIDE ( _EthinicBackground, _Total )
			measure 'Ethnicity %' =
					
					VAR _Total = [Students on Roll]
					VAR _EthinicBackground =
					    CALCULATE (
					        [Students on Roll],
					        NOT 'Student Database (Full)'[Ethnicity Code]
					            IN { "WBRI", "WENG", "WIRI", "WOWB", "WSCO", "WWEL", "NOBT", "REFU" }
					    ) + 0
					RETURN
					    DIVIDE ( _EthinicBackground, _Total )
				formatString: 0.0%;-0.0%;0.0%
				displayFolder: Student Measures
				lineageTag: 3117340c-30fb-486d-8ca5-5f55408a392b

			/// 
			/// CALCULATE ( [Ethnicity %], 'Calendar'[Current School Year Offset] = 0 )
			measure 'Ethnicity % CY' =
					
					CALCULATE ( [Ethnicity %], 'Calendar'[Current School Year Offset] = 0 )
				formatString: 0.0%;-0.0%;0.0%
				displayFolder: Student Measures
				lineageTag: e1bc84c6-fdab-42a9-b3b5-2553437e1491

			/// 
			/// VAR _Offset =
			///     MAX ( 'Calendar'[Current School Year Offset] ) - 1
			/// RETURN
			///     CALCULATE (
			///         [Ethnicity %],
			///         'Calendar'[Current School Year Offset] = _Offset,
			///         REMOVEFILTERS ( 'Calendar'[School Year] )
			///     )
			measure 'Ethnicity % PY' =
					
					VAR _Offset =
					    MAX ( 'Calendar'[Current School Year Offset] ) - 1
					RETURN
					    CALCULATE (
					        [Ethnicity %],
					        'Calendar'[Current School Year Offset] = _Offset,
					        REMOVEFILTERS ( 'Calendar'[School Year] )
					    )
				formatString: 0.0%;-0.0%;0.0%
