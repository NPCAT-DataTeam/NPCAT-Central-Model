			/// DIVIDE (
			///     [Number of Grades],
			///     CALCULATE (
			///         [Number of Grades],
			///         REMOVEFILTERS ( 'KS4 Assessments'[Grade], 'KS4 Assessments'[Grade Sort] )
			///     )
			/// )
			measure 'Grade %' =
					DIVIDE (
					    [Number of Grades],
