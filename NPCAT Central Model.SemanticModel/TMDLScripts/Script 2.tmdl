			/// 
			/// CALCULATE (
			///     SUM ( 'Management Accounts'[Budget (Full Year)] ),
			///     FILTER (
			///         'Management Accounts',
			///         NOT ( 'Management Accounts'[Expense Department] IN { "Income" } )
			///     )
			/// )
			measure 'Budgeted Expenses' =
					
					CALCULATE (
					    SUM ( 'Management Accounts'[Budget (Full Year)] ),
					    FILTER (
					        'Management Accounts',
					        NOT ( 'Management Accounts'[Expense Department] IN { "Income" } )
					    )
					)
				formatString: "£"#,0;-"£"#,0;"£"#,0
				displayFolder: Finance Measures\3. Budgeted Expenditure
				lineageTag: f6c0c49a-9940-49f6-849e-29683b1a0cae

				annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

			/// 
			/// CALCULATE (
			///     SUM ( 'Management Accounts'[Budget (Full Year)] ),
			///     FILTER (
			///         'Management Accounts',
			///         'Management Accounts'[Expense Department] IN { "Income" }
			///     )
			/// )
			measure 'Budgeted Income' =
					
					CALCULATE (
					    SUM ( 'Management Accounts'[Budget (Full Year)] ),
					    FILTER (
					        'Management Accounts',
					        'Management Accounts'[Expense Department] IN { "Income" }
					    )
					)
				formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
				displayFolder: Finance Measures\3. Budgeted Expenditure
				lineageTag: 65967b1b-2cfe-46dd-b221-66545bae560d

				annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

			/// 
			/// CALCULATE (
			///     SUM ( 'Management Accounts'[Budget (Full Year)] ),
			///     FILTER (
			///         'Management Accounts',
			///         'Management Accounts'[Management Grouping]
			///             IN { "B0", "B1", "B2", "B3", "B4", "B5", "B6" }
			///                 || 'Management Accounts'[CoreNominal] IN { "5164", "5167", "5175", "5185" }
			///     )
			/// )
			measure 'Budgeted Total Staff Cost' =
					
					CALCULATE (
					    SUM ( 'Management Accounts'[Budget (Full Year)] ),
					    FILTER (
					        'Management Accounts',
					        'Management Accounts'[Management Grouping]
					            IN { "B0", "B1", "B2", "B3", "B4", "B5", "B6" }
					                || 'Management Accounts'[CoreNominal] IN { "5164", "5167", "5175", "5185" }
					    )
					)
				displayFolder: Finance Measures\3. Budgeted Expenditure
				lineageTag: 00894971-6575-4835-bb5b-e3a620b8eb90

				annotation PBI_FormatHint = {"isGeneralNumber":true}

