			/// 
			/// VAR _MaxDate =
			///     MAX ( 'Calendar'[Date] )
			/// VAR _ComplianceTable =
			///     CALCULATETABLE (
			///         SUMMARIZE (
			///             'Catering Audit Compliance',
			///             'Catering Audit Compliance'[SUID],
			///             "Numerator",
			///                 CALCULATE (
			///                     COUNTROWS ( 'Catering Audit Compliance' ),
			///                     'Catering Audit Compliance'[Value] = "Yes",
			///                     'Catering Audit'[Date of Quality Standards Audit]
			///                         = MAX ( 'Catering Audit'[Date of Quality Standards Audit] )
			///                 ),
			///             "Denominator",
			///                 CALCULATE (
			///                     COUNTROWS ( 'Catering Audit Compliance' ),
			///                     'Catering Audit'[Date of Quality Standards Audit]
			///                         = MAX ( 'Catering Audit'[Date of Quality Standards Audit] )
			///                 )
			///         ),
			///         'Catering Audit'[Date of Quality Standards Audit] <= _MaxDate
			///     )
			/// VAR _Result =
			///     CALCULATE (
			///         DIVIDE (
			///             SUMX ( _ComplianceTable, [Numerator] ),
			///             SUMX ( _ComplianceTable, [Denominator] )
			///         )
			///     )
			/// RETURN
			///     _Result
			measure 'Compliance% over time' =
					
					VAR _MaxDate =
					    MAX ( 'Calendar'[Date] )
					VAR _ComplianceTable =
					    CALCULATETABLE (
					        SUMMARIZE (
					            'Catering Audit Compliance',
					            'Catering Audit Compliance'[SUID],
					            "Numerator",
					                CALCULATE (
					                    COUNTROWS ( 'Catering Audit Compliance' ),
					                    'Catering Audit Compliance'[Value] = "Yes",
					                    'Catering Audit'[Date of Quality Standards Audit]
					                        = MAX ( 'Catering Audit'[Date of Quality Standards Audit] )
					                ),
					            "Denominator",
					                CALCULATE (
					                    COUNTROWS ( 'Catering Audit Compliance' ),
					                    'Catering Audit'[Date of Quality Standards Audit]
					                        = MAX ( 'Catering Audit'[Date of Quality Standards Audit] )
					                )
					        ),
					        'Catering Audit'[Date of Quality Standards Audit] <= _MaxDate
					    )
					VAR _Result =
					    CALCULATE (
					        DIVIDE (
					            SUMX ( _ComplianceTable, [Numerator] ),
					            SUMX ( _ComplianceTable, [Denominator] )
					        )
					    )
					RETURN
					    _Result
				formatString: 0.0%;-0.0%;0.0%
				displayFolder: Catering Audit
				lineageTag: 2210d7d3-108b-498d-8eee-288bdbd27c5f

				changedProperty = FormatString

			/// 
			/// CALCULATE (
