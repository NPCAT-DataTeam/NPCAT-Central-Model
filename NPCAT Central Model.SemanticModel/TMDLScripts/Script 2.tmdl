			/// 
			/// VAR __Denominator =
			///     CALCULATE (
			///         DISTINCTCOUNT ( 'Health&Safety Actions Dates'[Action Ref Number] ),
			///         FILTER (
			///             'Health&Safety Actions',
			///             'Health&Safety Actions'[Complete Check]
			///                 IN { "Complete (late)", "In Progress (late)", "Complete" }
			///         ),
			///         DATESBETWEEN (
			///             'Calendar'[Date],
			///             MAX ( 'Calendar'[Date] ) - 365,
			///             MAX ( 'Calendar'[Date] )
			///         )
			///     ) + 0
			/// VAR __Numerator =
			///     CALCULATE (
			///         DISTINCTCOUNT ( 'Health&Safety Actions Dates'[Action Ref Number] ),
			///         FILTER (
			///             'Health&Safety Actions',
			///             'Health&Safety Actions'[Complete Check] IN { "Complete", "Complete (late)" }
			///         ),
			///         DATESBETWEEN (
			///             'Calendar'[Date],
			///             MAX ( 'Calendar'[Date] ) - 365,
			///             MAX ( 'Calendar'[Date] )
			///         )
			///     ) + 0
			/// RETURN
			///     CALCULATE ( DIVIDE ( __Numerator, __Denominator ) )
			measure 'Action Compliance' =
					
					VAR __Denominator =
					    CALCULATE (
					        DISTINCTCOUNT ( 'Health&Safety Actions Dates'[Action Ref Number] ),
					        FILTER (
					            'Health&Safety Actions',
					            'Health&Safety Actions'[Complete Check]
					                IN { "Complete (late)", "In Progress (late)", "Complete" }
					        ),
					        DATESBETWEEN (
					            'Calendar'[Date],
					            MAX ( 'Calendar'[Date] ) - 365,
					            MAX ( 'Calendar'[Date] )
					        )
					    ) + 0
					VAR __Numerator =
					    CALCULATE (
					        DISTINCTCOUNT ( 'Health&Safety Actions Dates'[Action Ref Number] ),
					        FILTER (
					            'Health&Safety Actions',
					            'Health&Safety Actions'[Complete Check] IN { "Complete", "Complete (late)" }
					        ),
					        DATESBETWEEN (
					            'Calendar'[Date],
					            MAX ( 'Calendar'[Date] ) - 365,
					            MAX ( 'Calendar'[Date] )
					        )
					    ) + 0
					RETURN
					    CALCULATE ( DIVIDE ( __Numerator, __Denominator ) )
				formatString: 0%;-0%;0%
				displayFolder: H&S Actions
				lineageTag: 9911e435-6afb-4804-b491-ab2e74df440b

			/// 
			/// CALCULATE (
			///     DISTINCTCOUNT ( 'Health&Safety Actions Dates'[Action Ref Number] ),
			///     FILTER (
			///         'Health&Safety Actions',
			///         CONTAINSSTRING ( 'Health&Safety Actions'[Complete Check], "Complete" )
			///     ),
			///     DATESBETWEEN (
			///         'Calendar'[Date],
			///         MAX ( 'Calendar'[Date] ) - 365,
			///         MAX ( 'Calendar'[Date] )
			///     )
			/// )
			measure 'Complete Actions' =
					
					CALCULATE (
					    DISTINCTCOUNT ( 'Health&Safety Actions Dates'[Action Ref Number] ),
					    FILTER (
					        'Health&Safety Actions',
					        CONTAINSSTRING ( 'Health&Safety Actions'[Complete Check], "Complete" )
					    ),
					    DATESBETWEEN (
					        'Calendar'[Date],
					        MAX ( 'Calendar'[Date] ) - 365,
					        MAX ( 'Calendar'[Date] )
					    )
					)
				formatString: 0
