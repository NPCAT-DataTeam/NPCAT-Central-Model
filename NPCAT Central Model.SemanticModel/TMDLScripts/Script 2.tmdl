				summarizeBy: none
				sortByColumn: 'Bucket Sort'

				annotation SummarizationSetBy = Automatic

			column 'Bucket Type' = ```
					
					    SWITCH( TRUE(),
					    CONTAINSSTRING('zP Headlines + Buckets'[zP Headlines + Buckets]," P8"),"Headlines",
					    CONTAINSSTRING('zP Headlines + Buckets'[zP Headlines + Buckets],"Subject"),"Subject",
					    CONTAINSSTRING('zP Headlines + Buckets'[zP Headlines + Buckets],"Class"),"Class",
					    CONTAINSSTRING('zP Headlines + Buckets'[zP Headlines + Buckets],"Target"),"Target",
					    CONTAINSSTRING('zP Headlines + Buckets'[zP Headlines + Buckets],"Grade"),"Grade",
					    CONTAINSSTRING('zP Headlines + Buckets'[zP Headlines + Buckets],"Diff"),"Diff",
					    CONTAINSSTRING('zP Headlines + Buckets'[zP Headlines + Buckets],"P8/SPI"),"P8/SPI",
					    CONTAINSSTRING('zP Headlines + Buckets'[zP Headlines + Buckets],"Residual"),"Residual",
					    CONTAINSSTRING('zP Headlines + Buckets'[zP Headlines + Buckets],"ABCD"),"ABCD",
					    CONTAINSSTRING('zP Headlines + Buckets'[zP Headlines + Buckets],"Effort"),"Effort"
					)
