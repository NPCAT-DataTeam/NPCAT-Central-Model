			/// 
			/// VAR CutOff = [Dynamic Max Date]
			/// RETURN
			///     CALCULATE (
			///         DISTINCTCOUNT ( Creditors[Invoice ID] ),
			///         REMOVEFILTERS ( Calendar[Date] ),
			///         Creditors[Invoice Date] <= CutOff
			///             && (
			///                 ISBLANK ( Creditors[Pay Date] )
			///                     || Creditors[Pay Date] > CutOff
			///             )
			///             && DATEDIFF ( Creditors[Due Date], CutOff, DAY ) > 0
			///             && DATEDIFF ( Creditors[Due Date], CutOff, DAY ) <= 30
			///     )
			measure 'Invoices 0-30-Days' =
					
					VAR CutOff = [Dynamic Max Date]
					RETURN
					    CALCULATE (
					        DISTINCTCOUNT ( Creditors[Invoice ID] ),
					        REMOVEFILTERS ( Calendar[Date] ),
					        Creditors[Invoice Date] <= CutOff
					            && (
					                ISBLANK ( Creditors[Pay Date] )
					                    || Creditors[Pay Date] > CutOff
					            )
					            && DATEDIFF ( Creditors[Due Date], CutOff, DAY ) > 0
					            && DATEDIFF ( Creditors[Due Date], CutOff, DAY ) <= 30
					    )
				formatString: 0
				displayFolder: Finance Measures\Creditors
				lineageTag: 0a342620-fbc8-4f6b-8956-527eff9cafed

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			/// 
			/// VAR _Cutoff = [Dynamic Max Date]
			/// RETURN
			///     CALCULATE (
			///         DISTINCTCOUNT ( Creditors[Account] ),
			///         REMOVEFILTERS ( Calendar[Date] ),
			///         Creditors[Invoice Date] <= _Cutoff
			///             && (
			///                 ISBLANK ( Creditors[Pay Date] )
			///                     || Creditors[Pay Date] > _Cutoff
			///             )
			///     )
			measure 'Suppliers Open' =
					
					VAR _Cutoff = [Dynamic Max Date]
					RETURN
					    CALCULATE (
					        DISTINCTCOUNT ( Creditors[Account] ),
					        REMOVEFILTERS ( Calendar[Date] ),
					        Creditors[Invoice Date] <= _Cutoff
					            && (
					                ISBLANK ( Creditors[Pay Date] )
					                    || Creditors[Pay Date] > _Cutoff
					            )
					    )
				formatString: 0
