			/// 
			/// VAR _FirstDate =
			///     FIRSTDATE ( 'Calendar'[Date] )
			/// RETURN
			///     CALCULATE (
			///         DISTINCTCOUNT ( 'Absences'[Employee Absence Key] ),
			///         'Absences'[Absence Start Date] >= _FirstDate,
			///         'Absences'[Absence End Date] >= _FirstDate
			///             || ISBLANK ( 'Absences'[Absence End Date] ),
			///         'Absences'[Absence Type] = "General Absence"
			///     )
			measure 'General Absence (Count)' =
					
					VAR _FirstDate =
					    FIRSTDATE ( 'Calendar'[Date] )
					RETURN
					    CALCULATE (
					        DISTINCTCOUNT ( 'Absences'[Employee Absence Key] ),
					        'Absences'[Absence Start Date] >= _FirstDate,
					        'Absences'[Absence End Date] >= _FirstDate
					            || ISBLANK ( 'Absences'[Absence End Date] ),
					        'Absences'[Absence Type] = "General Absence"
					    )
				formatString: #,0
				displayFolder: Human Resources\General Absence
				lineageTag: 2555fadb-8624-4167-85b5-814799bdad46

				changedProperty = FormatString

			/// 
			/// CALCULATE (
			///     AVERAGE ( 'Absences'[Working Days Lost] ),
			///     'Absences'[Absence Type] = "General Absence"
			/// )
			measure 'General Absence Avg Days Lost' =
					
					CALCULATE (
					    AVERAGE ( 'Absences'[Working Days Lost] ),
					    'Absences'[Absence Type] = "General Absence"
					)
				formatString: 0.0
				displayFolder: Human Resources\General Absence
				lineageTag: ecf367e4-fe00-4403-9ddb-179f683db566

				changedProperty = FormatString

			/// 
			/// VAR _LastDate =
			///     MAX ( 'Calendar'[Date] )
			/// RETURN
			///     CALCULATE (
			///         DISTINCTCOUNT ( 'Absences'[Employee Absence Key] ),
			///         'Absences'[Absence Start Date] <= _LastDate,
			///         'Absences'[Absence End Date] >= _LastDate
			///             || ISBLANK ( 'Absences'[Absence End Date] ),
			///         'Absences'[Absence Type] = "General Absence"
			///     )
			measure 'Current General Absence' =
					
					VAR _LastDate =
					    MAX ( 'Calendar'[Date] )
					RETURN
					    CALCULATE (
					        DISTINCTCOUNT ( 'Absences'[Employee Absence Key] ),
					        'Absences'[Absence Start Date] <= _LastDate,
					        'Absences'[Absence End Date] >= _LastDate
					            || ISBLANK ( 'Absences'[Absence End Date] ),
					        'Absences'[Absence Type] = "General Absence"
					    )
				formatString: 0
				displayFolder: Human Resources\General Absence
				lineageTag: 073fc467-904f-4e6c-b86b-b00de82bb796

			/// 
			/// VAR _LastDate =
			///     MAX ( 'Calendar'[Date] )
			/// VAR _FirstDate =
			///     MIN ( 'Calendar'[Date] )
			/// VAR __Final =
			///     CALCULATE (
			///         SUM ( 'Absences'[Working Days Lost] ),
			///         'Absences'[Absence Start Date] >= _FirstDate,
			///         'Absences'[Absence Start Date] <= _LastDate,
			///         'Absences'[Absence End Date] <= _LastDate
			///             || ISBLANK ( 'Absences'[Absence End Date] )
			///     )
			/// RETURN
			///     CALCULATE ( __Final, 'Absences'[Absence Type] = "General Absence" )
			measure 'General Absence Total Days Lost' =
					
					VAR _LastDate =
					    MAX ( 'Calendar'[Date] )
					VAR _FirstDate =
					    MIN ( 'Calendar'[Date] )
					VAR __Final =
					    CALCULATE (
					        SUM ( 'Absences'[Working Days Lost] ),
					        'Absences'[Absence Start Date] >= _FirstDate,
					        'Absences'[Absence Start Date] <= _LastDate,
					        'Absences'[Absence End Date] <= _LastDate
					            || ISBLANK ( 'Absences'[Absence End Date] )
					    )
					RETURN
					    CALCULATE ( __Final, 'Absences'[Absence Type] = "General Absence" )
				formatString: #,0.0
				displayFolder: Human Resources\General Absence
				lineageTag: 12699570-3e54-4dfc-9e81-332b2f8e4e71

				changedProperty = FormatString

