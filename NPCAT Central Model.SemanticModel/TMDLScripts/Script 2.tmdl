			partition 'zP KS4 Comparator' = calculated
				mode: import
				source = ```
						{
						("No. Students",NAMEOF('Measures Folder'[Total Students]), 0),
						("No. Grades",NAMEOF('Measures Folder'[Number of Grades]), 1),
						("Avg KS2",NAMEOF('Measures Folder'[Average KS2 FG]), 2),
						("Avg KS2",NAMEOF('Measures Folder'[Average KS2 (Subject Level)]), 3),
						("Avg Points",NAMEOF('Measures Folder'[Average Points]), 4),
						("Overall P8",NAMEOF('Measures Folder'[Headline Overall P8]), 5),
						("English P8",NAMEOF('Measures Folder'[Headline English P8]), 6),
						("Maths P8",NAMEOF('Measures Folder'[Headline Maths P8]), 7),
						("Ebacc P8",NAMEOF('Measures Folder'[Headline Ebacc P8]), 8),
						("Open P8",NAMEOF('Measures Folder'[Headline Open P8]), 9),
						("Basics 4+%",NAMEOF('Measures Folder'[Basics 4+%]), 10),
						("Basics 5+%",NAMEOF('Measures Folder'[Basics 5+%]), 11),
						("English 4+%",NAMEOF('Measures Folder'[English 4+%]), 11),
						("English 5+%",NAMEOF('Measures Folder'[English 5+%]), 13),
						("Maths 4+%",NAMEOF('Measures Folder'[Maths 4+%]), 14),
						("Maths 5+%",NAMEOF('Measures Folder'[Maths 5+%]), 15),
						("Overall A8",NAMEOF('Measures Folder'[Headline Overall A8]), 16),
						("English A8",NAMEOF('Measures Folder'[Headline English A8]), 17),
						("Maths A8",NAMEOF('Measures Folder'[Headline Maths A8]), 18),
						("Ebacc A8",NAMEOF('Measures Folder'[Headline Ebacc A8]), 19),
						("Open A8",NAMEOF('Measures Folder'[Headline Open A8]), 20),
						("SPI",NAMEOF('Measures Folder'[Subject Progress 8 (SPI)]), 21),
						("9+",NAMEOF('Measures Folder'[Subject Grade 9+]), 22),
						("8+",NAMEOF('Measures Folder'[Subject Grade 8+]), 23),
