			/// 
			/// VAR _Numerator =
			///     CALCULATE (
			///         COUNTA ( 'KS2 Tests & TA Results'[Grade] ),
			///         'KS2 Tests & TA Results'[Grade] IN { "GDS" },
			///         'KS2 Tests & TA Results'[Assessment Type] IN { "TA" }
			///     )
			/// VAR _Denmonator =
			///     CALCULATE (
			///         COUNTA ( 'KS2 Tests & TA Results'[Grade] ),
			///         ALLSELECTED ( 'KS2 Tests & TA Results'[Grade] ),
			///         ALLSELECTED ( 'KS2 Tests & TA Results'[Grade Sort] ),
			///         'KS2 Tests & TA Results'[Assessment Type] IN { "TA" }
			///     )
			/// RETURN
			///     IF (
			///         ISBLANK ( DIVIDE ( _Numerator, _Denmonator ) ),
			///         IF ( ISBLANK ( _Denmonator ), BLANK (), 0 ),
			///         DIVIDE ( _Numerator, _Denmonator )
			///     )
			measure 'KS2 GDS% - All' =
					
					VAR _Numerator =
					    CALCULATE (
					        COUNTA ( 'KS2 Tests & TA Results'[Grade] ),
					        'KS2 Tests & TA Results'[Grade] IN { "GDS" },
					        'KS2 Tests & TA Results'[Assessment Type] IN { "TA" }
					    )
					VAR _Denmonator =
					    CALCULATE (
					        COUNTA ( 'KS2 Tests & TA Results'[Grade] ),
					        ALLSELECTED ( 'KS2 Tests & TA Results'[Grade] ),
					        ALLSELECTED ( 'KS2 Tests & TA Results'[Grade Sort] ),
					        'KS2 Tests & TA Results'[Assessment Type] IN { "TA" }
					    )
					RETURN
					    IF (
					        ISBLANK ( DIVIDE ( _Numerator, _Denmonator ) ),
					        IF ( ISBLANK ( _Denmonator ), BLANK (), 0 ),
					        DIVIDE ( _Numerator, _Denmonator )
					    )
				formatString: 0.0%;-0.0%;0.0%
				displayFolder: Statutory KS2
				lineageTag: b6a8de35-efbd-45bc-b144-3848df784321

				changedProperty = FormatString

