			/// 
			/// VAR _StudentCount =
			///     CALCULATE (
			///         DISTINCTCOUNT ( 'Phonics'[Global Unique ID] ),
			///         Phonics[Year Group] = "Year 1"
			///     )
			/// VAR _YearCount =
			///     DISTINCTCOUNT ( 'Phonics'[Academic Year] )
			/// RETURN
			///     DIVIDE ( _StudentCount, _YearCount )
			measure 'Y1 Phonics No. Pupils' =
					
					VAR _StudentCount =
					    CALCULATE (
					        DISTINCTCOUNT ( 'Phonics'[Global Unique ID] ),
					        Phonics[Year Group] = "Year 1"
					    )
					VAR _YearCount =
					    DISTINCTCOUNT ( 'Phonics'[Academic Year] )
					RETURN
					    DIVIDE ( _StudentCount, _YearCount )
				formatString: 0
				displayFolder: Statutory Phonics
				lineageTag: f5d4c9f4-3d02-4a02-8a74-96123cec22c9

