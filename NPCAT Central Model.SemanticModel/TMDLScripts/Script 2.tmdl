			/// 
			/// VAR _MaxWeekOffset =
			///     MAX ( 'Calendar'[CurWeekOffset] )
			/// VAR _PW =
			///     MAX ( 'Calendar'[CurWeekOffset] ) - 1
			/// VAR _PreviousPeriod =
			///     CALCULATE (
			///         [Attendance Percentage],
			///         FILTER ( ALL ( 'Calendar' ), 'Calendar'[CurWeekOffset] = _PW )
			///     )
			/// VAR _CW =
			///     CALCULATE (
			///         [Attendance Percentage],
			///         'Calendar'[CurWeekOffset] = _MaxWeekOffset
			///     )
			/// RETURN
			///     _CW - _PreviousPeriod
			measure 'Attendance Percentage WoW' =
					
					VAR _MaxWeekOffset =
					    MAX ( 'Calendar'[CurWeekOffset] )
					VAR _PW =
					    MAX ( 'Calendar'[CurWeekOffset] ) - 1
					VAR _PreviousPeriod =
					    CALCULATE (
					        [Attendance Percentage],
					        FILTER ( ALL ( 'Calendar' ), 'Calendar'[CurWeekOffset] = _PW )
					    )
					VAR _CW =
					    CALCULATE (
					        [Attendance Percentage],
					        'Calendar'[CurWeekOffset] = _MaxWeekOffset
					    )
					RETURN
					    _CW - _PreviousPeriod
				formatString: 0.0%;-0.0%;0.0%
				displayFolder: Attendance Measures
				lineageTag: cc39163a-dc19-45b0-bba4-0c7f0dbb2cfb

				changedProperty = FormatString

