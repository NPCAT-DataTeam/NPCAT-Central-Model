			/// 
			/// VAR LatestVisitDatePerPlace =
			///     CALCULATE (
			///         MAX ( 'Safeguarding Visits'[Snapshot Date] ),
			///         ALLEXCEPT (
			///             'Safeguarding Visits',
			///             'Safeguarding Visits'[SUID],
			///             'Calendar'[Date]
			///         )
			///     )
			/// VAR DistintTable =
			///     SUMMARIZE (
			///         'Safeguarding Visits',
			///         'Safeguarding Visits'[SUID],
			///         "Most Recent Date", LatestVisitDatePerPlace
			///     )
			/// RETURN
			///     CALCULATE (
			///         COUNTROWS ( DistintTable ),
			///         REMOVEFILTERS (
			///             'Safeguarding Visits'[Safeguarding Tier],
			///             'Safeguarding Visits'[Safeguarding Statutory Tier]
			///         )
			///     )
			measure 'Most Recent Visits' =
					
					VAR LatestVisitDatePerPlace =
					    CALCULATE (
					        MAX ( 'Safeguarding Visits'[Snapshot Date] ),
					        ALLEXCEPT (
					            'Safeguarding Visits',
					            'Safeguarding Visits'[SUID],
					            'Calendar'[Date]
					        )
					    )
					VAR DistintTable =
					    SUMMARIZE (
					        'Safeguarding Visits',
					        'Safeguarding Visits'[SUID],
					        "Most Recent Date", LatestVisitDatePerPlace
					    )
					RETURN
					    CALCULATE (
					        COUNTROWS ( DistintTable ),
					        REMOVEFILTERS (
					            'Safeguarding Visits'[Safeguarding Tier],
					            'Safeguarding Visits'[Safeguarding Statutory Tier]
					        )
					    )
				displayFolder: Safeguarding
				lineageTag: 7abe60af-a685-4fc7-acc3-ab62bb1e25cc

