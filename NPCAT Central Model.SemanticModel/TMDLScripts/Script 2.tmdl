			/// 
			/// CALCULATE (
			///     DISTINCTCOUNT ( 'Compliance Daily Logs'[ActivityRecordKey] ),
			///     FILTER ( ALL ( 'Calendar'[Date] ), 'Calendar'[Date] = MAX ( 'Calendar'[Date] ) )
			/// )
			measure 'Compliance Activities' =
					
					CALCULATE (
					    DISTINCTCOUNT ( 'Compliance Daily Logs'[ActivityRecordKey] ),
					    FILTER ( ALL ( 'Calendar'[Date] ), 'Calendar'[Date] = MAX ( 'Calendar'[Date] ) )
					)
				formatString: 0
