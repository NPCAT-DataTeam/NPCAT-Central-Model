			/// 
			/// VAR __CurrentIndex =
			///     CALCULATE (
			///         MAX ( 'SEN Audit Visits'[ID] ),
			///         REMOVEFILTERS ( 'SEN Audit Visits'[QA Offset] )
			///     )
			/// VAR __LastAuditDate =
			///     CALCULATE (
			///         MAX ( 'SEN Audit Visits'[Date of QA] ),
			///         REMOVEFILTERS ( 'SEN Audit Visits'[QA Offset] ),
			///         'SEN Audit Visits'[ID] = __CurrentIndex
			///     )
			/// RETURN
			///     IF (
			///         ISBLANK ( __LastAuditDate ),
			///         BLANK (),
			///         COUNTROWS ( DATESBETWEEN ( 'Calendar'[Date], __LastAuditDate, TODAY () ) ) - 1
			///     )
			measure 'Days Since Last SEN Audit Date' =
					
					VAR __CurrentIndex =
					    CALCULATE (
					        MAX ( 'SEN Audit Visits'[ID] ),
					        REMOVEFILTERS ( 'SEN Audit Visits'[QA Offset] )
					    )
					VAR __LastAuditDate =
					    CALCULATE (
					        MAX ( 'SEN Audit Visits'[Date of QA] ),
					        REMOVEFILTERS ( 'SEN Audit Visits'[QA Offset] ),
					        'SEN Audit Visits'[ID] = __CurrentIndex
					    )
					RETURN
					    IF (
					        ISBLANK ( __LastAuditDate ),
					        BLANK (),
					        COUNTROWS ( DATESBETWEEN ( 'Calendar'[Date], __LastAuditDate, TODAY () ) ) - 1
					    )
				formatString: #,0
				displayFolder: SEN QA
				lineageTag: ea530640-14cb-48de-afe7-5e1de623afda

			/// 
			/// VAR _MostRecent = [No. SEN Support (Most Recent Audit)]
			/// VAR _PreviousAudit =
			///     CALCULATE (
			///         SUM ( 'SEN Audit Visits'[Number of pupils with EHCP] ),
			///         'SEN Audit Scores'[QA Offset] = -1
			///     )
			/// VAR _Change = _MostRecent - _PreviousAudit
			/// RETURN
			///     IF (
			///         ISBLANK ( _MostRecent & " (" & _PreviousAudit & ") " & _Change ),
			///         "",
			///         _MostRecent & " (" & _PreviousAudit & ") " & _Change
			///     )
			measure 'No. EHCP (Change)' =
					
					VAR _MostRecent = [No. SEN Support (Most Recent Audit)]
					VAR _PreviousAudit =
					    CALCULATE (
					        SUM ( 'SEN Audit Visits'[Number of pupils with EHCP] ),
					        'SEN Audit Scores'[QA Offset] = -1
					    )
					VAR _Change = _MostRecent - _PreviousAudit
					RETURN
					    IF (
					        ISBLANK ( _MostRecent & " (" & _PreviousAudit & ") " & _Change ),
					        "",
					        _MostRecent & " (" & _PreviousAudit & ") " & _Change
					    )
				displayFolder: SEN QA
