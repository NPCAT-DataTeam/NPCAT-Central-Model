			///         'Student Indicies'[Category] = "Living",
			///         'Student Database (Full)'[DOA] <= _LastDate,
			///         'Student Database (Full)'[Leaving date] > _LastDate
			///             || ISBLANK ( 'Student Database (Full)'[Leaving date] ),
			///         'Calendar'[Date] = _LastDate
			///     )
			measure 'Living Decile' =
					
					VAR _LastDate =
					    MAX ( 'Calendar'[Date] )
					VAR _Table =
					    FILTER (
					        'Student Indicies',
					        NOT ( [Decile] = "Undefined" )
					            && 'Student Indicies'[RELEASE_YEAR] = 2025 && 'Student Indicies'[Category] = "Living"
					    )
					VAR _TableWithDecile =
					    ADDCOLUMNS ( _Table, "DecileValue", VALUE ( 'Student Indicies'[Decile] ) )
					RETURN
					    CALCULATE (
					        AVERAGEX ( _TableWithDecile, VALUE ( [Decile] ) ),
					        'Student Indicies'[Category] = "Living",
					        'Student Database (Full)'[DOA] <= _LastDate,
					        'Student Database (Full)'[Leaving date] > _LastDate
					            || ISBLANK ( 'Student Database (Full)'[Leaving date] ),
					        'Calendar'[Date] = _LastDate
					    )
				formatString: 0.0
				displayFolder: Student Measures\IDACI Measures
				lineageTag: ffa955ae-94d8-48c9-873c-0d051514e90b

			/// 
			/// VAR _LastDate =
			///     MAX ( 'Calendar'[Date] )
			/// VAR _Table =
			///     FILTER (
			///         'Student Indicies',
			///         NOT ( [Decile] = "Undefined" )
			///             && 'Student Indicies'[Category] = "Income"
			///     )
			/// VAR _TableWithDecile =
			///     ADDCOLUMNS ( _Table, "DecileValue", VALUE ( 'Student Indicies'[Decile] ) )
			/// RETURN
			///     CALCULATE (
			///         AVERAGEX ( _TableWithDecile, VALUE ( [Decile] ) ),
			///         'Student Indicies'[Category] = "Income",
			///         'Student Database (Full)'[DOA] <= _LastDate,
			///         'Student Database (Full)'[Leaving date] > _LastDate
			///             || ISBLANK ( 'Student Database (Full)'[Leaving date] ),
			///         'Calendar'[Date] = _LastDate
			///     )
			measure 'Income Decile' =
					
					VAR _LastDate =
					    MAX ( 'Calendar'[Date] )
					VAR _Table =
					    FILTER (
					        'Student Indicies',
					        NOT ( [Decile] = "Undefined" )
					            && 'Student Indicies'[RELEASE_YEAR] = 2025 && 'Student Indicies'[Category] = "Income"
					    )
					VAR _TableWithDecile =
					    ADDCOLUMNS ( _Table, "DecileValue", VALUE ( 'Student Indicies'[Decile] ) )
					RETURN
					    CALCULATE (
					        AVERAGEX ( _TableWithDecile, VALUE ( [Decile] ) ),
					        'Student Indicies'[Category] = "Income",
					        'Student Database (Full)'[DOA] <= _LastDate,
					        'Student Database (Full)'[Leaving date] > _LastDate
					            || ISBLANK ( 'Student Database (Full)'[Leaving date] ),
					        'Calendar'[Date] = _LastDate
					    )
