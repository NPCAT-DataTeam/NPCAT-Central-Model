			measure 'Budgeted Defecit (Expenditure minus Total Income)' =
					
					ROUNDDOWN ( [Budgeted Income] - [Budgeted Expenses], 5 )
				formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
