					SWITCH(
					    TRUE(),
					    CONTAINSSTRING('zP KS4 Headlines'[zP KS4 Headlines Fields],"P8"),1,
					    CONTAINSSTRING('zP KS4 Headlines'[zP KS4 Headlines Fields],"A8"),2,
					    CONTAINSSTRING('zP KS4 Headlines'[zP KS4 Headlines Fields],"+%"),3
