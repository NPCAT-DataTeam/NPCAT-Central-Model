					[Safeguarding Statutory Compliance %] > 0.95,"Tier 2",
					[Safeguarding Statutory Compliance %] >= 0.9,"Tier 3",
					[Safeguarding Statutory Compliance %] < 0.9,"Tier 4")
				lineageTag: debae665-8da5-4bf9-ab02-c811eb3b9f42
				summarizeBy: none

				annotation SummarizationSetBy = Automatic

			column 'Safeguarding Statutory Tier Sort' =
					
					SWITCH(TRUE(),
