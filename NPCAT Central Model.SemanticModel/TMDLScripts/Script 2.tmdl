			///     DISTINCTCOUNT ( 'Compliance Daily Logs'[ActivityRecordKey] ),
			///     LASTNONBLANK ( 'Calendar'[Date], 1 )
			/// )
			measure 'Compliance Denominator' =
					
					CALCULATE (
					    DISTINCTCOUNT ( 'Compliance Daily Logs'[ActivityRecordKey] ),
					    LASTNONBLANK ( 'Calendar'[Date], 1 )
					)
				formatString: 0
				displayFolder: Compliance Measures
				lineageTag: af6f95a9-cc47-4c1d-8108-fc9574b6a79e

			/// 
			/// CALCULATE (
			///     DISTINCTCOUNT ( 'Compliance Daily Logs'[ActivityRecordKey] ),
			///     'Compliance Daily Logs'[Compliance Status] IN { "Green", "Amber" },
			///     LASTNONBLANK ( 'Calendar'[Date], 1 )
			/// ) + 0
			measure 'Compliance Numerator' =
					
					CALCULATE (
					    DISTINCTCOUNT ( 'Compliance Daily Logs'[ActivityRecordKey] ),
					    'Compliance Daily Logs'[Compliance Status] IN { "Green", "Amber" },
					    LASTNONBLANK ( 'Calendar'[Date], 1 )
					) + 0
				formatString: 0
				displayFolder: Compliance Measures
				lineageTag: 238c7b7f-4c55-4d9d-b537-b84e1420c664

