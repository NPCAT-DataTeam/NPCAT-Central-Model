			/// 
			/// VAR _CutOff = [Dynamic Max Date]
			/// RETURN
			///     CALCULATE (
			///         AVERAGE ( Creditors[Days to Pay] ),
			///         REMOVEFILTERS ( Calendar[Date] ),
			///         Creditors[Status]
			///             IN { "P" }
			///                 && Creditors[Invoice Date] <= _CutOff
			///                 && (
			///                     ISBLANK ( Creditors[Pay Date] )
			///                         || Creditors[Pay Date] > _CutOff
			///                 )
			///     )
			/// //CALCULATE ( AVERAGE ([Average Days to Pay]) , Creditors[Status] = "P" )
			measure 'Average Days to Pay (Closed)' =
					
					VAR _CutOff = [Dynamic Max Date]
					RETURN
					    CALCULATE (
					        AVERAGE ( Creditors[Days to Pay] ),
					        REMOVEFILTERS ( Calendar[Date] ),
					        Creditors[Status]
					            IN { "P" }
					                && Creditors[Invoice Date] <= _CutOff
					                && (
					                    ISBLANK ( Creditors[Pay Date] )
					                        || Creditors[Pay Date] > _CutOff
					                )
					    )
					//CALCULATE ( AVERAGE ([Average Days to Pay]) , Creditors[Status] = "P" )
				displayFolder: Finance Measures\Creditors
