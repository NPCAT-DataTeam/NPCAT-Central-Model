				formatString: 0.00%;-0.00%;0.00%
				displayFolder: Attendance Measures
				lineageTag: f88d2a19-b3f0-4464-b987-c89e94b142e6

			measure 'Attendance Contribution to the Whole School Average (Experimental)' =
					
					VAR ThisAttendance =
					    [Attendance Percentage YTD]   -- current pupil / group context
					
					VAR ThisPossible =
					    CALCULATE (
					        SUM ( Attendance[Sessions] ),
					        Attendance[Redaction Check] <> 1,
					        Attendance[On Roll] <> "Unenrolled",
					        Attendance[Compulsory Age] = 1
					    )
					
					VAR TotalPossible =
					    CALCULATE (
					        SUM ( Attendance[Sessions] ),
					        Attendance[Redaction Check] <> 1,
					        Attendance[On Roll] <> "Unenrolled",
					        Attendance[Compulsory Age] = 1,
					        -- remove pupil / year-group filters but KEEP school context
					        ALLEXCEPT('Student Database (Full)','Student Database (Full)'[School ID],'School Database'[School Short Name]),
					        //REMOVEFILTERS ( 'Student Database (Full)'[Full Name],'Student Database (Full)'[Full Name: DOB] ),
					        REMOVEFILTERS ( 'Student Year Groups' )     -- ignores Year Group rows
					        //KEEPFILTERS('School Database'[School Short Name])
					    )
					
					VAR Weighting =
					    DIVIDE ( ThisPossible, TotalPossible )
					
					VAR WholeSchool =
					    CALCULATE (
					        [Attendance Percentage YTD],
					        Attendance[Redaction Check] <> 1,
					        Attendance[On Roll] <> "Unenrolled",
					        Attendance[Compulsory Age] = 1,
					        ALLEXCEPT('Student Database (Full)','Student Database (Full)'[School ID],'School Database'[School Short Name]),
					        //REMOVEFILTERS ( 'Student Database (Full)'[Full Name],'Student Database (Full)'[Full Name: DOB] ),
					        REMOVEFILTERS ( 'Student Year Groups' )
					        //KEEPFILTERS('School Database'[School Short Name])
					    )
					
					RETURN
					    -- in percentage points
					   "( "& FORMAT(ThisAttendance,"0.00%")& " - " & FORMAT(WholeSchool,"0.00%")& " ) = "& FORMAT(ThisAttendance - WholeSchool,"0.00%") &" * " & FORMAT(Weighting,"0.0000%") & " -> ( " &  ThisPossible & " / " & TotalPossible & " ) = " & FORMAT((ThisAttendance - WholeSchool) * Weighting,"0.00%")
				displayFolder: Attendance Measures
				lineageTag: 399a6717-d366-46ff-b64f-d7f441233d2a

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			/// 
			/// VAR _LastDate =
			///     MAX ( 'Calendar'[Date] )
			/// VAR _Table =
			///     FILTER (
			///         'Student Indicies',
			///         NOT ( [Decile] = "Undefined" )
			///             && 'Student Indicies'[Category] = "IDACI"
			///     )
			/// VAR _TableWithDecile =
			///     ADDCOLUMNS ( _Table, "DecileValue", VALUE ( 'Student Indicies'[Decile] ) )
			/// RETURN
			///     CALCULATE (
			///         AVERAGEX ( _TableWithDecile, VALUE ( [Decile] ) ),
			///         'Student Indicies'[Category] = "IDACI",
			///         'Student Database (Full)'[DOA] <= _LastDate,
			///         'Student Database (Full)'[Leaving date] > _LastDate
			///             || ISBLANK ( 'Student Database (Full)'[Leaving date] ),
			///         'Calendar'[Date] = _LastDate
			///     )
			measure 'IDACI Decile (2019)' =
					
					VAR _LastDate =
					    MAX ( 'Calendar'[Date] )
					VAR _Table =
					    FILTER (
					        'Student Indicies',
					        NOT ( [Decile] = "Undefined" )
					            && 'Student Indicies'[RELEASE_YEAR] = 2019 && 'Student Indicies'[Category] = "IDACI"
					    )
					VAR _TableWithDecile =
					    ADDCOLUMNS ( _Table, "DecileValue", VALUE ( 'Student Indicies'[Decile] ) )
					RETURN
					    CALCULATE (
					        AVERAGEX ( _TableWithDecile, VALUE ( [Decile] ) ),
					        'Student Indicies'[Category] = "IDACI",
					        'Student Database (Full)'[DOA] <= _LastDate,
					        'Student Database (Full)'[Leaving date] > _LastDate
					            || ISBLANK ( 'Student Database (Full)'[Leaving date] ),
					        'Calendar'[Date] = _LastDate
					    )
				formatString: 0.0
				displayFolder: Student Measures\IDACI Measures\2019 IDACI
				lineageTag: 73670615-7258-43ba-8ad4-eee41e37949a

