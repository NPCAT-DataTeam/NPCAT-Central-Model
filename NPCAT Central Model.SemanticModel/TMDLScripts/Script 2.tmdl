			measure 'Forecast Spend on Premises Percentile' =
					
					VAR __Denominator =
					    DISTINCTCOUNT ( 'Financial Benchmark Data'[URN] )
					VAR __Numerator =
					    CALCULATE (
					        DISTINCTCOUNT ( 'Financial Benchmark Data'[URN] ),
					        FILTER (
					            'Financial Benchmark Data',
					            'Financial Benchmark Data'[Spend on premises (including staff) costs as a percentage of total expenditure] <= [Spend on Premises (Including Staff Costs) as % Total Expenditure]
					        )
					    )
					VAR __NumeratorErrorHandling =
					    IF ( ISBLANK ( __Numerator ), 1, 0 )
					VAR __NumeratorFinal =
					    IF (
					        __NumeratorErrorHandling = 0,
					        __Numerator,
					        IF (
					            [Spend on Premises (Including Staff Costs) as % Total Expenditure]
					                < MIN ( 'Financial Benchmark Data'[Spend on premises (including staff) costs as a percentage of total expenditure] ),
					            1,
					            __Denominator
					        )
					    )
					RETURN
					    DIVIDE ( __NumeratorFinal, __Denominator ) * 100
