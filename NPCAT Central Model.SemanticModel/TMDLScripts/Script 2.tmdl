		table 'Dynamic student Calc group'
			lineageTag: ec0b699e-b029-457f-99a5-283e6b6e262e

			calculationGroup
				precedence: 2

				calculationItem 'All Students' = SELECTEDMEASURE ()

				calculationItem Male =
						CALCULATE (
						    SELECTEDMEASURE (), 'Student Database (Full)'[Gender] = "Male"
						)

				calculationItem Female =
						CALCULATE (
						    SELECTEDMEASURE (), 'Student Database (Full)'[Gender] = "Female"
						)

				calculationItem Catholic = ```
						CALCULATE (
						    SELECTEDMEASURE (), 
						    'Student Database (Full)'[Religion]
						            IN {
						            "Roman Catholic"
						        }
						)
						```

				calculationItem 'Non Catholic' = ```
						CALCULATE (
						    SELECTEDMEASURE (),
						    NOT( 
						    'Student Database (Full)'[Religion]
						            IN {
						            "Roman Catholic"
						        })
						)
						```

				calculationItem FSM = ```
						
						VAR _MaxDate = [Dynamic Max Date]
						
						-- 1) Gather the set of Student IDs who have Tag = "FSM" active at _MaxDate
						VAR StudentsWithTag =
						    CALCULATETABLE(
						        VALUES('Student Database (Full)'[Globally Unique Student ID]),
						        FILTER(
						            'Demographics',
						            'Demographics'[Tag] = "FSM"
						            && 'Demographics'[Tag Start Date] <= _MaxDate
						            && 'Demographics'[Tag End Date]   >= _MaxDate
						        )
						    )
						
						-- 2) Intersect with current filter context if needed.
						--    Usually you can rely on the existing School->Student context,
						--    but if you want to explicitly keep only students in the current context:
						VAR CurrentStudents =
						    VALUES('Student Database (Full)'[Globally Unique Student ID])
						
						VAR FinalIDs =
						    INTERSECT( StudentsWithTag, CurrentStudents )
						
						RETURN
						CALCULATE(
						    SELECTEDMEASURE(),
						    
						    -- 3) Apply the Tag-based set of Student IDs to the Student table
						    TREATAS( FinalIDs, 'Student Database (Full)'[Globally Unique Student ID] )
						)
						```

				calculationItem 'Not FSM' = ```
						VAR _MaxDate = [Dynamic Max Date]
						
						-- 1) Gather the set of Student IDs who have Tag = "FSM" active at _MaxDate
						VAR StudentsWithTag =
						    CALCULATETABLE(
						        VALUES('Student Database (Full)'[Globally Unique Student ID]),
						        FILTER(
						            'Demographics',
						            'Demographics'[Tag] = "FSM"
						            && 'Demographics'[Tag Start Date] <= _MaxDate
						            && 'Demographics'[Tag End Date]   >= _MaxDate
						        )
						    )
						
						-- 2) Intersect with current filter context if needed.
						--    Usually you can rely on the existing School->Student context,
						--    but if you want to explicitly keep only students in the current context:
						VAR CurrentStudents =
						    VALUES('Student Database (Full)'[Globally Unique Student ID])
						
						VAR FinalIDs =
						    EXCEPT( CurrentStudents, StudentsWithTag )
						
						RETURN
						CALCULATE(
						    SELECTEDMEASURE(),
						    
						    -- 3) Apply the Tag-based set of Student IDs to the Student table
						    TREATAS( FinalIDs, 'Student Database (Full)'[Globally Unique Student ID] )
						)
						```

				calculationItem 'Male FSM' = ```
						
						// VAR _MaxDate = [Dynamic Max Date]
						
						// RETURN
						//     CALCULATE (
						//         SELECTEDMEASURE (),
						//         'Demographics Enrollment'[Date List] = _MaxDate,
						//         'Demographics Enrollment'[FSM] = 1,
						//         'Student Database (Full)'[Gender]="Male"
						//     )
						VAR _MaxDate = [Dynamic Max Date]
						
						-- 1) Gather the set of Student IDs who have Tag = "FSM" active at _MaxDate
						VAR StudentsWithTag =
						    CALCULATETABLE(
						        VALUES('Student Database (Full)'[Globally Unique Student ID]),
						        FILTER(
						            'Demographics',
						            'Demographics'[Tag] = "FSM"
						            && 'Demographics'[Tag Start Date] <= _MaxDate
						            && 'Demographics'[Tag End Date]   >= _MaxDate
						        )
						    )
						
						-- 2) Intersect with current filter context if needed.
						--    Usually you can rely on the existing School->Student context,
						--    but if you want to explicitly keep only students in the current context:
						VAR CurrentStudents =
						    VALUES('Student Database (Full)'[Globally Unique Student ID])
						
						VAR FinalIDs =
						    INTERSECT( StudentsWithTag, CurrentStudents )
						
						RETURN
						CALCULATE(
						    SELECTEDMEASURE(),
						    
						    -- 3) Apply the Tag-based set of Student IDs to the Student table
						    TREATAS( FinalIDs, 'Student Database (Full)'[Globally Unique Student ID] ),
						    
						    -- 4) Also filter on "Gender = Male"
						    KEEPFILTERS(
						        FILTER(
						            'Student Database (Full)',
						            'Student Database (Full)'[Gender] = "Male"
						        )
						    )
						)
						```

				calculationItem 'Female FSM' = ```
						
						// VAR _MaxDate = [Dynamic Max Date]
						
						// RETURN
						//     CALCULATE (
						//         SELECTEDMEASURE (),
						//         'Demographics Enrollment'[Date List] = _MaxDate,
