			/// 
			/// VAR _LastDate =
			///     MAX ( 'Calendar'[Date] )
			/// VAR _Offset =
			///     MAX ( 'Calendar'[Current School Year Offset] )
			/// RETURN
			///     CALCULATE (
			///         DISTINCTCOUNT ( 'Attendance'[Unique Student ID] ),
			///         'Student Database (Full)'[DOA] <= _LastDate,
			///         'Student Database (Full)'[Leaving date] >= _LastDate
			///             || ISBLANK ( 'Student Database (Full)'[Leaving date] ),
			///         'Calendar'[Current School Year Offset] = _Offset
			///     )
			measure 'Students on Roll' =
					
					VAR _LastDate =
					    MAX ( 'Calendar'[Date] )
					VAR _Offset =
					    MAX ( 'Calendar'[Current School Year Offset] )
					RETURN
					    CALCULATE (
					        DISTINCTCOUNT ( 'Attendance'[Unique Student ID] ),
					        'Student Database (Full)'[DOA] <= _LastDate,
					        'Student Database (Full)'[Leaving date] >= _LastDate
					            || ISBLANK ( 'Student Database (Full)'[Leaving date] ),
					        'Calendar'[Current School Year Offset] = _Offset
					    )
				formatString: #,0
				displayFolder: Student Measures
				lineageTag: 8fd3c701-69cf-4ae8-aadc-a0c5c7aed834

				changedProperty = FormatString

			/// 
