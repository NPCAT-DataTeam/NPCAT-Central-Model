			partition 'zP Trust Summative Y1-Y6 Indicators-b35c4d71-a86b-453a-ae16-81690750db31' = calculated
				mode: import
				source =
						{
						    ("BLW %", NAMEOF([Below % (Period ARE Target)]), 0),
						    ("OT %", NAMEOF([On Track % (Period ARE Target)]), 1),
						    ("AT %", NAMEOF([At % (Period ARE Target)]), 2),
						    ("AB %", NAMEOF([Above % (Period ARE Target)]), 3),
						    ("OT+ %", NAMEOF([On Track or Above % (Period ARE Target)]), 4),
						    ("AT+ %", NAMEOF([At or Above % (Period ARE Target)]), 5),
						    ("Avg. Prog", NAMEOF([Avg Baseline Variation Period Offset Measure]), 6)
						}

