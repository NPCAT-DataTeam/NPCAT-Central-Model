					    CONTAINSSTRING( 'zP Primary Summative Key Marginals (York Hub)'[zP Primary Summative Key Marginals (York Hub) Fields] , "At or"), "AT",
					    CONTAINSSTRING( 'zP Primary Summative Key Marginals (York Hub)'[zP Primary Summative Key Marginals (York Hub) Fields] , "GDS"), "GDS"
					)
