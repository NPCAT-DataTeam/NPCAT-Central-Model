			/// 
			/// COUNTROWS ( 'Absence Insurance Claims' )
			measure 'Absence Insurance Claims Count' =
					
					COUNTROWS ( 'Absence Insurance Claims' )
				displayFolder: Absence Insurance Claims
				lineageTag: 92a22ef5-8986-46f7-8c92-8442f3ad8447

			/// 
			/// VAR _LastDate =
			///     MAX ( 'Calendar'[Date] )
			/// VAR _FirstDate =
			///     MIN ( 'Calendar'[Date] )
			/// VAR __Final =
			///     CALCULATE (
			///         SUM ( 'Absence Insurance Claims'[Network Days Lost] ),
			///         'Absence Insurance Claims'[Absence Start Date] >= _FirstDate,
			///         'Absence Insurance Claims'[Absence Start Date] <= _LastDate,
			///         'Absence Insurance Claims'[Absence End Date] <= _LastDate
			///             || ISBLANK ( 'Absence Insurance Claims'[Absence End Date] )
			///     )
			/// RETURN
			///     CALCULATE ( __Final )
			measure 'Absence Insurance Total Working Days Lost' =
					
					VAR _LastDate =
					    MAX ( 'Calendar'[Date] )
					VAR _FirstDate =
					    MIN ( 'Calendar'[Date] )
					VAR __Final =
					    CALCULATE (
					        SUM ( 'Absence Insurance Claims'[Network Days Lost] ),
					        'Absence Insurance Claims'[Absence Start Date] >= _FirstDate,
					        'Absence Insurance Claims'[Absence Start Date] <= _LastDate,
					        'Absence Insurance Claims'[Absence End Date] <= _LastDate
					            || ISBLANK ( 'Absence Insurance Claims'[Absence End Date] )
					    )
					RETURN
					    CALCULATE ( __Final )
				formatString: #,0.0
				displayFolder: Absence Insurance Claims
				lineageTag: 84a068f8-bd75-47c6-bfce-4675e19cde45

				changedProperty = FormatString

			/// 
			/// TOTALYTD (
			///     [Absence Insurance Total Working Days Lost],
			///     'Calendar'[Date],
			///     "31/08"
			/// )
			measure 'Absence Insurance Total Working Days Lost (YTD)' =
					
					TOTALYTD (
					    [Absence Insurance Total Working Days Lost],
					    'Calendar'[Date],
					    "31/08"
					)
				formatString: #,0.0
				displayFolder: Absence Insurance Claims
				lineageTag: 76341cfa-a0f9-4072-93db-688e6e05e4e8

				changedProperty = FormatString

