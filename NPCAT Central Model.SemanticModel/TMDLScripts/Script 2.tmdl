			/// 
			/// VAR _LastDate =
			///     LASTDATE ( 'Calendar'[Date] )
			/// VAR __PREV_YEAR =
			///     CALCULATE (
			///         [ICT Tickets YTD],
			///         DATESINPERIOD ( 'Calendar'[Date], _LastDate, -1, YEAR )
			///     ) + 0
			/// RETURN
			///     [ICT Tickets YTD] - __PREV_YEAR
			measure 'ICT Last 12 Months Tickets Change to Previous Year' =
					
					VAR _LastDate =
					    LASTDATE ( 'Calendar'[Date] )
					VAR __PREV_YEAR =
					    CALCULATE (
					        [ICT Tickets YTD],
					        DATESINPERIOD ( 'Calendar'[Date], _LastDate, -1, YEAR )
					    ) + 0
					RETURN
					    [ICT Tickets YTD] - __PREV_YEAR
				displayFolder: Unused
				lineageTag: da912102-f5ae-4ecd-acb4-55113fb619d9

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			/// 
			/// VAR startyear =
			///     CALCULATE (
			///         FIRSTDATE ( 'Calendar'[Date] ),
			///         'Calendar'[Current School Year Offset] IN { -1 }
			///     )
			/// VAR enddate =
			///     (
			///         CALCULATE (
			///             LASTDATE ( 'Calendar'[Date] ),
			///             'Calendar'[Current School Year Offset] IN { 0 }
			///         ) - 365
			///     )
			/// RETURN
			///     CALCULATE (
			///         [ICT Tickets YTD],
			///         DATESBETWEEN ( Calendar[Date], startyear, enddate )
			///     )
			measure 'ICT tickets YTD SPLY (-1 Years)' =
					
					VAR startyear =
					    CALCULATE (
					        FIRSTDATE ( 'Calendar'[Date] ),
					        'Calendar'[Current School Year Offset] IN { -1 }
					    )
					VAR enddate =
					    (
					        CALCULATE (
					            LASTDATE ( 'Calendar'[Date] ),
					            'Calendar'[Current School Year Offset] IN { 0 }
					        ) - 365
					    )
					RETURN
					    CALCULATE (
					        [ICT Tickets YTD],
					        DATESBETWEEN ( Calendar[Date], startyear, enddate )
					    )
				displayFolder: Unused
				lineageTag: e3405111-ce5e-4476-a53b-4526ae8f71e0

