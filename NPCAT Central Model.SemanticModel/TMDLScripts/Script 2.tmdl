			/// DIVIDE (
			///     [Total Students]
			///         - CALCULATE (
			///             DISTINCTCOUNT ( 'KS4 Student Headlines'[Unique Student ID] ),
			///             'KS4 Student Headlines'[English & Maths 4+] = 0
			///         ),
			///     [Total Students]
			/// )
			measure 'Basics 4+%' =
					DIVIDE (
					    [Total Students]
					        - CALCULATE (
