			/// 
			/// VAR startyear =
			///     CALCULATE (
			///         FIRSTDATE ( 'Calendar'[Date] ),
			///         'Calendar'[Current School Year Offset] IN { -2 }
			///     )
			/// VAR enddate =
			///     (
			///         CALCULATE (
			///             LASTDATE ( 'Calendar'[Date] ),
			///             'Calendar'[Current School Year Offset] IN { 0 }
			///         ) - 730
			///     )
			/// RETURN
			///     CALCULATE (
			///         [Attendance Percentage YTD],
			///         DATESBETWEEN ( Calendar[Date], startyear, enddate )
			///     )
			measure 'Attendance YTD SP2Y (-2 Years)' =
					
					VAR startyear =
					    CALCULATE (
					        FIRSTDATE ( 'Calendar'[Date] ),
					        'Calendar'[Current School Year Offset] IN { -2 }
					    )
					VAR enddate =
					    (
					        CALCULATE (
					            LASTDATE ( 'Calendar'[Date] ),
					            'Calendar'[Current School Year Offset] IN { 0 }
					        ) - 730
					    )
					RETURN
					    CALCULATE (
					        [Attendance Percentage YTD],
					        DATESBETWEEN ( Calendar[Date], startyear, enddate )
					    )
				formatString: 0.00%;-0.00%;0.00%
				displayFolder: Attendance Measures
				lineageTag: c49a87cb-8364-413f-a199-76f791204025

