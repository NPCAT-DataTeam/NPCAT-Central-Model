			///         [Total ICT Tickets],
			///         'ICT Help Desk'[Create Date] >= _MinDate,
			///         'ICT Help Desk'[Create Date] < _MaxDate
			///     )
			measure 'Total Tickets Trend' =
					
					VAR _MinDate =
					    MIN ( 'Calendar'[Date] )
					VAR _MaxDate =
					    MAX ( 'Calendar'[Date] )
					RETURN
					    CALCULATE (
					        [Total ICT Tickets],
					        'ICT Help Desk'[Create Date] >= _MinDate,
					        'ICT Help Desk'[Create Date] < _MaxDate
					    )
