			/// 
			/// VAR __TotalTime =
			///     CALCULATE (
			///         DISTINCTCOUNT ( 'Calendar'[Date] ),
			///         FILTER ( ALLSELECTED ( 'Calendar'[WeekdayNum] ), [WeekdayNum] <> 5 || 6 )
			///     ) * 8
			/// RETURN
			///     DIVIDE (
			///         DIVIDE ( [Duration Printing (Hours)], [Count of Printers] ),
			///         __TotalTime
			///     )
			measure 'Time Usage%' =
					
					VAR __TotalTime =
					    CALCULATE (
					        DISTINCTCOUNT ( 'Calendar'[Date] ),
					        FILTER ( ALLSELECTED ( 'Calendar'[WeekdayNum] ), [WeekdayNum] <> 5 || 6 )
					    ) * 8
					RETURN
					    DIVIDE (
					        DIVIDE ( [Duration Printing (Hours)], [Count of Printers] ),
					        __TotalTime
					    )
				formatString: 0.0%;-0.0%;0.0%
				displayFolder: Unused
				lineageTag: 4a527c9d-f719-4252-bb82-0f9ca0176e2e

