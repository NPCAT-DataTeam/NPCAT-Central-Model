			/// 
			/// SELECTEDVALUE ( 'EYFS ELGs/GLD'[Grade] )
			measure 'Selected EYFS Grade' =
					
					SELECTEDVALUE ( 'EYFS ELGs/GLD'[Grade] )
				displayFolder: Statutory EYFS
				lineageTag: 035baecb-cc99-43c6-a19a-0f60bd6fdf9f

			/// 
			/// VAR _LastDate =
			///     CALCULATE (
			///         LASTDATE ( 'Calendar'[Date] ),
			///         'Calendar'[Current School Year Offset] = 0
			///     )
			/// VAR _StartDate =
			///     CALCULATE (
			///         FIRSTDATE ( 'Calendar'[Date] ),
			///         'Calendar'[Current School Year Offset] = 0
			///     )
			/// RETURN
			///     CALCULATE (
			///         DISTINCTCOUNT ( 'Employee Job Roles'[Employee ID] ),
			///         'Employee Job Roles'[Post End Date] <= _LastDate,
			///         'Employee Job Roles'[Post End Date] >= _StartDate,
			///         'Employee Job Roles'[Movement Type] = "Leaver"
			///     )
			measure 'Staff Turnover (Time) Current School Year' =
					
					VAR _LastDate =
					    CALCULATE (
					        LASTDATE ( 'Calendar'[Date] ),
					        'Calendar'[Current School Year Offset] = 0
					    )
					VAR _StartDate =
					    CALCULATE (
					        FIRSTDATE ( 'Calendar'[Date] ),
					        'Calendar'[Current School Year Offset] = 0
					    )
					RETURN
					    CALCULATE (
					        DISTINCTCOUNT ( 'Employee Job Roles'[Employee ID] ),
					        'Employee Job Roles'[Post End Date] <= _LastDate,
					        'Employee Job Roles'[Post End Date] >= _StartDate,
					        'Employee Job Roles'[Movement Type] = "Leaver"
					    )
				formatString: 0
				displayFolder: Employees/Retention
				lineageTag: a8899b65-7e0b-4391-bb7c-746469e78fcb

			/// 
			/// CALCULATE (
			///     DIVIDE ( [Staff Turnover (Time)], ( [Staff Employed (Period)] ) ),
			///     'Calendar'[Current School Year Offset] = 0
			/// )
			measure 'Staff Turnover % Current School Year' =
					
					CALCULATE (
					    DIVIDE ( [Staff Turnover (Time)], ( [Staff Employed (Period)] ) ),
					    'Calendar'[Current School Year Offset] = 0
					)
				formatString: 0.00%;-0.00%;0.00%
				displayFolder: Employees/Retention
				lineageTag: c4ebae37-9539-43c5-afe0-830f6a99b744

