			/// 
			/// VAR _MaxDate = [Dynamic Max Date]
			/// VAR _gender = [Selected Gender]
			/// VAR _Student = SELECTEDVALUE('Student Database (Full)'[Globally Unique Student ID])
			/// VAR _HasActiveSEN =
			///     CALCULATE(
			///         COUNTROWS('Demographics'),
			///         'Demographics'[Person Unique ID] = _Student,
			///         'Demographics'[Tag] = "EHCP",
			///         'Demographics'[Tag Start Date] <= _MaxDate,
			///         'Demographics'[Tag End Date] >= _MaxDate
			///     )
			/// RETURN
			/// IF(ISBLANK(_gender),BLANK(),
			/// IF(_HasActiveSEN > 0, "EHCP", "No EHCP"))
			measure 'Selected EHCP' =
					
					VAR _MaxDate = [Dynamic Max Date]
					VAR _gender = [Selected Gender]
					VAR _Student = SELECTEDVALUE('Student Database (Full)'[Globally Unique Student ID])
					VAR _HasActiveSEN =
					    CALCULATE(
					        COUNTROWS('Demographics'),
					        'Demographics'[Person Unique ID] = _Student,
					        'Demographics'[Tag] = "EHCP",
					        'Demographics'[Tag Start Date] <= _MaxDate,
					        'Demographics'[Tag End Date] >= _MaxDate
					    )
					RETURN
					IF(ISBLANK(_gender),BLANK(),
					IF(_HasActiveSEN > 0, "EHCP", "No EHCP"))
				displayFolder: Student Measures
				lineageTag: 3e98176b-55b6-40ba-81cf-50bb6e0b2d5d

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			/// 
			/// VAR __PACore =
			///     CALCULATE (
			///         DISTINCTCOUNT ( Attendance[Unique Student ID] ),
			///         FILTER (
			///             VALUES ( Attendance[Unique Student ID] ),
			///             [Attendance Percentage YTD] <= 0.50
			///         ),
			///         NOT ( Attendance[Mark] IN { "#", "Z", "-" } ),
			///         Attendance[Redaction Check] <> 1,
			///         Attendance[On Roll] <> "Unenrolled",
			///         Attendance[Compulsory Age] = 1
			///     )
			/// RETURN
			///     CALCULATE ( __PACore )
			measure 'Severe Persistent Absence' =
					
					VAR __PACore =
					    CALCULATE (
					        DISTINCTCOUNT ( Attendance[Unique Student ID] ),
					        FILTER (
					            VALUES ( Attendance[Unique Student ID] ),
					            [Attendance Percentage YTD] <= 0.50
					        ),
					        NOT ( Attendance[Mark] IN { "#", "Z", "-" } ),
					        Attendance[Redaction Check] <> 1,
					        Attendance[On Roll] <> "Unenrolled",
					        Attendance[Compulsory Age] = 1
					    )
					RETURN
					    CALCULATE ( __PACore )
				displayFolder: Persistent Absence
				lineageTag: e3c1ec59-62f7-4f5f-8dee-5bf14ce51081

