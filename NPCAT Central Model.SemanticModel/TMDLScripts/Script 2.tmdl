					        __NumeratorErrorHandling = 0,
					        __Numerator,
					        IF (
					            [Spend on Other Staff as % Total Expenditure]
					                < MIN ( 'Financial Benchmark Data'[Spend on other staff costs as a percentage of total expenditure] ),
					            1,
					            __Denominator
					        )
					    )
					RETURN
					    DIVIDE ( __NumeratorFinal, __Denominator ) * 100
