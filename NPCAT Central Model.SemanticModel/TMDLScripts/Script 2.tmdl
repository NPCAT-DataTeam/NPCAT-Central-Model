			/// 
			/// VAR _MaxDate =
			///     MAX ( 'Calendar'[Date] )
			/// VAR _ComplianceTable =
			///     CALCULATETABLE (
			///         SUMMARIZE (
			///             'Safeguarding Visit Scores',
			///             'Safeguarding Visit Scores'[SUID],
			///             "Numerator",
			///                 CALCULATE (
			///                     COUNTROWS ( 'Safeguarding Visit Scores' ),
			///                     'Safeguarding Visit Scores'[Met/Not Met] IN { "Met" },
			///                     //, "Partially Met" },
			///                     'Safeguarding Visits'[Snapshot Date]
			///                         = MAX ( 'Safeguarding Visits'[Snapshot Date] )
			///                 ),
			///             "Denominator",
			///                 CALCULATE (
			///                     COUNTROWS ( 'Safeguarding Visit Scores' ),
			///                     'Safeguarding Visit Scores'[Met/Not Met]
			///                         IN { "Met", "Not Met", "Partially Met" },
			///                     'Safeguarding Visits'[Snapshot Date]
			///                         = MAX ( 'Safeguarding Visits'[Snapshot Date] )
			///                 )
			///         ),
			///         ALL ( 'Calendar' ),
			///         'Safeguarding Visits'[Snapshot Date] <= _MaxDate
			///     )
			/// VAR _Result =
			///     CALCULATE (
			///         DIVIDE (
			///             SUMX ( _ComplianceTable, [Numerator] ),
			///             SUMX ( _ComplianceTable, [Denominator] )
			///         )
			///     )
			/// RETURN
			///     _Result
			measure 'Safeguarding Compliance% over time' =
					
					VAR _MaxDate =
					    MAX ( 'Calendar'[Date] )
					VAR _ComplianceTable =
					    CALCULATETABLE (
					        SUMMARIZE (
					            'Safeguarding Visit Scores',
					            'Safeguarding Visit Scores'[SUID],
					            "Numerator",
					                CALCULATE (
					                    COUNTROWS ( 'Safeguarding Visit Scores' ),
					                    'Safeguarding Visit Scores'[Met/Not Met] IN { "Met" },
					                    //, "Partially Met" },
					                    'Safeguarding Visits'[Snapshot Date]
					                        = MAX ( 'Safeguarding Visits'[Snapshot Date] )
					                ),
					            "Denominator",
					                CALCULATE (
					                    COUNTROWS ( 'Safeguarding Visit Scores' ),
					                    'Safeguarding Visit Scores'[Met/Not Met]
					                        IN { "Met", "Not Met", "Partially Met" },
					                    'Safeguarding Visits'[Snapshot Date]
					                        = MAX ( 'Safeguarding Visits'[Snapshot Date] )
					                )
					        ),
					        ALL ( 'Calendar' ),
					        'Safeguarding Visits'[Snapshot Date] <= _MaxDate
					    )
					VAR _Result =
					    CALCULATE (
					        DIVIDE (
					            SUMX ( _ComplianceTable, [Numerator] ),
					            SUMX ( _ComplianceTable, [Denominator] )
					        )
					    )
					RETURN
					    _Result
				formatString: 0.00%;-0.00%;0.00%
				displayFolder: Safeguarding
				lineageTag: 2f62d072-6408-4e0a-a559-8b36913ae67d

				changedProperty = FormatString

