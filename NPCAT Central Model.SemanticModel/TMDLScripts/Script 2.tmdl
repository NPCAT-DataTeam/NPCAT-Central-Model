			/// 
			/// VAR CountedStudents =
			///     CALCULATE (
			///         [Students on Roll],
			///         AND (
			///             'Student Year Groups'[Year Sort] >= 0,
			///             'Student Year Groups'[Year Sort] <= 11
			///         )
			///     )
			/// VAR Places = [School Capacity] - CountedStudents
			/// RETURN
			///     Places
			measure 'Student Spaces' =
					
					VAR CountedStudents =
					    CALCULATE (
					        [Students on Roll],
					        AND (
					            'Student Year Groups'[Year Sort] >= 0,
					            'Student Year Groups'[Year Sort] <= 11
					        )
					    )
					VAR Places = [School Capacity] - CountedStudents
					RETURN
					    Places
				formatString: 0
				displayFolder: Unused
