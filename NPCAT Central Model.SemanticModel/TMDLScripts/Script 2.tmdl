			///         )
			///     ),
			///     'SEN Audit Scores'[QA Offset] = 0
			/// )
			measure 'SEN Compliance % (Most Recent QA)' =
					
					CALCULATE (
					    DIVIDE (
					        CALCULATE (
					            COUNTA ( 'SEN Audit Scores'[Answer] ),
					            'SEN Audit Scores'[Answer] IN { "Met" },
					            'SEN Audit Scores'[Question] <> "The SENCO is a qualified teacher and has the relevant qualifications."
					        ) + 0,
					        CALCULATE (
					            COUNTA ( 'SEN Audit Scores'[Answer] ),
					            'SEN Audit Scores'[Answer] IN { "Met", "Not Met", "Partially Met" },
					            'SEN Audit Scores'[Question] <> "The SENCO is a qualified teacher and has the relevant qualifications."
					        )
					    ),
					    'SEN Audit Scores'[QA Offset] = 0
					)
				formatString: 0.0%;-0.0%;0.0%
				displayFolder: SEN QA
				lineageTag: 11aa04cb-7037-49bf-9fb8-2a765ed16682

			/// 
			/// VAR _MaxDate =
			///     MAX ( 'Calendar'[Date] )
			/// VAR _SENComplianceTable =
			///     CALCULATETABLE (
			///         SUMMARIZE (
			///             'SEN Audit Scores',
			///             'SEN Audit Visits'[SUID],
			///             "Numerator",
			///                 CALCULATE (
			///                     COUNTA ( 'SEN Audit Scores'[Answer] ),
			///                     'SEN Audit Scores'[Answer] IN { "Met" },
			///                     'SEN Audit Scores'[Question] <> "The SENCO is a qualified teacher and has the relevant qualifications.",
			///                     'SEN Audit Visits'[Date of QA] = MAX('SEN Audit Visits'[Date of QA])
			///                 ) + 0,
			///             "Denomiator",
			///                 CALCULATE (
			///                     COUNTA ( 'SEN Audit Scores'[Answer] ),
			///                     'SEN Audit Scores'[Answer] IN { "Met", "Not Met", "Partially Met" },
			///                     'SEN Audit Scores'[Question] <> "The SENCO is a qualified teacher and has the relevant qualifications.",
			///                     'SEN Audit Visits'[Date of QA] = MAX('SEN Audit Visits'[Date of QA])
			///                 )
			///         ),
			///         ALL ( 'Calendar' ),
			///         'SEN Audit Visits'[Date of QA] <= _MaxDate
			///     )
			/// VAR _Result =
			///     CALCULATE (
			///         DIVIDE (
			///             SUMX ( _SENComplianceTable, [Numerator] ),
			///             SUMX ( _SENComplianceTable, [Denomiator] )
			///         )
			///     )
			/// RETURN
			///     _Result
			measure 'SEN Compliance % (Over Time)' =
					
					VAR _MaxDate =
					    MAX ( 'Calendar'[Date] )
					VAR _SENComplianceTable =
					    CALCULATETABLE (
					        SUMMARIZE (
					            'SEN Audit Scores',
					            'SEN Audit Visits'[SUID],
					            "Numerator",
					                CALCULATE (
					                    COUNTA ( 'SEN Audit Scores'[Answer] ),
					                    'SEN Audit Scores'[Answer] IN { "Met" },
					                    'SEN Audit Scores'[Question] <> "The SENCO is a qualified teacher and has the relevant qualifications.",
					                    'SEN Audit Visits'[Date of QA] = MAX('SEN Audit Visits'[Date of QA])
					                ) + 0,
					            "Denomiator",
					                CALCULATE (
					                    COUNTA ( 'SEN Audit Scores'[Answer] ),
					                    'SEN Audit Scores'[Answer] IN { "Met", "Not Met", "Partially Met" },
					                    'SEN Audit Scores'[Question] <> "The SENCO is a qualified teacher and has the relevant qualifications.",
					                    'SEN Audit Visits'[Date of QA] = MAX('SEN Audit Visits'[Date of QA])
					                )
					        ),
					        ALL ( 'Calendar' ),
					        'SEN Audit Visits'[Date of QA] <= _MaxDate
					    )
					VAR _Result =
					    CALCULATE (
					        DIVIDE (
					            SUMX ( _SENComplianceTable, [Numerator] ),
					            SUMX ( _SENComplianceTable, [Denomiator] )
					        )
					    )
					RETURN
					    _Result
				formatString: 0.0%;-0.0%;0.0%
				displayFolder: SEN QA
				lineageTag: 557b33a8-bd98-4f46-819e-eb390698d617

			/// 
