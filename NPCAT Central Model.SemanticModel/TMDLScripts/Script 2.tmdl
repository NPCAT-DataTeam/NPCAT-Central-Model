			column 'Every Checks #/%' =
					
					SWITCH(
					    TRUE(),
					    CONTAINSSTRING('zP Every Checks'[zP Every Checks Fields],"%"),"Percentage",
					    NOT(CONTAINSSTRING('zP Every Checks'[zP Every Checks Fields],"%")), "Count")
				lineageTag: b937c461-77d8-4438-bb6d-49ff792865c8
				summarizeBy: none

				annotation SummarizationSetBy = Automatic

			partition 'zP Every Checks' = calculated
				mode: import
				source =
						{
						    ("All Issues", NAMEOF('Measures Folder'[Employee + Job Roles Total Fail %]), 0),
						    ("All Issues", NAMEOF('Measures Folder'[Employee + Job Roles Total Fails]), 1),
						    ("Employee Issues", NAMEOF('Measures Folder'[Employee Table Total Fail %]), 2),
						    ("Employee Issues", NAMEOF('Measures Folder'[Employee Table Total Fails]), 3),
						    ("Role Issues", NAMEOF('Measures Folder'[Employee Roles Table Total Fails %]), 4),
						    ("Role Issues", NAMEOF('Measures Folder'[Employee Roles Table Total Fails]), 5),
						    ("DOB", NAMEOF('Measures Folder'[DOB Check - Fail %]), 6),
						    ("DOB", NAMEOF('Measures Folder'[DOB Check - Fails]), 7),
						    ("Ethnicity", NAMEOF('Measures Folder'[Ethnicity Check - Fail %]), 8),
						    ("Ethnicity", NAMEOF('Measures Folder'[Ethnicity Check - Fails]), 9),
						    ("Gender", NAMEOF('Measures Folder'[Gender Check - Fail %]), 10),
