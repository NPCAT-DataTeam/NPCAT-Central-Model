			///             'SEN Audit Visits'[SUID],
			///             "Numerator",
			///                 CALCULATE (
			///                     COUNTA ( 'SEN Audit Scores'[Answer] ),
			///                     'SEN Audit Scores'[Answer] IN { "Met" },
			///                     'SEN Audit Scores'[Question] <> "The SENCO is a qualified teacher and has the relevant qualifications."
			///                 ) + 0,
			///             "Denomiator",
			///                 CALCULATE (
			///                     COUNTA ( 'SEN Audit Scores'[Answer] ),
			///                     'SEN Audit Scores'[Answer] IN { "Met", "Not Met", "Partially Met" },
