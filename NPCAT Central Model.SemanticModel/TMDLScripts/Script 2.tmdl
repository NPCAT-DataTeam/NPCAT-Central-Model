			///     )
			/// VAR Op_Diff = [Selected Subject National Percentage Grade 4+ Difference]
			/// VAR Difference =
			///     IF (
			///         ISBLANK ( [Selected Subject National Percentage Grade 4+ Difference] ),
			///         BLANK (),
			///         FORMAT ( [Selected Subject National Percentage Grade 4+ Difference], "0.0%" )
			///     )
			/// VAR Operator =
			///     SWITCH (
			///         TRUE,
			///         ISBLANK ( Difference ), "",
			///         Op_Diff >= 0, " +",
			///         Op_Diff < 0, " "
			///     )
			/// VAR Actual =
			///     IF (
			///         ISBLANK ( [Subject Grade 4+] ),
			///         "N/A",
			///         FORMAT ( [Subject Grade 4+], "0.0%" )
			///     )
			/// VAR Final =
			///     Actual & UNICHAR ( 10 ) & "(" & NationalValue & ")" & Operator
			///         & IF ( ISBLANK ( Difference ), "", Difference )
			/// RETURN
			///     IF ( Actual = "N/A", BLANK (), Final )
			measure 'Selected Subject National Percentage Grade 4+ KPI' =
					
					VAR NationalValue =
					    IF (
					        ISBLANK ( [Selected Subject National Percentage Grade 4+] ),
					        "N/A",
					        FORMAT ( [Selected Subject National Percentage Grade 4+], "0.0%" )
					    )
					VAR Op_Diff = [Selected Subject National Percentage Grade 4+ Difference]
					VAR Difference =
					    IF (
					        ISBLANK ( [Selected Subject National Percentage Grade 4+ Difference] ),
					        BLANK (),
					        FORMAT ( [Selected Subject National Percentage Grade 4+ Difference], "0.0%" )
					    )
					VAR Operator =
					    SWITCH (
					        TRUE,
					        ISBLANK ( Difference ), "",
					        Op_Diff >= 0, " +",
					        Op_Diff < 0, " "
					    )
					VAR Actual =
					    IF (
					        ISBLANK ( [Subject Grade 4+] ),
					        "N/A",
					        FORMAT ( [Subject Grade 4+], "0.0%" )
					    )
					VAR Final =
					    Actual & UNICHAR ( 10 ) & "(" & NationalValue & ")" & Operator
					        & IF ( ISBLANK ( Difference ), "", Difference )
					RETURN
					    IF ( Actual = "N/A", BLANK (), Final )
