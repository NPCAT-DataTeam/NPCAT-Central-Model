			/// 
			/// VAR _LastDate =
			///     MAX ( 'Calendar'[Date] )
			/// VAR _Table =
			///     FILTER (
			///         'Student Indicies',
			///         NOT ( [Rank] = "Undefined" )
			///             && 'Student Indicies'[Category] = "IDACI"
			///     )
			/// VAR _TableWithRank =
			///     ADDCOLUMNS ( _Table, "RankValue", VALUE ( 'Student Indicies'[Rank] ) )
			/// RETURN
			///     CALCULATE (
			///         AVERAGEX ( _TableWithRank, VALUE ( [Rank] ) ),
			///         'Student Indicies'[Category] = "IDACI",
			///         'Student Database (Full)'[DOA] <= _LastDate,
			///         'Student Database (Full)'[Leaving date] > _LastDate
			///             || ISBLANK ( 'Student Database (Full)'[Leaving date] ),
			///         'Calendar'[Date] = _LastDate
			///     )
			measure 'IDACI Rank' =
					
					VAR _LastDate =
					    MAX ( 'Calendar'[Date] )
					VAR _Table =
					    FILTER (
					        'Student Indicies',
					        NOT ( [Rank] = "Undefined" )
					            && 'Student Indicies'[RELEASE_YEAR] = 2025 && 'Student Indicies'[Category] = "IDACI"
					    )
					VAR _TableWithRank =
					    ADDCOLUMNS ( _Table, "RankValue", VALUE ( 'Student Indicies'[Rank] ) )
					RETURN
					    CALCULATE (
					        AVERAGEX ( _TableWithRank, VALUE ( [Rank] ) ),
					        'Student Indicies'[Category] = "IDACI",
					        'Student Database (Full)'[DOA] <= _LastDate,
					        'Student Database (Full)'[Leaving date] > _LastDate
					            || ISBLANK ( 'Student Database (Full)'[Leaving date] ),
					        'Calendar'[Date] = _LastDate
					    )
				formatString: #,##0
				displayFolder: Student Measures\IDACI Measures
				lineageTag: 2705acdb-a956-4eca-8bc5-666c173dfa23

