			partition 'zP KS4 Grade Distribution' = calculated
				mode: import
				source =
						{
						    ("Number of Grades", NAMEOF('KS4 Distinct Grades'[Grade (Short)]), 0),
						    ("Cumulative Grade", NAMEOF('KS4 Distinct Grades'[Grade (+)]), 1),
						    ("Grade Percentage", NAMEOF('KS4 Distinct Grades'[Grade (%)]), 2),
						    ("Cumulative Grade Percentage", NAMEOF('KS4 Distinct Grades'[Grade (%+)]), 3)
						}

