			/// 
			/// VAR _LastDate =
			///     MAX ( 'Calendar'[Date] )
			/// VAR _Table =
			///     FILTER ( 'Student Indicies', NOT ( [Decile] = "Undefined" ) )
			/// VAR _TableWithDecile =
			///     ADDCOLUMNS ( _Table, "DecileValue", VALUE ( 'Student Indicies'[Decile] ) )
			/// RETURN
			///     CALCULATE (
			///         AVERAGEX ( _TableWithDecile, VALUE ( [Decile] ) ),
			///         'Student Database (Full)'[DOA] <= _LastDate,
			///         'Student Database (Full)'[Leaving date] > _LastDate
			///             || ISBLANK ( 'Student Database (Full)'[Leaving date] ),
			///         'Calendar'[Date] = _LastDate
			///     )
			measure 'Indicies Decile' =
					
					VAR _LastDate =
					    MAX ( 'Calendar'[Date] )
					VAR _Table =
					    FILTER ( 'Student Indicies', NOT ( [Decile] = "Undefined" ) && 'Student Indicies'[RELEASE_YEAR] = 2025 )
					VAR _TableWithDecile =
					    ADDCOLUMNS ( _Table, "DecileValue", VALUE ( 'Student Indicies'[Decile] ) )
					RETURN
					    CALCULATE (
					        AVERAGEX ( _TableWithDecile, VALUE ( [Decile] ) ),
					        'Student Database (Full)'[DOA] <= _LastDate,
					        'Student Database (Full)'[Leaving date] > _LastDate
					            || ISBLANK ( 'Student Database (Full)'[Leaving date] ),
					        'Calendar'[Date] = _LastDate
					    )
				formatString: 0.0
				displayFolder: Student Measures\IDACI Measures
				lineageTag: 8916dd13-6bfc-420f-bd22-0d0faf505fc3

				changedProperty = FormatString

