			/// 
			/// VAR __MaxDate =
			///     MAX ( 'Safeguarding Visits'[Snapshot Date] )
			/// VAR __Numerator =
			///     CALCULATE (
			///         COUNTA ( 'Safeguarding Visit Scores'[Met/Not Met] ),
			///         'Safeguarding Visit Scores'[Met/Not Met] IN { "Met", "Partially Met" }
			///     )
			/// VAR __Denominator =
			///     CALCULATE (
			///         COUNTA ( 'Safeguarding Visit Scores'[Met/Not Met] ),
			///         'Safeguarding Visit Scores'[Met/Not Met]
			///             IN { "Met", "Not Met", "Partially Met" }
			///     )
			/// RETURN
			///     CALCULATE (
			///         IF (
			///             ISBLANK ( [Safeguarding Statutory Compliance %] ),
			///             "",
			///             __Numerator & " of " & __Denominator
			///         ) //Partially Met is counted as a negative
			///     )
			measure 'Safeguarding Activities x of y' =
					
					VAR __MaxDate =
					    MAX ( 'Safeguarding Visits'[Snapshot Date] )
					VAR __Numerator =
					    CALCULATE (
					        COUNTA ( 'Safeguarding Visit Scores'[Met/Not Met] ),
					        'Safeguarding Visit Scores'[Met/Not Met] IN { "Met", "Partially Met" }
					    )
					VAR __Denominator =
					    CALCULATE (
					        COUNTA ( 'Safeguarding Visit Scores'[Met/Not Met] ),
					        'Safeguarding Visit Scores'[Met/Not Met]
					            IN { "Met", "Not Met", "Partially Met" }
					    )
					RETURN
					    CALCULATE (
					        IF (
					            ISBLANK ( [Safeguarding Statutory Compliance %] ),
					            "",
					            __Numerator & " of " & __Denominator
					        ) //Partially Met is counted as a negative
					    )
				displayFolder: Safeguarding
				lineageTag: c65322dc-7d16-4b65-8245-fec56ed653dd

			/// 
			/// CALCULATE (
			///     DIVIDE (
			///         //Trust Standard
			///         CALCULATE (
			///             COUNTA ( 'Safeguarding Visit Scores'[Met/Not Met] ),
			///             'Safeguarding Visit Scores'[Met/Not Met] IN { "Met" } //, "Partially Met" }
			///         ) + 0,
			///         CALCULATE (
			///             COUNTA ( 'Safeguarding Visit Scores'[Met/Not Met] ),
			///             'Safeguarding Visit Scores'[Met/Not Met]
			///                 IN { "Met", "Not Met", "Partially Met" }
			///         )
			///     ),
			///     'Safeguarding Visits'[Snapshot Date]
			///         = MAX ( 'Safeguarding Visits'[Snapshot Date] )
			/// )
			measure 'Safeguarding Trust Compliance %' =
					
					CALCULATE (
					    DIVIDE (
					        //Trust Standard
					        CALCULATE (
					            COUNTA ( 'Safeguarding Visit Scores'[Met/Not Met] ),
					            'Safeguarding Visit Scores'[Met/Not Met] IN { "Met" } //, "Partially Met" }
					        ) + 0,
					        CALCULATE (
					            COUNTA ( 'Safeguarding Visit Scores'[Met/Not Met] ),
					            'Safeguarding Visit Scores'[Met/Not Met]
					                IN { "Met", "Not Met", "Partially Met" }
					        )
					    ),
					    'Safeguarding Visits'[Snapshot Date]
					        = MAX ( 'Safeguarding Visits'[Snapshot Date] )
					)
				formatString: 0.0%;-0.0%;0.0%
				displayFolder: Safeguarding
				lineageTag: 5cb2e16c-bef7-465f-8beb-62bebecc81a8

				changedProperty = FormatString

			/// 
			/// SWITCH (
			///     TRUE (),
			///     [Safeguarding Trust Compliance %] = 1, "Tier 1",
			///     [Safeguarding Trust Compliance %] >= 0.95, "Tier 2",
			///     [Safeguarding Trust Compliance %] >= 0.90, "Tier 3",
			///     [Safeguarding Trust Compliance %] < 0.9, "Tier 4"
			/// )
			measure 'Safeguarding Tier' =
					
					SWITCH (
					    TRUE (),
					    [Safeguarding Trust Compliance %] = 1, "Tier 1",
					    [Safeguarding Trust Compliance %] >= 0.95, "Tier 2",
					    [Safeguarding Trust Compliance %] >= 0.90, "Tier 3",
					    [Safeguarding Trust Compliance %] < 0.9, "Tier 4"
					)
				displayFolder: Safeguarding
				lineageTag: 5fae0194-5aad-4c99-a8aa-31fb7d0999f3

