			///         "Days Open",
			///             CALCULATE (
			///                 COUNTROWS ( 'Health&Safety Actions Dates' ),
			///                 'Health&Safety Actions Dates'[Late Check] = "Overdue",
			///                 'Health&Safety Actions Dates'[Weekday] IN { 0, 1, 2, 3, 4 }
			///             )
