			/// 
			/// CALCULATE (
			///     DIVIDE (
			///         CALCULATE ( COUNTA ( 'Attendance'[Mark] ), 'Attendance'[Mark] IN { "T" } ),
			///         SUM ( 'Attendance'[Sessions] )
			///     ),
			///     'Calendar'[FutureDate] IN { "Past" }
			/// )
			measure 'Traveller Absence %' =
					
					CALCULATE (
					    DIVIDE (
