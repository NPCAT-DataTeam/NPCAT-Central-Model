			/// 
			/// VAR _TotalCostTbl =
			///     CALCULATETABLE (
			///         ADDCOLUMNS (
			///             SUMMARIZE (
			///                 'Printing and Copying',
			///                 'Printing and Copying'[Paper Cost Lookup],
			///                 "Total Cost",
			///                     CALCULATE (
			///                         MIN ( 'Printing and Copying'[Total Cost] ),
			///                         'Printing and Copying'[Total Cost] > 0
			///                     ),
			///                 "Total Sheets", SUM ( 'Printing and Copying'[Pages Per Job] ),
			///                 "What if Total Sheets",
			///                     SUM ( 'Printing and Copying'[Pages Per Job] ) * ( 1 - [zP Total page Scenario Value] )
			///             ),
			///             "Original Total Cost Calc", [Total Cost] * [Total Sheets],
			///             "What if Total Cost Calc", [Total Cost] * [What if Total Sheets]
			///         ),
			///         ISONORAFTER ( 'Calendar'[Date], MIN ( 'Calendar'[Date] ), ASC )
			///     )
			/// VAR _OGTotalCost =
			///     CALCULATE ( SUMX ( _TotalCostTbl, [Original Total Cost Calc] ) )
			/// VAR _WhatIfTotalCost =
			///     CALCULATE ( SUMX ( _TotalCostTbl, [What if Total Cost Calc] ) )
			/// VAR Final = _WhatIfTotalCost - _OGTotalCost
			/// RETURN
			///     Final
			measure 'Volume Costs Difference What if' =
					
					VAR _TotalCostTbl =
					    CALCULATETABLE (
					        ADDCOLUMNS (
					            SUMMARIZE (
					                'Printing and Copying',
					                'Printing and Copying'[Paper Cost Lookup],
					                "Total Cost",
					                    CALCULATE (
					                        MIN ( 'Printing and Copying'[Total Cost] ),
					                        'Printing and Copying'[Total Cost] > 0
					                    ),
					                "Total Sheets", SUM ( 'Printing and Copying'[Pages Per Job] ),
					                "What if Total Sheets",
					                    SUM ( 'Printing and Copying'[Pages Per Job] ) * ( 1 - [zP Total page Scenario Value] )
					            ),
					            "Original Total Cost Calc", [Total Cost] * [Total Sheets],
					            "What if Total Cost Calc", [Total Cost] * [What if Total Sheets]
					        ),
					        ISONORAFTER ( 'Calendar'[Date], MIN ( 'Calendar'[Date] ), ASC )
					    )
					VAR _OGTotalCost =
					    CALCULATE ( SUMX ( _TotalCostTbl, [Original Total Cost Calc] ) )
					VAR _WhatIfTotalCost =
					    CALCULATE ( SUMX ( _TotalCostTbl, [What if Total Cost Calc] ) )
					VAR Final = _WhatIfTotalCost - _OGTotalCost
					RETURN
					    Final
				formatString: "£"#,0.0;-"£"#,0.0;"£"#,0.0
				displayFolder: Printing
				lineageTag: d96e7686-b20c-4a2a-bdee-b4e6a9d94b44

				annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

