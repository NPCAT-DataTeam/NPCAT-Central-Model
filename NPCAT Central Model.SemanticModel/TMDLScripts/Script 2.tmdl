			/// 
			/// VAR _LastDate =
			///     LASTDATE ( 'Calendar'[Date] )
			/// VAR _MaxCount =
			///     CALCULATE (
			///         DISTINCTCOUNT ( 'Employee Job Roles'[every ID] ),
			///         'Employee Job Roles'[Property Start Date] <= _LastDate,
			///         'Employee Job Roles'[Post End Date] > _LastDate
			///             || ISBLANK ( 'Employee Job Roles'[Post End Date] )
			///     )
			/// VAR _FirstDate =
			///     FIRSTDATE ( 'Calendar'[Date] )
			/// VAR _MinCount =
			///     CALCULATE (
			///         DISTINCTCOUNT ( 'Employee Job Roles'[every ID] ),
			///         'Employee Job Roles'[Property Start Date] >= _FirstDate,
			///         'Employee Job Roles'[Post End Date] > _FirstDate
			///             || ISBLANK ( 'Employee Job Roles'[Post End Date] )
			///     )
			/// RETURN
			///     DIVIDE ( ( _MaxCount + _MinCount ), 2 )
			measure 'Avg Staff Count' =
					
					VAR _LastDate =
					    LASTDATE ( 'Calendar'[Date] )
					VAR _MaxCount =
					    CALCULATE (
					        DISTINCTCOUNT ( 'Employee Job Roles'[every ID] ),
					        'Employee Job Roles'[Property Start Date] <= _LastDate,
					        'Employee Job Roles'[Post End Date] > _LastDate
					            || ISBLANK ( 'Employee Job Roles'[Post End Date] )
					    )
					VAR _FirstDate =
					    FIRSTDATE ( 'Calendar'[Date] )
					VAR _MinCount =
					    CALCULATE (
					        DISTINCTCOUNT ( 'Employee Job Roles'[every ID] ),
					        'Employee Job Roles'[Property Start Date] >= _FirstDate,
					        'Employee Job Roles'[Post End Date] > _FirstDate
					            || ISBLANK ( 'Employee Job Roles'[Post End Date] )
					    )
					RETURN
					    DIVIDE ( ( _MaxCount + _MinCount ), 2 )
				displayFolder: Unused
				lineageTag: a0105a24-f59f-4d36-b338-45071d6b60da

