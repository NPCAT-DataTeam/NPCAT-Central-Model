			///         CALCULATE([Total Students],
			///         REMOVEFILTERS( 'KS4 Student Headlines'[4+ Statement], 'KS4 Student Headlines'[5 + Statement], 'KS4 Student Headlines'[7 + Statement])
			///     )
			/// )
			measure 'Total Students 4+/5+' =
					
					DIVIDE(
					    [Total Students],
					        CALCULATE([Total Students],
					        REMOVEFILTERS( 'KS4 Student Headlines'[4+ Statement], 'KS4 Student Headlines'[5 + Statement], 'KS4 Student Headlines'[7 + Statement])
					    )
					)
