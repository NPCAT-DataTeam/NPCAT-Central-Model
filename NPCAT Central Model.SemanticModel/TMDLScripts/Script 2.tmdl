			/// VAR _MaxSchoolMonth =
			///     MAX ( 'Calendar'[School Month Number] )
			/// VAR _Yearselector =
			///     IF ( _MaxSchoolMonth < 10, _MaxOffset - 1, _MaxOffset )
			/// VAR _StudentCount =
			///     CALCULATE (
			///         DISTINCTCOUNT ( MTC[Globally Unique ID] ),
			///         REMOVEFILTERS ( 'Calendar' ),
			///         'Calendar'[Current School Year Offset] = _Yearselector
			///     )
			/// RETURN
			///     _StudentCount
			measure 'MTC No. Pupils PY' =
					
					VAR _MaxOffset =
					    MAX ( 'Calendar'[Current School Year Offset] ) - 1
					VAR _MaxSchoolMonth =
					    MAX ( 'Calendar'[School Month Number] )
					VAR _Yearselector =
					    IF ( _MaxSchoolMonth < 10, _MaxOffset - 1, _MaxOffset )
					VAR _StudentCount =
					    CALCULATE (
					        DISTINCTCOUNT ( MTC[Globally Unique ID] ),
					        REMOVEFILTERS ( 'Calendar' ),
					        'Calendar'[Current School Year Offset] = _Yearselector
					    )
