			/// 
			/// VAR ComplianceTable =
			///     CALCULATETABLE (
			///         SUMMARIZE (
			///             'SEN Audit Scores',
			///             'SEN Audit Scores'[SUID],
			///             "SEN Compliance", [SEN Compliance % (Most Recent QA)],
			///             "Date", MAX ( 'SEN Audit Visits'[Date of QA] )
			///         )
			///     )
			/// RETURN
			///     AVERAGEX ( ComplianceTable, [SEN Compliance % (Most Recent QA)] )
			measure 'SEN Compliance % (Multi School)' =
					
					VAR ComplianceTable =
					    CALCULATETABLE (
					        SUMMARIZE (
					            'SEN Audit Scores',
					            'SEN Audit Scores'[SUID],
					            "SEN Compliance", [SEN Compliance % (Most Recent QA)],
					            "Date", MAX ( 'SEN Audit Visits'[Date of QA] )
					        )
					    )
					RETURN
					    AVERAGEX ( ComplianceTable, [SEN Compliance % (Most Recent QA)] )
				formatString: 0.0%;-0.0%;0.0%
				displayFolder: Unused
				lineageTag: 1775d8bf-1309-4a6b-a84a-ceeffa0d51a5

			/// 
			/// SWITCH (
			///     TRUE (),
			///     [SEN Compliance % (Most Recent QA)] = 1, "Tier 1",
			///     [SEN Compliance % (Most Recent QA)] >= 0.95, "Tier 2",
			///     [SEN Compliance % (Most Recent QA)] >= 0.90, "Tier 3",
			///     [SEN Compliance % (Most Recent QA)] < 0.9, "Tier 4"
			/// )
			measure 'SEN Compliance Tier' =
					
					SWITCH (
					    TRUE (),
					    [SEN Compliance % (Most Recent QA)] = 1, "Tier 1",
					    [SEN Compliance % (Most Recent QA)] >= 0.95, "Tier 2",
					    [SEN Compliance % (Most Recent QA)] >= 0.90, "Tier 3",
					    [SEN Compliance % (Most Recent QA)] < 0.9, "Tier 4"
					)
				displayFolder: Unused
				lineageTag: a04e8660-dd42-4d4f-9f35-ddcecb563458

