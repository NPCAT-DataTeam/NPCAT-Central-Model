			/// 
			/// VAR _LastDate =
			///     MAX ( 'Calendar'[Date] )
			/// RETURN
			///     CALCULATE (
			///         DISTINCTCOUNT ( 'Absences'[Employee Absence Key] ),
			///         'Absences'[Absence Start Date] <= _LastDate,
			///         'Absences'[Absence End Date] >= _LastDate
			///             || ISBLANK ( 'Absences'[Absence End Date] ),
			///         CROSSFILTER ( 'Absences'[Absence Start Date], 'Calendar'[Date], NONE ),
			///         'Absences'[LTS Flag] = "LTS"
			///     )
			measure 'LTS Current Sickness (Count)' =
					
					VAR _LastDate =
					    MAX ( 'Calendar'[Date] )
					RETURN
					    CALCULATE (
					        DISTINCTCOUNT ( 'Absences'[Employee Absence Key] ),
					        'Absences'[Absence Start Date] <= _LastDate,
					        'Absences'[Absence End Date] >= _LastDate
					            || ISBLANK ( 'Absences'[Absence End Date] ),
					        CROSSFILTER ( 'Absences'[Absence Start Date], 'Calendar'[Date], NONE ),
					        'Absences'[LTS Flag] = "LTS"
					    )
				formatString: #,0
				displayFolder: Human Resources\Long Term Sickness
				lineageTag: c3f0d2f6-7046-4b18-b314-834ed3e17ecf

