			/// 
			/// COUNTROWS('Employee Job Roles')
			measure 'Employee Job Roles' =
					
					COUNTROWS('Employee Job Roles')
				displayFolder: Employees/Retention
				lineageTag: 25cdd655-d805-41cd-ab73-f63b6e8608ab

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			/// 
			/// // This is an overall over a window
			/// VAR _LastDate =
			///     LASTDATE ( 'Calendar'[Date] )
			/// VAR _FirstDate = 
			///     FIRSTDATE('Calendar'[Date])
			/// 
			/// VAR _Final =
			///     CALCULATE (
			///         DISTINCTCOUNT ( 'Employee Job Roles'[Employee ID] ),
			///         'Employee Job Roles'[Post Start Date] <= _LastDate,
			///         'Employee Job Roles'[Post End Date] > _FirstDate
			///             || ISBLANK ( 'Employee Job Roles'[Post End Date] )
			///     )
			/// RETURN
			///     _Final
			measure 'Staff Employed (Window)' = ```
					
					// This is an overall over a window
					VAR _LastDate =
					    LASTDATE ( 'Calendar'[Date] )
					VAR _FirstDate = 
					    FIRSTDATE('Calendar'[Date])
					
					VAR _Final =
					    CALCULATE (
					        DISTINCTCOUNT ( 'Employee Job Roles'[Employee ID] ),
					        'Employee Job Roles'[Post Start Date] <= _LastDate,
					        'Employee Job Roles'[Post End Date] > _FirstDate
					            || ISBLANK ( 'Employee Job Roles'[Post End Date] )
					    )
					RETURN
					    _Final
					```
				displayFolder: Employees/Retention
				lineageTag: 30a91f93-daa3-4cdd-89fa-b694e19e8330

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			/// 
			/// // This is an overall over a window of the Main Roles
			/// VAR _LastDate =
			///     LASTDATE ( 'Calendar'[Date] )
			/// VAR _FirstDate = 
			///     FIRSTDATE('Calendar'[Date])
			/// 
			/// -- Step 1: Filter Employee Job Roles to keep only one role per employee
			/// VAR _FilteredJobRoles =
			///     ADDCOLUMNS(
			///         SUMMARIZE(
			///             'Employee Job Roles',
			///             'Employee Job Roles'[Employee ID]
			///         ),
			///         "SelectedRoleID",
			///         VAR _EmpID = [Employee ID]
			///         VAR _MaxHours =
			///             CALCULATE(
			///                 MAX('Employee Job Roles'[Contract Hours]),
			///                 'Employee Job Roles'[Employee ID] = _EmpID
			///             )
			///         VAR _LatestStart =
			///             CALCULATE(
			///                 MAX('Employee Job Roles'[Post Start Date]),
			///                 'Employee Job Roles'[Employee ID] = _EmpID,
			///                 'Employee Job Roles'[Contract Hours] = _MaxHours
			///             )
			///         RETURN
			///             CALCULATE(
			///                 MAXX(
			///                     FILTER(
			///                         'Employee Job Roles',
			///                         'Employee Job Roles'[Employee ID] = _EmpID
			///                             && 'Employee Job Roles'[Contract Hours] = _MaxHours
			///                             && 'Employee Job Roles'[Post Start Date] = _LatestStart
			///                     ),
			///                     'Employee Job Roles'[Employee Post Key]  -- or any unique identifier
			///                 )
			///             )
			///     )
			/// 
			/// -- Step 2: Get the subset of Employee Job Roles matching those selected Role IDs
			/// VAR _Prefiltered =
			///     FILTER(
			///         'Employee Job Roles',
			///         'Employee Job Roles'[Employee Post Key] IN SELECTCOLUMNS(_FilteredJobRoles, "SelectedRoleID", [SelectedRoleID])
			///     )
			/// 
			/// VAR _Final =
			///     CALCULATE (
			///         DISTINCTCOUNT ( 'Employee Job Roles'[Employee ID] ),
			///         KEEPFILTERS(_Prefiltered),
			///         'Employee Job Roles'[Post Start Date] <= _LastDate,
			///         'Employee Job Roles'[Post End Date] > _FirstDate
			///             || ISBLANK ( 'Employee Job Roles'[Post End Date] )
			///     )
			/// RETURN
			///     _Final
			measure 'Head Count (Window)' = ```
					
					// This is an overall over a window of the Main Roles
					VAR _LastDate =
					    LASTDATE ( 'Calendar'[Date] )
					VAR _FirstDate = 
					    FIRSTDATE('Calendar'[Date])
					
					-- Step 1: Filter Employee Job Roles to keep only one role per employee
					VAR _FilteredJobRoles =
					    ADDCOLUMNS(
					        SUMMARIZE(
					            'Employee Job Roles',
					            'Employee Job Roles'[Employee ID]
					        ),
					        "SelectedRoleID",
					        VAR _EmpID = [Employee ID]
					        VAR _MaxHours =
					            CALCULATE(
					                MAX('Employee Job Roles'[Contract Hours]),
					                'Employee Job Roles'[Employee ID] = _EmpID
					            )
					        VAR _LatestStart =
					            CALCULATE(
					                MAX('Employee Job Roles'[Post Start Date]),
					                'Employee Job Roles'[Employee ID] = _EmpID,
					                'Employee Job Roles'[Contract Hours] = _MaxHours
					            )
					        RETURN
					            CALCULATE(
					                MAXX(
					                    FILTER(
					                        'Employee Job Roles',
					                        'Employee Job Roles'[Employee ID] = _EmpID
					                            && 'Employee Job Roles'[Contract Hours] = _MaxHours
					                            && 'Employee Job Roles'[Post Start Date] = _LatestStart
					                    ),
					                    'Employee Job Roles'[Employee Post Key]  -- or any unique identifier
					                )
					            )
					    )
					
					-- Step 2: Get the subset of Employee Job Roles matching those selected Role IDs
					VAR _Prefiltered =
					    FILTER(
					        'Employee Job Roles',
					        'Employee Job Roles'[Employee Post Key] IN SELECTCOLUMNS(_FilteredJobRoles, "SelectedRoleID", [SelectedRoleID])
					    )
					
					VAR _Final =
					    CALCULATE (
					        DISTINCTCOUNT ( 'Employee Job Roles'[Employee ID] ),
					        KEEPFILTERS(_Prefiltered),
					        'Employee Job Roles'[Post Start Date] <= _LastDate,
					        'Employee Job Roles'[Post End Date] > _FirstDate
					            || ISBLANK ( 'Employee Job Roles'[Post End Date] )
					    )
					RETURN
					    _Final
					```
				formatString: 0
				displayFolder: Employees/Retention
				lineageTag: b62d42f6-8b13-443c-acf5-18aa83cc93d0

			/// 
			/// VAR _LastDate =
			///     LASTDATE ( 'Calendar'[Date] )
			/// VAR _FirstDate =
			///     FIRSTDATE ( 'Calendar'[Date] )
			/// 
			/// RETURN
			///     CALCULATE (
			///         SUM ( 'Employee Job Roles'[FTE Ratio] ),
			///         'Employee Job Roles'[Post Start Date] <= _LastDate,
			///         'Employee Job Roles'[Post End Date] > _FirstDate
			///             || ISBLANK ( 'Employee Job Roles'[Post End Date] )
			///     )
			measure 'Staff FTE (Window)' =
					
					VAR _LastDate =
					    LASTDATE ( 'Calendar'[Date] )
					VAR _FirstDate =
					    FIRSTDATE ( 'Calendar'[Date] )
					
					RETURN
					    CALCULATE (
					        SUM ( 'Employee Job Roles'[FTE Ratio] ),
					        'Employee Job Roles'[Post Start Date] <= _LastDate,
					        'Employee Job Roles'[Post End Date] > _FirstDate
					            || ISBLANK ( 'Employee Job Roles'[Post End Date] )
					    )
				displayFolder: Employees/Retention
				lineageTag: f7c5261d-609c-484f-8684-eabcd79ba84e

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Sessions needed until not PA' = ```
					
					
					VAR TotalSessionsToDate = SUM ( Attendance[Sessions] )
					
					VAR P = CALCULATE(SUM ( Attendance[Sessions] ),Attendance[Attendance] = 1)
					VAR T = SUM ( Attendance[Sessions] )
					VAR Need = 9 * T - 10 * P
					VAR CutOff = 380-(MAX('Calendar'[School Month Number])-1)*40
					RETURN
					
					IF(MAX( Need, 0 )>CutOff,"Confirmed PA",FORMAT(Need,0))
					
					
					```
				displayFolder: Attendance Measures
				lineageTag: b557b9fe-a32e-4a1b-8e59-017b971bad70

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Days needed until not PA' = ```
					
					
					VAR TotalSessionsToDate = SUM ( Attendance[Sessions] )
					
					VAR P = CALCULATE(SUM ( Attendance[Sessions] ),Attendance[Present] = 1)
					VAR T = SUM ( Attendance[Sessions] )
					VAR Need =( 9 * T - 10 * P)/2
					VAR CutOff = 190-(MAX('Calendar'[School Month Number])-1)*20
					RETURN
					IF(MAX( Need, 0 )>CutOff,"Confirmed PA",FORMAT(Need,0.0))
					
					
					```
				displayFolder: Attendance Measures
