			///         [Students on Roll (IDACI)],
			///         ALL ( 'Student Indicies'[Decile], 'Student Indicies'[Decile Sort] )
			///     )
			/// )
			measure '% Students (Excluding Decile)' =
					
					DIVIDE (
					    [Students on Roll (IDACI)],
					    CALCULATE (
					        [Students on Roll (IDACI)],
					        ALL ( 'Student Indicies'[Decile], 'Student Indicies'[Decile Sort] )
