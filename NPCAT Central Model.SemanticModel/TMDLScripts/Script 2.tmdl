			/// 
			/// VAR CutOff = [Dynamic Max Date]
			/// RETURN
			///     CALCULATE (
			///         DISTINCTCOUNT ( Creditors[Invoice ID] ),
			///         REMOVEFILTERS ( 'Calendar'[Date] ),
			///         Creditors[Invoice Date] <= CutOff
			///             && (
			///                 ISBLANK ( Creditors[Pay Date] )
			///                     || Creditors[Pay Date] > CutOff
			///             )
			///             && Creditors[Due Date] < CutOff //DATEDIFF ( Creditors[Due Date], CutOff, DAY ) > 0
			///     )
			measure 'Invoices Overdue' =
					
					VAR CutOff = [Dynamic Max Date]
					RETURN
					    CALCULATE (
					        DISTINCTCOUNT ( Creditors[Invoice ID] ),
					        REMOVEFILTERS ( 'Calendar'[Date] ),
					        Creditors[Invoice Date] <= CutOff
					            && (
					                ISBLANK ( Creditors[Pay Date] )
					                    || Creditors[Pay Date] > CutOff
					            )
					            && Creditors[Due Date] < CutOff //DATEDIFF ( Creditors[Due Date], CutOff, DAY ) > 0
					    )
				formatString: 0
				displayFolder: Finance Measures\Creditors
				lineageTag: 0e08232a-5f4f-439b-a7e6-ff0764d87c0a

				annotation PBI_FormatHint = {"isGeneralNumber":true}

