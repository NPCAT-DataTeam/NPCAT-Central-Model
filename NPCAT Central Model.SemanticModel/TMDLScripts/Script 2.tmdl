			/// 
			/// CALCULATE (
			///     AVERAGE ( MTC[Mark Number] ),
			///     'MTC'[MARK_GRADE] <> "B",
			///     'MTC'[MARK_GRADE] <> "A",
			///     'MTC'[MARK_GRADE] <> "U",
			///     'MTC'[MARK_GRADE] <> "X",
			///     'MTC'[MARK_GRADE] <> "J",
			///     'MTC'[MARK_GRADE] <> "L",
			///     'MTC'[MARK_GRADE] <> "Q"
			/// )
			measure 'Avg. MTC Mark' =
					
					CALCULATE (
					    AVERAGE ( MTC[Mark Number] ),
					    'MTC'[MARK_GRADE] <> "B",
					    'MTC'[MARK_GRADE] <> "A",
					    'MTC'[MARK_GRADE] <> "U",
					    'MTC'[MARK_GRADE] <> "X",
					    'MTC'[MARK_GRADE] <> "J",
					    'MTC'[MARK_GRADE] <> "L",
					    'MTC'[MARK_GRADE] <> "Q"
					)
				formatString: 0.0
				displayFolder: Statutory MTC
				lineageTag: bcbb5556-6c30-46b6-b908-99eb1f0bbde3

				changedProperty = FormatString

			/// 
			/// CALCULATE ( [MTC No. Pupils], 'MTC'[Mark Number] IN { 25 } ) + 0
			measure 'MTC # Ach Full Marks' =
					
					CALCULATE ( [MTC No. Pupils], 'MTC'[Mark Number] IN { 25 } ) + 0
				formatString: 0
				displayFolder: Statutory MTC
				lineageTag: 4eff9c7f-0218-463d-8d2f-21a715e72a2f

			/// 
			/// VAR _FullMarkPupils =
			///     CALCULATE ( [MTC No. Pupils], 'MTC'[Mark Number] IN { 25 } )
			/// VAR _TotalPupils = [MTC No. Pupils]
			/// RETURN
			///     IF (
			///         ISBLANK ( DIVIDE ( _FullMarkPupils, _TotalPupils ) ),
			///         IF ( ISBLANK ( _TotalPupils ), BLANK (), 0 ),
			///         DIVIDE ( _FullMarkPupils, _TotalPupils )
			///     )
			measure 'MTC % Ach Full Marks' =
					
					VAR _FullMarkPupils =
					    CALCULATE ( [MTC No. Pupils], 'MTC'[Mark Number] IN { 25 } )
					VAR _TotalPupils = [MTC No. Pupils]
					RETURN
					    IF (
					        ISBLANK ( DIVIDE ( _FullMarkPupils, _TotalPupils ) ),
					        IF ( ISBLANK ( _TotalPupils ), BLANK (), 0 ),
					        DIVIDE ( _FullMarkPupils, _TotalPupils )
					    )
				formatString: 0.0%;-0.0%;0.0%
				displayFolder: Statutory MTC
				lineageTag: ae6344c6-1131-4748-a649-d47f0ecb0e81

				changedProperty = FormatString

			/// 
			/// VAR _StudentCount =
			///     DISTINCTCOUNT ( 'MTC'[Globally Unique ID] )
			/// VAR _YearCount =
			///     DISTINCTCOUNT ( 'MTC'[Academic Year] )
			/// RETURN
			///     DIVIDE ( _StudentCount, _YearCount )
			measure 'MTC No. Pupils' =
					
					VAR _StudentCount =
					    DISTINCTCOUNT ( 'MTC'[Globally Unique ID] )
					VAR _YearCount =
					    DISTINCTCOUNT ( 'MTC'[Academic Year] )
					RETURN
					    DIVIDE ( _StudentCount, _YearCount )
				formatString: 0
				displayFolder: Statutory MTC
				lineageTag: a96770b6-777c-48ff-b866-1c226747366b

			/// 
			/// CALCULATE (
			///     [MTC No. Pupils],
			///     FILTER (
			///         CALCULATETABLE (
			///             SUMMARIZE ( 'MTC', 'MTC'[Mark Groups Sort], 'MTC'[Mark Groups] ),
			///             ALLSELECTED ( 'MTC' )
			///         ),
			///         ISONORAFTER (
			///             'MTC'[Mark Groups Sort], MIN ( 'MTC'[Mark Groups Sort] ), ASC,
			///             'MTC'[Mark Groups], MIN ( 'MTC'[Mark Groups] ), ASC
			///         )
			///     )
			/// )
			measure 'MTC No. Pupils Reverse running total in Mark Groups' =
					
					CALCULATE (
					    [MTC No. Pupils],
					    FILTER (
					        CALCULATETABLE (
					            SUMMARIZE ( 'MTC', 'MTC'[Mark Groups Sort], 'MTC'[Mark Groups] ),
					            ALLSELECTED ( 'MTC' )
					        ),
					        ISONORAFTER (
					            'MTC'[Mark Groups Sort], MIN ( 'MTC'[Mark Groups Sort] ), ASC,
					            'MTC'[Mark Groups], MIN ( 'MTC'[Mark Groups] ), ASC
					        )
					    )
					)
				formatString: 0
				displayFolder: Statutory MTC
				lineageTag: d7711a9e-0e6b-4090-981a-575d146d802b

				changedProperty = FormatString

