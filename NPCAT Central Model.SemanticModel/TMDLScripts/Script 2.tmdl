				annotation PBI_FormatHint = {"isGeneralNumber":true}

			/// 
			///     VAR MaxDate = MAX(Calendar[Date])
			///     VAR MonthDiff = SWITCH(TRUE(),MONTH(MaxDate) <= 8, 7,MONTH(MaxDate) = 1, 7,MONTH(MaxDate) > 8, 6)
			///     VAR _6Month = DATE(YEAR(MaxDate),MONTH(MaxDate)-MonthDiff,DAY(MaxDate))
			/// RETURN
			/// CALCULATE ( [% Failed Phishing Simulations (Email)], SAMEPERIODLASTYEAR ( 'Calendar'[Date] ),
			///         'Boxphish Courses'[Date Completed] >= _6Month
			///     )
			measure '% of Simmulations Failed 6Months' = ```
					
					    VAR MaxDate = MAX(Calendar[Date])
					    VAR MonthDiff = SWITCH(TRUE(),MONTH(MaxDate) <= 8, 7,MONTH(MaxDate) = 1, 7,MONTH(MaxDate) > 8, 6)
					    VAR _6Month = DATE(YEAR(MaxDate),MONTH(MaxDate)-MonthDiff,DAY(MaxDate))
					RETURN
					CALCULATE ( [% Failed Phishing Simulations (Email)], SAMEPERIODLASTYEAR ( 'Calendar'[Date] ),
					        'Boxphish Courses'[Date Completed] >= _6Month
					    )
					```
				formatString: 0.0%;-0.0%;0.0%
				displayFolder: Boxphish
				lineageTag: 25f46ada-9590-4f2c-8110-68188746dae2

