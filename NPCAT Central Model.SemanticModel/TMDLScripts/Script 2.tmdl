			///             REMOVEFILTERS ( 'Safeguarding Visits'[Is Most Recent Safeguarding Visit] ),
			///             'Safeguarding Visit Scores'[Subgroup Index] = __PrevRecordIndex
			///         )
			///     )
			/// VAR __CurrentValue =
			///     CALCULATE (
			///         SUM ( 'Safeguarding Visits'[Looked After Child] ),
			///         REMOVEFILTERS ( 'Safeguarding Visits'[Is Most Recent Safeguarding Visit] ),
			///         'Safeguarding Visit Scores'[Subgroup Index] = __CurrentIndex
			///     )
			/// RETURN
			///     IF ( ISBLANK ( __PreviousValue ), BLANK (), __CurrentValue - __PreviousValue )
			measure 'LAC Change' =
					
					VAR __CurrentIndex =
					    CALCULATE (
					        MAX ( 'Safeguarding Visits'[Subgroup Index] ),
					        REMOVEFILTERS ( 'Safeguarding Visits'[Is Most Recent Safeguarding Visit] )
					    )
					VAR __PrevRecordIndex =
					    CALCULATE (
					        MAX ( 'Safeguarding Visits'[Subgroup Index] ) - 1,
					        REMOVEFILTERS ( 'Safeguarding Visits'[Is Most Recent Safeguarding Visit] )
					    )
					VAR __PreviousValue =
					    IF (
					        __PrevRecordIndex = 0,
					        BLANK (),
					        CALCULATE (
					            SUM ( 'Safeguarding Visits'[Looked After Child] ),
					            REMOVEFILTERS ( 'Safeguarding Visits'[Is Most Recent Safeguarding Visit] ),
					            'Safeguarding Visit Scores'[Subgroup Index] = __PrevRecordIndex
					        )
					    )
					VAR __CurrentValue =
					    CALCULATE (
					        SUM ( 'Safeguarding Visits'[Looked After Child] ),
					        REMOVEFILTERS ( 'Safeguarding Visits'[Is Most Recent Safeguarding Visit] ),
					        'Safeguarding Visit Scores'[Subgroup Index] = __CurrentIndex
					    )
					RETURN
					    IF ( ISBLANK ( __PreviousValue ), BLANK (), __CurrentValue - __PreviousValue )
				formatString: 0
				displayFolder: Safeguarding
				lineageTag: 977963e9-f494-4fbd-b16a-77247f98af1e

			/// 
			/// VAR ComplianceTable =
			///     CALCULATETABLE (
			///         SUMMARIZE (
			///             'Safeguarding Visit Scores',
			///             'Safeguarding Visit Scores'[SUID],
			///             "LAC",
			///                 CALCULATE (
			///                     SUM ( 'Safeguarding Visits'[Looked After Child] ),
			///                     'Safeguarding Visits'[Snapshot Date]
			///                         = MAX ( 'Safeguarding Visits'[Snapshot Date] )
			///                 )
			///         )
			///     )
			/// RETURN
			///     SUMX ( ComplianceTable, [LAC] )
			measure 'LAC Students' =
					
					VAR ComplianceTable =
					    CALCULATETABLE (
					        SUMMARIZE (
					            'Safeguarding Visit Scores',
					            'Safeguarding Visit Scores'[SUID],
					            "LAC",
					                CALCULATE (
					                    SUM ( 'Safeguarding Visits'[Looked After Child] ),
					                    'Safeguarding Visits'[Snapshot Date]
					                        = MAX ( 'Safeguarding Visits'[Snapshot Date] )
					                )
					        )
					    )
					RETURN
					    SUMX ( ComplianceTable, [LAC] )
				formatString: 0
				displayFolder: Safeguarding
				lineageTag: c19c2476-d981-408d-8a97-17f82841928d

			/// 
