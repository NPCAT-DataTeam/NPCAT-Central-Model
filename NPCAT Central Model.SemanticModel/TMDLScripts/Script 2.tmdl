			column 'Attendance YTD' = Calculate(Divide(SUM(Attendance[Attendance]),SUM(Attendance[Sessions])),Attendance[Redaction Check]<>1,Attendance[On Roll] <> "Unenrolled")
				formatString: 0.0%;-0.0%;0.0%
				lineageTag: 7623e129-d86f-486d-8d46-846840d6dcc2
				summarizeBy: sum

				annotation SummarizationSetBy = Automatic

			column 'Attendance Rank' = ```
					
					SWITCH(TRUE(), 
					[Attendance YTD] >= 0.97,"100%-97%",
					[Attendance YTD] >= 0.94, "97%-94%",
					[Attendance YTD] >= 0.90,"94%-90%",
					[Attendance YTD] >= 0.75,"90%-75%",
					[Attendance YTD] >= 0.50,"75%-50%",
					[Attendance YTD] >= 0.25,"50%-25%",
					[Attendance YTD] < 0.25,"25%-0%"
					)
					```
				lineageTag: 5eee02d8-8486-41b7-b56e-81abe4d39112
				summarizeBy: none
				sortByColumn: 'Attendance Rank Sort'

				changedProperty = SortByColumn

				annotation SummarizationSetBy = Automatic

			column 'Attendance Rank Sort' =
					
					VAR AttendanceYTD = [Attendance YTD]
					RETURN
					SWITCH(TRUE(),
					        AttendanceYTD >= 0.97, 1,
					        AttendanceYTD >= 0.94, 2,
					        AttendanceYTD >= 0.90, 3,
					        AttendanceYTD >= 0.75, 4,
					        AttendanceYTD >= 0.5, 5,
					        AttendanceYTD >= 0.25, 6,
					        AttendanceYTD < 0.25, 7
					        )
				formatString: 0
				lineageTag: 7866f4cd-83ce-483e-951e-695ff7030cf0
				summarizeBy: sum

				annotation SummarizationSetBy = Automatic

			column 'In Year Leaver Flag' = IF ( MONTH([End date]) = 8 , "Not In Year Leaver", "In Year Leaver")
				lineageTag: a9942840-4c9d-4710-90b5-d2653375b959
				summarizeBy: none

				annotation SummarizationSetBy = Automatic

			column 'Fixed Term Exclusions (0,1+,2+)' = ```
					
					VAR Incidents = CALCULATE(
					        COUNTROWS( 'Excluded Students')
					        )
					VAR IncidentsNoBlank = IF(ISBLANK(Incidents),0,Incidents)
					RETURN
					    // SWITCH(TRUE(),
					    //     IncidentsNoBlank=0,"0",
					    //     IncidentsNoBlank>=2,"2+",
					    //     IncidentsNoBlank>=1,"1+"
					    // )
					    IncidentsNoBlank
					
					
					
					```
				formatString: 0
				lineageTag: 881274ea-15e1-42c4-8894-176a8a41a63c
				summarizeBy: sum

				annotation SummarizationSetBy = Automatic

			column 'IDACI Decile' =
					FORMAT(IF(ISBLANK(
					LOOKUPVALUE(
					    'Student Indicies'[Decile],
					    'Student Indicies'[Globally Unique Student - Year], 'Student Year Groups'[Unique Student ID - Academic Year],
					    'Student Indicies'[Category],"IDACI",
					    'Student Indicies'[RELEASE_YEAR],2025
					)),"Undefined",
					 LOOKUPVALUE(
					    'Student Indicies'[Decile],
					    'Student Indicies'[Globally Unique Student - Year], 'Student Year Groups'[Unique Student ID - Academic Year],
					    'Student Indicies'[Category],"IDACI",
					    'Student Indicies'[RELEASE_YEAR],2025
					)),"0")
				lineageTag: e2343923-07a3-467b-b2ba-87a54bb444b9
				summarizeBy: none
				sortByColumn: 'IDACI Decile Sort'

				changedProperty = SortByColumn

				annotation SummarizationSetBy = Automatic

