						    ("Maths", NAMEOF('Measures Folder'[2. WTS or Above (Period ARE Target) - Maths Int]), 2),
						    ("Reading", NAMEOF('Measures Folder'[2. WTS or Above (Period ARE Target) - Reading Int]), 0),
						    ("Writing", NAMEOF('Measures Folder'[2. WTS or Above (Period ARE Target) - Writing Int]), 1)
						}

