					Switch (
					    True (),
					    CONTAINSSTRING( 'zP Primary Summative Key Marginals (York Hub)'[zP Primary Summative Key Marginals (York Hub) Fields] , "WTS"), 1, 
					    CONTAINSSTRING( 'zP Primary Summative Key Marginals (York Hub)'[zP Primary Summative Key Marginals (York Hub) Fields] , "At or"), 2,
					    CONTAINSSTRING( 'zP Primary Summative Key Marginals (York Hub)'[zP Primary Summative Key Marginals (York Hub) Fields] , "GDS"), 3
