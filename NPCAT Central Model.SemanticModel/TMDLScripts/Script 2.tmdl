			/// 
			/// VAR _LastDate =
			///     LASTDATE ( 'Calendar'[Date] )
			/// RETURN
			///     CALCULATE (
			///         [Creditors Total Value],
			///         'Creditors (Dates)'[Date List] = _LastDate,
			///         'Creditors (Dates)'[Days until Due] >= -30,
			///         'Creditors (Dates)'[Days until Due] < 0
			///     )
			measure 'Creditors Cost of Overdue <30 Days' =
					
					VAR _LastDate =
					    LASTDATE ( 'Calendar'[Date] )
					RETURN
					    CALCULATE (
					        [Creditors Total Value],
					        'Creditors (Dates)'[Date List] = _LastDate,
