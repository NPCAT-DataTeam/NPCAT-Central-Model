			/// 
			/// VAR __Denominator =
			///     DISTINCTCOUNT ( 'Financial Benchmark Data'[URN] )
			/// VAR __Numerator =
			///     CALCULATE (
			///         DISTINCTCOUNT ( 'Financial Benchmark Data'[URN] ),
			///         FILTER (
			///             'Financial Benchmark Data',
			///             AND (
			///                 SUM ( 'Financial Benchmark Data'[Spend on energy as a percentage of total expenditure] ) <> 0,
			///                 'Financial Benchmark Data'[Spend on energy as a percentage of total expenditure] <= [Spend on Energy as % Total Expenditure]
			///             )
			///         )
			///     )
			/// VAR __NumeratorErrorHandling =
			///     IF ( ISBLANK ( __Numerator ), 1, 0 )
			/// VAR __NumeratorFinal =
			///     IF (
			///         __NumeratorErrorHandling = 0,
			///         __Numerator,
			///         IF (
			///             [Spend on Energy as % Total Expenditure]
			///                 < MIN ( 'Financial Benchmark Data'[Spend on energy as a percentage of total expenditure] ),
			///             1,
			///             __Denominator
			///         )
			///     )
			/// RETURN
			///     IF (
			///         [Spend on Energy as % Total Expenditure] = 0,
			///         0,
			///         DIVIDE ( __NumeratorFinal, __Denominator ) * 100
			///     )
			measure 'Forecast Spend on Energy Percentile' =
					
					VAR __Denominator =
					    DISTINCTCOUNT ( 'Financial Benchmark Data'[URN] )
					VAR __Numerator =
					    CALCULATE (
					        DISTINCTCOUNT ( 'Financial Benchmark Data'[URN] ),
					        FILTER (
					            'Financial Benchmark Data',
					            AND (
					                SUM ( 'Financial Benchmark Data'[Spend on energy as a percentage of total expenditure] ) <> 0,
					                'Financial Benchmark Data'[Spend on energy as a percentage of total expenditure] <= [Spend on Energy as % Total Expenditure]
					            )
					        )
					    )
					VAR __NumeratorErrorHandling =
					    IF ( ISBLANK ( __Numerator ), 1, 0 )
					VAR __NumeratorFinal =
					    IF (
					        __NumeratorErrorHandling = 0,
					        __Numerator,
					        IF (
					            [Spend on Energy as % Total Expenditure]
					                < MIN ( 'Financial Benchmark Data'[Spend on energy as a percentage of total expenditure] ),
					            1,
					            __Denominator
					        )
					    )
					RETURN
					    IF (
					        [Spend on Energy as % Total Expenditure] = 0,
					        0,
					        DIVIDE ( __NumeratorFinal, __Denominator ) * 100
					    )
				formatString: 0
				displayFolder: Finance Measures\4. Benchmark Percentiles
				lineageTag: b2585d4c-c5a2-4a72-af41-36b52ee099e3

