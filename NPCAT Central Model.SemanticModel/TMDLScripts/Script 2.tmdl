			/// 
			/// VAR _DaysOpen =
			///     SUMMARIZE (
			///         'Catering Actions Date List',
			///         'Catering Actions Date List'[Action Ref Number],
			///         "Days Open",
			///             CALCULATE (
			///                 COUNTROWS ( 'Catering Actions Date List' ),
			///                 'Catering Actions Date List'[Weekday] IN { 0, 1, 2, 3, 4 }
			///             )
			///     )
			/// VAR _AVGDays =
			///     AVERAGEX ( _DaysOpen, [Days Open] )
			/// RETURN
			///     _AVGDays
			measure 'AVG Days Action Open 1' =
					
					VAR _DaysOpen =
					    SUMMARIZE (
					        'Catering Actions Date List',
					        'Catering Actions Date List'[Action Ref Number],
					        "Days Open",
					            CALCULATE (
					                COUNTROWS ( 'Catering Actions Date List' ),
					                'Catering Actions Date List'[Weekday] IN { 0, 1, 2, 3, 4 }
					            )
					    )
					VAR _AVGDays =
					    AVERAGEX ( _DaysOpen, [Days Open] )
					RETURN
					    _AVGDays
				formatString: 0
				displayFolder: Catering Actions
				lineageTag: 0d45e165-7a3b-471d-8f77-6513107156bb

