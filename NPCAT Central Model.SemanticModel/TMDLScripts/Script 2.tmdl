			/// 
			/// CALCULATE (
			///     IF ( [Complete Actions] = BLANK (), "0", [Complete Actions] ) & " of "
			///         & IF ( [Total Actions(lst 12 mts)] = BLANK (), "0", [Total Actions(lst 12 mts)] ),
			///     DATESBETWEEN (
			///         'Calendar'[Date],
			///         MAX ( 'Calendar'[Date] ) - 365,
			///         MAX ( 'Calendar'[Date] )
			///     )
			/// )
			measure Actions =
					
					CALCULATE (
					    IF ( [Complete Actions] = BLANK (), "0", [Complete Actions] ) & " of "
					        & IF ( [Total Actions(lst 12 mts)] = BLANK (), "0", [Total Actions(lst 12 mts)] ),
					    DATESBETWEEN (
					        'Calendar'[Date],
					        MAX ( 'Calendar'[Date] ) - 365,
					        MAX ( 'Calendar'[Date] )
