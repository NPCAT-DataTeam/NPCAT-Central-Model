			/// 
			/// VAR __CurrentIndex =
			///     CALCULATE (
			///         MAX ( 'Health and Safety Audit Overview'[Subgroup Index] ),
			///         REMOVEFILTERS ( 'Health and Safety Audit Overview'[Is Most Recent Health and Safety Audit] )
			///     )
			/// VAR __PrevRecordIndex =
			///     CALCULATE (
			///         MAX ( 'Health and Safety Audit Overview'[Subgroup Index] ) - 1,
			///         REMOVEFILTERS ( 'Health and Safety Audit Overview'[Is Most Recent Health and Safety Audit] )
			///     )
			/// VAR __PreviousValue =
			///     IF (
			///         __PrevRecordIndex = 0,
			///         BLANK (),
			///         CALCULATE (
			///             SUM ( 'Health and Safety Audit Overview'[2 - Significant (Timely Manner)] ),
			///             REMOVEFILTERS ( 'Health and Safety Audit Overview'[Is Most Recent Health and Safety Audit] ),
			///             'Health and Safety Audit Overview'[Subgroup Index] = __PrevRecordIndex
			///         )
			///     )
			/// VAR __CurrentValue =
			///     CALCULATE (
			///         SUM ( 'Health and Safety Audit Overview'[2 - Significant (Timely Manner)] ),
			///         REMOVEFILTERS ( 'Health and Safety Audit Overview'[Is Most Recent Health and Safety Audit] ),
			///         'Health and Safety Audit Overview'[Subgroup Index] = __CurrentIndex
			///     )
			/// RETURN
			///     IF ( ISBLANK ( __PreviousValue ), BLANK (), __CurrentValue - __PreviousValue )
			measure 'Significant Priority Task Change' =
					
					VAR __CurrentIndex =
					    CALCULATE (
					        MAX ( 'Health and Safety Audit Overview'[Subgroup Index] ),
					        REMOVEFILTERS ( 'Health and Safety Audit Overview'[Is Most Recent Health and Safety Audit] )
					    )
					VAR __PrevRecordIndex =
					    CALCULATE (
					        MAX ( 'Health and Safety Audit Overview'[Subgroup Index] ) - 1,
					        REMOVEFILTERS ( 'Health and Safety Audit Overview'[Is Most Recent Health and Safety Audit] )
					    )
					VAR __PreviousValue =
					    IF (
					        __PrevRecordIndex = 0,
					        BLANK (),
					        CALCULATE (
					            SUM ( 'Health and Safety Audit Overview'[2 - Significant (Timely Manner)] ),
					            REMOVEFILTERS ( 'Health and Safety Audit Overview'[Is Most Recent Health and Safety Audit] ),
					            'Health and Safety Audit Overview'[Subgroup Index] = __PrevRecordIndex
					        )
					    )
					VAR __CurrentValue =
					    CALCULATE (
					        SUM ( 'Health and Safety Audit Overview'[2 - Significant (Timely Manner)] ),
					        REMOVEFILTERS ( 'Health and Safety Audit Overview'[Is Most Recent Health and Safety Audit] ),
					        'Health and Safety Audit Overview'[Subgroup Index] = __CurrentIndex
					    )
					RETURN
					    IF ( ISBLANK ( __PreviousValue ), BLANK (), __CurrentValue - __PreviousValue )
				formatString: 0
				displayFolder: Unused
				lineageTag: bb2bcf87-da59-40e2-b394-5f91822296ab

			/// 
			/// VAR _SimplexCostTbl =
			///     CALCULATETABLE (
			///         SUMMARIZE (
			///             'Printing and Copying',
			///             'Printing and Copying'[Page Size (A4/A3)],
			///             "Paper Cost",
			///                 CALCULATE (
			///                     MIN ( 'Printing and Copying'[Paper Cost] ),
			///                     'Printing and Copying'[Paper Cost] <> 0
			///                 ),
			///             "Total Sheets", SUM ( 'Printing and Copying'[Pages Per Job] ),
			///             "Duplex Sheets",
			///                 ROUNDUP (
			///                     CALCULATE (
			///                         SUM ( 'Printing and Copying'[Pages Per Job] ),
			///                         'Printing and Copying'[Duplex] = "Duplex"
			///                     ) * 0.5,
			///                     0
			///                 ),
			///             "Simplex Sheets",
			///                 CALCULATE (
			///                     SUM ( 'Printing and Copying'[Pages Per Job] ),
			///                     'Printing and Copying'[Duplex] = "Simplex"
			///                 ),
			///             "What if Simplex Sheets",
			///                 ROUND (
			///                     (
			///                         SUM ( 'Printing and Copying'[Pages Per Job] ) * ( 1 - [zP Total page Scenario Value] )
			///                     ) * [zP Simplex Scenario Value],
			///                     0
			///                 ),
			///             "What if Duplex Sheets",
			///                 ROUND (
			///                     (
			///                         (
			///                             SUM ( 'Printing and Copying'[Pages Per Job] ) * ( 1 - [zP Total page Scenario Value] )
			///                         )
			///                             - (
			///                                 (
			///                                     SUM ( 'Printing and Copying'[Pages Per Job] ) * ( 1 - [zP Total page Scenario Value] )
			///                                 ) * [zP Simplex Scenario Value]
			///                             )
			///                     ) * 0.5,
			///                     0
			///                 )
			///         ),
			///         ISONORAFTER ( 'Calendar'[Date], MIN ( 'Calendar'[Date] ), ASC )
			///     )
			/// VAR _OGSimplex =
			///     CALCULATE ( SUMX ( _SimplexCostTbl, [Simplex Sheets] ) )
			/// VAR _OGDuplex =
			///     CALCULATE ( SUMX ( _SimplexCostTbl, [Duplex Sheets] ) )
			/// VAR _WhatIfSimplex =
			///     CALCULATE ( SUMX ( _SimplexCostTbl, [What if Simplex Sheets] ) )
			/// VAR _WhatIfDuplex =
			///     CALCULATE ( SUMX ( _SimplexCostTbl, [What if Duplex Sheets] ) )
			/// VAR Final = ( _WhatIfDuplex + _WhatIfSimplex ) - ( _OGDuplex + _OGSimplex )
			/// RETURN
			///     Final
			measure 'Simplex Pages Difference What if' =
					
					VAR _SimplexCostTbl =
					    CALCULATETABLE (
					        SUMMARIZE (
					            'Printing and Copying',
					            'Printing and Copying'[Page Size (A4/A3)],
					            "Paper Cost",
					                CALCULATE (
					                    MIN ( 'Printing and Copying'[Paper Cost] ),
					                    'Printing and Copying'[Paper Cost] <> 0
					                ),
					            "Total Sheets", SUM ( 'Printing and Copying'[Pages Per Job] ),
					            "Duplex Sheets",
					                ROUNDUP (
					                    CALCULATE (
					                        SUM ( 'Printing and Copying'[Pages Per Job] ),
					                        'Printing and Copying'[Duplex] = "Duplex"
					                    ) * 0.5,
					                    0
					                ),
					            "Simplex Sheets",
					                CALCULATE (
					                    SUM ( 'Printing and Copying'[Pages Per Job] ),
					                    'Printing and Copying'[Duplex] = "Simplex"
					                ),
					            "What if Simplex Sheets",
					                ROUND (
					                    (
					                        SUM ( 'Printing and Copying'[Pages Per Job] ) * ( 1 - [zP Total page Scenario Value] )
					                    ) * [zP Simplex Scenario Value],
					                    0
					                ),
					            "What if Duplex Sheets",
					                ROUND (
					                    (
					                        (
					                            SUM ( 'Printing and Copying'[Pages Per Job] ) * ( 1 - [zP Total page Scenario Value] )
					                        )
					                            - (
					                                (
					                                    SUM ( 'Printing and Copying'[Pages Per Job] ) * ( 1 - [zP Total page Scenario Value] )
					                                ) * [zP Simplex Scenario Value]
					                            )
					                    ) * 0.5,
					                    0
					                )
					        ),
					        ISONORAFTER ( 'Calendar'[Date], MIN ( 'Calendar'[Date] ), ASC )
					    )
					VAR _OGSimplex =
					    CALCULATE ( SUMX ( _SimplexCostTbl, [Simplex Sheets] ) )
					VAR _OGDuplex =
					    CALCULATE ( SUMX ( _SimplexCostTbl, [Duplex Sheets] ) )
					VAR _WhatIfSimplex =
					    CALCULATE ( SUMX ( _SimplexCostTbl, [What if Simplex Sheets] ) )
					VAR _WhatIfDuplex =
					    CALCULATE ( SUMX ( _SimplexCostTbl, [What if Duplex Sheets] ) )
					VAR Final = ( _WhatIfDuplex + _WhatIfSimplex ) - ( _OGDuplex + _OGSimplex )
					RETURN
					    Final
				formatString: #,0
				displayFolder: Unused
				lineageTag: 43bfe1be-f0e8-4a39-bac2-8a472f4ff5fd

			/// 
			/// IF (
			///     OR ( ISBLANK ( [SPECIFIC Exp % CY] ), ISBLANK ( [SPECIFIC Exp % PY] ) ),
			///     "",
			///     [SPECIFIC Exp % CY] - [SPECIFIC Exp % PY]
