			///     )
			/// RETURN
			///     IF ( ISBLANK ( _Breach ), 0, _Breach )
			measure 'GRN Breach Total Value' =
					
					VAR _Breach =
					    CALCULATE (
					        SUM ( 'Purchasing Details'[Total Cost] ),
					        'Purchasing Details'[GRN Process Compliance] = "Red"
					    )
					RETURN
					    IF ( ISBLANK ( _Breach ), 0, _Breach )
