			///     CALCULATE (
			///             DISTINCTCOUNT ( 'KS4 Student Headlines'[Unique Student ID] ),
			///             OR('KS4 Student Headlines'[Science 1st Bucket Points] >= 5,
			///                 'KS4 Student Headlines'[Science 2nd Bucket Points] >= 5)
