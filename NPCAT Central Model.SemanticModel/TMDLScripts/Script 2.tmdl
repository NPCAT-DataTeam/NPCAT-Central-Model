			/// VAR _MaxOffset =
			///     MAX ( 'Calendar'[Current School Year Offset] )
			/// VAR _CountCY =
			///     CALCULATE (
			///         COUNTROWS ( RONI ),
			///         'Student Database (Full)'[DOA] <= _LastDate,
			///         'Student Database (Full)'[Leaving date] >= _LastDate
			///             || ISBLANK ( 'Student Database (Full)'[Leaving date] )
			///     )
			/// RETURN
			///     _CountCY
			measure 'Risk of NEET Count' =
					
					VAR _LastDate =
					    MAX ( 'Calendar'[Date] )
					VAR _MaxOffset =
					    MAX ( 'Calendar'[Current School Year Offset] )
					VAR _CountCY =
					    CALCULATE (
					        COUNTROWS ( RONI ),
					        'Student Database (Full)'[DOA] <= _LastDate,
					        'Student Database (Full)'[Leaving date] >= _LastDate
					            || ISBLANK ( 'Student Database (Full)'[Leaving date] )
					    )
					RETURN
					    _CountCY
