			/// 
			/// VAR __CurrentIndex =
			///     CALCULATE (
			///         MAX ( 'Health and Safety Audit Overview'[Subgroup Index] ),
			///         REMOVEFILTERS ( 'Health and Safety Audit Overview'[Is Most Recent Health and Safety Audit] )
			///     )
			/// VAR __PrevRecordIndex =
			///     CALCULATE (
			///         MAX ( 'Health and Safety Audit Overview'[Subgroup Index] ) - 1,
			///         REMOVEFILTERS ( 'Health and Safety Audit Overview'[Is Most Recent Health and Safety Audit] )
			///     )
			/// VAR __PreviousValue =
			///     IF (
			///         __PrevRecordIndex = 0,
			///         BLANK (),
			///         CALCULATE (
			///             SUM ( 'Health and Safety Audit Overview'[1 - Fundamental (Immediate)] ),
			///             REMOVEFILTERS ( 'Health and Safety Audit Overview'[Is Most Recent Health and Safety Audit] ),
			///             'Health and Safety Audit Overview'[Subgroup Index] = __PrevRecordIndex
			///         )
			///     )
			/// VAR __CurrentValue =
			///     CALCULATE (
			///         SUM ( 'Health and Safety Audit Overview'[1 - Fundamental (Immediate)] ),
			///         REMOVEFILTERS ( 'Health and Safety Audit Overview'[Is Most Recent Health and Safety Audit] ),
			///         'Health and Safety Audit Overview'[Subgroup Index] = __CurrentIndex
			///     )
			/// RETURN
			///     IF ( ISBLANK ( __PreviousValue ), BLANK (), __CurrentValue - __PreviousValue )
			measure 'Fundamental Priority Task Change' =
					
					VAR __CurrentIndex =
					    CALCULATE (
					        MAX ( 'Health and Safety Audit Overview'[Subgroup Index] ),
					        REMOVEFILTERS ( 'Health and Safety Audit Overview'[Is Most Recent Health and Safety Audit] )
					    )
					VAR __PrevRecordIndex =
					    CALCULATE (
					        MAX ( 'Health and Safety Audit Overview'[Subgroup Index] ) - 1,
					        REMOVEFILTERS ( 'Health and Safety Audit Overview'[Is Most Recent Health and Safety Audit] )
					    )
					VAR __PreviousValue =
					    IF (
					        __PrevRecordIndex = 0,
					        BLANK (),
					        CALCULATE (
					            SUM ( 'Health and Safety Audit Overview'[1 - Fundamental (Immediate)] ),
					            REMOVEFILTERS ( 'Health and Safety Audit Overview'[Is Most Recent Health and Safety Audit] ),
					            'Health and Safety Audit Overview'[Subgroup Index] = __PrevRecordIndex
					        )
					    )
					VAR __CurrentValue =
					    CALCULATE (
					        SUM ( 'Health and Safety Audit Overview'[1 - Fundamental (Immediate)] ),
					        REMOVEFILTERS ( 'Health and Safety Audit Overview'[Is Most Recent Health and Safety Audit] ),
					        'Health and Safety Audit Overview'[Subgroup Index] = __CurrentIndex
					    )
					RETURN
					    IF ( ISBLANK ( __PreviousValue ), BLANK (), __CurrentValue - __PreviousValue )
				formatString: 0
				displayFolder: Unused
				lineageTag: fdb69d5e-b914-4307-b9ea-6c33fe31ebb8

