				lineageTag: f8d127cb-9a1a-437e-95bc-bb2e4043991f

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			/// 
			/// VAR _Yearselector =
			///     MAX ( 'Calendar'[Current School Year Offset] ) - 1
			/// VAR _StudentCount =
			///     CALCULATE (
			///         DISTINCTCOUNT ( 'KS2 Tests & TA Results'[Globally Unique Student ID] ),
			///         REMOVEFILTERS ( 'Calendar' ),
			///         'Calendar'[Current School Year Offset] = _Yearselector
			///     )
			/// RETURN
			///     _StudentCount
			measure 'No. KS2 Pupils PY' =
					
					VAR _Yearselector =
					    MAX ( 'Calendar'[Current School Year Offset] ) - 1
					VAR _StudentCount =
					    CALCULATE (
					        DISTINCTCOUNT ( 'KS2 Tests & TA Results'[Globally Unique Student ID] ),
					        REMOVEFILTERS ( 'Calendar' ),
					        'Calendar'[Current School Year Offset] = _Yearselector
					    )
					RETURN
					    _StudentCount
				displayFolder: Statutory KS2
				lineageTag: 3840f8c3-a3f7-4eba-a45c-39f282958916

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			/// 
			/// VAR _Yearselector =
			///     MAX ( 'Calendar'[Current School Year Offset] ) - 1
			/// VAR _StudentCount =
			///     CALCULATE (
			///         DISTINCTCOUNT ( 'MTC'[Globally Unique ID] ),
			///         REMOVEFILTERS ( 'Calendar' ),
			///         'MTC'[MARK_GRADE] <> "B",
			///         'MTC'[MARK_GRADE] <> "A",
			///         'MTC'[MARK_GRADE] <> "U",
			///         'MTC'[MARK_GRADE] <> "X",
			///         'MTC'[MARK_GRADE] <> "J",
			///         'MTC'[MARK_GRADE] <> "L",
			///         'MTC'[MARK_GRADE] <> "Q",
			///         'Calendar'[Current School Year Offset] = _Yearselector
			///     )
			/// RETURN
			///     _StudentCount
			measure 'MTC No. Pupils (Took Check) PY' =
					
					VAR _Yearselector =
					    MAX ( 'Calendar'[Current School Year Offset] ) - 1
					VAR _StudentCount =
					    CALCULATE (
					        DISTINCTCOUNT ( 'MTC'[Globally Unique ID] ),
					        REMOVEFILTERS ( 'Calendar' ),
					        'MTC'[MARK_GRADE] <> "B",
					        'MTC'[MARK_GRADE] <> "A",
					        'MTC'[MARK_GRADE] <> "U",
					        'MTC'[MARK_GRADE] <> "X",
					        'MTC'[MARK_GRADE] <> "J",
					        'MTC'[MARK_GRADE] <> "L",
					        'MTC'[MARK_GRADE] <> "Q",
					        'Calendar'[Current School Year Offset] = _Yearselector
