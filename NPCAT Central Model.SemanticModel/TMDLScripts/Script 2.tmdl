			column Bucket =
					
					SWITCH(TRUE(),
					    [zP P8 Slots + Headlines Order]<5,"Headlines",
					    [zP P8 Slots + Headlines Order]<14,"English",
					    [zP P8 Slots + Headlines Order]<23,"Maths",
					    [zP P8 Slots + Headlines Order]<32,"Ebacc 1",
					    [zP P8 Slots + Headlines Order]<41,"Ebacc 2",
