				annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

			/// 
			/// SUM ( 'Printing and Copying'[Grayscale Cost] )
			measure 'Sum Grayscale Cost' =
					
					SUM ( 'Printing and Copying'[Grayscale Cost] )
				formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
				displayFolder: Printing
				lineageTag: 97dbdb8d-d584-4938-a9ea-d6c32a30305c

				annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

			/// 
			/// VAR _ColourCostTbl =
			///     CALCULATETABLE (
			///         ADDCOLUMNS (
			///             SUMMARIZE (
			///                 'Printing and Copying',
			///                 'Printing and Copying'[Paper Cost Lookup],
			///                 "Colour Cost",
			///                     CALCULATE (
			///                         MIN ( 'Printing and Copying'[Colour Cost] ),
			///                         'Printing and Copying'[Colour Cost] > 0
			///                     ),
			///                 "Grayscale cost",
			///                     CALCULATE (
			///                         MIN ( 'Printing and Copying'[Grayscale Cost] ),
			///                         'Printing and Copying'[Grayscale Cost] > 0
			///                     ),
			///                 "Total Sheets", SUM ( 'Printing and Copying'[Pages Per Job] ),
			///                 "Colour Sheets", SUM ( 'Printing and Copying'[Total Colour Pages] ),
			///                 "Grayscale Sheets",
			///                     (
			///                         SUM ( 'Printing and Copying'[Pages Per Job] )
			///                             - SUM ( 'Printing and Copying'[Total Colour Pages] )
			///                     ),
			///                 "What if Colour Sheets",
			///                     (
			///                         SUM ( 'Printing and Copying'[Pages Per Job] ) * ( 1 - [zP Total page Scenario Value] )
			///                     ) * [zP Colour Scenario Value],
			///                 "What if Gray Sheets",
			///                     (
			///                         SUM ( 'Printing and Copying'[Pages Per Job] ) * ( 1 - [zP Total page Scenario Value] )
			///                     )
			///                         - (
			///                             (
			///                                 SUM ( 'Printing and Copying'[Pages Per Job] ) * ( 1 - [zP Total page Scenario Value] )
			///                             ) * [zP Colour Scenario Value]
			///                         )
			///             ),
			///             "Original Colour Cost Calc", [Colour Cost] * [Colour Sheets],
			///             "Original Gray Cost Calc", [Grayscale Cost] * [Grayscale Sheets],
			///             "What if Colour Calc", [Colour Cost] * [What if Colour Sheets],
			///             "What if Gray Calc", [Grayscale cost] * [What if Gray Sheets]
			///         ),
			///         ISONORAFTER ( 'Calendar'[Date], MIN ( 'Calendar'[Date] ), ASC )
			///     )
			/// VAR _OGColourCost =
			///     CALCULATE ( SUMX ( _ColourCostTbl, [Original Colour Cost Calc] ) )
			/// VAR _OGGrayscaleCost =
			///     CALCULATE ( SUMX ( _ColourCostTbl, [Original Gray Cost Calc] ) )
			/// VAR _WhatIfColourCost =
			///     CALCULATE ( SUMX ( _ColourCostTbl, [What if Colour Calc] ) )
			/// VAR _WhatIfGrayscaleCost =
			///     CALCULATE ( SUMX ( _ColourCostTbl, [What if Gray Calc] ) )
			/// VAR Final = ( _WhatIfColourCost + _WhatIfGrayscaleCost ) - ( _OGColourCost + _OGGrayscaleCost )
			/// RETURN
			///     Final
			measure 'Colour Costs Difference What if' =
					
					VAR _ColourCostTbl =
					    CALCULATETABLE (
					        ADDCOLUMNS (
					            SUMMARIZE (
					                'Printing and Copying',
					                'Printing and Copying'[Paper Cost Lookup],
					                "Colour Cost",
					                    CALCULATE (
					                        MIN ( 'Printing and Copying'[Colour Cost] ),
					                        'Printing and Copying'[Colour Cost] > 0
					                    ),
					                "Grayscale cost",
					                    CALCULATE (
					                        MIN ( 'Printing and Copying'[Grayscale Cost] ),
					                        'Printing and Copying'[Grayscale Cost] > 0
					                    ),
					                "Total Sheets", SUM ( 'Printing and Copying'[Pages Per Job] ),
					                "Colour Sheets", SUM ( 'Printing and Copying'[Total Colour Pages] ),
					                "Grayscale Sheets",
					                    (
					                        SUM ( 'Printing and Copying'[Pages Per Job] )
					                            - SUM ( 'Printing and Copying'[Total Colour Pages] )
					                    ),
					                "What if Colour Sheets",
					                    (
					                        SUM ( 'Printing and Copying'[Pages Per Job] ) * ( 1 - [zP Total page Scenario Value] )
					                    ) * [zP Colour Scenario Value],
					                "What if Gray Sheets",
					                    (
					                        SUM ( 'Printing and Copying'[Pages Per Job] ) * ( 1 - [zP Total page Scenario Value] )
					                    )
					                        - (
					                            (
					                                SUM ( 'Printing and Copying'[Pages Per Job] ) * ( 1 - [zP Total page Scenario Value] )
					                            ) * [zP Colour Scenario Value]
					                        )
					            ),
					            "Original Colour Cost Calc", [Colour Cost] * [Colour Sheets],
					            "Original Gray Cost Calc", [Grayscale Cost] * [Grayscale Sheets],
					            "What if Colour Calc", [Colour Cost] * [What if Colour Sheets],
					            "What if Gray Calc", [Grayscale cost] * [What if Gray Sheets]
					        ),
					        ISONORAFTER ( 'Calendar'[Date], MIN ( 'Calendar'[Date] ), ASC )
					    )
					VAR _OGColourCost =
					    CALCULATE ( SUMX ( _ColourCostTbl, [Original Colour Cost Calc] ) )
					VAR _OGGrayscaleCost =
					    CALCULATE ( SUMX ( _ColourCostTbl, [Original Gray Cost Calc] ) )
					VAR _WhatIfColourCost =
					    CALCULATE ( SUMX ( _ColourCostTbl, [What if Colour Calc] ) )
					VAR _WhatIfGrayscaleCost =
					    CALCULATE ( SUMX ( _ColourCostTbl, [What if Gray Calc] ) )
					VAR Final = ( _WhatIfColourCost + _WhatIfGrayscaleCost ) - ( _OGColourCost + _OGGrayscaleCost )
					RETURN
					    Final
				formatString: "£"#,0.0;-"£"#,0.0;"£"#,0.0
				displayFolder: Printing
				lineageTag: cbae4101-5b23-4d34-b5d1-4aee0d769318

				annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

			/// 
			/// VAR _SimplexCostTbl =
			///     CALCULATETABLE (
			///         ADDCOLUMNS (
			///             SUMMARIZE (
			///                 'Printing and Copying',
			///                 'Printing and Copying'[Page Size (A4/A3)],
			///                 "Paper Cost",
			///                     CALCULATE (
			///                         MIN ( 'Printing and Copying'[Paper Cost] ),
			///                         'Printing and Copying'[Paper Cost] <> 0
			///                     ),
			///                 "Total Sheets", SUM ( 'Printing and Copying'[Pages Per Job] ),
			///                 "Duplex Sheets",
			///                     CALCULATE (
			///                         SUM ( 'Printing and Copying'[Pages Per Job] ),
			///                         'Printing and Copying'[Duplex] = "Duplex"
			///                     ) * 0.5,
			///                 "Simplex Sheets",
			///                     CALCULATE (
			///                         SUM ( 'Printing and Copying'[Pages Per Job] ),
			///                         'Printing and Copying'[Duplex] = "Simplex"
			///                     ),
			///                 "What if Simplex Sheets",
			///                     (
			///                         SUM ( 'Printing and Copying'[Pages Per Job] ) * ( 1 - [zP Total page Scenario Value] )
			///                     ) * [zP Simplex Scenario Value],
			///                 "What if Duplex Sheets",
			///                     (
			///                         (
			///                             SUM ( 'Printing and Copying'[Pages Per Job] ) * ( 1 - [zP Total page Scenario Value] )
			///                         )
			///                             - (
			///                                 (
			///                                     SUM ( 'Printing and Copying'[Pages Per Job] ) * ( 1 - [zP Total page Scenario Value] )
			///                                 ) * [zP Simplex Scenario Value]
			///                             )
			///                     ) * 0.5
			///             ),
			///             "Original Duplex Cost Calc", [Paper Cost] * [Duplex Sheets],
			///             "Original Simplex Cost Calc", [Paper Cost] * [Simplex Sheets],
			///             "What if Duplex Calc", [Paper Cost] * [What if Duplex Sheets],
			///             "What if Simplex Calc", [Paper cost] * [What if Simplex Sheets],
			///             "Target Cost",
			///                 ( [Paper Cost] * [What if Duplex Sheets] ) + ( [Paper cost] * [What if Simplex Sheets] )
			///         ),
			///         ISONORAFTER ( 'Calendar'[Date], MIN ( 'Calendar'[Date] ), ASC )
			///     )
			/// VAR _OGSimplexCost =
			///     CALCULATE ( SUMX ( _SimplexCostTbl, [Original Simplex Cost Calc] ) )
			/// VAR _OGDuplexCost =
			///     CALCULATE ( SUMX ( _SimplexCostTbl, [Original Duplex Cost Calc] ) )
			/// VAR _WhatIfSimplexCost =
			///     CALCULATE ( SUMX ( _SimplexCostTbl, [What if Simplex Calc] ) )
			/// VAR _WhatIfDuplexCost =
			///     CALCULATE ( SUMX ( _SimplexCostTbl, [What if Duplex Calc] ) )
			/// VAR Final = ( _WhatIfDuplexCost + _WhatIfSimplexCost ) - ( _OGDuplexCost + _OGSimplexCost )
			/// RETURN
			///     Final
			measure 'Simplex Costs Difference What if' =
					
					VAR _SimplexCostTbl =
					    CALCULATETABLE (
					        ADDCOLUMNS (
					            SUMMARIZE (
					                'Printing and Copying',
					                'Printing and Copying'[Page Size (A4/A3)],
					                "Paper Cost",
					                    CALCULATE (
					                        MIN ( 'Printing and Copying'[Paper Cost] ),
					                        'Printing and Copying'[Paper Cost] <> 0
					                    ),
					                "Total Sheets", SUM ( 'Printing and Copying'[Pages Per Job] ),
					                "Duplex Sheets",
					                    CALCULATE (
					                        SUM ( 'Printing and Copying'[Pages Per Job] ),
					                        'Printing and Copying'[Duplex] = "Duplex"
					                    ) * 0.5,
					                "Simplex Sheets",
					                    CALCULATE (
					                        SUM ( 'Printing and Copying'[Pages Per Job] ),
					                        'Printing and Copying'[Duplex] = "Simplex"
					                    ),
					                "What if Simplex Sheets",
					                    (
					                        SUM ( 'Printing and Copying'[Pages Per Job] ) * ( 1 - [zP Total page Scenario Value] )
					                    ) * [zP Simplex Scenario Value],
					                "What if Duplex Sheets",
					                    (
					                        (
					                            SUM ( 'Printing and Copying'[Pages Per Job] ) * ( 1 - [zP Total page Scenario Value] )
					                        )
					                            - (
					                                (
					                                    SUM ( 'Printing and Copying'[Pages Per Job] ) * ( 1 - [zP Total page Scenario Value] )
					                                ) * [zP Simplex Scenario Value]
					                            )
					                    ) * 0.5
					            ),
					            "Original Duplex Cost Calc", [Paper Cost] * [Duplex Sheets],
					            "Original Simplex Cost Calc", [Paper Cost] * [Simplex Sheets],
					            "What if Duplex Calc", [Paper Cost] * [What if Duplex Sheets],
					            "What if Simplex Calc", [Paper cost] * [What if Simplex Sheets],
					            "Target Cost",
					                ( [Paper Cost] * [What if Duplex Sheets] ) + ( [Paper cost] * [What if Simplex Sheets] )
					        ),
					        ISONORAFTER ( 'Calendar'[Date], MIN ( 'Calendar'[Date] ), ASC )
					    )
					VAR _OGSimplexCost =
					    CALCULATE ( SUMX ( _SimplexCostTbl, [Original Simplex Cost Calc] ) )
					VAR _OGDuplexCost =
					    CALCULATE ( SUMX ( _SimplexCostTbl, [Original Duplex Cost Calc] ) )
					VAR _WhatIfSimplexCost =
					    CALCULATE ( SUMX ( _SimplexCostTbl, [What if Simplex Calc] ) )
					VAR _WhatIfDuplexCost =
					    CALCULATE ( SUMX ( _SimplexCostTbl, [What if Duplex Calc] ) )
					VAR Final = ( _WhatIfDuplexCost + _WhatIfSimplexCost ) - ( _OGDuplexCost + _OGSimplexCost )
					RETURN
					    Final
				formatString: "£"#,0.0;-"£"#,0.0;"£"#,0.0
				displayFolder: Printing
				lineageTag: 4a34f907-3315-401c-86b7-75ef557ce846

				annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

