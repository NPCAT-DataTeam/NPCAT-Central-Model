			///         _CurrentPeriodIndex = 0,
			///         0,
			///         CALCULATE (
			///             [2. Above % (Period ARE Target) - CRWM],
			///             'Primary Summative Marks (South)'[Assessment Index] = _CurrentPeriodIndex
			///         ) * 100
			///     )
			/// VAR _Previous =
			///     CALCULATE (
			///         [2. Above % (Period ARE Target) - CRWM],
			///         REMOVEFILTERS (
			///             'Primary Summative Marks (South)'[Assessment Index],
