			/// 
			/// VAR _Yearselector =
			///     MAX ( 'Calendar'[Current School Year Offset] ) - 1
			/// VAR _StudentCount =
			///     CALCULATE (
			///         DISTINCTCOUNT ( 'EYFS ELGs/GLD'[Globally Unique ID] ),
			///         'EYFS ELGs/GLD'[Grade] <> "A",
			///         REMOVEFILTERS ( 'Calendar' ),
			///         'Calendar'[Current School Year Offset] = _Yearselector
			///     )
			/// RETURN
			///     _StudentCount
			measure 'EYFS No. Pupils (Included in Calc) PY' =
					
					VAR _Yearselector =
					    MAX ( 'Calendar'[Current School Year Offset] ) - 1
					VAR _StudentCount =
					    CALCULATE (
					        DISTINCTCOUNT ( 'EYFS ELGs/GLD'[Globally Unique ID] ),
					        'EYFS ELGs/GLD'[Grade] <> "A",
					        REMOVEFILTERS ( 'Calendar' ),
					        'Calendar'[Current School Year Offset] = _Yearselector
					    )
					RETURN
					    _StudentCount
				displayFolder: Statutory EYFS
				lineageTag: 892c1dc6-5bad-454a-a009-3b7be2709ac9

				annotation PBI_FormatHint = {"isGeneralNumber":true}

