			/// 
			/// VAR TotalStudents =
			///     CALCULATE (
			///         [Students on Roll],
			///         ALL ( 'Student Database (Full)'[Ethnicity Name] )
			///     )
			/// VAR _SignificantEthnicGroups =
			///     SUMX (
			///         FILTER (
			///             SUMMARIZE (
			///                 'Student Database (Full)',
			///                 'Student Database (Full)'[Ethnicity Name],
			///                 "StudentCount", [Students on Roll]
			///             ),
			///             DIVIDE ( [Students on Roll], TotalStudents ) > 0.05
			///         ),
			///         [StudentCount]
			///     )
			/// RETURN
			///     DIVIDE ( _SignificantEthnicGroups, TotalStudents )
			measure '% Significant Ethnic Groups' =
					
					VAR TotalStudents =
					    CALCULATE (
					        [Students on Roll],
					        ALL ( 'Student Database (Full)'[Ethnicity Name] )
					    )
					VAR _SignificantEthnicGroups =
					    SUMX (
					        FILTER (
					            SUMMARIZE (
					                'Student Database (Full)',
					                'Student Database (Full)'[Ethnicity Name],
					                "StudentCount", [Students on Roll]
					            ),
					            DIVIDE ( [Students on Roll], TotalStudents ) > 0.05
					        ),
					        [StudentCount]
					    )
					RETURN
					    DIVIDE ( _SignificantEthnicGroups, TotalStudents )
				formatString: 0.0%;-0.0%;0.0%
				displayFolder: Student Measures
				lineageTag: 435a894c-90ae-47dd-80ab-30114c030153

			/// 
			/// VAR TotalStudents =
			///     CALCULATE (
			///         [Students on Roll],
			///         ALL ( 'Student Database (Full)'[Ethnicity Name] )
			///     )
			/// VAR _SignificantEthnicGroups =
			///     SUMX (
			///         FILTER (
			///             SUMMARIZE (
			///                 'Student Database (Full)',
			///                 'Student Database (Full)'[Ethnicity Name],
			///                 "StudentCount", [Students on Roll]
			///             ),
			///             DIVIDE ( [Students on Roll], TotalStudents ) > 0.05
			///         ),
			///         [StudentCount]
			///     )
			/// RETURN
			///     _SignificantEthnicGroups
			measure '# Significant Ethnic Groups' =
					
					VAR TotalStudents =
					    CALCULATE (
					        [Students on Roll],
					        ALL ( 'Student Database (Full)'[Ethnicity Name] )
					    )
					VAR _SignificantEthnicGroups =
					    SUMX (
					        FILTER (
					            SUMMARIZE (
					                'Student Database (Full)',
					                'Student Database (Full)'[Ethnicity Name],
					                "StudentCount", [Students on Roll]
					            ),
					            DIVIDE ( [Students on Roll], TotalStudents ) > 0.05
					        ),
					        [StudentCount]
					    )
					RETURN
					    _SignificantEthnicGroups
				formatString: 0
				displayFolder: Student Measures
				lineageTag: a17d6241-0ca0-4016-afa1-7af0f74b4e26

			/// 
