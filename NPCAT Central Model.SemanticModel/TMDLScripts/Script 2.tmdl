			/// 
			/// VAR EYFS_Year =
			///     CALCULATE (
			///         MAX ( 'EYFS ELGs/GLD'[School Year] ),
			///         REMOVEFILTERS ( 'Calendar' ),
			///         REMOVEFILTERS ( 'Student Year Groups' )
			///     )
			/// VAR KS1_Year =
			///     CALCULATE (
			///         MAX ( 'KS1 Teacher Assessments'[School Year] ),
			///         REMOVEFILTERS ( 'Calendar' ),
			///         REMOVEFILTERS ( 'Student Year Groups' )
			///     )
			/// VAR KS2_Year =
			///     CALCULATE (
			///         MAX ( 'KS2 Tests & TA Results'[School Year] ),
			///         REMOVEFILTERS ( 'Calendar' ),
			///         REMOVEFILTERS ( 'Student Year Groups' )
			///     )
			/// VAR Phonics_Year =
			///     CALCULATE (
			///         MAX ( 'Phonics'[School Year] ),
			///         REMOVEFILTERS ( 'Calendar' ),
			///         REMOVEFILTERS ( 'Student Year Groups' )
			///     )
			/// VAR MTC_Year =
			///     CALCULATE (
			///         MAX ( 'MTC'[School Year] ),
			///         REMOVEFILTERS ( 'Calendar' ),
			///         REMOVEFILTERS ( 'Student Year Groups' )
			///     )
			/// RETURN
			///     MAXX (
			///         { ( EYFS_Year ), ( KS1_Year ), ( KS2_Year ), ( Phonics_Year ), ( MTC_Year ) },
			///         [Value]
			///     )
			measure 'Max School Year (All)' =
					
					VAR EYFS_Year =
					    CALCULATE (
					        MAX ( 'EYFS ELGs/GLD'[School Year] ),
					        REMOVEFILTERS ( 'Calendar' ),
					        REMOVEFILTERS ( 'Student Year Groups' )
					    )
					VAR KS1_Year =
					    CALCULATE (
					        MAX ( 'KS1 Teacher Assessments'[School Year] ),
					        REMOVEFILTERS ( 'Calendar' ),
					        REMOVEFILTERS ( 'Student Year Groups' )
					    )
					VAR KS2_Year =
					    CALCULATE (
					        MAX ( 'KS2 Tests & TA Results'[School Year] ),
					        REMOVEFILTERS ( 'Calendar' ),
					        REMOVEFILTERS ( 'Student Year Groups' )
					    )
					VAR Phonics_Year =
					    CALCULATE (
					        MAX ( 'Phonics'[School Year] ),
					        REMOVEFILTERS ( 'Calendar' ),
					        REMOVEFILTERS ( 'Student Year Groups' )
					    )
					VAR MTC_Year =
					    CALCULATE (
					        MAX ( 'MTC'[School Year] ),
					        REMOVEFILTERS ( 'Calendar' ),
					        REMOVEFILTERS ( 'Student Year Groups' )
					    )
					RETURN
					    MAXX (
					        { ( EYFS_Year ), ( KS1_Year ), ( KS2_Year ), ( Phonics_Year ), ( MTC_Year ) },
					        [Value]
					    )
				lineageTag: 246d78f2-e63e-4c72-b72f-2f0ba5dc8a1d

