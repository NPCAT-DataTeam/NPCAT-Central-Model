			/// VAR _PreviousPeriod =
			///     CALCULATE (
			///         [Attendance Sessions],
			///         FILTER ( ALL ( 'Calendar' ), 'Calendar'[CurDayOffset] = _PW )
			///     )
			/// VAR _CW =
			///     CALCULATE ( [Attendance Sessions], 'Calendar'[CurDayOffset] = _MaxDayOffset )
			/// RETURN
			///     _CW - _PreviousPeriod
			measure 'Attendance Sessions Rolling WoW' =
					
					VAR _MaxDayOffset =
					    MAX ( 'Calendar'[CurDayOffset] )
					VAR _PW =
					    MAX ( 'Calendar'[CurDayOffset] ) - 7
					VAR _PreviousPeriod =
					    CALCULATE (
					        [Attendance Sessions],
					        FILTER ( ALL ( 'Calendar' ), 'Calendar'[CurDayOffset] = _PW )
					    )
					VAR _CW =
					    CALCULATE ( [Attendance Sessions], 'Calendar'[CurDayOffset] = _MaxDayOffset )
					RETURN
					    _CW - _PreviousPeriod
