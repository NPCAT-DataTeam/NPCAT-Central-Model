			/// 
			/// VAR _Yearselector =
			///     MAX ( 'Calendar'[Current School Year Offset] ) - 1
			/// VAR _StudentCount =
			///     CALCULATE (
			///         DISTINCTCOUNT ( 'KS1 Teacher Assessments'[Globally Unique ID] ),
			///         REMOVEFILTERS ( 'Calendar' ),
			///         'Calendar'[Current School Year Offset] = _Yearselector
			///     )
			/// RETURN
			///     _StudentCount
			measure 'No. KS1 Pupils PY' =
					
					VAR _Yearselector =
					    MAX ( 'Calendar'[Current School Year Offset] ) - 1
					VAR _StudentCount =
					    CALCULATE (
					        DISTINCTCOUNT ( 'KS1 Teacher Assessments'[Globally Unique ID] ),
					        REMOVEFILTERS ( 'Calendar' ),
					        'Calendar'[Current School Year Offset] = _Yearselector
					    )
					RETURN
