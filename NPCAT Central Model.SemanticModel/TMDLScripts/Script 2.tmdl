			/// SWITCH (
			///     SELECTEDVALUE ( 'Boxphish Phishing Simulations'[Email Simulation Outcome] ),
			///     "Pass", 1,
			///     "Fail", 2
			/// )
			measure 'Simulation Outcome Icons' =
					
					SWITCH (
					    SELECTEDVALUE ( 'Boxphish Phishing Simulations'[Email Simulation Outcome] ),
					    "Pass", 1,
					    "Fail", 2
					)
				formatString: 0
