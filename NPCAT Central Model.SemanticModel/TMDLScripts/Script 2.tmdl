			/// 
			/// CALCULATE (
			///     DIVIDE (
			///         SUM ( 'KS2 Tests & TA Results'[Mark] ),
			///         SUM ( 'KS2 Tests & TA Results'[Max Mark] ),
			///         BLANK ()
			///     ),
			///     KEEPFILTERS ( 'KS2 Tests & TA Results'[Assessment Type] = "Test" ),
			///     KEEPFILTERS ( NOT ( 'KS2 Tests & TA Results'[Type] IN { "Outcome", "Scaled Score" } ) )
			/// )
			measure 'KS2 Paper %' =
					
					CALCULATE (
					    DIVIDE (
					        SUM ( 'KS2 Tests & TA Results'[Mark] ),
					        SUM ( 'KS2 Tests & TA Results'[Max Mark] ),
					        BLANK ()
					    ),
					    KEEPFILTERS ( 'KS2 Tests & TA Results'[Assessment Type] = "Test" ),
					    KEEPFILTERS ( NOT ( 'KS2 Tests & TA Results'[Type] IN { "Outcome", "Scaled Score" } ) )
					)
