			/// 
			/// VAR __Length =
			///     SUM ( 'Printing and Copying'[Paper Height (m)] )
			/// RETURN
			///     VAR __Width =
			///         SUM ( 'Printing and Copying'[Paper Width (m)] )
			///     RETURN
			///         VAR __Height =
			///             SUM ( 'Printing and Copying'[Sheets] ) * 0.0001
			///         RETURN
			///             __Length * __Width * __Height
			measure 'Volume of Paper' =
					
					VAR __Length =
					    SUM ( 'Printing and Copying'[Paper Height (m)] )
					RETURN
					    VAR __Width =
					        SUM ( 'Printing and Copying'[Paper Width (m)] )
					    RETURN
					        VAR __Height =
					            SUM ( 'Printing and Copying'[Sheets] ) * 0.0001
					        RETURN
					            __Length * __Width * __Height
				formatString: 0.00
				displayFolder: Unused
				lineageTag: 846271b6-3237-44df-af71-3ba5589f2128

			/// 
			/// VAR _TotalCostTbl =
			///     CALCULATETABLE (
			///         SUMMARIZE (
			///             'Printing and Copying',
			///             'Printing and Copying'[Paper Cost Lookup],
			///             "Total Cost",
			///                 CALCULATE (
			///                     MIN ( 'Printing and Copying'[Total Cost] ),
			///                     'Printing and Copying'[Total Cost] > 0
			///                 ),
			///             "Total Sheets", SUM ( 'Printing and Copying'[Pages Per Job] ),
			///             "What if Total Sheets",
			///                 SUM ( 'Printing and Copying'[Pages Per Job] ) * ( 1 - [zP Total page Scenario Value] )
			///         ),
			///         ISONORAFTER ( 'Calendar'[Date], MIN ( 'Calendar'[Date] ), ASC )
			///     )
			/// VAR _OGTotalSheets =
			///     CALCULATE ( SUMX ( _TotalCostTbl, [Total Sheets] ) )
			/// VAR _WhatIfTotalSheets =
			///     CALCULATE ( SUMX ( _TotalCostTbl, [What if Total Sheets] ) )
			/// VAR Final = _WhatIfTotalSheets - _OGTotalSheets
			/// RETURN
			///     Final
			measure 'Volume Page Difference What if' =
					
					VAR _TotalCostTbl =
					    CALCULATETABLE (
					        SUMMARIZE (
					            'Printing and Copying',
					            'Printing and Copying'[Paper Cost Lookup],
					            "Total Cost",
					                CALCULATE (
					                    MIN ( 'Printing and Copying'[Total Cost] ),
					                    'Printing and Copying'[Total Cost] > 0
					                ),
					            "Total Sheets", SUM ( 'Printing and Copying'[Pages Per Job] ),
					            "What if Total Sheets",
					                SUM ( 'Printing and Copying'[Pages Per Job] ) * ( 1 - [zP Total page Scenario Value] )
					        ),
					        ISONORAFTER ( 'Calendar'[Date], MIN ( 'Calendar'[Date] ), ASC )
					    )
					VAR _OGTotalSheets =
					    CALCULATE ( SUMX ( _TotalCostTbl, [Total Sheets] ) )
					VAR _WhatIfTotalSheets =
					    CALCULATE ( SUMX ( _TotalCostTbl, [What if Total Sheets] ) )
					VAR Final = _WhatIfTotalSheets - _OGTotalSheets
					RETURN
					    Final
				formatString: #,0
				displayFolder: Unused
				lineageTag: 5b937ea0-5367-4bab-b3d8-8b71473285c6

