						    ("NI Number", NAMEOF('Measures Folder'[NI Number Check - Fails]), 17),
						    ("NPCAT ID", NAMEOF('Measures Folder'[NPCAT ID Check - Fail %]), 18),
						    ("NPCAT ID", NAMEOF('Measures Folder'[NPCAT ID Check - Fails]), 19),
						    ("Payroll Number", NAMEOF('Measures Folder'[Payroll Number Check - Fail %]), 20),
