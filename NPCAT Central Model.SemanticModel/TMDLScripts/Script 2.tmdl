			/// 
			/// CALCULATE (
			///     DIVIDE (
			///         CALCULATE (
			///             COUNTA ( 'Secondary Standards QA Questions'[Answer] ),
			///             'Secondary Standards QA Questions'[Question Type] = "Question",
			///             'Secondary Standards QA Questions'[Name] = "Behaviour Focus",
			///             'Secondary Standards QA Questions'[Answer]
			///                 IN { "Yes", "Partially", "No" } //, "Partially Met" }
			///         ) + 0,
			///         CALCULATE (
			///             COUNTA ( 'Secondary Standards QA Questions'[Answer] ),
			///             'Secondary Standards QA Questions'[Question Type] = "Question",
			///             'Secondary Standards QA Questions'[Name] = "Behaviour Focus",
			///             'Secondary Standards QA Questions'[Answer]
			///                 IN { "Yes", "Partially", "No", "N/A" }
			///         )
			///     )
			/// )
			measure 'Behaviour Focus Questions Present For %' =
					
					CALCULATE (
					    DIVIDE (
					        CALCULATE (
					            COUNTA ( 'Secondary Standards QA Questions'[Answer] ),
					            'Secondary Standards QA Questions'[Question Type] = "Question",
					            'Secondary Standards QA Questions'[Name] = "Behaviour Focus",
					            'Secondary Standards QA Questions'[Answer]
					                IN { "Yes", "Partially", "No" } //, "Partially Met" }
					        ) + 0,
					        CALCULATE (
					            COUNTA ( 'Secondary Standards QA Questions'[Answer] ),
					            'Secondary Standards QA Questions'[Question Type] = "Question",
					            'Secondary Standards QA Questions'[Name] = "Behaviour Focus",
					            'Secondary Standards QA Questions'[Answer]
					                IN { "Yes", "Partially", "No", "N/A" }
					        )
					    )
					)
				formatString: 0.0%;-0.0%;0.0%
				displayFolder: Secondary QA\Behaviour for Learning
