		table 'Measures Folder'
			lineageTag: b766d8ef-c797-430c-88ac-5e706bd2ed4d

			/// 
			/// VAR __Attendancecore =
			///     CALCULATE (
			///         DIVIDE ( SUM ( Attendance[Attendance] ), SUM ( Attendance[Sessions] ) ),
			///         Attendance[Redaction Check] <> 1,
			///         Attendance[On Roll] <> "Unenrolled",
			///         Attendance[Compulsory Age] = 1
			///     )
			/// VAR __InScope =
			///     ISINSCOPE ( 'Student Year Groups'[Year Group] )
			/// RETURN
			///     __Attendancecore
			/// // IF (
			/// //     __InScope,
			/// //     __Attendancecore,
			/// //     CALCULATE (
			/// //         __Attendancecore,
			/// //         KEEPFILTERS ( NOT ( 'Student Year Groups'[Year Group]
			/// //             IN {
			/// //                 { "EY1" },
			/// //                 { "EY2" },
			/// //                 { "N1" },
			/// //                 { "N2" },
			/// //                 { "Reception" },
			/// //                 { "Year 12" },
			/// //                 { "Year 13" },
			/// //                 { "Year 14" }
			/// //             } ) )
			/// //     )
			/// // )
			measure 'Attendance Percentage' =
					
					VAR __Attendancecore =
					    CALCULATE (
					        DIVIDE ( SUM ( Attendance[Attendance] ), SUM ( Attendance[Sessions] ) ),
					        Attendance[Redaction Check] <> 1,
					        Attendance[On Roll] <> "Unenrolled",
					        Attendance[Compulsory Age] = 1
					    )
					VAR __InScope =
					    ISINSCOPE ( 'Student Year Groups'[Year Group] )
					RETURN
					    __Attendancecore
					// IF (
					//     __InScope,
					//     __Attendancecore,
					//     CALCULATE (
					//         __Attendancecore,
					//         KEEPFILTERS ( NOT ( 'Student Year Groups'[Year Group]
					//             IN {
					//                 { "EY1" },
					//                 { "EY2" },
					//                 { "N1" },
					//                 { "N2" },
					//                 { "Reception" },
					//                 { "Year 12" },
					//                 { "Year 13" },
					//                 { "Year 14" }
					//             } ) )
					//     )
					// )
				formatString: 0.0%;-0.0%;0.0%
				displayFolder: Attendance Measures
				lineageTag: 2c739a01-08a1-4685-9856-5c6023138d02

				extendedProperty MeasureTemplate =
						{
						  "version": 0,
						  "daxTemplateName": "MathematicalDivision"
						}

				changedProperty = FormatString

			/// 
			/// CALCULATE (
			///     DIVIDE (
			///         SUM ( Attendance[Authorised Absence] ),
			///         SUM ( 'Attendance'[Sessions] )
			///     ),
			///     'Calendar'[FutureDate] IN { "Past" }
			/// )
			measure 'Authorised Absence' =
					
					CALCULATE (
					    DIVIDE (
					        SUM ( Attendance[Authorised Absence] ),
					        SUM ( 'Attendance'[Sessions] )
					    ),
					    'Calendar'[FutureDate] IN { "Past" },
					        Attendance[Redaction Check] <> 1,
					        Attendance[On Roll] <> "Unenrolled",
					        Attendance[Compulsory Age] = 1
					)
				formatString: 0.00%;-0.00%;0.00%
				displayFolder: Attendance Measures
				lineageTag: 868f444c-f735-4768-8b64-26771eba2ac8

			/// 
			/// CALCULATE (
			///     DIVIDE (
			///         SUM ( Attendance[Unauthorised Absence] ),
			///         SUM ( 'Attendance'[Sessions] )
			///     ),
			///     'Calendar'[FutureDate] IN { "Past" }
			/// )
			measure 'Unauthorised Absence' =
					
					CALCULATE (
					    DIVIDE (
					        SUM ( Attendance[Unauthorised Absence] ),
					        SUM ( 'Attendance'[Sessions] )
					    ),
					    'Calendar'[FutureDate] IN { "Past" },
					        Attendance[Redaction Check] <> 1,
					        Attendance[On Roll] <> "Unenrolled",
					        Attendance[Compulsory Age] = 1
					)
				formatString: 0.00%;-0.00%;0.00%
				displayFolder: Attendance Measures
				lineageTag: 38ce8d4a-8b01-410f-8e77-a91b161a3e35

			/// 
			/// CALCULATE (
			///     DIVIDE (
			///         CALCULATE ( COUNTA ( Attendance[Mark] ), 'Attendance'[Mark] IN { "L" } ),
			///         SUM ( Attendance[Sessions] )
			///     ),
			///     'Calendar'[FutureDate] IN { "Past" }
			/// ) + 0
			measure 'Late Percentage' =
					
					CALCULATE (
					    DIVIDE (
					        CALCULATE ( COUNTA ( Attendance[Mark] ), 'Attendance'[Mark] IN { "L" } ),
					        SUM ( Attendance[Sessions] )
					    ),
					    'Calendar'[FutureDate] IN { "Past" }
					) + 0
				formatString: 0.00%;-0.00%;0.00%
				displayFolder: Attendance Measures
				lineageTag: 670e3f16-ca76-4ca4-b101-df4415145727

			/// 
			/// VAR SelectedSchoolType =
			///     SELECTEDVALUE ( 'School Database'[School Type] )
			/// RETURN
			///     SWITCH (
			///         TRUE (),
			///         SelectedSchoolType = "Primary", 0.052,
			///         SelectedSchoolType = "Secondary", 0.086,
			///         0.069
			///     )
			measure 'DfE Target Overall Absence' =
					
					VAR SelectedSchoolType =
					    SELECTEDVALUE ( 'School Database'[School Type] )
					RETURN
					    SWITCH (
					        TRUE (),
					        SelectedSchoolType = "Primary", 0.052,
					        SelectedSchoolType = "Secondary", 0.086,
					        0.069
					    )
				formatString: 0.00%;-0.00%;0.00%
				displayFolder: Attendance Measures
				lineageTag: 29f40f9e-370f-447f-a833-39418cd36642

			/// 
			/// [Authorised Absence YTD] + [Unauthorised Absence YTD]
			measure 'Overall Absence' =
					
					[Authorised Absence YTD] + [Unauthorised Absence YTD]
				formatString: 0.00%;-0.00%;0.00%
				displayFolder: Attendance Measures
				lineageTag: 0a738955-5eb9-4be0-899b-15ea95368dc4

			/// 
			/// VAR SelectedSchoolType =
			///     SELECTEDVALUE ( 'School Database'[School Type] )
			/// RETURN
			///     SWITCH (
			///         TRUE (),
			///         SelectedSchoolType = "Primary", 0.037,
			///         SelectedSchoolType = "Secondary", 0.053,
			///         0.045
			///     )
			measure 'DfE Target Authorised Absence' =
					
					VAR SelectedSchoolType =
					    SELECTEDVALUE ( 'School Database'[School Type] )
					RETURN
					    SWITCH (
					        TRUE (),
					        SelectedSchoolType = "Primary", 0.037,
					        SelectedSchoolType = "Secondary", 0.053,
					        0.045
					    )
				formatString: 0.00%;-0.00%;0.00%
				displayFolder: Attendance Measures
				lineageTag: f0b5624b-b86c-45f1-b086-51837106075b

			/// 
			/// VAR SelectedSchoolType =
			///     SELECTEDVALUE ( 'School Database'[School Type] )
			/// RETURN
			///     SWITCH (
			///         TRUE (),
			///         SelectedSchoolType = "Primary", 0.015,
			///         SelectedSchoolType = "Secondary", 0.033,
			///         0.023
			///     )
			measure 'DfE Target Unauthorised Absence' =
					
					VAR SelectedSchoolType =
					    SELECTEDVALUE ( 'School Database'[School Type] )
					RETURN
					    SWITCH (
					        TRUE (),
					        SelectedSchoolType = "Primary", 0.015,
					        SelectedSchoolType = "Secondary", 0.033,
					        0.023
					    )
				formatString: 0.00%;-0.00%;0.00%
				displayFolder: Attendance Measures
				lineageTag: 18187f57-6cdb-4022-831f-6104d55fa876

			/// 
			/// VAR SelectedSchoolType =
			///     SELECTEDVALUE ( 'School Database'[School Type] )
			/// RETURN
			///     SWITCH (
			///         TRUE (),
			///         SelectedSchoolType = "Primary", 0.948,
			///         SelectedSchoolType = "Secondary", 0.914,
			///         0.931
			///     )
			measure 'DfE Target Attendance' =
					
					VAR SelectedSchoolType =
					    SELECTEDVALUE ( 'School Database'[School Type] )
					RETURN
					    SWITCH (
					        TRUE (),
					        SelectedSchoolType = "Primary", 0.948,
					        SelectedSchoolType = "Secondary", 0.914,
					        0.931
					    )
				formatString: 0.00%;-0.00%;0.00%
				displayFolder: Attendance Measures
				lineageTag: c7f544b3-e10f-41d7-85d7-322e71bff4be

			/// 
			/// VAR selectedschool =
			///     SELECTEDVALUE ( 'School Database'[School Name] )
			/// RETURN
			///     IF (
			///         ISBLANK ( selectedschool ),
			///         "Nicholas Postgate Catholic Academy Trust",
			///         selectedschool
			///     )
			measure 'Selected School' =
					
					VAR selectedschool =
					    SELECTEDVALUE ( 'School Database'[School Name] )
					RETURN
					    IF (
					        ISBLANK ( selectedschool ),
					        "Nicholas Postgate Catholic Academy Trust",
					        selectedschool
					    )
				displayFolder: Formating Measures
				lineageTag: 8bdb0693-3048-41e9-8667-39e605c6e39b

			/// 
			/// DIVIDE ( [Fixed Term Exclusions], [Fixed Term Exclusion Students] )
			measure 'Fixed Term Exclusion Average per Student' =
					
