			/// VAR __Numerator =
			///     CALCULATE (
			///         DISTINCTCOUNT ( 'Financial Benchmark Data'[URN] ),
			///         FILTER (
			///             'Financial Benchmark Data',
			///             'Financial Benchmark Data'[Total Income] <= [Forecast Income]
			///         )
			///     )
			/// VAR __NumeratorErrorHandling =
			///     IF ( ISBLANK ( __Numerator ), 1, 0 )
			/// VAR __NumeratorFinal =
			///     IF (
			///         __NumeratorErrorHandling = 0,
			///         __Numerator,
			///         IF (
			///             [Forecast Income] < MIN ( 'Financial Benchmark Data'[Total Income] ),
			///             1,
			///             __Denominator
			///         )
			///     )
			/// RETURN
			///     DIVIDE ( __NumeratorFinal, __Denominator ) * 100
			measure 'Forecast Income Percentile' =
					
					VAR __Denominator =
					    DISTINCTCOUNT ( 'Financial Benchmark Data'[URN] )
					VAR __Numerator =
					    CALCULATE (
					        DISTINCTCOUNT ( 'Financial Benchmark Data'[URN] ),
					        FILTER (
					            'Financial Benchmark Data',
					            'Financial Benchmark Data'[Total Income] <= [Forecast Income]
					        )
					    )
					VAR __NumeratorErrorHandling =
					    IF ( ISBLANK ( __Numerator ), 1, 0 )
					VAR __NumeratorFinal =
					    IF (
					        __NumeratorErrorHandling = 0,
					        __Numerator,
					        IF (
					            [Forecast Income] < MIN ( 'Financial Benchmark Data'[Total Income] ),
					            1,
					            __Denominator
					        )
					    )
					RETURN
					    DIVIDE ( __NumeratorFinal, __Denominator ) * 100
