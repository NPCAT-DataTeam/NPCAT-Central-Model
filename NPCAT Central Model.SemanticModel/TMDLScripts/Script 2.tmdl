NPCAT24" else if [Location] = "St Paulinus Primary" then "NPCAT06" else if [Location] = "St Peters Catholic College" then "NPCAT21" else if [Location] = "St PiusX Primary" then "NPCAT22" else if [Location] = "St Therese of Lisieux" then "NPCAT26" else if [Location] = "St Thomas More" then "NPCAT16" else if [Location] = "St Wilfrids Primary" then "NPCAT38" else if [Location] = "Trinity Catholic College" then "NPCAT17" else null, type text),
