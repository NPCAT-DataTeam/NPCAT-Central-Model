			///     DIVIDE (
			///         CALCULATE ( COUNTA ( 'Attendance'[Mark] ), 'Attendance'[Mark] IN { "O", "I" } ),
			///         SUM ( 'Attendance'[Sessions] )
			///     ),
			///     'Calendar'[FutureDate] IN { "Past" }
			/// )
			measure 'Illness or O Code Absence Percentage' =
					
					CALCULATE (
