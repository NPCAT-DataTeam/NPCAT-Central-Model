			/// 
			/// CALCULATE (
			///     COUNTA ( 'Boxphish Phishing Simulations'[Email Simulation Outcome] ),
			///     'Boxphish Phishing Simulations'[Email Simulation Outcome] = "Pass"
			/// )
			measure 'No. Simulations Passed' =
					
					VAR _SimulationsClicked = CALCULATE (
					    COUNTA ( 'Boxphish Phishing Simulations'[Email Simulation Outcome] ),
					    'Boxphish Phishing Simulations'[Email Simulation Outcome] = "Fail")
					RETURN
					[Total Phishing Simulations Sent] - _SimulationsClicked
					
