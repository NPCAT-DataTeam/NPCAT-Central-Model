			///         MAX ( 'Calendar'[Date] ),
			///         'Calendar'[Current School Year Offset] = _Yearselector
			///     )
			/// RETURN
			///     CALCULATE (
			///         [KS2 Paper %],
			///         ALLEXCEPT ( 'Calendar', 'Calendar'[FutureDate] ),
			///         'Calendar'[Current School Year Offset] = _Yearselector
			///     )
			measure 'KS2 Paper % PY' =
					
					VAR _Yearselector =
					    MAX ( 'Calendar'[Current School Year Offset] ) - 1
					VAR _DateSelector =
					    CALCULATE (
					        MAX ( 'Calendar'[Date] ),
					        'Calendar'[Current School Year Offset] = _Yearselector
					    )
					RETURN
					    CALCULATE (
					        [KS2 Paper %],
					        ALLEXCEPT ( 'Calendar', 'Calendar'[FutureDate] ),
