			/// 
			/// VAR CutOff = [Dynamic Max Date]
			/// RETURN
			///     CALCULATE (
			///         SUM ( Creditors[Value] ),
			///         REMOVEFILTERS ( 'Calendar'[Date] ),
			///         //Creditors[Status] IN { "O","D" } &&
			///         Creditors[Invoice Date] <= CutOff
			///             && (
			///                 ISBLANK ( Creditors[Pay Date] )
			///                     || Creditors[Pay Date] > CutOff
			///             )
			///             && DATEDIFF ( Creditors[Due Date], CutOff, DAY ) > 0
			///             && DATEDIFF ( Creditors[Due Date], CutOff, DAY ) <= 30
			///     )
			measure 'Value >30 Days (£)' =
					
					VAR CutOff = [Dynamic Max Date]
					RETURN
					    CALCULATE (
					        SUM ( Creditors[Value] ),
					        REMOVEFILTERS ( 'Calendar'[Date] ),
					        //Creditors[Status] IN { "O","D" } &&
					        Creditors[Invoice Date] <= CutOff
					            && (
					                ISBLANK ( Creditors[Pay Date] )
					                    || Creditors[Pay Date] > CutOff
					            )
					            && DATEDIFF ( Creditors[Due Date], CutOff, DAY ) > 0
					            && DATEDIFF ( Creditors[Due Date], CutOff, DAY ) <= 30
					    )
				formatString: "£"#,0.0;-"£"#,0.0;"£"#,0.0
				displayFolder: Finance Measures\Creditors
				lineageTag: 101cfd5c-2300-4706-9ee2-f4d7ceb12fa7

