			/// VAR CurrentGrade =
			///     MAX ( 'KS4 Assessments'[Grade Sort] )
			/// VAR CountOfGrades =
			///     CALCULATE (
			///         [Number of Grades],
			///         REMOVEFILTERS ( 'KS4 Assessments'[Grade], 'KS4 Assessments'[Grade Sort] ),
			///         'KS4 Assessments'[Grade Sort] >= CurrentGrade
			///     )
			/// RETURN
			///     IF ( ISBLANK ( CurrentGrade ), BLANK (), CountOfGrades )
			measure 'Grade +' =
					VAR CurrentGrade =
					    MAX ( 'KS4 Assessments'[Grade Sort] )
					VAR CountOfGrades =
					    CALCULATE (
					        [Number of Grades],
					        REMOVEFILTERS ( 'KS4 Assessments'[Grade], 'KS4 Assessments'[Grade Sort] ),
					        'KS4 Assessments'[Grade Sort] >= CurrentGrade
					    )
					RETURN
					    IF ( ISBLANK ( CurrentGrade ), BLANK (), CountOfGrades )
				formatString: 0
