			/// 
			/// VAR _StudentCount =
			///     DISTINCTCOUNT ( 'KS1 Teacher Assessments'[Globally Unique ID] )
			/// VAR _YearCount =
			///     DISTINCTCOUNT ( 'KS1 Teacher Assessments'[Academic Year] )
			/// RETURN
			///     DIVIDE ( _StudentCount, _YearCount )
			measure 'No. KS1 Pupils' =
					
