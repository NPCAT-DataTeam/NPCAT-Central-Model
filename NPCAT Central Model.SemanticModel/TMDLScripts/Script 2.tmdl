			/// 
			/// VAR _MaxDayOffset =
			///     MAX ( 'Calendar'[CurDayOffset] )
			/// VAR _PW =
			///     MAX ( 'Calendar'[CurDayOffset] ) - 7
			/// VAR _PreviousPeriod =
			///     CALCULATE (
			///         [Behaviour Incidents],
			///         FILTER ( ALL ( 'Calendar' ), 'Calendar'[CurDayOffset] = _PW )
			///     )
			/// VAR _CW =
			///     CALCULATE ( [Behaviour Incidents], 'Calendar'[CurDayOffset] = _MaxDayOffset )
			/// RETURN
			///     _CW - _PreviousPeriod
			measure 'Behaviour Incidents Rolling WoW' =
					
					VAR _MaxDayOffset =
					    MAX ( 'Calendar'[CurDayOffset] )
					VAR _PW =
					    MAX ( 'Calendar'[CurDayOffset] ) - 7
					VAR _PreviousPeriod =
					    CALCULATE (
					        [Behaviour Incidents],
					        FILTER ( ALL ( 'Calendar' ), 'Calendar'[CurDayOffset] = _PW )
					    )
					VAR _CW =
					    CALCULATE ( [Behaviour Incidents], 'Calendar'[CurDayOffset] = _MaxDayOffset )
					RETURN
					    _CW - _PreviousPeriod
				formatString: #,0
