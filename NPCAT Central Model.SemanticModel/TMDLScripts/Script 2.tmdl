		table Absences
			lineageTag: db9bf59f-a153-481f-bd44-48b0314e17e6

			/// 
			/// CALCULATE (
			///     DISTINCTCOUNT ( 'Student Database (Full)'[Globally Unique Student ID] ),
			///     'Student Database (Full)'[On roll] = "Yes"
			/// )
			measure 'Students on Roll Test' =
					
					CALCULATE (
					    DISTINCTCOUNT ( 'Student Database (Full)'[Globally Unique Student ID] ),
					    'Student Database (Full)'[On roll] = "Yes"
					)
				formatString: 0
				lineageTag: 70028a0c-ec23-4323-84b0-024e71a650c9

