			///     SUMMARIZE (
			///         'Catering Actions Date List',
			///         'Catering Actions Date List'[Action Ref Number],
			///         "Days Open",
			///             CALCULATE (
			///                 COUNTROWS ( 'Catering Actions Date List' ),
			///                 'Catering Actions Date List'[Late Check(List)] = "Overdue",
			///                 'Catering Actions Date List'[Weekday] IN { 0, 1, 2, 3, 4 }
			///             )
			///     )
			/// VAR _AVGDays =
			///     AVERAGEX ( _DaysOpen, [Days Open] )
			/// RETURN
			///     _AVGDays
			measure 'AVG Days Action Overdue 1' =
					
					VAR _DaysOpen =
					    SUMMARIZE (
					        'Catering Actions Date List',
					        'Catering Actions Date List'[Action Ref Number],
					        "Days Open",
					            CALCULATE (
					                COUNTROWS ( 'Catering Actions Date List' ),
					                'Catering Actions Date List'[Late Check(List)] = "Overdue",
					                'Catering Actions Date List'[Weekday] IN { 0, 1, 2, 3, 4 }
					            )
					    )
					VAR _AVGDays =
					    AVERAGEX ( _DaysOpen, [Days Open] )
					RETURN
					    _AVGDays
				formatString: 0
				displayFolder: Catering Actions
				lineageTag: 2b76dd1b-3084-498e-966b-5d3e1a02f6a6

