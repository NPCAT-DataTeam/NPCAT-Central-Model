			/// 
			/// //This is the risk over the inherent risk associated with human factors
			/// VAR _SimFail      = ROUND(MIN ( [% of Simulations Failed YTD] / 0.15 , 1 ),2)*0.35
			/// VAR _CourseFail   = ROUND(MIN ( [% of Courses Failed YTD] / 0.10 , 1 ),2)*0.1
			/// VAR _CourseInc    = ROUND(MIN ( [% of Courses Incomplete] / 0.2 , 1 ),2)*0.15
			/// VAR _Sim2plus = ROUND(MIN ( [% Failed 2+ Simulation] / 0.50 , 1 ),2)*0.25
			/// VAR _Course2plus = ROUND(MIN ( [% Failed 2+ Course] / 0.50 , 1 ),2)*0.15
			/// 
			/// VAR _Final = 
			///     (_SimFail)+
			///     (_CourseFail)+
			///     (_CourseInc)+
			///     (_Sim2plus)+
			///     (_Course2plus)
			/// 
			/// RETURN
			/// "Final : "&_Final&UNICHAR(10)&"Sim Fail : "&_SimFail & UNICHAR(10)&"Course Fail : "&_CourseFail&UNICHAR(10)&"Course Incomplete : "&_CourseInc&UNICHAR(10)&"Sim Fail 2+ : "&_Sim2plus&UNICHAR(10)&"Course Fail 2+ : "&_Course2plus
			/// 
			measure 'Weighted Residual Risk (0-1) Break down' = ```
					
					//This is the risk over the inherent risk associated with human factors
					VAR _SimFail      = ROUND(MIN ( [% of Simulations Failed YTD] / 0.15 , 1 ),2)*0.35
					VAR _CourseFail   = ROUND(MIN ( [% of Courses Failed YTD] / 0.10 , 1 ),2)*0.1
					VAR _CourseInc    = ROUND(MIN ( [% of Courses Incomplete] / 0.2 , 1 ),2)*0.15
					VAR _Sim2plus = ROUND(MIN ( [% Failed 2+ Simulation] / 0.50 , 1 ),2)*0.25
					VAR _Course2plus = ROUND(MIN ( [% Failed 2+ Course] / 0.50 , 1 ),2)*0.15
					
					VAR _Final = 
					    (_SimFail)+
					    (_CourseFail)+
					    (_CourseInc)+
					    (_Sim2plus)+
					    (_Course2plus)
					
					RETURN
					"Final : "&_Final&UNICHAR(10)&"Sim Fail : "&_SimFail & UNICHAR(10)&"Course Fail : "&_CourseFail&UNICHAR(10)&"Course Incomplete : "&_CourseInc&UNICHAR(10)&"Sim Fail 2+ : "&_Sim2plus&UNICHAR(10)&"Course Fail 2+ : "&_Course2plus
					
					```
				displayFolder: Boxphish
				lineageTag: 05ef840a-ec75-4121-8e09-48b64bae4643

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			/// 
			/// 
			///     SWITCH(TRUE(),
			///         [Weighted Residual Risk (0-100)]<25, "Green",
			///         [Weighted Residual Risk (0-100)]<50, "Blue",
			///         [Weighted Residual Risk (0-100)]<75, "Amber",
			///         [Weighted Residual Risk (0-100)]<=100, "Red"
			///     )
			measure 'Weighted Residual Risk Rating (RABG)' = ```
					
					
					    SWITCH(TRUE(),
					        [Weighted Residual Risk (0-100)]<25, "Green",
					        [Weighted Residual Risk (0-100)]<50, "Blue",
					        [Weighted Residual Risk (0-100)]<75, "Amber",
					        [Weighted Residual Risk (0-100)]<=100, "Red"
					    )
					```
				displayFolder: Boxphish
				lineageTag: f09f2b8b-e8e6-48e7-a4c4-eafc77096c81

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			/// 
			/// //This is the risk over the inherent risk associated with human factors
			/// VAR _SimFail      = ROUND(MIN ( [% of Simulations Failed SPLY] / 0.15 , 1 ),2)
			/// VAR _CourseFail   = ROUND(MIN ( [% of Courses Failed SPLY] / 0.10 , 1 ),2)
			/// VAR _CourseInc    = ROUND(MIN ( CALCULATE([% of Courses Incomplete],SAMEPERIODLASTYEAR('Calendar'[Date])) / 0.2 , 1 ),2)
			/// VAR _Sim2plus = ROUND(MIN ( CALCULATE([% Failed 2+ Simulation],SAMEPERIODLASTYEAR('Calendar'[Date])) / 0.50 , 1 ),2)
			/// VAR _Course2plus = ROUND(MIN ( CALCULATE([% Failed 2+ Course],SAMEPERIODLASTYEAR('Calendar'[Date])) / 0.50 , 1 ),2)
			/// 
			/// VAR _Final = ROUND(
			///     (0.35*_SimFail)+
			///     (0.1*_CourseFail)+
			///     (0.15*_CourseInc)+
			///     (0.25*_Sim2plus)+
			///     (0.15*_Course2plus)
			/// ,2)
			/// 
			/// RETURN
			/// _Final *100
			measure 'Weighted Residual Risk (0-100) SPLY' =
					
					//This is the risk over the inherent risk associated with human factors
					VAR _SimFail      = ROUND(MIN ( [% of Simulations Failed SPLY] / 0.15 , 1 ),2)
					VAR _CourseFail   = ROUND(MIN ( [% of Courses Failed SPLY] / 0.10 , 1 ),2)
					VAR _CourseInc    = ROUND(MIN ( CALCULATE([% of Courses Incomplete],SAMEPERIODLASTYEAR('Calendar'[Date])) / 0.2 , 1 ),2)
					VAR _Sim2plus = ROUND(MIN ( CALCULATE([% Failed 2+ Simulation],SAMEPERIODLASTYEAR('Calendar'[Date])) / 0.50 , 1 ),2)
					VAR _Course2plus = ROUND(MIN ( CALCULATE([% Failed 2+ Course],SAMEPERIODLASTYEAR('Calendar'[Date])) / 0.50 , 1 ),2)
					
					VAR _Final = ROUND(
					    (0.35*_SimFail)+
					    (0.1*_CourseFail)+
					    (0.15*_CourseInc)+
					    (0.25*_Sim2plus)+
					    (0.15*_Course2plus)
					,2)
					
					RETURN
					_Final *100
				formatString: 0
				displayFolder: Boxphish
				lineageTag: 5d4a887b-0cb8-4a91-84c9-f46f5fe7b2b6

				annotation PBI_FormatHint = {"isDecimal":true}

			/// 
			/// [Weighted Residual Risk (0-100)] - [Weighted Residual Risk (0-100) SPLY]
			measure 'Weighted Residual Risk (0-100) YoY' =
					
					[Weighted Residual Risk (0-100)] - [Weighted Residual Risk (0-100) SPLY]
				formatString: 0
				displayFolder: Boxphish
				lineageTag: d30034da-6388-476c-a0da-5cb541a57066

				annotation PBI_FormatHint = {"isDecimal":true}

			/// 
			///    Primary Student List = 
			/// 
			/// CONCATENATEX(
			///     'Primary Summative Marks (South)',
			///     'Primary Summative Marks (South)'[Student Full Name: DOB],// & FORMAT([2. Avg Variation from Baseline], "0.0"),
			///     UNICHAR(10),                                   -- delimiter
			///     'Primary Summative Marks (South)'[Student Full Name: DOB],  -- sort by this column
			///     ASC                                           -- sort direction (ASC or DESC)
			/// )
			measure 'Primary Student List' =
					
					
					CONCATENATEX(
					    'Primary Summative Marks (South)',
					
					        'Primary Summative Marks (South)'[Student Full Name: DOB]
					        & "  "
					        & SWITCH(
					            TRUE(),
					            [2. Avg Variation from Baseline] > 0, UNICHAR(11088),//UNICHAR(9989)Green Tick,//UNICHAR(128316) blue up arrow & UNICHAR(128994)Green circle
					            [2. Avg Variation from Baseline] < 0, UNICHAR(8252) & UNICHAR(65039),//UNICHAR(128317)Blue down Arrow & UNICHAR(128308) red circle
					            [2. Avg Variation from Baseline] = 0,BLANK()       -- no change
					        ),
					
					    UNICHAR(10),   -- line break
					    'Primary Summative Marks (South)'[Student Full Name: DOB],
					    ASC
					)
				displayFolder: Primary Summative(South)
				lineageTag: d4d6a5c2-7122-4804-81ee-d53cc6f6d5cc

				annotation PBI_FormatHint = {"isGeneralNumber":true}

