			/// 
			/// VAR _LastDate =
			///     MAX ( 'Calendar'[Date] )
			/// VAR _Table =
			///     FILTER (
			///         'Student Indicies',
			///         NOT ( [Rank] = "Undefined" )
			///             && 'Student Indicies'[Category] = "Living"
			///     )
			/// VAR _TableWithRank =
			///     ADDCOLUMNS ( _Table, "RankValue", VALUE ( 'Student Indicies'[Rank] ) )
			/// RETURN
			///     CALCULATE (
			///         AVERAGEX ( _TableWithRank, VALUE ( [Rank] ) ),
			///         'Student Indicies'[Category] = "Living",
			///         'Student Database (Full)'[DOA] <= _LastDate,
			///         'Student Database (Full)'[Leaving date] > _LastDate
			///             || ISBLANK ( 'Student Database (Full)'[Leaving date] ),
			///         'Calendar'[Date] = _LastDate
			///     )
			measure 'Living Rank' =
					
					VAR _LastDate =
					    MAX ( 'Calendar'[Date] )
					VAR _Table =
					    FILTER (
					        'Student Indicies',
					        NOT ( [Rank] = "Undefined" )
					            && 'Student Indicies'[Category] = "Living"
					    )
					VAR _TableWithRank =
					    ADDCOLUMNS ( _Table, "RankValue", VALUE ( 'Student Indicies'[Rank] ) )
					RETURN
					    CALCULATE (
					        AVERAGEX ( _TableWithRank, VALUE ( [Rank] ) ),
					        'Student Indicies'[Category] = "Living",
					        'Student Database (Full)'[DOA] <= _LastDate,
					        'Student Database (Full)'[Leaving date] > _LastDate
					            || ISBLANK ( 'Student Database (Full)'[Leaving date] ),
					        'Calendar'[Date] = _LastDate
					    )
				formatString: #,##0
				displayFolder: Unused
				lineageTag: 58730930-e22e-4984-a160-e06b480143f9

