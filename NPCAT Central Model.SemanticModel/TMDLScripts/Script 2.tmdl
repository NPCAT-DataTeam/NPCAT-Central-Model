			/// 
			/// VAR __Numerator =  SUM ( 'KS4 Assessments'[Slots] ) - [Total Slots Filled]
			/// VAR __Denominator =  SUM ( 'KS4 Assessments'[Slots] ) 
			/// VAR __Final =  DIVIDE ( __Numerator, __Denominator ) 
			/// RETURN  
			/// __Final
			measure '% Slots in Spare Bucket' = ```
					
					VAR __Numerator =  SUM ( 'KS4 Assessments'[Slots] ) - [Total Slots Filled]
					VAR __Denominator =  SUM ( 'KS4 Assessments'[Slots] ) 
					VAR __Final =  DIVIDE ( __Numerator, __Denominator ) 
					RETURN  
					__Final
