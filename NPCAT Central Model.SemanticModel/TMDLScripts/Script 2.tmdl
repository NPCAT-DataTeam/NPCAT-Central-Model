			/// VAR __SelectedGrade =
			///     SELECTEDVALUE ( 'KS4 Assessments'[Grade Sort] )
			/// VAR __CumulativeGrade =
			///     CALCULATE (
			///         [Number of Grades],
			///         REMOVEFILTERS ( 'KS4 Assessments'[Grade], 'KS4 Assessments'[Grade Sort] ),
			///         'KS4 Assessments'[Grade Sort] >= __SelectedGrade
			///     ) + 0
			/// VAR __CumulativePercentage =
			///     DIVIDE (
			///         __CumulativeGrade,
			///         CALCULATE (
			///             [Number of Grades],
			///             REMOVEFILTERS ( 'KS4 Assessments'[Grade], 'KS4 Assessments'[Grade Sort] )
			///         )
			///     ) + 0
			/// RETURN
			///     __CumulativePercentage
			measure 'Grade %+' =
					VAR __SelectedGrade =
					    SELECTEDVALUE ( 'KS4 Assessments'[Grade Sort] )
					VAR __CumulativeGrade =
					    CALCULATE (
					        [Number of Grades],
					        REMOVEFILTERS ( 'KS4 Assessments'[Grade], 'KS4 Assessments'[Grade Sort] ),
					        'KS4 Assessments'[Grade Sort] >= __SelectedGrade
					    ) + 0
					VAR __CumulativePercentage =
					    DIVIDE (
					        __CumulativeGrade,
					        CALCULATE (
					            [Number of Grades],
					            REMOVEFILTERS ( 'KS4 Assessments'[Grade], 'KS4 Assessments'[Grade Sort] )
					        )
					    ) + 0
					RETURN
					    __CumulativePercentage
				displayFolder: KS4 Assessment\KS4 Subject
				lineageTag: 5bff7e84-5a5d-43b1-b542-ea7c9fefd671

				changedProperty = FormatString

