			/// )
			measure 'Selected Boxphish School' =
					
					CALCULATE(
					    CONCATENATEX(Employees,Employees[School Short Name],", "),
					    Employees[Work Email] =  SELECTEDVALUE('Boxphish Courses'[Email Address])
