			/// VAR _PreviousPeriod =
			///     CALCULATE (
			///         [Absence Insurance Claims Count],
			///         FILTER ( ALL ( 'Calendar' ), 'Calendar'[CurWeekOffset] = _PW )
			///     )
			/// VAR _CW =
			///     CALCULATE (
			///         [Absence Insurance Claims Count],
			///         'Calendar'[CurWeekOffset] = _MaxWeekOffset
			///     )
			/// RETURN
			///     _CW - _PreviousPeriod
			measure 'Absence Insurance WoW' =
					
					VAR _MaxWeekOffset =
					    MAX ( 'Calendar'[CurWeekOffset] )
					VAR _PW =
					    MAX ( 'Calendar'[CurWeekOffset] ) - 1
					VAR _PreviousPeriod =
					    CALCULATE (
					        [Absence Insurance Claims Count],
					        FILTER ( ALL ( 'Calendar' ), 'Calendar'[CurWeekOffset] = _PW )
					    )
					VAR _CW =
					    CALCULATE (
					        [Absence Insurance Claims Count],
					        'Calendar'[CurWeekOffset] = _MaxWeekOffset
					    )
					RETURN
					    _CW - _PreviousPeriod
