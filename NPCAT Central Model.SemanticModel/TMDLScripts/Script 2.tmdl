			/// 
			/// VAR __CurrentIndex =
			///     CALCULATE (
			///         MAX ( 'Health and Safety Audit Overview'[ID] ),
			///         REMOVEFILTERS ( 'Health and Safety Audit Overview'[Is Most Recent Health and Safety Audit] )
			///     )
			/// VAR __LastAuditDate =
			///     CALCULATE (
			///         MAX ( 'Health and Safety Audit Overview'[Date of Audit] ),
			///         REMOVEFILTERS ( 'Health and Safety Audit Overview'[Is Most Recent Health and Safety Audit] ),
			///         'Health and Safety Audit Overview'[ID] = __CurrentIndex
			///     )
			/// RETURN
			///     COUNTROWS ( DATESBETWEEN ( 'Calendar'[Date], __LastAuditDate, TODAY () ) ) - 1
			measure 'Days Since Last Audit Date' =
					
					VAR __CurrentIndex =
					    CALCULATE (
					        MAX ( 'Health and Safety Audit Overview'[ID] ),
					        REMOVEFILTERS ( 'Health and Safety Audit Overview'[Is Most Recent Health and Safety Audit] )
					    )
					VAR __LastAuditDate =
					    CALCULATE (
					        MAX ( 'Health and Safety Audit Overview'[Date of Audit] ),
					        REMOVEFILTERS ( 'Health and Safety Audit Overview'[Is Most Recent Health and Safety Audit] ),
					        'Health and Safety Audit Overview'[ID] = __CurrentIndex
					    )
					RETURN
					    COUNTROWS ( DATESBETWEEN ( 'Calendar'[Date], __LastAuditDate, TODAY () ) ) - 1
				formatString: 0
				displayFolder: H&S Actions
				lineageTag: 48ed2d57-e108-45ec-a10a-ad09605dd881

			/// 
			/// VAR __MaxAuditDate =
			///     MAX ( 'Health and Safety Audit Overview'[Date of Audit] )
			/// VAR __Record =
			///     CALCULATE (
			///         MIN ( 'Health and Safety Audit Overview'[Assurance Status] ),
			///         'Health and Safety Audit Overview'[Date of Audit] = __MaxAuditDate
			///     )
			/// RETURN
			///     __Record
			measure 'Most Recent Assurance Status' =
					
					VAR __MaxAuditDate =
					    MAX ( 'Health and Safety Audit Overview'[Date of Audit] )
					VAR __Record =
					    CALCULATE (
					        MIN ( 'Health and Safety Audit Overview'[Assurance Status] ),
					        'Health and Safety Audit Overview'[Date of Audit] = __MaxAuditDate
