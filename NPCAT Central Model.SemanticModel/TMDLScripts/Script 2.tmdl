			///         'Calendar'[Date] = _LastDate
			///     )
			measure 'Income Decile PY (2019)' =
					
					VAR _LastDate =
					    CALCULATE ( MAX ( 'Calendar'[Date] ), DATEADD ( 'Calendar'[Date], -1, YEAR ) )
					VAR _Table =
					    FILTER (
					        'Student Indicies',
					        NOT ( [Decile] = "Undefined" )
					            && 'Student Indicies'[RELEASE_YEAR] = 2019 && 'Student Indicies'[Category] = "Income"
					    )
					VAR _TableWithDecile =
					    ADDCOLUMNS ( _Table, "DecileValue", VALUE ( 'Student Indicies'[Decile] ) )
					RETURN
					    CALCULATE (
					        AVERAGEX ( _TableWithDecile, VALUE ( [Decile] ) ),
					        'Student Indicies'[Category] = "Income",
					        'Student Database (Full)'[DOA] <= _LastDate,
					        'Student Database (Full)'[Leaving date] > _LastDate
					            || ISBLANK ( 'Student Database (Full)'[Leaving date] ),
					        'Calendar'[Date] = _LastDate
					    )
				formatString: 0.0
				displayFolder: Student Measures\IDACI Measures\2019 IDACI
				lineageTag: 8678e700-f4a9-40cf-9f5b-73f1fd70bbf0

			/// 
			/// VAR _LastDate =
			///     MAX ( 'Calendar'[Date] )
			/// VAR _Table =
			///     FILTER ( 'Student Indicies', NOT ( [Decile] = "Undefined" ) )
			/// VAR _TableWithDecile =
			///     ADDCOLUMNS ( _Table, "DecileValue", VALUE ( 'Student Indicies'[Decile] ) )
			/// RETURN
			///     CALCULATE (
			///         AVERAGEX ( _TableWithDecile, VALUE ( [Decile] ) ),
			///         'Student Database (Full)'[DOA] <= _LastDate,
			///         'Student Database (Full)'[Leaving date] > _LastDate
			///             || ISBLANK ( 'Student Database (Full)'[Leaving date] ),
			///         'Calendar'[Date] = _LastDate
			///     )
			measure 'Indicies Decile PY (2019)' =
					
					VAR _LastDate =
					    CALCULATE ( MAX ( 'Calendar'[Date] ), DATEADD ( 'Calendar'[Date], -1, YEAR ) )
					VAR _Table =
					    FILTER ( 'Student Indicies', NOT ( [Decile] = "Undefined" ) && 'Student Indicies'[RELEASE_YEAR] = 2019 )
					VAR _TableWithDecile =
					    ADDCOLUMNS ( _Table, "DecileValue", VALUE ( 'Student Indicies'[Decile] ) )
					RETURN
					    CALCULATE (
					        AVERAGEX ( _TableWithDecile, VALUE ( [Decile] ) ),
					        'Student Database (Full)'[DOA] <= _LastDate,
					        'Student Database (Full)'[Leaving date] > _LastDate
					            || ISBLANK ( 'Student Database (Full)'[Leaving date] ),
					        'Calendar'[Date] = _LastDate
					    )
				formatString: 0.0
				displayFolder: Student Measures\IDACI Measures\2019 IDACI
				lineageTag: e3d0218f-e5a8-4c8a-a9b7-7ec01a02ae3c

				changedProperty = FormatString

			/// 
			/// VAR _LastDate =
			///     MAX ( 'Calendar'[Date] )
			/// VAR _Table =
			///     FILTER ( 'Student Indicies', NOT ( [Rank] = "Undefined" ) )
			/// VAR _TableWithRank =
			///     ADDCOLUMNS ( _Table, "RankValue", VALUE ( 'Student Indicies'[Rank] ) )
			/// RETURN
			///     CALCULATE (
			///         AVERAGEX ( _TableWithRank, VALUE ( [Rank] ) ),
			///         'Student Database (Full)'[DOA] <= _LastDate,
			///         'Student Database (Full)'[Leaving date] > _LastDate
			///             || ISBLANK ( 'Student Database (Full)'[Leaving date] ),
			///         'Calendar'[Date] = _LastDate
			///     )
			measure 'Indicies Rank PY (2019)' =
					
					VAR _LastDate =
					    CALCULATE ( MAX ( 'Calendar'[Date] ), DATEADD ( 'Calendar'[Date], -1, YEAR ) )
					VAR _Table =
					    FILTER ( 'Student Indicies', NOT ( [Rank] = "Undefined" ) && 'Student Indicies'[RELEASE_YEAR] = 2019 )
					VAR _TableWithRank =
					    ADDCOLUMNS ( _Table, "RankValue", VALUE ( 'Student Indicies'[Rank] ) )
					RETURN
					    CALCULATE (
					        AVERAGEX ( _TableWithRank, VALUE ( [Rank] ) ),
					        'Student Database (Full)'[DOA] <= _LastDate,
					        'Student Database (Full)'[Leaving date] > _LastDate
					            || ISBLANK ( 'Student Database (Full)'[Leaving date] ),
					        'Calendar'[Date] = _LastDate
					    )
				formatString: #,##0
				displayFolder: Student Measures\IDACI Measures\2019 IDACI
				lineageTag: 1b923ab7-914f-45b0-9bc8-765062c4b5ab

