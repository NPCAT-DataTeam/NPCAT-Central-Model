			/// 
			/// CALCULATE (
			///     DIVIDE (
			///         //Trust Standard
			///         CALCULATE (
			///             COUNTA ( 'Safeguarding Visit Scores'[Met/Not Met] ),
			///             'Safeguarding Visit Scores'[Met/Not Met] IN { "Met" } //, "Partially Met" }
			///         ) + 0,
			///         CALCULATE (
			///             COUNTA ( 'Safeguarding Visit Scores'[Met/Not Met] ),
			///             'Safeguarding Visit Scores'[Met/Not Met]
			///                 IN { "Met", "Not Met", "Partially Met" }
			///         )
			///     ),
			///     'Safeguarding Visit Scores'[Priority] = "Statutory",
			///     'Safeguarding Visits'[Snapshot Date]
			///         = MAX ( 'Safeguarding Visits'[Snapshot Date] )
			/// )
			measure 'Safeguarding Statutory Compliance %' =
					
					CALCULATE (
					    DIVIDE (
					        //Trust Standard
					        CALCULATE (
					            COUNTA ( 'Safeguarding Visit Scores'[Met/Not Met] ),
					            'Safeguarding Visit Scores'[Met/Not Met] IN { "Met" } //, "Partially Met" }
					        ) + 0,
					        CALCULATE (
					            COUNTA ( 'Safeguarding Visit Scores'[Met/Not Met] ),
					            'Safeguarding Visit Scores'[Met/Not Met]
					                IN { "Met", "Not Met", "Partially Met" }
					        )
					    ),
					    'Safeguarding Visit Scores'[Priority] = "Statutory",
					    'Safeguarding Visits'[Snapshot Date]
					        = MAX ( 'Safeguarding Visits'[Snapshot Date] )
					)
				formatString: 0.0%;-0.0%;0.0%
				displayFolder: Safeguarding
				lineageTag: cb10f4d6-beb7-4ec9-963c-5df3d75da888

				changedProperty = FormatString

