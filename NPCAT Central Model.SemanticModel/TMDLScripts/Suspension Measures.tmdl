createOrReplace

	ref table 'Measures Folder'

		/// 
		/// CALCULATE (
		///     DISTINCTCOUNT ( 'Behaviour Sanctions'[Globally Unique Student ID] ),
		///     FILTER (
		///         VALUES ( 'Behaviour Sanctions'[Globally Unique Student ID] ),
		///         [Suspension Sessions SPLY] >= 20
		///     )
		/// ) + 0
		measure '20 Sessions or Suspension SPLY' =
				
				CALCULATE (
				    DISTINCTCOUNT ( 'Behaviour Sanctions'[Globally Unique Student ID] ),
				    FILTER (
				        VALUES ( 'Behaviour Sanctions'[Globally Unique Student ID] ),
				        [Suspension Sessions SPLY] >= 20
				    ),
					'Behaviour Sanctions'[Source Table]="Suspension"
				) + 0
			formatString: 0
			displayFolder: Behaviour Sanctions\Suspensions
			lineageTag: 10ed8ac2-96a6-434e-9e2b-d14ea9bcfba1

		/// 
		/// CALCULATE (
		///     DISTINCTCOUNT ( 'Behaviour Sanctions'[Globally Unique Student ID] ),
		///     FILTER (
		///         VALUES ( 'Behaviour Sanctions'[Globally Unique Student ID] ),
		///         [Suspension Sessions YTD] >= 20
		///     )
		/// ) + 0
		measure '20 Sessions or Suspension YTD' =
				
				CALCULATE (
				    DISTINCTCOUNT ( 'Behaviour Sanctions'[Globally Unique Student ID] ),
				    FILTER (
				        VALUES ( 'Behaviour Sanctions'[Globally Unique Student ID] ),
				        [Suspension Sessions YTD] >= 20
				    ),
					'Behaviour Sanctions'[Source Table]="Suspension"
				) + 0
			formatString: 0
			displayFolder: Behaviour Sanctions\Suspensions
			lineageTag: 79bcfa39-799e-4b7b-9c79-7f00b227f96d

		/// 
		/// CALCULATE (
		///     DISTINCTCOUNT ( 'Behaviour Sanctions'[Globally Unique Student ID] ),
		///     FILTER (
		///         VALUES ( 'Behaviour Sanctions'[Globally Unique Student ID] ),
		///         [Suspension Sessions YTD] >= 80
		///     )
		/// ) + 0
		measure '80 Sessions or Suspension YTD' =
				
				CALCULATE (
				    DISTINCTCOUNT ( 'Behaviour Sanctions'[Globally Unique Student ID] ),
				    FILTER (
				        VALUES ( 'Behaviour Sanctions'[Globally Unique Student ID] ),
				        [Suspension Sessions YTD] >= 80
				    ),
					'Behaviour Sanctions'[Source Table]="Suspension"
				) + 0
			formatString: 0
			displayFolder: Behaviour Sanctions\Suspensions
			lineageTag: 3946020b-0181-4e46-9427-7fd8951fffde

		/// 
		/// CALCULATE (
		///     DISTINCTCOUNT ( 'Behaviour Sanctions'[Globally Unique Student ID] ),
		///     FILTER (
		///         VALUES ( 'Behaviour Sanctions'[Globally Unique Student ID] ),
		///         [Suspension Sessions SPLY] >= 80
		///     )
		/// ) + 0
		measure '80 Sessions or Suspension SPLY' =
				
				CALCULATE (
				    DISTINCTCOUNT ( 'Behaviour Sanctions'[Globally Unique Student ID] ),
				    FILTER (
				        VALUES ( 'Behaviour Sanctions'[Globally Unique Student ID] ),
				        [Suspension Sessions SPLY] >= 80
				    ),
					'Behaviour Sanctions'[Source Table]="Suspension"
				) + 0
			formatString: 0
			displayFolder: Behaviour Sanctions\Suspensions
			lineageTag: 3ea787ca-3149-4d5a-ac88-0a58bb17cc2f

		/// 
		/// VAR _MaxWeekOffset =
		///     MAX ( 'Calendar'[CurWeekOffset] )
		/// RETURN
		///     CALCULATE ( [Percentage Excluded], 'Calendar'[CurWeekOffset] = _MaxWeekOffset )
		measure 'Percentage Suspended CW' =
				
				VAR _MaxWeekOffset =
				    MAX ( 'Calendar'[CurWeekOffset] )
				RETURN
				    CALCULATE ( [Percentage Excluded], 'Calendar'[CurWeekOffset] = _MaxWeekOffset )
			formatString: 0.0%;-0.0%;0.0%
			displayFolder: Behaviour Sanctions\Suspensions
			lineageTag: c51b25d1-86bf-4f13-b629-f8c6f7fb7743

			annotation PBI_FormatHint = {"isGeneralNumber":true}

		/// 
		/// VAR __PREV_MONTH =
		///     CALCULATE ( [Percentage Excluded MTD], DATEADD ( 'Calendar'[Date], -1, MONTH ) )
		/// RETURN
		///     IF ( ISBLANK ( __PREV_MONTH ), 0, [Percentage Excluded MTD] - __PREV_MONTH )
		measure 'Percentage Suspended MoM Change' =
				
				VAR __PREV_MONTH =
				    CALCULATE ( [Percentage Excluded MTD], DATEADD ( 'Calendar'[Date], -1, MONTH ) )
				RETURN
				    IF ( ISBLANK ( __PREV_MONTH ), 0, [Percentage Excluded MTD] - __PREV_MONTH )
			formatString: 0.0%;-0.0%;0.0%
			displayFolder: Behaviour Sanctions\Suspensions
			lineageTag: 7fb180a3-b2ed-4d98-bb90-3055dd6436af

			annotation PBI_FormatHint = {"isGeneralNumber":true}

		/// 
		/// TOTALMTD ( [Percentage Excluded], 'Calendar'[Date] )
		measure 'Percentage Suspended MTD' =
				
				TOTALMTD ( [Percentage Excluded], 'Calendar'[Date] )
			formatString: 0.0%;-0.0%;0.0%
			displayFolder: Behaviour Sanctions\Suspensions
			lineageTag: b72f4f46-7890-478d-be72-9ff6dbcf1c68

			annotation PBI_FormatHint = {"isGeneralNumber":true}

		/// 
		/// VAR _MaxWeekOffset =
		///     MAX ( 'Calendar'[CurWeekOffset] )
		/// VAR _PW =
		///     MAX ( 'Calendar'[CurWeekOffset] ) - 1
		/// VAR _PreviousPeriod =
		///     CALCULATE (
		///         [Percentage Excluded],
		///         FILTER ( ALL ( 'Calendar' ), 'Calendar'[CurWeekOffset] = _PW )
		///     )
		/// VAR _CW =
		///     CALCULATE ( [Percentage Excluded], 'Calendar'[CurWeekOffset] = _MaxWeekOffset )
		/// RETURN
		///     _CW - _PreviousPeriod
		measure 'Percentage Suspended WoW' =
				
				VAR _MaxWeekOffset =
				    MAX ( 'Calendar'[CurWeekOffset] )
				VAR _PW =
				    MAX ( 'Calendar'[CurWeekOffset] ) - 1
				VAR _PreviousPeriod =
				    CALCULATE (
				        [Percentage Excluded],
				        FILTER ( ALL ( 'Calendar' ), 'Calendar'[CurWeekOffset] = _PW )
				    )
				VAR _CW =
				    CALCULATE ( [Percentage Excluded], 'Calendar'[CurWeekOffset] = _MaxWeekOffset )
				RETURN
				    _CW - _PreviousPeriod
			formatString: 0.0%;-0.0%;0.0%
			displayFolder: Behaviour Sanctions\Suspensions
			lineageTag: 4de5ed8f-43c9-4e56-80f5-ca6b857eacd2

		/// 
		/// DIVIDE ( [Suspension Students], [Students on Roll] )
