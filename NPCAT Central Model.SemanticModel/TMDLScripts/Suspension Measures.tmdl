		/// VAR _PreviousPeriod =
		///     CALCULATE (
		///         [Suspensions],
		///         FILTER ( ALL ( 'Calendar' ), 'Calendar'[CurDayOffset] = _PW )
		///     )
		/// VAR _CW =
		///     CALCULATE ( [Suspensions], 'Calendar'[CurDayOffset] = _MaxDayOffset )
		/// RETURN
		///     _CW - _PreviousPeriod
		measure 'Suspension Rolling WoW' =
				
				VAR _MaxDayOffset =
				    MAX ( 'Calendar'[CurDayOffset] )
				VAR _PW =
				    MAX ( 'Calendar'[CurDayOffset] ) - 7
				VAR _PreviousPeriod =
				    CALCULATE (
				        [Suspension],
				        FILTER ( ALL ( 'Calendar' ), 'Calendar'[CurDayOffset] = _PW )
				    )
				VAR _CW =
				    CALCULATE ( [Suspension], 'Calendar'[CurDayOffset] = _MaxDayOffset )
				RETURN
				    _CW - _PreviousPeriod
			formatString: 0
			displayFolder: Behaviour Sanctions\Suspensions
